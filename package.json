{
  "name": "logitrack-g2",
  "version": "1.0.0",
  "description": "Sistema de gestion de envios - Grupo 2",
  "license": "ISC",
  "type": "commonjs",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "start:ml": "python ml/api.py",
    "start:all": "node -e \"require('child_process').spawn('python', ['ml/api.py'], {cwd:'ml', stdio:'inherit'});\" && npm start",
    "dev": "nodemon app.js",
    "db:setup": "node src/database/setup.js",
    "db:seed-shipments": "node src/database/runSql.js src/database/seed_shipments.sql",
    "db:seed-zones": "node src/database/runSql.js src/database/seed_zones_transports.sql",
    "db:migrate": "node src/database/migrate.js",
    "test": "cross-env NODE_ENV=test jest --forceExit --detectOpenHandles",
    "test:coverage": "cross-env NODE_ENV=test jest --forceExit --detectOpenHandles --coverage",
    "test:watch": "jest --watch",
    "help:screenshots": "node Test/capture-help-screenshots.js",
    "lint": "eslint ."
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/Test/**/*.test.js"
    ],
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/database/seed.sql",
      "!src/docs/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 30,
        "functions": 12
      }
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.3.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^3.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "otplib": "^12.0.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "sweetalert2": "^11.26.24",
    "twilio": "^5.13.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "docx": "^9.6.1",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.61.1",
    "sqlite3": "^6.0.1",
    "supertest": "^7.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  }
}
