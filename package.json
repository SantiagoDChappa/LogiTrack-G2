{
  "name": "logitrack-g2",
  "version": "1.0.0",
  "description": "Sistema de gestion de envios - Grupo 2",
  "license": "ISC",
  "type": "commonjs",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:setup": "node src/database/setup.js",
