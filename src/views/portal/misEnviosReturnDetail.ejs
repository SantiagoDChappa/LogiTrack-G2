<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Devolución #<%= ret.id %> - <%= support.nombre %></title>
    <script>(function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
    <link rel="stylesheet" href="/css/portal.css?v=<%= assetVersion %>">
    <link rel="shortcut icon" href="/images/favicon.ico">
</head>
<body>
    <%- include('../partials/portal-nav', { support }) %>

    <section class="portal-mis-envios-section">
        <div class="portal-mis-envios-wrapper portal-mis-envios-detail-wrapper">
            <div class="portal-mis-envios-detail-top">
                <a href="/portal/mis-envios/devoluciones" class="portal-mis-envios-back">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Volver a mis devoluciones
                </a>
            </div>

            <div class="portal-mis-envios-header">
                <span class="portal-incident-eyebrow">Devolución</span>
                <h1>#<%= ret.id %> · <%= ret.shipment ? ret.shipment.trackingId : '' %></h1>
                <p class="portal-mis-envios-lead"><span class="portal-badge <%= ret.status.toLowerCase() %>"><%= ReturnStatusLabel[ret.status] || ret.status %></span></p>
            </div>

            <div class="portal-manage-card">
                <h2>Detalle</h2>
                <dl class="portal-kv">
                    <dt>Motivo</dt>
                    <dd><%= ReturnReasonLabel[ret.reason] || ret.reason %><% if (ret.reason === 'OTRO' && ret.reasonOther) { %> — <%= ret.reasonOther %><% } %></dd>
                    <dt>Modalidad</dt>
                    <dd><%= ret.deliveryMode === 'branch' ? 'Entrega en sucursal' : 'Retiro a domicilio' %></dd>
                    <% if (ret.observations) { %>
                    <dt>Observaciones</dt>
                    <dd><%= ret.observations %></dd>
                    <% } %>
                    <dt>Solicitud</dt>
                    <dd><%= new Date(ret.createdAt).toLocaleString('es-AR') %></dd>
                    <% if (ret.status === 'RECHAZADA' && ret.rejectionReason) { %>
                    <dt>Motivo de rechazo</dt>
                    <dd><%= ret.rejectionReason %></dd>
                    <% } %>
                    <% if (ret.result) { %>
                    <dt>Resultado</dt>
                    <dd><%= ret.result === 'REEMBOLSO' ? 'Reembolso (nota de crédito)' : 'Reemplazo (envío de reposición)' %></dd>
                    <% if (ret.result === 'REEMBOLSO' && creditNote) { %>
                    <dt>Nota de crédito</dt>
                    <dd>
                        <a href="/portal/mis-envios/nota-credito/<%= creditNote.id %>" style="color:var(--c-primary);">
                            <%= creditNote.number %>
                        </a>
                        · $<%= Number(creditNote.amount).toLocaleString('es-AR', { minimumFractionDigits: 2 }) %>
                    </dd>
                    <% } %>
                    <% if (ret.result === 'REEMPLAZO' && replacement) { %>
                    <dt>Envío de reposición</dt>
                    <dd><a href="/portal/mis-envios/envio/<%= replacement.id %>"><%= replacement.trackingId %></a></dd>
                    <% } %>
                    <% } %>
                </dl>
            </div>

            <% if (typeof query !== 'undefined' && query.modalidadOk) { %>
                <div class="portal-manage-card" style="border-left:4px solid var(--c-success);"><p style="margin:0;">Modalidad actualizada.</p></div>
            <% } %>
            <% if (typeof query !== 'undefined' && query.modalidadError) { %>
                <div class="portal-manage-card" style="border-left:4px solid var(--c-danger);"><p style="margin:0;"><%= query.modalidadError %></p></div>
            <% } %>

            <% if (canEditModality) { %>
            <div class="portal-manage-card">
                <h2>Cambiar modalidad</h2>
                <form method="POST" action="/portal/mis-envios/devolucion/<%= ret.id %>/modalidad">
                    <% const _mode = ret.deliveryMode || 'home'; %>
                    <label class="portal-manage-radio">
                        <input type="radio" name="deliveryMode" value="home" <%= _mode === 'home' ? 'checked' : '' %>>
                        Retiro a domicilio
                    </label>
                    <div class="portal-manage-hint" id="returnHomeInfo" style="<%= _mode === 'home' ? '' : 'display:none;' %>">
                        Pasamos a retirar por:
                        <strong><%= [shipment.address && shipment.address.street, shipment.address && shipment.address.number].filter(Boolean).join(' ') || 'el domicilio del envío' %></strong><% if (shipment.address && shipment.address.postalCode) { %> (CP <%= shipment.address.postalCode %>)<% } %>.
                    </div>
                    <label class="portal-manage-radio">
                        <input type="radio" name="deliveryMode" value="branch" <%= _mode === 'branch' ? 'checked' : '' %>>
                        Entrega en sucursal
                    </label>
                    <div class="portal-search-field" id="returnBranchWrap" style="<%= _mode === 'branch' ? '' : 'display:none;' %>">
                        <label class="portal-search-label" for="pickupBranchId">Sucursal</label>
                        <select name="pickupBranchId" id="pickupBranchId" class="portal-search-input-field">
                            <option value="">— seleccionar —</option>
                            <% branches.forEach(function(b) { %>
                            <option value="<%= b.id %>" <%= String(ret.pickupBranchId) === String(b.id) ? 'selected' : '' %>><%= b.name %><%= b.address ? ' — ' + b.address : '' %></option>
                            <% }); %>
                        </select>
                    </div>
                    <button type="submit" class="portal-search-panel-btn" style="margin-top:.75rem;">
                        <span class="material-symbols-outlined">edit</span>
                        Guardar modalidad
                    </button>
                </form>
            </div>
            <% } %>

            <div class="portal-manage-card">
                <h2>Seguimiento</h2>
                <% if (!ret.history || ret.history.length === 0) { %>
                    <p class="portal-manage-hint">Sin actualizaciones todavía.</p>
                <% } else { %>
                    <ul class="portal-vlog">
                        <% ret.history.forEach(function(h) { %>
                            <li class="portal-vlog-item">
                                <span class="portal-vlog-dot"></span>
                                <div class="portal-vlog-title"><%= ReturnStatusLabel[h.toStatus] || h.toStatus %></div>
                                <div class="portal-vlog-date"><%= new Date(h.createdAt).toLocaleString('es-AR') %></div>
                                <% if (h.comment) { %><div class="portal-vlog-comment"><%= h.comment %></div><% } %>
                            </li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
        </div>
    </section>
    <script src="/js/theme.js" defer></script>
    <script>
        (function () {
            // Modalidad: muestra domicilio (home) o selector de sucursal (branch).
            var homeInfo = document.getElementById('returnHomeInfo');
            var branchWrap = document.getElementById('returnBranchWrap');
            var branchSel = document.getElementById('pickupBranchId');
            if (!branchWrap) { return; }
            document.querySelectorAll('input[name="deliveryMode"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    var branch = document.querySelector('input[name="deliveryMode"]:checked').value === 'branch';
                    branchWrap.style.display = branch ? '' : 'none';
                    if (homeInfo) { homeInfo.style.display = branch ? 'none' : ''; }
                    if (branch) { branchSel.setAttribute('required', 'required'); } else { branchSel.removeAttribute('required'); }
                });
            });
        })();
    </script>
</body>
</html>
