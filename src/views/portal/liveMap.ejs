<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= support.nombre %> - Seguí tu envío en vivo</title>
    <script>(function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <link rel="stylesheet" href="/css/portal.css?v=<%= assetVersion %>">
    <link rel="shortcut icon" href="/images/favicon.ico">
    <style>
        html, body { margin:0; height:100%; }
        body { display:flex; flex-direction:column; min-height:100vh; background:var(--c-bg); color:var(--c-text);
               font-family:'Inter',system-ui,sans-serif; }

        .lm-bar { display:flex; align-items:center; gap:.6rem; padding:.6rem 1.1rem;
                  background:var(--c-surface); border-bottom:1px solid var(--c-border); }
        .lm-bar .material-symbols-outlined { color:var(--c-primary); font-size:1.2rem; }
        .lm-bar-title { font-weight:600; font-size:.95rem; }
        .lm-bar-track { margin-left:auto; font-size:.8rem; color:var(--c-text-2); }
        .lm-bar-track b { color:var(--c-text); }

        /* Escenario: mapa (izq) + panel de info/chat (der). */
        .lm-stage { flex:1; min-height:0; display:flex; }
        .lm-map-col { flex:1; position:relative; min-width:0; }
        #lm-map { position:absolute; inset:0; width:100%; height:100%; background:var(--c-bg); }
        .leaflet-container { font-family:'Inter',system-ui,sans-serif; }

        .lm-panel { width:360px; flex:none; background:var(--c-surface); border-left:1px solid var(--c-border);
                    display:flex; flex-direction:column; min-height:0; }
        .lm-info { padding:1rem 1.1rem; border-bottom:1px solid var(--c-border); }
        .lm-info h2 { margin:0 0 .7rem; font-size:1rem; font-weight:600; }
        .lm-info-row { display:flex; align-items:flex-start; gap:.55rem; font-size:.85rem; color:var(--c-text-2); margin:.35rem 0; }
        .lm-info-row .material-symbols-outlined { font-size:1.1rem; color:var(--c-text-3); margin-top:1px; }
        .lm-info-row b { color:var(--c-text); font-weight:500; }
        .lm-eta { margin-top:.7rem; padding:.55rem .8rem; border-radius:10px; font-size:.85rem; font-weight:600;
                  background:var(--badge-transit-bg); color:var(--badge-transit-text); display:none; }
        .lm-eta.delayed { background:var(--badge-delayed-bg); color:var(--badge-delayed-text); }
        .lm-status { margin-top:.55rem; display:flex; align-items:center; gap:.45rem; font-size:.82rem; color:var(--c-text-2); }
        .lm-status .material-symbols-outlined { font-size:1.05rem; color:var(--c-primary); }

        /* Chat. */
        .lm-chat { flex:1; min-height:0; display:flex; flex-direction:column; }
        .lm-chat-head { padding:.6rem 1.1rem; font-size:.85rem; font-weight:600; border-bottom:1px solid var(--c-border);
                        display:flex; align-items:center; gap:.4rem; }
        .lm-chat-head .material-symbols-outlined { font-size:1.05rem; color:var(--c-primary); }
        .lm-chat-msgs { flex:1; min-height:0; overflow-y:auto; padding:.8rem 1.1rem; display:flex; flex-direction:column; gap:.45rem; }
        .lm-msg { max-width:82%; padding:.45rem .7rem; border-radius:12px; font-size:.86rem; line-height:1.35; }
        .lm-msg--client { align-self:flex-end; background:var(--c-primary); color:#fff; border-bottom-right-radius:4px; }
        .lm-msg--driver { align-self:flex-start; background:var(--c-bg); color:var(--c-text); border:1px solid var(--c-border); border-bottom-left-radius:4px; }
        .lm-chat-note { padding:1rem 1.1rem; font-size:.82rem; color:var(--c-text-3); text-align:center; }
        .lm-chat-form { display:flex; gap:.4rem; padding:.6rem; border-top:1px solid var(--c-border); }
        .lm-chat-form input { flex:1; padding:.5rem .7rem; border:1px solid var(--c-border); border-radius:8px;
                              background:var(--c-bg); color:var(--c-text); font-size:.86rem; font-family:inherit; }
        .lm-chat-form button { padding:.5rem .8rem; border:0; border-radius:8px; background:var(--c-primary); color:#fff;
                               font-weight:600; cursor:pointer; display:flex; align-items:center; }
        .lm-chat-form button .material-symbols-outlined { font-size:1.1rem; }

        /* Marcadores: camión (repartidor) y casa (destino). */
        .lm-mk { width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center;
                 border:3px solid var(--c-surface); box-shadow:var(--shadow); color:#fff; }
        .lm-mk .material-symbols-outlined { font-size:20px; line-height:1; }
        .lm-mk--dest { background:var(--c-danger); }
        .lm-mk--driver { background:var(--c-primary); position:relative; }
        .lm-mk--driver::after { content:''; position:absolute; inset:-3px; border-radius:50%;
                  border:2px solid var(--c-primary); opacity:.5; animation:lm-pulse 1.8s ease-out infinite; }
        @keyframes lm-pulse { 0%{ transform:scale(1); opacity:.5; } 100%{ transform:scale(2.4); opacity:0; } }
        @media (prefers-reduced-motion: reduce) { .lm-mk--driver::after { animation:none; } }

        .lm-empty { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center;
                    justify-content:center; gap:.4rem; padding:2rem; text-align:center; color:var(--c-text-2); }
        .lm-empty .material-symbols-outlined { font-size:2.6rem; color:var(--c-text-3); }
        .lm-empty h1 { color:var(--c-text); font-size:1.15rem; font-weight:600; margin:.3rem 0 0; }
        .lm-empty p { margin:.15rem 0; font-size:.9rem; }
        .lm-link { color:var(--c-primary); font-weight:600; text-decoration:none; margin-top:.4rem; }

        /* Mobile: apilar mapa arriba, panel abajo. */
        @media (max-width: 820px) {
            .lm-stage { flex-direction:column; }
            .lm-map-col { flex:none; height:48vh; }
            .lm-panel { width:auto; border-left:0; border-top:1px solid var(--c-border); flex:1; }
        }
    </style>
</head>
<body>
    <%- include('../partials/portal-nav', { support }) %>

    <div class="lm-bar">
        <span class="material-symbols-outlined">my_location</span>
        <span class="lm-bar-title">Seguí tu envío en vivo</span>
        <% if (!notFound && shipment) { %>
        <span class="lm-bar-track">Seguimiento <b><%= shipment.trackingId %></b></span>
        <% } %>
    </div>

    <% if (notFound || !shipment) { %>
    <div class="lm-stage"><div class="lm-map-col"><div class="lm-empty">
        <span class="material-symbols-outlined">wrong_location</span>
        <h1>No encontramos ese envío</h1>
        <p>Verificá el código de seguimiento<% if (trackingId) { %> (<b><%= trackingId %></b>)<% } %> e intentá de nuevo.</p>
        <a class="lm-link" href="/">Ir al seguimiento</a>
    </div></div></div>
    <% } else if (!shipment.dest) { %>
    <div class="lm-stage"><div class="lm-map-col"><div class="lm-empty">
        <span class="material-symbols-outlined">location_off</span>
        <h1>Sin punto de entrega en el mapa</h1>
        <p>Todavía no tenemos la ubicación geográfica de la dirección de entrega.</p>
        <a class="lm-link" href="/?q=<%= encodeURIComponent(shipment.trackingId) %>">Ver el detalle del envío</a>
    </div></div></div>
    <% } else { %>
    <div class="lm-stage">
        <div class="lm-map-col">
            <div id="lm-map"></div>
        </div>
        <aside class="lm-panel">
            <div class="lm-info">
                <h2>Tu entrega</h2>
                <div class="lm-info-row"><span class="material-symbols-outlined">home</span>
                    <span><b><%= shipment.dest.label %></b></span></div>
                <% if (shipment.recipient) { %>
                <div class="lm-info-row"><span class="material-symbols-outlined">person</span>
                    <span>Recibe <b><%= shipment.recipient %></b></span></div>
                <% } %>
                <div id="lm-eta" class="lm-eta"></div>
                <div class="lm-status">
                    <span class="material-symbols-outlined" id="lm-status-icon">local_shipping</span>
                    <span id="lm-status-text">Buscando al repartidor…</span>
                </div>
            </div>
            <div class="lm-chat">
                <div class="lm-chat-head"><span class="material-symbols-outlined">chat</span> Chat con el repartidor</div>
                <div class="lm-chat-msgs" id="lm-chat-msgs"></div>
                <div class="lm-chat-note" id="lm-chat-note">El chat se abre cuando el repartidor está en camino hacia vos.</div>
                <form class="lm-chat-form" id="lm-chat-form" style="display:none;">
                    <input type="text" id="lm-chat-input" maxlength="1000" placeholder="Escribí un mensaje…" autocomplete="off">
                    <button type="submit" aria-label="Enviar"><span class="material-symbols-outlined">send</span></button>
                </form>
            </div>
        </aside>
    </div>
    <% } %>

    <script src="/js/theme.js" defer></script>
    <% if (!notFound && shipment && shipment.dest) { %>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    (function(){
        var DATA = <%- JSON.stringify({
            trackingId: shipment.trackingId,
            recipient: shipment.recipient,
            dest: shipment.dest,
            activeRouteId: shipment.activeRouteId,
        }) %>;

        var cssVar = function(n){ return getComputedStyle(document.documentElement).getPropertyValue(n).trim() || '#2563eb'; };

        var map = L.map('lm-map', { zoomControl: true, attributionControl: true })
            .setView([DATA.dest.lat, DATA.dest.lng], 14);

        var dark = document.documentElement.getAttribute('data-theme') === 'dark';
        L.tileLayer('https://{s}.basemaps.cartocdn.com/' + (dark ? 'dark_all' : 'light_all') + '/{z}/{x}/{y}{r}.png', {
            attribution: '© OpenStreetMap © CARTO', subdomains: 'abcd', maxZoom: 19,
        }).addTo(map);

        // Destino = casa.
        var destIcon = L.divIcon({ className:'', iconSize:[38,38], iconAnchor:[19,19], popupAnchor:[0,-17],
            html:'<div class="lm-mk lm-mk--dest"><span class="material-symbols-outlined">home</span></div>' });
        L.marker([DATA.dest.lat, DATA.dest.lng], { icon: destIcon })
            .addTo(map)
            .bindPopup('<b>Punto de entrega</b><br>' + (DATA.dest.label || '')
                + (DATA.recipient ? '<br>' + DATA.recipient : ''));

        var statusText = document.getElementById('lm-status-text');
        var statusIcon = document.getElementById('lm-status-icon');
        var setStatus = function(icon, text){ statusIcon.textContent = icon; statusText.textContent = text; };

        if (!DATA.activeRouteId) {
            setStatus('schedule', 'El repartidor todavía no salió a la calle.');
            map.setView([DATA.dest.lat, DATA.dest.lng], 15);
        }

        // Repartidor = camión. Sin transición CSS: Leaflet reposiciona por transform al
        // hacer zoom y una transición lo haría "deslizar"; setLatLng ya lo deja fijo.
        var driverIcon = L.divIcon({ className:'', iconSize:[38,38], iconAnchor:[19,19],
            html:'<div class="lm-mk lm-mk--driver"><span class="material-symbols-outlined">local_shipping</span></div>' });
        var liveMarker = null, fittedOnce = false, lastPos = null, routeLine = null, lastRoutedPos = null;

        var haversineKm = function(a, b){
            var R = 6371, toRad = function(d){ return d*Math.PI/180; };
            var dLat = toRad(b.lat-a.lat), dLng = toRad(b.lng-a.lng);
            var s = Math.sin(dLat/2)*Math.sin(dLat/2)
                + Math.cos(toRad(a.lat))*Math.cos(toRad(b.lat))*Math.sin(dLng/2)*Math.sin(dLng/2);
            return 2*R*Math.asin(Math.sqrt(s));
        };

        // Camino por calle (OSRM) repartidor → destino; se recalcula sólo al moverse > ~40 m.
        var drawRoute = function(from, to){
            var url = 'https://router.project-osrm.org/route/v1/driving/'
                + from.lng + ',' + from.lat + ';' + to.lng + ',' + to.lat + '?overview=full&geometries=geojson';
            fetch(url).then(function(r){ return r.ok ? r.json() : null; }).then(function(d){
                if (!d || !d.routes || !d.routes[0]) { return; }
                var poly = d.routes[0].geometry.coordinates.map(function(c){ return [c[1], c[0]]; });
                if (routeLine) { map.removeLayer(routeLine); }
                routeLine = L.polyline(poly, { color: cssVar('--c-primary'), weight: 4, opacity: 0.7 }).addTo(map);
            }).catch(function(){});
        };

        var updateLive = function(){
            if (!DATA.activeRouteId) { return; }
            fetch('/track/' + encodeURIComponent(DATA.trackingId) + '/position')
                .then(function(r){ return r.ok ? r.json() : null; })
                .then(function(p){
                    if (!p || p.lat == null) {
                        if (!liveMarker) { setStatus('schedule', 'El repartidor está por salir.'); }
                        return;
                    }
                    lastPos = { lat: p.lat, lng: p.lng };
                    if (liveMarker) { liveMarker.setLatLng([p.lat, p.lng]); }
                    else { liveMarker = L.marker([p.lat, p.lng], { icon: driverIcon }).addTo(map).bindPopup('Repartidor en camino'); }

                    if (!lastRoutedPos || haversineKm(lastPos, lastRoutedPos) > 0.04) {
                        drawRoute(lastPos, DATA.dest);
                        lastRoutedPos = lastPos;
                    }

                    var km = haversineKm(lastPos, DATA.dest);
                    if (km < 0.15) { setStatus('flag', '¡El repartidor está llegando!'); }
                    else { setStatus('local_shipping', 'En camino · a ' + (km < 1 ? Math.round(km*1000) + ' m' : km.toFixed(1) + ' km') + ' del destino'); }

                    if (!fittedOnce) {
                        map.fitBounds([[p.lat, p.lng], [DATA.dest.lat, DATA.dest.lng]], { padding: [50,50], maxZoom: 16 });
                        fittedOnce = true;
                    }
                }).catch(function(){});
        };
        updateLive();
        setInterval(updateLive, 1000);

        var etaBox = document.getElementById('lm-eta');
        var updateEta = function(){
            fetch('/track/' + encodeURIComponent(DATA.trackingId) + '/eta')
                .then(function(r){ return r.ok ? r.json() : null; })
                .then(function(e){
                    if (!e || !e.text) { etaBox.style.display = 'none'; return; }
                    etaBox.textContent = '🕒 ' + e.text;
                    etaBox.className = 'lm-eta' + (e.delayed ? ' delayed' : '');
                    etaBox.style.display = 'block';
                }).catch(function(){});
        };
        updateEta();
        setInterval(updateEta, 20000);

        // Chat cliente ↔ repartidor (público por tracking). Polling cada 4 s.
        var msgsEl = document.getElementById('lm-chat-msgs');
        var noteEl = document.getElementById('lm-chat-note');
        var formEl = document.getElementById('lm-chat-form');
        var inputEl = document.getElementById('lm-chat-input');
        var lastId = 0;
        var append = function(m){
            var row = document.createElement('div');
            row.className = 'lm-msg ' + (m.role === 'CLIENT' ? 'lm-msg--client' : 'lm-msg--driver');
            row.textContent = m.body;
            msgsEl.appendChild(row);
            if (m.id > lastId) { lastId = m.id; }
        };
        var pollChat = function(){
            fetch('/track/' + encodeURIComponent(DATA.trackingId) + '/chat?since=' + lastId)
                .then(function(r){ return r.ok ? r.json() : null; })
                .then(function(t){
                    if (!t) { return; }
                    if (t.open) {
                        noteEl.style.display = 'none';
                        formEl.style.display = 'flex';
                        (t.messages || []).forEach(append);
                        if (t.messages && t.messages.length) { msgsEl.scrollTop = msgsEl.scrollHeight; }
                    } else {
                        formEl.style.display = 'none';
                        noteEl.style.display = 'block';
                        noteEl.textContent = (t.status === 'CLOSED')
                            ? 'El chat se cerró: tu envío ya fue entregado o gestionado.'
                            : 'El chat se abre cuando el repartidor está en camino hacia vos.';
                    }
                }).catch(function(){});
        };
        formEl.addEventListener('submit', function(ev){
            ev.preventDefault();
            var body = inputEl.value.trim();
            if (!body) { return; }
            inputEl.value = '';
            fetch('/track/' + encodeURIComponent(DATA.trackingId) + '/chat', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ body }),
            }).then(function(r){ return r.ok ? r.json() : null; })
              .then(function(m){ if (m) { append(m); msgsEl.scrollTop = msgsEl.scrollHeight; } })
              .catch(function(){});
        });
        pollChat();
        setInterval(pollChat, 4000);
    })();
    </script>
    <% } %>
</body>
</html>
