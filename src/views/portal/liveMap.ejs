<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= support.nombre %> - Seguimiento en vivo</title>
    <script>(function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
    <link rel="shortcut icon" href="/images/favicon.ico">
    <style>
        html, body { margin:0; height:100%; font-family:var(--font-family); background:var(--color-bg); color:var(--color-text); }
        .lm-wrap { position:fixed; inset:0; display:flex; flex-direction:column; }

        .lm-top { display:flex; align-items:center; gap:.6rem; padding:.7rem 1.1rem;
                  background:var(--color-surface); border-bottom:1px solid var(--color-border); z-index:1000; }
        .lm-top .material-symbols-outlined { color:var(--color-primary); font-size:1.3rem; }
        .lm-brand { font-weight:600; font-size:.98rem; }
        .lm-tracking { margin-left:auto; font-size:.8rem; color:var(--color-text-secondary); }
        .lm-tracking b { color:var(--color-text); font-weight:600; }

        #lm-map { flex:1; width:100%; background:var(--color-surface-alt); }
        .leaflet-container { font-family:var(--font-family); }

        /* Píldora de ETA — limpia, tono informativo del sistema. */
        .lm-eta { position:absolute; left:50%; transform:translateX(-50%); top:60px; z-index:1000;
                  background:var(--color-info-bg); color:var(--color-info); border:1px solid var(--color-border);
                  border-radius:var(--radius-full); padding:.45rem 1rem; font-weight:500; font-size:.85rem;
                  box-shadow:var(--shadow-sm); display:none; max-width:90%; text-align:center; }
        .lm-eta.delayed { background:var(--color-warning-bg); color:var(--color-warning); }

        /* Banner inferior — tarjeta sobria con tokens del sistema. */
        .lm-banner { position:absolute; left:50%; transform:translateX(-50%); bottom:20px; z-index:1000;
                     background:var(--color-surface); color:var(--color-text); border:1px solid var(--color-border);
                     border-radius:var(--radius-md); padding:.6rem 1rem; font-size:.85rem;
                     box-shadow:var(--shadow-md); display:flex; align-items:center; gap:.5rem; max-width:92%; }
        .lm-banner .material-symbols-outlined { color:var(--color-primary); font-size:1.15rem; }

        /* Marcadores minimalistas: puntos simples, sin íconos recargados. */
        .lm-dot { width:16px; height:16px; border-radius:50%; border:3px solid var(--color-surface); box-shadow:var(--shadow-sm); }
        .lm-dot--dest { background:var(--color-danger); }
        .lm-dot--driver { position:relative; background:var(--color-primary); }
        .lm-dot--driver::after { content:''; position:absolute; inset:-3px; border-radius:50%;
                  border:2px solid var(--color-primary); opacity:.55; animation:lm-pulse 1.8s ease-out infinite; }
        @keyframes lm-pulse { 0%{ transform:scale(1); opacity:.55; } 100%{ transform:scale(2.6); opacity:0; } }
        @media (prefers-reduced-motion: reduce) { .lm-dot--driver::after { animation:none; } }

        .lm-empty { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
                    gap:.4rem; padding:2rem; text-align:center; color:var(--color-text-secondary); }
        .lm-empty .material-symbols-outlined { font-size:2.6rem; color:var(--color-text-secondary); }
        .lm-empty h1 { color:var(--color-text); font-size:1.15rem; font-weight:600; margin:.3rem 0 0; }
        .lm-empty p { margin:.15rem 0; font-size:.9rem; }
        .lm-link { color:var(--color-primary); font-weight:600; text-decoration:none; margin-top:.4rem; }
    </style>
</head>
<body>
    <div class="lm-wrap">
        <div class="lm-top">
            <span class="material-symbols-outlined">local_shipping</span>
            <span class="lm-brand"><%= support.nombre %></span>
            <% if (!notFound && shipment) { %>
            <span class="lm-tracking">Seguimiento <b><%= shipment.trackingId %></b></span>
            <% } %>
        </div>

        <% if (notFound || !shipment) { %>
        <div class="lm-empty">
            <span class="material-symbols-outlined">wrong_location</span>
            <h1>No encontramos ese envío</h1>
            <p>Verificá el código de seguimiento<% if (trackingId) { %> (<b><%= trackingId %></b>)<% } %> e intentá de nuevo.</p>
            <a class="lm-link" href="/">Ir al seguimiento</a>
        </div>
        <% } else if (!shipment.dest) { %>
        <div class="lm-empty">
            <span class="material-symbols-outlined">location_off</span>
            <h1>Sin punto de entrega en el mapa</h1>
            <p>Todavía no tenemos la ubicación geográfica de la dirección de entrega.</p>
            <a class="lm-link" href="/?q=<%= encodeURIComponent(shipment.trackingId) %>">Ver el detalle del envío</a>
        </div>
        <% } else { %>
        <div id="lm-eta" class="lm-eta"></div>
        <div id="lm-map"></div>
        <div class="lm-banner" id="lm-banner">
            <span class="material-symbols-outlined" id="lm-banner-icon">my_location</span>
            <span id="lm-banner-text">Buscando al repartidor…</span>
        </div>
        <% } %>
    </div>

    <% if (!notFound && shipment && shipment.dest) { %>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    (function(){
        var DATA = <%- JSON.stringify({
            trackingId: shipment.trackingId,
            recipient: shipment.recipient,
            dest: shipment.dest,
            activeRouteId: shipment.activeRouteId,
        }) %>;

        var map = L.map('lm-map', { zoomControl: true, attributionControl: true })
            .setView([DATA.dest.lat, DATA.dest.lng], 14);

        // Basemap minimalista (CARTO) que acompaña el tema claro/oscuro — mucho menos
        // ruido visual que el OSM estándar.
        var dark = document.documentElement.getAttribute('data-theme') === 'dark';
        L.tileLayer('https://{s}.basemaps.cartocdn.com/' + (dark ? 'dark_all' : 'light_all') + '/{z}/{x}/{y}{r}.png', {
            attribution: '© OpenStreetMap © CARTO', subdomains: 'abcd', maxZoom: 19,
        }).addTo(map);

        // Punto de entrega: punto simple en color de alerta.
        var destIcon = L.divIcon({ className:'', html:'<div class="lm-dot lm-dot--dest"></div>',
            iconSize:[16,16], iconAnchor:[8,8], popupAnchor:[0,-10] });
        L.marker([DATA.dest.lat, DATA.dest.lng], { icon: destIcon })
            .addTo(map)
            .bindPopup('<b>Punto de entrega</b><br>' + (DATA.dest.label || '')
                + (DATA.recipient ? '<br>' + DATA.recipient : ''));

        var banner = document.getElementById('lm-banner');
        var bannerText = document.getElementById('lm-banner-text');
        var bannerIcon = document.getElementById('lm-banner-icon');
        var setBanner = function(icon, text) { bannerIcon.textContent = icon; bannerText.textContent = text; };

        if (!DATA.activeRouteId) {
            setBanner('schedule', 'El repartidor todavía no salió a la calle. Te avisamos cuando esté en camino.');
            map.setView([DATA.dest.lat, DATA.dest.lng], 15);
        }

        // Repartidor en vivo: punto simple en color primario, con halo sutil que late.
        var driverIcon = L.divIcon({ className:'', html:'<div class="lm-dot lm-dot--driver"></div>',
            iconSize:[16,16], iconAnchor:[8,8] });
        var liveMarker = null;
        var fittedOnce = false;
        var lastPos = null;

        var haversineKm = function(a, b) {
            var R = 6371, toRad = function(d){ return d*Math.PI/180; };
            var dLat = toRad(b.lat-a.lat), dLng = toRad(b.lng-a.lng);
            var s = Math.sin(dLat/2)*Math.sin(dLat/2)
                + Math.cos(toRad(a.lat))*Math.cos(toRad(b.lat))*Math.sin(dLng/2)*Math.sin(dLng/2);
            return 2*R*Math.asin(Math.sqrt(s));
        };

        var updateLive = function() {
            if (!DATA.activeRouteId) { return; }
            fetch('/track/' + encodeURIComponent(DATA.trackingId) + '/position')
                .then(function(r){ return r.ok ? r.json() : null; })
                .then(function(p){
                    if (!p || p.lat == null) {
                        if (!liveMarker) { setBanner('schedule', 'El repartidor está por salir. La ubicación aparece apenas arranca el GPS.'); }
                        return;
                    }
                    lastPos = { lat: p.lat, lng: p.lng };
                    if (liveMarker) { liveMarker.setLatLng([p.lat, p.lng]); }
                    else { liveMarker = L.marker([p.lat, p.lng], { icon: driverIcon }).addTo(map).bindPopup('Repartidor en camino'); }

                    var km = haversineKm(lastPos, DATA.dest);
                    if (km < 0.15) { setBanner('flag', '¡El repartidor está llegando a tu domicilio!'); }
                    else { setBanner('my_location', 'Repartidor en camino · a ' + (km < 1 ? Math.round(km*1000) + ' m' : km.toFixed(1) + ' km') + ' del destino'); }

                    if (!fittedOnce) {
                        map.fitBounds([[p.lat, p.lng], [DATA.dest.lat, DATA.dest.lng]], { padding: [60,60], maxZoom: 16 });
                        fittedOnce = true;
                    }
                }).catch(function(){});
        };
        updateLive();
        setInterval(updateLive, 8000);

        // Franja horaria de llegada (ETA), se recalcula sola.
        var etaBox = document.getElementById('lm-eta');
        var updateEta = function() {
            fetch('/track/' + encodeURIComponent(DATA.trackingId) + '/eta')
                .then(function(r){ return r.ok ? r.json() : null; })
                .then(function(e){
                    if (!e || !e.text) { etaBox.style.display = 'none'; return; }
                    etaBox.textContent = e.text;
                    etaBox.className = 'lm-eta' + (e.delayed ? ' delayed' : '');
                    etaBox.style.display = 'block';
                }).catch(function(){});
        };
        updateEta();
        setInterval(updateEta, 20000);
    })();
    </script>
    <% } %>
</body>
</html>
