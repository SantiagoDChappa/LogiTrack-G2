<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= support.nombre %> — Seguí tu envío</title>
    <script>(function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
    <link rel="stylesheet" href="/css/portal.css?v=<%= assetVersion %>">
    <link rel="shortcut icon" href="/images/favicon.ico">
    <style>
        body { margin:0; background:var(--c-bg,#f1f5f9); color:var(--c-text,#0f172a);
               font-family:'Inter',system-ui,sans-serif; }
        .ts-bar { display:flex; align-items:center; gap:.55rem; padding:.7rem 1.1rem;
                  background:var(--c-surface,#fff); border-bottom:1px solid var(--c-border,#e2e8f0); }
        .ts-bar .material-symbols-outlined { color:var(--c-primary,#2563eb); }
        .ts-bar b { font-weight:700; }
        .ts-wrap { max-width:560px; margin:0 auto; padding:1.25rem 1rem 2.5rem; }
        :root { --color-surface:var(--c-surface,#fff); --color-border:var(--c-border,#e2e8f0);
                --color-text-secondary:var(--c-text-2,#64748b); --color-primary:var(--c-primary,#2563eb); }
    </style>
</head>
<body>
    <div class="ts-bar">
        <span class="material-symbols-outlined">local_shipping</span>
        <b><%= support.nombre %></b>
        <span style="margin-left:auto;font-size:.82rem;color:var(--c-text-2,#64748b)">Seguimiento</span>
    </div>

    <div class="ts-wrap">
        <% if (notFound) { %>
            <div style="text-align:center;padding:3rem 1rem">
                <span class="material-symbols-outlined" style="font-size:3rem;color:#94a3b8">search_off</span>
                <h2>No encontramos ese envío</h2>
                <p style="color:var(--c-text-2,#64748b)">Revisá el código de seguimiento<% if (trackingId) { %> (<strong><%= trackingId %></strong>)<% } %> e intentá de nuevo.</p>
            </div>
        <% } else { %>
            <%- include('../partials/shipment-status-summary', {
                sv, timeline,
                authed: false,
                qrDataUrl: null,
                pickup: null,
                trackingId,
                detailUrl: null,
                identifyUrl,
            }) %>

            <% if (!sv.isReady && !sv.isPickup) { %>
                <div style="text-align:center;margin-top:.5rem">
                    <a href="/track/<%= encodeURIComponent(trackingId) %>/live" style="color:var(--c-primary,#2563eb);font-weight:600;text-decoration:none">Ver mapa en vivo →</a>
                </div>
            <% } %>
        <% } %>
    </div>
</body>
</html>
