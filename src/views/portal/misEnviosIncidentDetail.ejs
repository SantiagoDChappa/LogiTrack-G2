<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Incidencia #<%= incident.id %> - Mis incidencias</title>
    <script>(function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
    <link rel="stylesheet" href="/css/portal.css">
    <link rel="stylesheet" href="/css/incidents.css">
    <link rel="shortcut icon" href="/images/favicon.ico">
</head>
<body>
    <%- include('../partials/portal-nav', { support }) %>

    <section class="portal-mis-envios-section">
        <div class="portal-mis-envios-wrapper portal-mis-envios-detail-wrapper">
            <div class="portal-mis-envios-detail-top">
                <a href="/portal/mis-envios/incidencias" class="portal-mis-envios-back">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Volver al listado
                </a>
            </div>

            <div class="portal-mis-envios-header">
                <span class="portal-incident-eyebrow">Incidencia #<%= incident.id %></span>
                <h1><%= incident.typeLabel %></h1>
                <p class="portal-mis-envios-lead">
                    Envío asociado:
                    <a href="/portal/mis-envios/envio/<%= incident.shipmentId %>" class="portal-mis-envios-link" style="display:inline-flex;">
                        <%= incident.trackingId %>
                    </a>
                </p>
            </div>

            <% if (flash) { %>
            <div class="portal-mis-envios-alert" style="background:#ecfdf5;color:#065f46;border:1px solid #bbf7d0;">
                <span class="material-symbols-outlined">check_circle</span>
                <%= flash %>
            </div>
            <% } %>
            <% if (error) { %>
            <div class="portal-mis-envios-alert portal-mis-envios-alert-error">
                <span class="material-symbols-outlined">error</span>
                <%= error %>
            </div>
            <% } %>

            <div class="portal-incident-detail-card">
                <div class="portal-incident-detail-row">
                    <span class="portal-card-label">Estado</span>
                    <span class="portal-card-value">
                        <span class="incident-badge incident-badge--<%= incident.statusKey %>"><%= incident.statusLabel %></span>
                    </span>
                </div>
                <div class="portal-incident-detail-row">
                    <span class="portal-card-label">Fecha de creación</span>
                    <span class="portal-card-value">
                        <%= new Date(incident.createdAt).toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                </div>
                <% if (incident.lastUpdatedAt) { %>
                <div class="portal-incident-detail-row">
                    <span class="portal-card-label">Última actualización</span>
                    <span class="portal-card-value">
                        <%= new Date(incident.lastUpdatedAt).toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                </div>
                <% } %>
                <div class="portal-incident-detail-row portal-incident-detail-row--block">
                    <span class="portal-card-label">Descripción del problema</span>
                    <p class="portal-incident-description"><%= incident.description %></p>
                </div>
            </div>

            <% if (incident.resolutionLabel || incident.closedAt) { %>
            <div class="portal-incident-resolution-card">
                <div class="portal-incident-resolution-header">
                    <span class="material-symbols-outlined">verified</span>
                    <h2>Resolución de la incidencia</h2>
                </div>
                <% if (incident.resolutionLabel) { %>
                <div class="portal-incident-detail-row">
                    <span class="portal-card-label">Resolución aplicada</span>
                    <span class="portal-card-value"><%= incident.resolutionLabel %></span>
                </div>
                <% } %>
                <% if (incident.closedAt) { %>
                <div class="portal-incident-detail-row">
                    <span class="portal-card-label">Fecha de cierre</span>
                    <span class="portal-card-value">
                        <%= new Date(incident.closedAt).toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                </div>
                <% } %>
            </div>
            <% } %>

            <% if (typeof damage !== 'undefined' && damage.isDamage) { %>
            <div class="portal-incident-detail-card portal-incident-section">
                <h2 class="portal-incident-section-title">Tu paquete llegó con daño</h2>
                <% if (damage.choice) { %>
                    <p class="portal-manage-hint">Elegiste: <strong><%= damage.choice === 'REEMBOLSO' ? 'Reembolso' : 'Reemplazo' %></strong>. El operador lo verá y actuará en consecuencia.</p>
                    <% if (!damage.closed) { %><p class="portal-manage-hint">Podés cambiar tu elección mientras la incidencia siga abierta.</p><% } %>
                <% } else { %>
                    <p class="portal-manage-hint">¿Querés un reembolso o un reemplazo? Elegí una opción y el operador la gestionará.</p>
                <% } %>
                <% if (!damage.closed) { %>
                <form method="POST" action="/portal/mis-envios/incidencia/<%= incident.id %>/eleccion" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px">
                    <button type="submit" name="choice" value="REEMBOLSO" class="portal-search-panel-btn">Solicitar reembolso</button>
                    <button type="submit" name="choice" value="REEMPLAZO" class="portal-search-panel-btn">Solicitar reemplazo</button>
                </form>
                <% } %>
            </div>
            <% } %>

            <% if (incident.attachments && incident.attachments.length) { %>
            <div class="portal-incident-detail-card portal-incident-section">
                <h2 class="portal-incident-section-title">Evidencias adjuntas</h2>
                <ul class="portal-incident-attachments">
                    <% incident.attachments.forEach(function(att) { %>
                    <li>
                        <a href="<%= att.downloadUrl %>" target="_blank" rel="noopener" class="portal-incident-attachment-link">
                            <span class="material-symbols-outlined"><%= att.isImage ? 'image' : 'description' %></span>
                            <%= att.fileName %>
                        </a>
                        <span class="portal-incident-attachment-meta">
                            <%= new Date(att.createdAt).toLocaleDateString('es-AR', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                        </span>
                    </li>
                    <% }); %>
                </ul>
            </div>
            <% } %>

            <% if (incident.history && incident.history.length) { %>
            <div class="portal-incident-detail-card portal-incident-section">
                <h2 class="portal-incident-section-title">Historial de interacciones</h2>
                <ol class="portal-incident-timeline">
                    <% incident.history.forEach(function(h) { %>
                    <li class="portal-incident-timeline-item <%= h.isClient ? 'portal-incident-timeline-item--client' : '' %>">
                        <div class="portal-incident-timeline-head">
                            <strong><%= h.eventLabel %></strong>
                            <span><%= new Date(h.changedAt).toLocaleString('es-AR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                        </div>
                        <div class="portal-incident-timeline-meta"><%= h.authorLabel %></div>
                        <% if (h.detail) { %>
                        <p class="portal-incident-timeline-detail"><%= h.detail %></p>
                        <% } %>
                    </li>
                    <% }); %>
                </ol>
            </div>
            <% } %>

            <% if (incident.canInteract) { %>
            <div class="portal-incident-detail-card portal-incident-section">
                <h2 class="portal-incident-section-title">Responder incidencia</h2>
                <p class="portal-manage-hint">Podés aportar un comentario, adjuntar fotos o documentos PDF (máx. 5 MB).</p>
                <form method="POST" action="/portal/mis-envios/incidencia/<%= incident.id %>/responder" enctype="multipart/form-data" class="portal-mis-envios-form">
                    <div class="portal-search-field">
                        <label class="portal-search-label" for="comment">Comentario o respuesta</label>
                        <textarea id="comment" name="comment" class="portal-search-input-field" rows="4" maxlength="2000" placeholder="Contanos la información adicional..."></textarea>
                    </div>
                    <div class="portal-search-field">
                        <label class="portal-search-label" for="evidence">Adjuntar evidencia (opcional)</label>
                        <input id="evidence" type="file" name="evidence" class="portal-search-input-field" accept="image/jpeg,image/png,application/pdf">
                        <p class="portal-manage-hint">Formatos: JPG, PNG o PDF. Tamaño máximo 5 MB.</p>
                    </div>
                    <button type="submit" class="portal-search-panel-btn">
                        <span class="material-symbols-outlined">send</span>
                        Enviar respuesta
                    </button>
                </form>
            </div>
            <% } else if (incident.closedMessage) { %>
            <div class="portal-mis-envios-alert portal-mis-envios-alert-error">
                <span class="material-symbols-outlined">lock</span>
                <%= incident.closedMessage %>
            </div>
            <% } %>

            <div class="portal-mis-envios-actions" style="border-top:none;padding-top:0;">
                <a href="/portal/mis-envios/envio/<%= incident.shipmentId %>" class="portal-card-incident-cta-link">
                    <span class="material-symbols-outlined">inventory_2</span>
                    Ver envío asociado
                </a>
            </div>
        </div>
    </section>
    <script src="/js/theme.js" defer></script>
</body>
</html>
