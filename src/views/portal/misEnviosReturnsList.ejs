<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis devoluciones - Mis envíos</title>
    <script>(function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
    <link rel="stylesheet" href="/css/portal.css?v=<%= assetVersion %>">
    <link rel="shortcut icon" href="/images/favicon.ico">
</head>
<body>
    <%- include('../partials/portal-nav', { support }) %>

    <section class="portal-mis-envios-section">
        <div class="portal-mis-envios-wrapper portal-mis-envios-detail-wrapper">
            <div class="portal-mis-envios-detail-top">
                <a href="/portal/mis-envios/lista" class="portal-mis-envios-back">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Volver al listado
                </a>
            </div>

            <div class="portal-mis-envios-header">
                <span class="portal-incident-eyebrow">Mis devoluciones</span>
                <h1>Devoluciones</h1>
            </div>

            <% if (!returns || returns.length === 0) { %>
                <div class="portal-mis-envios-alert">
                    <span class="material-symbols-outlined">inbox</span>
                    No tenés devoluciones registradas.
                </div>
            <% } else { %>
                <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.6rem;">
                    <% returns.forEach(function(r) { %>
                        <li>
                            <a href="/portal/mis-envios/devolucion/<%= r.id %>" style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;border:1px solid var(--portal-border,#e2e8f0);border-radius:10px;padding:.75rem 1rem;text-decoration:none;color:inherit;">
                                <strong>#<%= r.id %></strong>
                                <span><%= r.trackingId %></span>
                                <span style="opacity:.8;"><%= r.reasonLabel %></span>
                                <span class="portal-badge"><%= r.statusLabel %></span>
                                <span style="margin-left:auto;opacity:.7;font-size:.8rem;"><%= new Date(r.createdAt).toLocaleDateString('es-AR') %></span>
                            </a>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </div>
    </section>
    <script src="/js/theme.js" defer></script>
</body>
</html>
