<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= shipment.trackingId %> - Mis envíos</title>
    <script>(function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
    <link rel="stylesheet" href="/css/portal.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/css/incidents.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <link rel="shortcut icon" href="/images/favicon.ico">
</head>
<body>
    <%- include('../partials/portal-nav', { support }) %>

    <section class="portal-mis-envios-section">
        <div class="portal-mis-envios-wrapper portal-mis-envios-detail-wrapper">
            <div class="portal-mis-envios-detail-top">
                <a href="/portal/mis-envios/lista" class="portal-mis-envios-back">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Volver al listado
                </a>
                <form method="POST" action="/portal/mis-envios/salir" class="portal-mis-envios-logout-form">
                    <button type="submit" class="portal-mis-envios-logout">
                        <span class="material-symbols-outlined">logout</span>
                        Cerrar sesión
                    </button>
                </form>
            </div>

            <%- include('../partials/portal-shipment-public-detail', { shipment, canSelfService, modifications: typeof modifications !== 'undefined' ? modifications : [], incidents: typeof incidents !== 'undefined' ? incidents : [] }) %>

            <%# LGT-182 — Devoluciones del envío %>
            <% const _returns = typeof returns !== 'undefined' ? returns : []; %>
            <div class="portal-mis-envios-card" style="margin-top:1rem;">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
                    <h2 style="margin:0;">Devoluciones</h2>
                    <% if (typeof canRequestReturn !== 'undefined' && canRequestReturn) { %>
                        <a href="/portal/mis-envios/envio/<%= shipment.id %>/devolucion" class="portal-search-panel-btn" style="width:auto;">
                            <span class="material-symbols-outlined">assignment_return</span>
                            Solicitar devolución
                        </a>
                    <% } %>
                </div>

                <% if (typeof returnError !== 'undefined' && returnError) { %>
                    <div class="portal-mis-envios-alert portal-mis-envios-alert-error" style="margin-top:.75rem;">
                        <span class="material-symbols-outlined">error</span>
                        <%= returnError %>
                    </div>
                <% } %>

                <% if (_returns.length === 0) { %>
                    <p class="portal-manage-hint" style="margin-top:.5rem;">Este envío no tiene devoluciones registradas.</p>
                <% } else { %>
                    <ul style="list-style:none;margin:.75rem 0 0;padding:0;display:flex;flex-direction:column;gap:.5rem;">
                        <% _returns.forEach(function(r) { %>
                            <li style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;border:1px solid var(--portal-border,#e2e8f0);border-radius:10px;padding:.6rem .8rem;">
                                <strong>#<%= r.id %></strong>
                                <span><%= r.reasonLabel %></span>
                                <span class="portal-badge"><%= r.statusLabel %></span>
                                <span style="opacity:.7;font-size:.8rem;margin-left:auto;"><%= new Date(r.createdAt).toLocaleDateString('es-AR') %></span>
                            </li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
        </div>
    </section>

    <script src="/js/theme.js" defer></script>
    <% if (shipment.mapStops && shipment.mapStops.length >= 1) { %>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    (function(){
        const item = <%- JSON.stringify({ id: shipment.id, stops: shipment.mapStops || [], activeRouteId: shipment.activeRouteId || null }) %>;
        const el = document.getElementById('portal-map-' + item.id);
        if (!el || !item.stops.length) return;
        const map = L.map(el).setView([item.stops[0].lat, item.stops[0].lng], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
        const bounds = [];
        item.stops.forEach((stop, idx) => {
            const marker = L.marker([stop.lat, stop.lng]).addTo(map);
            marker.bindPopup(stop.label || ('Punto ' + (idx + 1)));
            bounds.push([stop.lat, stop.lng]);
        });
        if (bounds.length > 1) { map.fitBounds(bounds, { padding: [30, 30] }); }
    })();
    </script>
    <% } %>
</body>
</html>
