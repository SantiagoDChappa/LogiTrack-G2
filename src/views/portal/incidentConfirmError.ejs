<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmación inválida - LogiTrack</title>
    <script>(function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
    <link rel="stylesheet" href="/css/portal.css">
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/incidents.css">
    <link rel="shortcut icon" href="/images/favicon.ico">
</head>
<body>
    <nav class="portal-nav">
        <a href="/" class="portal-brand">
            <img src="/images/logo.png" alt="LogiTrack" class="portal-logo">
            <span>LogiTrack</span>
        </a>
        <div class="portal-nav-right">
            <button id="btn-theme" class="portal-theme-btn" aria-label="Cambiar tema">
                <span class="material-symbols-outlined" id="theme-icon">light_mode</span>
                <span id="theme-label">Modo claro</span>
            </button>
            <a href="/" class="portal-nav-login">
                <span class="material-symbols-outlined">arrow_back</span>
                Volver al portal
            </a>
        </div>
    </nav>

    <section class="portal-incident-section">
        <div class="portal-incident-wrapper portal-incident-success">
            <div class="portal-incident-success-body">
                <span class="portal-incident-eyebrow">No se pudo confirmar</span>
                <span class="material-symbols-outlined portal-incident-success-icon" style="color:#dc2626">error</span>
                <h1>Confirmación inválida</h1>

                <p class="portal-incident-success-lead"><%= error %></p>

                <p class="portal-incident-success-copy">
                    Podés volver al portal y reiniciar el reporte. Si la dificultad persiste, contactá al operador.
                </p>
                <a href="/" class="btn-primary">Volver al portal</a>
            </div>
        </div>
    </section>
    <script src="/js/theme.js" defer></script>
</body>
</html>
