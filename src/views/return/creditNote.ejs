<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Nota de crédito <%= cn.number %> - LogiTrack</title>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <%
            const total = Number(cn.amount || 0);
            const subtotal = Number((total / 1.21).toFixed(2));
            const iva = Number((total - subtotal).toFixed(2));
            const recipient = shipment && shipment.recipient ? shipment.recipient : null;
            const addr = shipment && shipment.address ? shipment.address : null;
        %>
        <div class="page-header">
            <a href="javascript:history.back()" class="action-btn neutro" data-tooltip="Volver" aria-label="Volver"><span class="material-symbols-outlined">arrow_back</span></a>
            <h1>Nota de crédito</h1>
            <button onclick="window.print()" class="action-btn neutro" data-tooltip="Imprimir" aria-label="Imprimir" style="margin-left:auto;"><span class="material-symbols-outlined">print</span></button>
        </div>

        <div class="credit-note" style="max-width:780px;border:1px solid var(--color-border,#e2e8f0);border-radius:12px;padding:1.5rem;background:var(--color-surface,#fff);">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;border-bottom:1px solid var(--color-border,#e2e8f0);padding-bottom:1rem;">
                <div>
                    <h2 style="margin:0;"><%= empresa %> S.A.</h2>
                    <div style="font-size:.85rem;opacity:.8;">CUIT 30-71234567-9 · Resp. Inscripto</div>
                </div>
                <div style="text-align:right;">
                    <span style="display:inline-block;border:2px solid var(--color-text,#0f172a);border-radius:6px;padding:.1rem .5rem;font-weight:700;">NC</span>
                    <div style="font-weight:700;margin-top:.4rem;">Nota de crédito <%= cn.number %></div>
                    <div style="font-size:.85rem;opacity:.8;">Fecha: <%= new Date(cn.createdAt).toLocaleDateString('es-AR') %></div>
                </div>
            </div>

            <div style="display:flex;gap:2rem;flex-wrap:wrap;margin:1rem 0;">
                <div>
                    <div style="font-size:.72rem;opacity:.6;text-transform:uppercase;">Cliente</div>
                    <% if (recipient) { %>
                        <strong><%= recipient.fullName || '—' %></strong><br>
                        <% if (recipient.documentNumber) { %>DNI <%= recipient.documentNumber %><br><% } %>
                        <% if (addr) { %><%= [addr.street, addr.number].filter(Boolean).join(' ') %><% if (addr.postalCode) { %> · CP <%= addr.postalCode %><% } %><br><% } %>
                        <% if (recipient.phone) { %>Tel <%= recipient.phone %><% } %>
                    <% } else { %>—<% } %>
                </div>
                <div>
                    <div style="font-size:.72rem;opacity:.6;text-transform:uppercase;">Envío</div>
                    <% if (shipment) { %>
                        Tracking <strong><%= shipment.trackingId %></strong><br>
                        <% if (shipment.zone) { %>Zona: <%= shipment.zone.name %><br><% } %>
                        <% if (shipment.status) { %><span class="ot-badge ot-badge--green"><%= shipment.status.description %></span><% } %>
                    <% } else { %>—<% } %>
                </div>
            </div>

            <table class="report-table" style="width:100%;">
                <thead><tr><th>Concepto</th><th class="text-right">Importe</th></tr></thead>
                <tbody>
                    <% if (breakdown) { %>
                        <% if (breakdown.costoBase) { %><tr><td>Servicio de envío (base)</td><td class="text-right"><%= fmtMoney(breakdown.costoBase) %></td></tr><% } %>
                        <% if (breakdown.zoneBase) { %><tr><td>Costo por zona</td><td class="text-right"><%= fmtMoney(breakdown.zoneBase) %></td></tr><% } %>
                        <% if (breakdown.wSurcharge) { %><tr><td>Adicional por peso</td><td class="text-right"><%= fmtMoney(breakdown.wSurcharge) %></td></tr><% } %>
                        <% if (breakdown.vSurcharge) { %><tr><td>Adicional por volumen</td><td class="text-right"><%= fmtMoney(breakdown.vSurcharge) %></td></tr><% } %>
                    <% } else { %>
                        <tr><td>Servicio de envío</td><td class="text-right"><%= fmtMoney(subtotal) %></td></tr>
                    <% } %>
                </tbody>
                <tfoot>
                    <tr><td class="text-right">Subtotal</td><td class="text-right"><%= fmtMoney(subtotal) %></td></tr>
                    <tr><td class="text-right">IVA 21%</td><td class="text-right"><%= fmtMoney(iva) %></td></tr>
                    <tr><td class="text-right"><strong>Total</strong></td><td class="text-right"><strong><%= fmtMoney(total) %></strong></td></tr>
                </tfoot>
            </table>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;font-size:.8rem;opacity:.75;border-top:1px dashed var(--color-border,#e2e8f0);padding-top:.75rem;">
                <span>Comprobante asociado al envío <%= shipment ? shipment.trackingId : '' %><% if (cn.incidentId) { %> · incidencia #<%= cn.incidentId %><% } %><% if (cn.returnId) { %> · devolución #<%= cn.returnId %><% } %></span>
                <span>Documento generado por <%= empresa %></span>
            </div>
        </div>
    </main>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
