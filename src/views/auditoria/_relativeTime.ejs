<script>
    document.addEventListener('DOMContentLoaded', () => {
        const now = new Date();
        document.querySelectorAll('[data-ts]').forEach(el => {
            const ts = new Date(el.dataset.ts);
            const diff = Math.floor((now - ts) / 1000);
            let rel;
            if (diff < 60)           { rel = 'hace un momento'; }
            else if (diff < 3600)    { rel = 'hace ' + Math.floor(diff / 60) + ' min'; }
            else if (diff < 86400)   { rel = 'hace ' + Math.floor(diff / 3600) + ' h'; }
            else if (diff < 604800)  { rel = 'hace ' + Math.floor(diff / 86400) + ' días'; }
            else                     { return; }
            el.textContent = rel;
        });
    });
</script>
