<style>
    .audit-wrap       { max-width: 1140px; margin: 0 auto; padding: 1.5rem 2rem 3rem; }
    .audit-hero       { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
    .audit-hero-icon  { width: 48px; height: 48px; border-radius: 14px; background: var(--color-primary-light);
                        display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .audit-hero-icon span { color: var(--color-primary); font-size: 1.6rem; }
    .audit-hero h1    { font-size: 1.5rem; font-weight: 700; margin: 0; }
    .audit-hero p     { font-size: var(--font-size-sm); color: var(--color-text-secondary); margin: .1rem 0 0; }

    /* Tabs */
    .audit-tabs       { display: flex; gap: .3rem; flex-wrap: wrap; border-bottom: 1px solid var(--color-border);
                        margin-bottom: 1.75rem; }
    .audit-tab        { display: inline-flex; align-items: center; gap: .4rem; padding: .6rem .9rem;
                        font-size: .85rem; font-weight: 600; color: var(--color-text-secondary);
                        text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px;
                        transition: color .15s, border-color .15s; }
    .audit-tab .material-symbols-outlined { font-size: 1.05rem; }
    .audit-tab:hover  { color: var(--color-text); }
    .audit-tab.active { color: var(--color-primary); border-bottom-color: var(--color-primary); }

    /* Stat cards */
    .audit-stats      { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card        { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 14px;
                        padding: 1.1rem 1.3rem; display: flex; flex-direction: column; gap: .3rem; }
    .stat-card-label  { font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--color-text-secondary); }
    .stat-card-value  { font-size: 2rem; font-weight: 700; line-height: 1; color: var(--color-text); }
    .stat-card-sub    { font-size: .78rem; color: var(--color-text-secondary); }
    .stat-card.green .stat-card-value { color: var(--color-success); }
    .stat-card.blue  .stat-card-value { color: var(--color-primary); }

    /* Section cards */
    .audit-card       { background: var(--color-surface); border: 1px solid var(--color-border);
                        border-radius: 14px; overflow: hidden; margin-bottom: 1.5rem; }
    .audit-card-head  { display: flex; align-items: center; gap: .6rem; padding: 1.1rem 1.4rem;
                        border-bottom: 1px solid var(--color-border); background: var(--color-surface-alt); }
    .audit-card-head span.material-symbols-outlined { font-size: 1.2rem; color: var(--color-primary); }
    .audit-card-head h2 { font-size: .95rem; font-weight: 600; margin: 0; flex: 1; }
    .audit-card-head .badge-count { background: var(--color-primary-light); color: var(--color-primary);
                                    font-size: .72rem; font-weight: 700; padding: .15rem .55rem;
                                    border-radius: 999px; }
    .audit-card-body  { padding: 1.2rem 1.4rem; }

    /* Filters */
    .audit-filters    { display: flex; flex-wrap: wrap; gap: .65rem; align-items: flex-end; }
    .filter-group     { display: flex; flex-direction: column; gap: .3rem; }
    .filter-group label { font-size: .72rem; font-weight: 600; text-transform: uppercase;
                          letter-spacing: .05em; color: var(--color-text-secondary); }
    .filter-group select,
    .filter-group input[type=date] { font-size: .85rem; padding: .4rem .65rem; border-radius: 8px;
                                      border: 1px solid var(--color-border); background: var(--color-bg);
                                      color: var(--color-text); min-width: 140px; }
    .filter-actions   { display: flex; gap: .5rem; align-items: center; margin-left: auto; flex-wrap: wrap; }
    .btn-filter       { display: inline-flex; align-items: center; gap: .3rem; padding: .42rem .9rem;
                        border-radius: 8px; font-size: .85rem; font-weight: 500; cursor: pointer;
                        border: 1px solid var(--color-border); background: var(--color-surface);
                        color: var(--color-text); text-decoration: none; transition: background .15s; }
    .btn-filter:hover { background: var(--color-bg); }
    .btn-filter.primary { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }
    .btn-filter.primary:hover { background: var(--color-primary-dark); }
    .btn-filter.ghost   { border-color: transparent; color: var(--color-text-secondary); }
    .btn-filter.ghost:hover { color: var(--color-text); background: var(--color-bg); }
    .btn-filter .material-symbols-outlined { font-size: .95rem; }
    .btn-filter:disabled { opacity: .4; pointer-events: none; }

    /* Tables */
    .audit-table-wrap { overflow-x: auto; margin-top: 1rem; }
    .audit-table      { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .audit-table th   { text-align: left; padding: .55rem 1rem; font-size: .7rem; font-weight: 700;
                        text-transform: uppercase; letter-spacing: .06em; color: var(--color-text-secondary);
                        background: var(--color-surface-alt); border-bottom: 1px solid var(--color-border); }
    .audit-table td   { padding: .7rem 1rem; border-bottom: 1px solid var(--color-border); vertical-align: middle; }
    .audit-table tr:last-child td { border-bottom: none; }
    .audit-table tr:hover td { background: var(--color-surface-alt); }

    /* Badges */
    .badge-login      { display: inline-flex; align-items: center; gap: .25rem; font-size: .72rem; font-weight: 700;
                        padding: .2rem .6rem; border-radius: 999px;
                        background: var(--color-success-bg); color: var(--color-success); }
    .badge-logout     { display: inline-flex; align-items: center; gap: .25rem; font-size: .72rem; font-weight: 700;
                        padding: .2rem .6rem; border-radius: 999px;
                        background: var(--color-danger-bg); color: var(--color-danger); }
    .badge-failed     { display: inline-flex; align-items: center; gap: .25rem; font-size: .72rem; font-weight: 700;
                        padding: .2rem .6rem; border-radius: 999px;
                        background: #fff3cd; color: #92600a; }
    .badge-action     { display: inline-flex; align-items: center; gap: .2rem; font-size: .72rem; font-weight: 700;
                        padding: .15rem .55rem; border-radius: 999px; }
    .badge-create     { background: var(--color-success-bg); color: var(--color-success); }
    .badge-update     { background: var(--color-primary-light); color: var(--color-primary); }
    .badge-delete     { background: var(--color-danger-bg); color: var(--color-danger); }
    .badge-cancel     { background: #fef3c7; color: #92600a; }
    .badge-close      { background: #f3f4f6; color: #374151; }
    .badge-role       { display: inline-block; font-size: .7rem; font-weight: 600;
                        padding: .12rem .45rem; border-radius: 6px;
                        background: var(--color-primary-light); color: var(--color-primary); margin-left: .3rem; }
    .badge-login  .material-symbols-outlined,
    .badge-logout .material-symbols-outlined,
    .badge-failed .material-symbols-outlined { font-size: .8rem; }

    /* Active user dot */
    .active-dot       { width: 8px; height: 8px; border-radius: 50%; background: var(--color-success);
                        display: inline-block; margin-right: .4rem; box-shadow: 0 0 0 2px var(--color-success-bg); }

    /* User agent cell */
    .ua-cell          { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
                        font-size: .75rem; color: var(--color-text-secondary); }

    .empty-state      { text-align: center; padding: 2.5rem 1rem; color: var(--color-text-secondary); }
    .empty-state .material-symbols-outlined { font-size: 2.5rem; display: block; margin-bottom: .5rem; opacity: .4; }

    .filter-divider   { height: 1px; background: var(--color-border); margin: 1rem 0; }

    /* Pagination */
    .pagination       { display: flex; align-items: center; justify-content: center; gap: .5rem;
                        padding: 1rem 0 .2rem; }
    .pagination-info  { font-size: .8rem; color: var(--color-text-secondary); margin-right: auto; }

    /* Avatar */
    .u-avatar         { width: 30px; height: 30px; border-radius: 50%; display: inline-flex;
                        align-items: center; justify-content: center; font-size: .68rem;
                        font-weight: 700; color: #fff; flex-shrink: 0; }
    .user-cell        { display: flex; align-items: center; gap: .55rem; }
    .user-cell-info   { display: flex; flex-direction: column; }
    .user-cell-sub    { font-size: .73rem; color: var(--color-text-secondary); }

    /* Security alert */
    .security-alert   { display: flex; align-items: center; gap: .75rem; padding: .9rem 1.3rem;
                        background: #fff3cd; border: 1px solid #f6c200; border-radius: 12px;
                        margin-bottom: 1.5rem; }
    .security-alert span.material-symbols-outlined { color: #92600a; font-size: 1.3rem; flex-shrink: 0; }
    .security-alert strong { color: #92600a; font-size: .88rem; }
    .security-alert p { color: #7a5000; font-size: .8rem; margin: 0; }

    /* Activity chart */
    .chart-outer      { padding: .25rem 0 0; }
    .chart-grid       { display: flex; align-items: flex-end; gap: .6rem; height: 120px;
                        border-bottom: 1.5px solid var(--color-border); padding-bottom: 0; position: relative; }
    .chart-bar-col    { flex: 1; display: flex; flex-direction: column; align-items: center;
                        justify-content: flex-end; position: relative; }
    .chart-bar        { width: 100%; border-radius: 7px 7px 0 0;
                        background: linear-gradient(to top, var(--color-primary), #93c5fd);
                        transition: opacity .15s; cursor: default; }
    .chart-bar:hover  { opacity: .75; }
    .chart-bar.empty  { background: var(--color-border); border-radius: 4px; opacity: .45; height: 4px !important; }
    .chart-count      { position: absolute; top: -1.4rem; font-size: .72rem; font-weight: 700;
                        color: var(--color-primary); white-space: nowrap; }
    .chart-count.zero { color: var(--color-border); font-weight: 400; }
    .chart-days       { display: flex; gap: .6rem; margin-top: .55rem; }
    .chart-day        { flex: 1; text-align: center; font-size: .7rem; color: var(--color-text-secondary); }
    .chart-day.today  { font-weight: 700; color: var(--color-primary); }

    /* MAU / WAU / DAU */
    .mau-row          { display: flex; gap: 1.75rem; flex-wrap: wrap; }
    .mau-col          { flex: 1; min-width: 150px; display: flex; flex-direction: column; gap: .5rem; }
    .mau-icon         { width: 34px; height: 34px; border-radius: 10px; display: inline-flex;
                        align-items: center; justify-content: center; }
    .mau-icon .material-symbols-outlined { font-size: 1.1rem; }
    .mau-value        { font-size: 1.7rem; font-weight: 700; line-height: 1; }
    .mau-label        { font-size: .78rem; color: var(--color-text-secondary); font-weight: 600;
                        display: flex; align-items: center; gap: .4rem; }
    .mau-tag          { font-size: .62rem; font-weight: 700; padding: .08rem .4rem; border-radius: 999px;
                        background: var(--color-surface-alt); color: var(--color-text-secondary); }
    .mau-track        { height: 6px; border-radius: 999px; background: var(--color-border); overflow: hidden; }
    .mau-fill         { height: 100%; border-radius: 999px; transition: width .4s; }
    .mau-note         { font-size: .78rem; color: var(--color-text-secondary); margin: 1.1rem 0 0; }
</style>
