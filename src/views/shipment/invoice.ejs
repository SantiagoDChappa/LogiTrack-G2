<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Factura <%= inv.number %> - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/css/report.css?v=<%= assetVersion %>">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <%
            const neto = Number(inv.subtotal || inv.amount || 0);
            const iva = Number((neto * 0.21).toFixed(2));
            const total = Number((neto + iva).toFixed(2));
            const addr = shipment && shipment.address ? shipment.address : null;
        %>
        <div class="page-header">
            <h1>Factura</h1>
            <div class="page-header__actions">
                <a href="javascript:history.back()" class="action-btn action-btn--lg action-btn--tip-bottom neutro" data-tooltip="Volver" aria-label="Volver">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <button onclick="window.print()" class="action-btn action-btn--lg action-btn--tip-bottom neutro" data-tooltip="Imprimir" aria-label="Imprimir">
                    <span class="material-symbols-outlined">print</span>
                </button>
            </div>
        </div>

        <div style="padding: 0 clamp(1.25rem, 2.5vw, 2rem) 2rem;">
        <div class="credit-note" style="max-width:780px;border:1px solid var(--color-border,#e2e8f0);border-radius:12px;padding:1.5rem 2rem;background:var(--color-surface,#fff);">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;border-bottom:1px solid var(--color-border,#e2e8f0);padding-bottom:1rem;">
                <div>
                    <h2 style="margin:0;"><%= empresa %> S.A.</h2>
                    <div style="font-size:.85rem;opacity:.8;">CUIT 30-71234567-9 · Resp. Inscripto</div>
                </div>
                <div style="text-align:right;">
                    <span style="display:inline-block;border:2px solid var(--color-text,#0f172a);border-radius:6px;padding:.1rem .5rem;font-weight:700;">FA</span>
                    <div style="font-weight:700;margin-top:.4rem;">Factura <%= inv.number %></div>
                    <div style="font-size:.85rem;opacity:.8;">Fecha: <%= new Date(inv.createdAt).toLocaleDateString('es-AR') %></div>
                </div>
            </div>

            <div style="display:flex;gap:2rem;flex-wrap:wrap;margin:1rem 0;">
                <div>
                    <div style="font-size:.72rem;opacity:.6;text-transform:uppercase;">Cliente (remitente)</div>
                    <strong><%= inv.senderName || (shipment && shipment.sender ? shipment.sender.fullName : '—') || '—' %></strong><br>
                    <% if (inv.senderDocument) { %>Doc. <%= inv.senderDocument %><br><% } %>
                </div>
                <div>
                    <div style="font-size:.72rem;opacity:.6;text-transform:uppercase;">Envío</div>
                    <% if (shipment) { %>
                        Tracking <strong><%= shipment.trackingId %></strong><br>
                        <% if (shipment.zone) { %>Zona: <%= shipment.zone.name %><br><% } %>
                        <% if (addr) { %><%= [addr.street, addr.number].filter(Boolean).join(' ') %><% if (addr.postalCode) { %> · CP <%= addr.postalCode %><% } %><% } %>
                    <% } else { %>—<% } %>
                </div>
            </div>

            <table class="report-table" style="width:100%;">
                <thead><tr><th>Concepto</th><th class="text-right">Importe</th></tr></thead>
                <tbody>
                    <% if (Number(inv.costBase)) { %><tr><td>Servicio de envío (base)</td><td class="text-right"><%= fmtMoney(inv.costBase) %></td></tr><% } %>
                    <% if (Number(inv.zoneBase)) { %><tr><td>Costo por zona</td><td class="text-right"><%= fmtMoney(inv.zoneBase) %></td></tr><% } %>
                    <% if (Number(inv.weightSurcharge)) { %><tr><td>Adicional por peso</td><td class="text-right"><%= fmtMoney(inv.weightSurcharge) %></td></tr><% } %>
                    <% if (Number(inv.volumeSurcharge)) { %><tr><td>Adicional por volumen</td><td class="text-right"><%= fmtMoney(inv.volumeSurcharge) %></td></tr><% } %>
                    <% if (Number(inv.insuranceAmount)) { %><tr><td>Seguro de mercadería</td><td class="text-right"><%= fmtMoney(inv.insuranceAmount) %></td></tr><% } %>
                </tbody>
                <tfoot>
                    <tr><td class="text-right">Subtotal (neto)</td><td class="text-right"><%= fmtMoney(neto) %></td></tr>
                    <tr><td class="text-right">IVA 21%</td><td class="text-right"><%= fmtMoney(iva) %></td></tr>
                    <tr><td class="text-right"><strong>Total</strong></td><td class="text-right"><strong><%= fmtMoney(total) %></strong></td></tr>
                </tfoot>
            </table>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;font-size:.8rem;opacity:.75;border-top:1px dashed var(--color-border,#e2e8f0);padding-top:.75rem;">
                <span>Comprobante asociado al envío <%= shipment ? shipment.trackingId : '' %></span>
                <span>Documento generado por <%= empresa %></span>
            </div>
        </div>
        </div>
    </main>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
