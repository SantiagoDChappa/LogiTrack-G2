<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
    <style>
        .route-stop-badge {
            position: relative;
            cursor: default;
            border-bottom: 1px dashed var(--color-text-secondary);
            padding-bottom: 1px;
        }
        .route-seg-tooltip {
            display: none;
            position: absolute;
            bottom: calc(100% + 6px);
            left: 50%;
            transform: translateX(-50%);
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-sm);
            box-shadow: var(--shadow-md);
            padding: .5rem .75rem;
            font-size: .8rem;
            line-height: 1.6;
            z-index: 50;
            min-width: 220px;
            pointer-events: none;
        }
        .route-seg-tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 5px solid transparent;
            border-top-color: var(--color-border);
        }
        .route-stop-badge:hover .route-seg-tooltip,
        .route-stop-badge:focus .route-seg-tooltip {
            display: block;
        }
    </style>
    <link rel="stylesheet" href="/css/shipments-restyle.css">
    <link rel="stylesheet" href="/css/shipment-update.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>const serverErrors = <%- JSON.stringify(errors) %>;</script>
    <script src="/js/new_shipment_popup.js" defer></script>
    <title>Modificación de Envío - LogiTrack</title>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Modificación de envío</h1>
            <a href="<%= returnUrl %>" class="action-btn action-btn--lg action-btn--tip-bottom volver" data-tooltip="Volver" aria-label="Volver">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
        </div>

        <div class="page-update-wrapper">

            <% 
                const statusId = shipment.statusId;
                const isFinalStatus = statusId === 4 || statusId === 5;
                const isAtBranch = statusId === 3;
                const isInTransit = statusId === 2;
                const isPending = statusId === 1;

                const canEditAddress = isPending;
                const canEditRecipientBasic = isPending;
                const canEditContact = isPending || isInTransit;
                const canEditDelivery = isPending || isAtBranch;
                const isGlobalNonEditable = isFinalStatus;
            %>

            <% if (isInTransit) { %>
            <div style="display:flex;align-items:center;gap:8px;background:#fef3c7;border:1px solid #f59e0b;border-radius:6px;padding:10px 15px;margin-bottom:15px;color:#92400e;font-size:0.9rem; width: 100%; box-sizing: border-box;">
                <span class="material-symbols-outlined" style="font-size:1.2rem;">info</span>
                <span><strong>En Tránsito</strong>: solo editable Email y Teléfono. El repartidor asignado no puede cambiarse.</span>
            </div>
            <% } %>
            <% if (isAtBranch) { %>
            <div style="display:flex;align-items:center;gap:8px;background:#dbeafe;border:1px solid #3b82f6;border-radius:6px;padding:10px 15px;margin-bottom:15px;color:#1e40af;font-size:0.9rem; width: 100%; box-sizing: border-box;">
                <span class="material-symbols-outlined" style="font-size:1.2rem;">info</span>
                <span><strong>En Sucursal</strong>: solo se puede reasignar el transportista.</span>
            </div>
            <% } %>

            <%
                const _sk  = shipment.status.description.toLowerCase().replace(/[\s-]+/g, '_');
                const _slU = {pendiente:'Pendiente',en_transito:'En Tránsito',entregado:'Entregado',cancelado:'Cancelado',cancelada:'Cancelada',retrasado:'Retrasado',en_sucursal:'En Sucursal',inicial:'Inicial',asignado:'Asignado',en_preparacion:'En Preparación',paquete_fallido:'Paquete Fallido',intento_fallido:'Intento Fallido'};
                const _slLabel = _slU[_sk] || shipment.status.description;
            %>

            <!-- Tracking ID + estado -->
            <div class="detail-top" style="margin-bottom: 1rem;">
                <div class="detail-tracking">
                    <span class="detail-tracking-label">ID Tracking</span>
                    <span class="detail-tracking-id"><%= shipment.trackingId %></span>
                </div>
                <span class="status-badge <%= _sk %>"><%= _slLabel %></span>
            </div>

            <!-- ── Línea de tiempo ── -->
            <div class="update-card" style="margin-bottom: 1.5rem;">
                <h3><span class="material-symbols-outlined">timeline</span> Línea de tiempo</h3>
                <% if (history.length === 0) { %>
                    <p class="historial-empty">Sin eventos registrados.</p>
                <% } else { %>
                    <%
                        const _refLocationU = [shipment.address.street, shipment.address.number].filter(Boolean).join(' ') || null;
                    %>
                    <ol class="shipment-timeline">
                        <% history.forEach(function(h) { %>
                            <%
                                const _isCreated = h.eventType === 'CREATED';
                                const _tk = h.toStatus.description.toLowerCase().replace(/[\s-]+/g, '_');
                                const _tl = _slU[_tk] || h.toStatus.description;
                                const _icon = _isCreated ? 'add_circle' : 'swap_horiz';
                                const _author = h.user ? h.user.fullName : null;
                            %>
                            <li class="shipment-timeline-item">
                                <span class="shipment-timeline-dot <%= _tk %>">
                                    <span class="material-symbols-outlined"><%= _icon %></span>
                                </span>
                                <div class="shipment-timeline-content">
                                    <div class="shipment-timeline-header">
                                        <span class="status-badge status-badge--sm <%= _tk %>"><%= _tl %></span>
                                        <% if (_isCreated) { %>
                                            <span class="shipment-timeline-tag">Creación del envío</span>
                                        <% } else if (h.fromStatus) { %>
                                            <%
                                                const _fk = h.fromStatus.description.toLowerCase().replace(/[\s-]+/g, '_');
                                                const _fl = _slU[_fk] || h.fromStatus.description;
                                            %>
                                            <span class="shipment-timeline-tag">Desde <%= _fl %></span>
                                        <% } %>
                                    </div>
                                    <div class="shipment-timeline-meta">
                                        <span class="material-symbols-outlined shipment-timeline-meta-ico">schedule</span>
                                        <%= fmtDate(h.changedAt) %>
                                        <%= fmtTime(h.changedAt) %>
                                    </div>
                                    <% if (_author) { %>
                                        <div class="shipment-timeline-meta">
                                            <span class="material-symbols-outlined shipment-timeline-meta-ico">person</span>
                                            <%= _author %>
                                        </div>
                                    <% } %>
                                    <% if (_isCreated) { %>
                                        <div class="shipment-timeline-meta">
                                            <span class="material-symbols-outlined shipment-timeline-meta-ico">location_on</span>
                                            <%= mapData.origin.label.toUpperCase() %>
                                        </div>
                                    <% } else if (h.branch) { %>
                                        <div class="shipment-timeline-meta">
                                            <span class="material-symbols-outlined shipment-timeline-meta-ico">store</span>
                                            <%= h.branch.name.toUpperCase() %>
                                        </div>
                                    <% } else if (_refLocationU) { %>
                                        <div class="shipment-timeline-meta">
                                            <span class="material-symbols-outlined shipment-timeline-meta-ico">location_on</span>
                                            <%= _refLocationU.toUpperCase() %>
                                        </div>
                                    <% } %>
                                    <% if (h.comment) { %>
                                        <div class="shipment-timeline-comment">"<%= h.comment %>"</div>
                                    <% } %>
                                </div>
                            </li>
                        <% }) %>
                    </ol>
                <% } %>
            </div>

            <!-- ══════════ TOP GRID: INFO + MAPA ══════════ -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">

                <!-- ── Resumen del envío ── -->
                <div class="update-card" style="margin-bottom: 0;">
                    <h3><span class="material-symbols-outlined">inventory_2</span> Resumen</h3>
                    <div class="summary-stats-row" style="margin-bottom: 1rem;">
                        <div class="summary-stat-item">
                            <span class="summary-stat-label">Tipo</span>
                            <span class="summary-stat-value"><%= shipment.shipmentType ? shipment.shipmentType.description : '-' %></span>
                        </div>
                        <div class="summary-stat-item">
                            <span class="summary-stat-label">Peso</span>
                            <span class="summary-stat-value"><%= shipment.weightKg != null ? Number(shipment.weightKg).toFixed(1) + 'kg' : '-' %></span>
                        </div>
                        <div class="summary-stat-item">
                            <span class="summary-stat-label">Cant.</span>
                            <span class="summary-stat-value"><%= shipment.packageQty != null ? shipment.packageQty : '-' %></span>
                        </div>
                    </div>
                    <div style="font-size: 0.85rem; color: var(--color-text-secondary);">
                        <div style="margin-bottom: 4px;"><strong>ORIGEN:</strong> <%= mapData.origin.label.toUpperCase() %></div>
                        <div><strong>DESTINO:</strong> <%= [shipment.address.street, shipment.address.number].filter(Boolean).join(' ').toUpperCase() || '-' %></div>
                    </div>
                    <% if (shipment.expectedDeliveryDate) {
                        const _edU = new Date(shipment.expectedDeliveryDate);
                        const _edULabel = _edU.toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
                    %>
                        <div style="margin-top:1rem;padding:.75rem .85rem;border-radius:8px;background:var(--color-bg);border:1px solid var(--color-border);font-size:.9rem;">
                            <strong style="display:flex;align-items:center;gap:.4rem;margin-bottom:.3rem;color:var(--color-primary,#2563eb);">
                                <span class="material-symbols-outlined" style="font-size:1.1rem;">event_available</span>
                                Fecha estimada de entrega
                            </strong>
                            <span style="text-transform:capitalize;font-weight:600"><%= _edULabel %></span>
                            <small style="display:block;margin-top:.2rem;color:var(--color-text-secondary);">Valor guardado en base (cargado al alta).</small>
                        </div>
                    <% } %>
                </div>

                <!-- ── Mapa ── -->
                <div class="update-card update-map-card" style="margin-bottom: 0;">
                    <h3><span class="material-symbols-outlined">map</span> Trayecto</h3>
                    <div id="shipment-map" style="height: 200px; border-radius: 8px;"></div>
                    <div id="route-summary" style="margin-top:.5rem;font-size:.85rem;color:var(--color-text-secondary);display:flex;gap:1rem;flex-wrap:wrap;min-height:1.2em;"></div>
                    <div id="route-legend" class="map-legend" style="margin-top:.4rem;"></div>
                </div>

            </div>
            <!-- ══════════ FIN TOP GRID ══════════ -->


            <!-- ══════════ FORM + GESTIÓN DE ESTADO ══════════ -->
            <div class="update-bottom-grid">

                <form id="main-update-form" style="display:contents" action="/shipment/update/<%= shipment.id %>" method="post">

                    <div class="update-card" style="grid-area:destinatario">
                        <h3>Destinatario</h3>
                        <div class="update-fields">
                            <div class="field">
                                <label for="recipient-name">Nombre y Apellido <span class="req">*</span></label>
                                <input id="recipient-name" type="text" name="recipientName" value="<%= (shipment.recipient && shipment.recipient.fullName) || '' %>" placeholder="Ej: Juan Pérez" <%= !canEditRecipientBasic ? 'readonly style="pointer-events:none;opacity:0.6;"' : '' %>>
                            </div>
                            <div class="field">
                                <label for="recipient-document">Documento <span class="req">*</span></label>
                                <input id="recipient-document" type="text" name="recipientDocument" value="<%= (shipment.recipient && shipment.recipient.document) || '' %>" placeholder="Ej: 12.345.678" data-doc-format maxlength="11" <%= !canEditRecipientBasic ? 'readonly style="pointer-events:none;opacity:0.6;"' : '' %>>
                            </div>
                            <div class="field">
                                <label for="recipient-phone">Teléfono <span class="req">*</span></label>
                                <input id="recipient-phone" type="tel" name="recipientPhone" value="<%= (shipment.recipient && shipment.recipient.phone) || '' %>" placeholder="Ej: 1123456789" maxlength="10" pattern="[0-9]*" inputmode="numeric" <%= canEditContact ? 'required' : 'readonly style="pointer-events:none;opacity:0.6;"' %>>
                            </div>
                            <div class="field">
                                <label for="recipient-email">Email <span class="req">*</span></label>
                                <input id="recipient-email" type="email" name="recipientEmail" value="<%= (shipment.recipient && shipment.recipient.email) || '' %>" placeholder="Ej: juan@email.com" maxlength="100" <%= canEditContact ? 'required' : 'readonly style="pointer-events:none;opacity:0.6;"' %>>
                            </div>
                        </div>
                    </div>

                    <div class="update-card" style="grid-area:infopaquete">
                        <h3>Información del paquete</h3>
                        <div style="display:flex;align-items:center;gap:8px;background:#f3f4f6;border:1px solid #d1d5db;border-radius:4px;padding:10px 14px;margin-bottom:12px;color:#4b5563;font-size:0.88rem;">
                            <span class="material-symbols-outlined" style="font-size:1.1rem;">lock</span>
                            Estos campos no pueden modificarse después de la creación.
                        </div>
                        <div class="update-fields">
                            <div class="field">
                                <label for="shipment-type">Tipo de envío <span class="req">*</span></label>
                                <input type="hidden" name="shipmentTypeId" value="<%= shipment.shipmentTypeId || '' %>">
                                <select id="shipment-type" name="shipmentTypeId" disabled>
                                    <option value="">Seleccione un tipo</option>
                                    <% typesShipment.forEach(type => { %>
                                        <option value="<%= type.id %>" <%= shipment.shipmentTypeId == type.id ? 'selected' : '' %>><%= type.description %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="field">
                                <label for="weight-kg">Peso (kg) <span class="req">*</span></label>
                                <input id="weight-kg" type="number" name="weightKg" min="0.1" max="999" step="0.1" value="<%= shipment.weightKg || '' %>" placeholder="Ej: 1.5" readonly style="pointer-events:none;opacity:0.6;">
                            </div>
                            <div class="field">
                                <label for="package-qty">Cantidad de paquetes <span class="req">*</span></label>
                                <input id="package-qty" type="number" name="packageQty" min="1" max="999" step="1" value="<%= shipment.packageQty || '' %>" placeholder="Ej: 3" readonly style="pointer-events:none;opacity:0.6;">
                            </div>
                        </div>
                    </div>

                    <div class="update-card" style="grid-area:direccion">
                        <h3>Modalidad de entrega</h3>
                        <p style="margin:0 0 12px;font-size:0.92rem;">
                            <strong>
                                <%= shipment.deliveryMode === 'branch_pickup' ? 'Retiro por sucursal' : 'Envío a domicilio' %>
                            </strong>
                            <% if (shipment.deliveryMode === 'branch_pickup' && shipment.pickupBranch) { %>
                                — <%= shipment.pickupBranch.name %> (<%= shipment.pickupBranch.address %>)
                            <% } %>
                        </p>

                        <h3>Dirección de entrega</h3>

                        <% if (!canEditAddress) { %>
                        <div style="display:flex;align-items:center;gap:8px;background:#fef3c7;border:1px solid #f59e0b;border-radius:4px;padding:10px 14px;margin-bottom:12px;color:#92400e;font-size:0.88rem;">
                            <span class="material-symbols-outlined" style="font-size:1.1rem;">lock</span>
                            La dirección no puede modificarse en el estado actual.
                        </div>
                        <% } %>

                        <input type="hidden" id="street"      name="street"     value="<%= shipment.address.street || '' %>">
                        <input type="hidden" id="number"      name="number"     value="<%= shipment.address.number || '' %>">
                        <input type="hidden" id="province"    name="province"   value="<%= shipment.address.provinceId || '' %>">
                        <input type="hidden" id="postal-code" name="postalCode" value="<%= shipment.address.postalCode || '' %>">
                        <input type="hidden" id="address-lat" name="addressLat" value="<%= shipment.address.lat || '' %>">
                        <input type="hidden" id="address-lng" name="addressLng" value="<%= shipment.address.lng || '' %>">

                        <div class="update-fields" style="display:flex;flex-direction:column;gap:var(--space-3);">

                            <% if (canEditAddress) { %>
                            <div class="field addr-search-wrapper" style="position:relative;">
                                <label for="address-search">Dirección completa</label>
                                <input id="address-search" type="text" autocomplete="off"
                                       placeholder="Ej: Av. Corrientes 1234, CABA">
                                <div id="address-dropdown" class="addr-dropdown" style="display:none;"></div>
                            </div>
                            <% } %>

                            <% const currentProvName = provinces.find(p => p.id == shipment.address.provinceId)?.description || ''; %>
                            <div class="addr-selected-row" id="addr-selected-row"
                                 <% if (!shipment.address.street) { %>style="display:none;"<% } %>>
                                <div id="address-chip" class="addr-chip">
                                    <span class="material-symbols-outlined">pin_drop</span>
                                    <span id="addr-chip-text">
                                        <strong><%= shipment.address.street %> <%= shipment.address.number %></strong><% if (currentProvName) { %> — <%= currentProvName %><% } %>
                                    </span>
                                </div>
                                <% if (canEditAddress) { %>
                                <button type="button" id="address-clear" class="addr-clear-btn">
                                    <span class="material-symbols-outlined">close</span> Cambiar
                                </button>
                                <% } %>
                            </div>

                            <div class="field">
                                <label for="floor-apartment">Piso y/o Depto <span style="font-weight:400;color:var(--color-text-secondary)">(opcional)</span></label>
                                <input id="floor-apartment" type="text" name="floorApartment" value="<%= shipment.address.floorApartment || '' %>" placeholder="Ej: 3° B" <%= !canEditAddress ? 'readonly style="pointer-events:none;opacity:0.6;"' : '' %>>
                            </div>
                        </div>
                    </div>


                </form>

                <!-- Modal asignar repartidor (LGT-109) -->
                <div id="assign-modal" class="app-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="assign-modal-title">
                    <div class="app-modal">
                        <h3 id="assign-modal-title">
                            <span class="material-symbols-outlined">person_add</span>
                            Asignar repartidor
                        </h3>
                        <form action="/shipment/update/<%= shipment.id %>/assign" method="post" id="assign-modal-form">
                            <div class="field">
                                <label for="modal-deliveryUserId">Seleccionar repartidor</label>
                                <select name="deliveryUserId" id="modal-deliveryUserId" required>
                                    <option value="">-- Elegir repartidor --</option>
                                    <% deliveryUsers.forEach(user => { %>
                                        <option value="<%= user.id %>" <%= shipment.deliveryUserId == user.id ? 'selected' : '' %>>
                                            <%= user.fullName %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="app-modal-actions">
                                <button type="button" class="action-btn action-btn--lg cancelar" id="btn-close-assign-modal" data-tooltip="Cancelar" aria-label="Cancelar">
                                    <span class="material-symbols-outlined">close</span>
                                </button>
                                <button type="submit" class="action-btn action-btn--lg guardar" data-tooltip="Confirmar" aria-label="Confirmar">
                                    <span class="material-symbols-outlined">check</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Gestión de estado: flujo dinámico (LGT-109) -->
                <div class="gestion-estado" style="grid-area:gestion">
                    <h3>Gestión de Estado</h3>

                    <div class="estado-actual-badge">
                        ESTADO ACTUAL: <%= shipment.status.description.toUpperCase() %>
                    </div>

                    <% const isTerminal = [4, 5, 8].includes(shipment.statusId); %>
                    <% if (isTerminal) { %>
                        <div class="status-info-message" style="background-color:#e5e7eb;border:1px solid #9ca3af;border-radius:4px;padding:12px;margin-top:16px;color:#374151;font-size:0.9rem;">
                            <span class="material-symbols-outlined" style="vertical-align:text-bottom;margin-right:8px;">flag</span>
                            Este envío está en estado final. No se admiten más cambios.
                        </div>
                    <% } else if (!availableActions || availableActions.length === 0) { %>
                        <div class="status-info-message" style="background-color:#fef3c7;border:1px solid #f59e0b;border-radius:4px;padding:12px;margin-top:16px;color:#92400e;font-size:0.9rem;">
                            <span class="material-symbols-outlined" style="vertical-align:text-bottom;margin-right:8px;">info</span>
                            No hay acciones disponibles para tu rol en este estado.
                        </div>
                    <% } else { %>
                        <%
                            const _actionIcons = {
                                6: 'person_add', 7: 'play_arrow', 2: 'local_shipping',
                                3: 'store', 4: 'check_circle', 5: 'cancel',
                                8: 'report', 9: 'warning'
                            };
                        %>
                        <div class="dynamic-actions">
                            <% availableActions.forEach(function(action) { %>
                                <% const url = action.endpoint.replace(':id', shipment.id); %>
                                <% const icon = _actionIcons[action.toStatusId] || 'arrow_forward'; %>
                                <% const isAssign = url.includes('/assign'); %>
                                <% if (isAssign) { %>
                                    <button type="button" class="action-btn-dyn action-btn-status-<%= action.toStatusId %>" id="btn-open-assign-modal">
                                        <span class="material-symbols-outlined"><%= icon %></span>
                                        <%= action.label %>
                                    </button>
                                <% } else if (action.requireComment) { %>
                                    <button type="button" class="action-btn-dyn action-btn-status-<%= action.toStatusId %> action-with-comment"
                                            data-endpoint="<%= url %>"
                                            data-label="<%= action.label %>">
                                        <span class="material-symbols-outlined"><%= icon %></span>
                                        <%= action.label %>
                                    </button>
                                <% } else { %>
                                    <form action="<%= url %>" method="post" style="margin:0;">
                                        <button type="submit" class="action-btn-dyn action-btn-status-<%= action.toStatusId %>">
                                            <span class="material-symbols-outlined"><%= icon %></span>
                                            <%= action.label %>
                                        </button>
                                    </form>
                                <% } %>
                            <% }) %>
                        </div>

                        <div id="comment-modal" class="app-modal-backdrop" role="dialog" aria-modal="true">
                            <div class="app-modal">
                                <h3 id="comment-modal-title"></h3>
                                <form id="comment-modal-form" method="post" action="">
                                    <div class="field" style="margin-bottom:12px;">
                                        <label for="comment-modal-input">Motivo</label>
                                        <textarea name="comment" id="comment-modal-input" rows="4" required minlength="3"
                                                  placeholder="Motivo obligatorio..."></textarea>
                                    </div>
                                    <div class="app-modal-actions">
                                        <button type="button" class="action-btn action-btn--lg cancelar" id="comment-modal-cancel" data-tooltip="Cancelar" aria-label="Cancelar">
                                            <span class="material-symbols-outlined">close</span>
                                        </button>
                                        <button type="submit" class="action-btn action-btn--lg guardar" data-tooltip="Confirmar" aria-label="Confirmar">
                                            <span class="material-symbols-outlined">check</span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    <% } %>
                </div>

            </div>
            <!-- ══════════ FIN FORM ══════════ -->

            <div class="update-form-actions">
                <button type="submit" form="main-update-form" class="action-btn action-btn--lg guardar" id="btn-save-changes" data-tooltip="Guardar cambios" aria-label="Guardar cambios" <%= isGlobalNonEditable ? 'disabled' : '' %>>
                    <span class="material-symbols-outlined">save</span>
                </button>
            </div>

        </div>
    </main>

    <script>
        (function() {
            // ── Modal motivo (cancelar, paquete fallido, etc.) ──
            var cModal  = document.getElementById('comment-modal');
            var cForm   = document.getElementById('comment-modal-form');
            var cTitle  = document.getElementById('comment-modal-title');
            var cInput  = document.getElementById('comment-modal-input');
            var cCancel = document.getElementById('comment-modal-cancel');

            document.querySelectorAll('.action-with-comment').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    if (!cModal) return;
                    cForm.action = this.dataset.endpoint;
                    cTitle.textContent = this.dataset.label;
                    cInput.value = '';
                    cModal.classList.add('is-open');
                });
            });
            if (cCancel) cCancel.addEventListener('click', function() { cModal.classList.remove('is-open'); });
            if (cModal)  cModal.addEventListener('click', function(e) { if (e.target === cModal) cModal.classList.remove('is-open'); });

            // ── Modal asignar repartidor ──
            var aModal  = document.getElementById('assign-modal');
            var aOpen   = document.getElementById('btn-open-assign-modal');
            var aClose  = document.getElementById('btn-close-assign-modal');

            if (aOpen && aModal)  aOpen.addEventListener('click',  function() { aModal.classList.add('is-open'); });
            if (aClose)           aClose.addEventListener('click',  function() { aModal.classList.remove('is-open'); });
            if (aModal)           aModal.addEventListener('click',  function(e) { if (e.target === aModal) aModal.classList.remove('is-open'); });
        })();

        // Prevenir doble submit del form de datos.
        var mainForm = document.getElementById('main-update-form');
        if (mainForm) {
            mainForm.addEventListener('submit', function() {
                var btn = document.getElementById('btn-save-changes');
                if (btn) { btn.disabled = true; btn.textContent = 'Guardando...'; }
            });
        }
    </script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
    (function () {
        var ORIGIN       = { lat: <%- mapData.origin.lat %>, lng: <%- mapData.origin.lng %>, label: '<%- mapData.origin.label.replace(/'/g, "\\'") %>' };
        var DEST         = <%- mapData.destination ? JSON.stringify({ lat: mapData.destination.lat, lng: mapData.destination.lng, label: mapData.destination.label }) : 'null' %>;
        var INIT_ROUTE   = <%- mapData.route ? JSON.stringify(mapData.route) : 'null' %>;
        var BRANCH_ID    = <%= (currentUser && currentUser.branchId) ? currentUser.branchId : 'null' %>;

        var map = L.map('shipment-map');
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 18,
        }).addTo(map);

        var routeLayer   = null;
        var markersLayer = L.layerGroup().addTo(map);

        function makeIcon(color) {
            return L.divIcon({
                className: '',
                html: '<div style="width:12px;height:12px;border-radius:50%;background:' + color + ';border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4)"></div>',
                iconSize: [12, 12], iconAnchor: [6, 6],
            });
        }

        function renderRoute(route, origin, dest) {
            markersLayer.clearLayers();
            if (routeLayer) { map.removeLayer(routeLayer); routeLayer = null; }

            if (!dest) {
                L.marker([origin.lat, origin.lng], { icon: makeIcon('#2563eb') })
                    .addTo(markersLayer).bindPopup('<strong>Origen</strong><br>' + origin.label);
                map.setView([origin.lat, origin.lng], 10);
                updateSummary(null);
                updateLegend(null);
                return;
            }

            if (route && route.polyline && route.polyline.length > 1) {
                routeLayer = L.polyline(route.polyline, { color: '#2563eb', weight: 3, opacity: 0.8 }).addTo(map);

                route.stops.forEach(function (s) {
                    var color = s.kind === 'origin' ? '#2563eb' : s.kind === 'destination' ? '#dc2626' : '#f59e0b';
                    L.marker([s.lat, s.lng], { icon: makeIcon(color) })
                        .addTo(markersLayer)
                        .bindPopup('<strong>' + s.label + '</strong>');
                });

                map.fitBounds(routeLayer.getBounds(), { padding: [25, 25] });
            } else {
                L.marker([origin.lat, origin.lng], { icon: makeIcon('#2563eb') })
                    .addTo(markersLayer).bindPopup('<strong>Origen</strong><br>' + origin.label);
                L.marker([dest.lat, dest.lng], { icon: makeIcon('#dc2626') })
                    .addTo(markersLayer).bindPopup('<strong>Destino</strong><br>' + dest.label);
                L.polyline([[origin.lat, origin.lng], [dest.lat, dest.lng]], {
                    color: '#2563eb', weight: 2, dashArray: '5 5', opacity: 0.6,
                }).addTo(map);
                map.fitBounds([[origin.lat, origin.lng], [dest.lat, dest.lng]], { padding: [30, 30] });
            }

            updateSummary(route);
            updateLegend(route);
        }

        function haversineKm(a, b) {
            var R = 6371, dLat = (b.lat - a.lat) * Math.PI / 180, dLng = (b.lng - a.lng) * Math.PI / 180;
            var x = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(a.lat*Math.PI/180)*Math.cos(b.lat*Math.PI/180)*Math.sin(dLng/2)*Math.sin(dLng/2);
            return R * 2 * Math.atan2(Math.sqrt(x), Math.sqrt(1-x));
        }

        function updateSummary(route) {
            var el = document.getElementById('route-summary');
            if (!el) return;
            if (!route) { el.innerHTML = ''; return; }
            var intermediates = route.stops.filter(function(s){ return s.kind === 'branch'; }).length;
            var providerLabel = route.provider === 'osrm' ? 'Red vial real (OSRM)' : 'Estimado en línea recta';

            var stopSpan = '';
            if (intermediates > 0) {
                var segLines = [];
                for (var i = 0; i < route.stops.length - 1; i++) {
                    var from = route.stops[i], to = route.stops[i + 1];
                    var km = haversineKm(from, to).toFixed(1);
                    segLines.push('<div style="white-space:nowrap"><span style="color:#6b7280">' + from.label + ' → ' + to.label + '</span> <strong>' + km + ' km</strong></div>');
                }
                var tooltip = '<div class="route-seg-tooltip">' + segLines.join('') + '</div>';
                stopSpan = '<span class="route-stop-badge" tabindex="0">'
                    + '<strong>' + intermediates + '</strong> sucursal' + (intermediates > 1 ? 'es intermedias' : ' intermedia')
                    + tooltip
                    + '</span>';
            } else {
                stopSpan = '<span>Ruta directa</span>';
            }

            el.innerHTML = '<span><strong>' + route.totalKm.toFixed(1) + '</strong> km</span>'
                + stopSpan
                + '<span style="color:#9ca3af;font-size:.8rem;">' + providerLabel + '</span>';
        }

        function updateLegend(route) {
            var el = document.getElementById('route-legend');
            if (!el) return;
            if (!route) { el.innerHTML = ''; return; }
            var intermediates = route.stops.filter(function(s){ return s.kind === 'branch'; }).length;
            var html = '<div class="map-legend-item"><div class="map-dot" style="background:#2563eb"></div><span>Origen</span></div>';
            if (intermediates > 0) {
                html += '<div class="map-legend-item"><div class="map-dot" style="background:#f59e0b"></div><span>Sucursal intermedia</span></div>';
            }
            html += '<div class="map-legend-item"><div class="map-dot" style="background:#dc2626"></div><span>Destino</span></div>';
            el.innerHTML = html;
        }

        // Render inicial
        renderRoute(INIT_ROUTE, ORIGIN, DEST);

        // Recalcular al seleccionar nueva dirección
        var streetInput = document.getElementById('street');
        if (streetInput) {
            streetInput.addEventListener('change', function () {
                var lat = parseFloat(document.getElementById('address-lat').value);
                var lng = parseFloat(document.getElementById('address-lng').value);
                if (!isFinite(lat) || !isFinite(lng)) return;

                var destLabel = (document.getElementById('street').value || '') + ' ' + (document.getElementById('number').value || '');
                var url = '/api/route?originLat=' + ORIGIN.lat + '&originLng=' + ORIGIN.lng
                    + '&originLabel=' + encodeURIComponent(ORIGIN.label)
                    + '&destLat=' + lat + '&destLng=' + lng
                    + '&destLabel=' + encodeURIComponent(destLabel.trim())
                    + (BRANCH_ID ? '&originBranchId=' + BRANCH_ID : '');

                var summaryEl = document.getElementById('route-summary');
                if (summaryEl) summaryEl.innerHTML = '<span style="color:#6b7280">Calculando ruta...</span>';

                fetch(url)
                    .then(function(r){ return r.json(); })
                    .then(function(data){
                        var newDest = { lat: lat, lng: lng, label: destLabel.trim() };
                        renderRoute(data.route, ORIGIN, newDest);
                    })
                    .catch(function(){ if (summaryEl) summaryEl.innerHTML = ''; });
            });
        }
    })();
    </script>

    <script src="/js/new_shipment_popup.js" defer></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/address-autocomplete.js" defer></script>
    <script src="/js/document-format.js" defer></script>
</body>
</html>
