<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/shipments.css">
    <% const _hasMap = mapData && (mapData.destination || (mapData.stops && mapData.stops.length > 0)); %>
    <% if (_hasMap) { %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
    <% } %>
    <title>Detalle de Envío - LogiTrack</title>
</head>

<body>
    <%- include('../partials/header') %>

    <main class="main-content">
        <div class="page-header">
            <h1>Detalle de Envío</h1>
            <div style="display:flex;gap:var(--space-3)">
                <a href="<%= returnUrl %>" class="btn-secondary">Volver</a>
                <% if ((currentUser.roleId === 1 || currentUser.roleId === 2) && ![4, 5, 8].includes(shipment.statusId)) { %>
                <a href="/shipment/update/<%= shipment.id %>?from=/shipment/detail/<%= shipment.id %>" class="btn-primary">
                    <span class="material-symbols-outlined">edit</span>Modificar
                </a>
                <% } %>
            </div>
        </div>

        <div class="page-update-wrapper">

            <%
                const _sk  = shipment.status.description.toLowerCase().replace(/[\s-]+/g, '_');
                const _sl  = {pendiente:'Pendiente',en_transito:'En Tránsito',entregado:'Entregado',cancelado:'Cancelado',cancelada:'Cancelada',retrasado:'Retrasado',en_sucursal:'En Sucursal',inicial:'Inicial',asignado:'Asignado',en_preparacion:'En Preparación',paquete_fallido:'Paquete Fallido',intento_fallido:'Intento Fallido'};
                const _slLabel = _sl[_sk] || shipment.status.description;
            %>

            <!-- Tracking ID + estado -->
            <div class="detail-top" style="margin-bottom: 1.5rem;">
                <div class="detail-tracking">
                    <span class="detail-tracking-label">ID Tracking</span>
                    <span class="detail-tracking-id"><%= shipment.trackingId %></span>
                </div>
                <span class="status-badge <%= _sk %>"><%= _slLabel %></span>
            </div>

            <!-- ── Línea de tiempo (card independiente) ── -->
            <div class="update-card" style="margin-bottom: 1.5rem;">
                <h3><span class="material-symbols-outlined">timeline</span> Línea de tiempo</h3>
                <% if (history.length === 0) { %>
                    <p class="historial-empty">Sin eventos registrados.</p>
                <% } else { %>
                    <%
                        const _sl2 = {pendiente:'Pendiente',en_transito:'En Tránsito',entregado:'Entregado',cancelado:'Cancelado',cancelada:'Cancelada',retrasado:'Retrasado',en_sucursal:'En Sucursal',inicial:'Inicial',asignado:'Asignado',en_preparacion:'En Preparación',paquete_fallido:'Paquete Fallido',intento_fallido:'Intento Fallido'};
                        function _sk2(desc) { return desc.toLowerCase().replace(/[\s-]+/g, '_'); }
                        const _refLocation = [shipment.address.street, shipment.address.number].filter(Boolean).join(' ') || null;
                    %>
                    <ol class="shipment-timeline">
                        <% history.forEach(function(h) { %>
                            <%
                                const _isCreated = h.eventType === 'CREATED';
                                const _tk = _sk2(h.toStatus.description);
                                const _tl = _sl2[_tk] || h.toStatus.description;
                                const _icon = _isCreated ? 'add_circle' : 'swap_horiz';
                                const _author = h.user ? h.user.fullName : null;
                            %>
                            <li class="shipment-timeline-item">
                                <span class="shipment-timeline-dot <%= _tk %>">
                                    <span class="material-symbols-outlined"><%= _icon %></span>
                                </span>
                                <div class="shipment-timeline-content">
                                    <div class="shipment-timeline-header">
                                        <span class="status-badge status-badge--sm <%= _tk %>"><%= _tl %></span>
                                        <% if (_isCreated) { %>
                                            <span class="shipment-timeline-tag">Creación del envío</span>
                                        <% } else if (h.fromStatus) { %>
                                            <%
                                                const _fk = _sk2(h.fromStatus.description);
                                                const _fl = _sl2[_fk] || h.fromStatus.description;
                                            %>
                                            <span class="shipment-timeline-tag">Desde <%= _fl %></span>
                                        <% } %>
                                    </div>
                                    <div class="shipment-timeline-meta">
                                        <span class="material-symbols-outlined shipment-timeline-meta-ico">schedule</span>
                                        <%= new Date(h.changedAt).toLocaleDateString('es-AR') %>
                                        <%= new Date(h.changedAt).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }) %>
                                    </div>
                                    <% if (_author) { %>
                                        <div class="shipment-timeline-meta">
                                            <span class="material-symbols-outlined shipment-timeline-meta-ico">person</span>
                                            <%= _author %>
                                        </div>
                                    <% } %>
                                    <% if (h.branch) { %>
                                        <div class="shipment-timeline-meta">
                                            <span class="material-symbols-outlined shipment-timeline-meta-ico">store</span>
                                            SUCURSAL <%= h.branch.name.toUpperCase() %>
                                        </div>
                                    <% } else if (_isCreated) { %>
                                        <div class="shipment-timeline-meta">
                                            <span class="material-symbols-outlined shipment-timeline-meta-ico">location_on</span>
                                            <%= mapData.origin.label.toUpperCase() %>
                                        </div>
                                    <% } else if (_refLocation) { %>
                                        <div class="shipment-timeline-meta">
                                            <span class="material-symbols-outlined shipment-timeline-meta-ico">location_on</span>
                                            <%= _refLocation.toUpperCase() %>
                                        </div>
                                    <% } %>
                                    <% if (h.latitude != null && h.longitude != null) { %>
                                        <div class="shipment-timeline-meta">
                                            <span class="material-symbols-outlined shipment-timeline-meta-ico">my_location</span>
                                            <%= Number(h.latitude).toFixed(5) %>, <%= Number(h.longitude).toFixed(5) %>
                                            <% if (_hasMap) { %>
                                                <a href="#shipment-map" class="timeline-map-link" data-lat="<%= h.latitude %>" data-lng="<%= h.longitude %>" style="margin-left:.5rem;">Ver en mapa</a>
                                            <% } %>
                                        </div>
                                    <% } %>
                                    <% if (h.comment) { %>
                                        <div class="shipment-timeline-comment">"<%= h.comment %>"</div>
                                    <% } %>
                                </div>
                            </li>
                        <% }) %>
                    </ol>
                <% } %>
            </div>

            <!-- ══════════ TOP: 2 COLUMNAS ══════════ -->
            <div class="update-top-grid">

                <!-- ── Resumen del envío + ML ── -->
                <div class="update-card">
                    <h3><span class="material-symbols-outlined">inventory_2</span> Resumen del envío</h3>

                    <div class="summary-stats-row">
                        <div class="summary-stat-item">
                            <span class="summary-stat-label">Tipo de Envío</span>
                            <span class="summary-stat-value">
                                <span class="material-symbols-outlined">local_shipping</span>
                                <%= shipment.shipmentType ? shipment.shipmentType.description : '-' %>
                            </span>
                        </div>
                        <div class="summary-stat-item">
                            <span class="summary-stat-label">Peso</span>
                            <span class="summary-stat-value">
                                <span class="material-symbols-outlined">scale</span>
                                <%= shipment.weightKg != null ? Number(shipment.weightKg).toFixed(2) + ' kg' : '-' %>
                            </span>
                        </div>
                        <div class="summary-stat-item">
                            <span class="summary-stat-label">Cantidad</span>
                            <span class="summary-stat-value">
                                <span class="material-symbols-outlined">widgets</span>
                                <%= shipment.packageQty != null ? shipment.packageQty : '-' %>
                            </span>
                        </div>
                    </div>

                    <div class="summary-addresses">
                        <div><span class="summary-addr-lbl">ORIGEN:</span> <%= mapData.origin.label.toUpperCase() %></div>
                        <% if (mapData.currentBranch && mapData.currentBranch.label !== mapData.origin.label) { %>
                            <div><span class="summary-addr-lbl">UBICACIÓN ACTUAL:</span> <%= mapData.currentBranch.label.toUpperCase() %></div>
                        <% } %>
                        <div><span class="summary-addr-lbl">DESTINO:</span> <%= [shipment.address.street, shipment.address.number].filter(Boolean).join(' ').toUpperCase() || '-' %></div>
                    </div>

                    <div id="prediction-widget"
                         class="pred-card pred-card--embedded"
                         data-province-id="<%= shipment.address.provinceId %>"
                         data-street="<%= shipment.address.street || '' %>"
                         data-number="<%= shipment.address.number || '' %>"
                         data-weight-kg="<%= shipment.weightKg || '' %>"
                         data-package-qty="<%= shipment.packageQty || '' %>"
                         data-shipment-type-id="<%= shipment.shipmentTypeId || '' %>"
                         data-autoload="true">
                        <h3>
                            <span class="material-symbols-outlined">query_stats</span>
                            Detalles de la entrega
                        </h3>
                        <div id="prediction-result"></div>
                    </div>
                </div>

                <!-- ── Trayecto del envío (mapa) ── -->
                <% if (_hasMap) { %>
                <div class="update-card update-map-card">
                    <h3><span class="material-symbols-outlined">map</span> Trayecto del envío</h3>
                    <div id="shipment-map"></div>
                    <div class="map-legend">
                        <div class="map-legend-item">
                            <div class="map-dot map-dot--origin"></div>
                            <span>Sucursal / evento</span>
                        </div>
                        <div class="map-legend-item">
                            <div class="map-dot map-dot--dest"></div>
                            <span>Entrega final (GPS)</span>
                        </div>
                        <% if (mapData.destination) { %>
                        <div class="map-legend-item">
                            <div class="map-dot" style="background:#9ca3af"></div>
                            <span>Destino: <%= mapData.destination.label %></span>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% } %>

                <!-- ── Repartidor Asignado ── -->
                <div class="update-card">
                    <h3><span class="material-symbols-outlined">person_pin_circle</span> Repartidor</h3>
                    <div class="detail-field">
                        <span class="detail-label">Nombre y apellido</span>
                        <span class="detail-value"><%= shipment.deliveryUser ? shipment.deliveryUser.fullName : 'Sin asignar' %></span>
                    </div>
                </div>

            </div>
            <!-- ══════════ FIN TOP GRID ══════════ -->

            <!-- ══════════ BOTTOM: 2×2 CARDS ══════════ -->
            <div class="detail-bottom-grid">

                <div class="update-card">
                    <h3>Remitente</h3>
                    <div class="detail-field">
                        <span class="detail-label">Nombre y apellido</span>
                        <span class="detail-value"><%= shipment.sender.fullName %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Documento</span>
                        <span class="detail-value"><%= shipment.sender.document %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Teléfono</span>
                        <span class="detail-value"><%= shipment.sender.phone || '-' %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Email</span>
                        <span class="detail-value"><%= shipment.sender.email || '-' %></span>
                    </div>
                </div>

                <div class="update-card">
                    <h3>Destinatario</h3>
                    <div class="detail-field">
                        <span class="detail-label">Nombre y apellido</span>
                        <span class="detail-value"><%= shipment.recipient.fullName %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Documento</span>
                        <span class="detail-value"><%= shipment.recipient.document %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Teléfono</span>
                        <span class="detail-value"><%= shipment.recipient.phone || '-' %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Email</span>
                        <span class="detail-value"><%= shipment.recipient.email || '-' %></span>
                    </div>
                </div>

                <div class="update-card">
                    <h3>Dirección de entrega</h3>
                    <div class="detail-field">
                        <span class="detail-label">Calle y número</span>
                        <span class="detail-value"><%= shipment.address.street %> <%= shipment.address.number %><%= shipment.address.floorApartment ? ', ' + shipment.address.floorApartment : '' %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Provincia</span>
                        <span class="detail-value"><%= shipment.address.province ? shipment.address.province.description : '-' %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Código postal</span>
                        <span class="detail-value"><%= shipment.address.postalCode || '-' %></span>
                    </div>
                </div>

                <div class="update-card">
                    <h3>Información del paquete</h3>
                    <div class="detail-field">
                        <span class="detail-label">Tipo de envío</span>
                        <span class="detail-value"><%= shipment.shipmentType ? shipment.shipmentType.description : '-' %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Peso (kg)</span>
                        <span class="detail-value"><%= shipment.weightKg != null ? shipment.weightKg + ' kg' : '-' %></span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Cantidad de paquetes</span>
                        <span class="detail-value"><%= shipment.packageQty != null ? shipment.packageQty : '-' %></span>
                    </div>
                </div>

                <div class="update-card" style="text-align:center;">
                    <h3><span class="material-symbols-outlined">qr_code</span> Código QR</h3>
                    <img src="/shipment/<%= shipment.id %>/qr" alt="QR <%= shipment.trackingId %>"
                         style="width:180px;height:180px;margin:1rem auto;display:block;">
                    <a href="/shipment/<%= shipment.id %>/label" target="_blank" class="btn-secondary" style="margin-top:0.5rem;display:inline-flex;align-items:center;gap:0.4rem;">
                        <span class="material-symbols-outlined">print</span>Imprimir Etiqueta
                    </a>
                </div>

            </div>
            <!-- ══════════ FIN BOTTOM GRID ══════════ -->

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/prediction.js" defer></script>

    <% if (_hasMap) { %>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
    (function () {
        const stops = <%- JSON.stringify(mapData.stops || []) %>;
        const destination = <%- mapData.destination ? JSON.stringify(mapData.destination) : 'null' %>;

        const map = L.map('shipment-map');
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 18,
        }).addTo(map);

        const mkIcon = (color) => L.divIcon({
            className: '',
            html: '<div style="width:14px;height:14px;border-radius:50%;background:' + color + ';border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4)"></div>',
            iconSize: [14, 14], iconAnchor: [7, 7],
        });
        const podIcon    = mkIcon('#dc2626');
        const branchIcon = mkIcon('#2563eb');
        const destIcon   = mkIcon('#9ca3af');

        const fmtTs = (iso) => {
            const d = new Date(iso);
            return d.toLocaleDateString('es-AR') + ' ' + d.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
        };

        const escapeHtml = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

        const markers = [];
        const latlngs = [];
        stops.forEach((s, idx) => {
            const icon = s.isPOD ? podIcon : branchIcon;
            const m = L.marker([s.lat, s.lng], { icon }).addTo(map);
            const popup = '<strong>' + escapeHtml(s.label) + '</strong>'
                + (s.status ? '<br>Estado: ' + escapeHtml(s.status) : '')
                + '<br>' + escapeHtml(fmtTs(s.timestamp))
                + '<br><small>' + s.lat.toFixed(5) + ', ' + s.lng.toFixed(5) + '</small>';
            m.bindPopup(popup);
            m.__idx = idx;
            markers.push(m);
            latlngs.push([s.lat, s.lng]);
        });

        if (destination && (!stops.length || !stops[stops.length - 1].isPOD)) {
            L.marker([destination.lat, destination.lng], { icon: destIcon })
                .addTo(map)
                .bindPopup('<strong>Destino</strong><br>' + escapeHtml(destination.label));
            latlngs.push([destination.lat, destination.lng]);
        }

        if (latlngs.length >= 2) {
            L.polyline(latlngs, { color: '#2563eb', weight: 2, dashArray: '5 5', opacity: 0.7 }).addTo(map);
            map.fitBounds(latlngs, { padding: [30, 30] });
        } else if (latlngs.length === 1) {
            map.setView(latlngs[0], 13);
        } else {
            map.setView([-34.6037, -58.3816], 11);
        }

        document.querySelectorAll('.timeline-map-link').forEach(link => {
            link.addEventListener('click', (ev) => {
                const lat = parseFloat(link.dataset.lat);
                const lng = parseFloat(link.dataset.lng);
                if (Number.isFinite(lat) && Number.isFinite(lng)) {
                    map.setView([lat, lng], 15);
                    const hit = markers.find(m => {
                        const ll = m.getLatLng();
                        return Math.abs(ll.lat - lat) < 1e-6 && Math.abs(ll.lng - lng) < 1e-6;
                    });
                    if (hit) hit.openPopup();
                }
            });
        });
    })();
    </script>
    <% } %>
    <script>
    (function () {
        if (new URLSearchParams(window.location.search).get('created') !== 'true') return;
        const id = '<%= shipment.id %>';
        const trackingId = '<%= shipment.trackingId %>';
        const isDark = (localStorage.getItem('theme') ?? 'light') === 'dark';
        Swal.fire({
            title: '¡Envío creado!',
            html: '<p style="margin-bottom:1rem;font-size:0.95rem">Código QR generado para <strong>' + trackingId + '</strong></p>'
                + '<img src="/shipment/' + id + '/qr" style="width:220px;height:220px;display:block;margin:0 auto;" alt="QR">',
            showCancelButton: true,
            confirmButtonText: '<span style="display:flex;align-items:center;gap:6px"><span class="material-symbols-outlined" style="font-size:18px">print</span>Imprimir Etiqueta</span>',
            cancelButtonText: 'Cerrar',
            confirmButtonColor: isDark ? '#3b82f6' : '#2563eb',
            background: isDark ? '#1e293b' : '#ffffff',
            color: isDark ? '#f1f5f9' : '#1e293b',
        }).then(function (result) {
            if (result.isConfirmed) window.open('/shipment/' + id + '/label', '_blank');
            history.replaceState(null, '', window.location.pathname);
        });
    })();
    </script>
</body>
</html>
