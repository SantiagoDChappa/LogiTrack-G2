<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/shipments-import.css">
    <title>Preview de importación - LogiTrack</title>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Preview de importación</h1>
            <div class="page-header__actions">
                <a href="/shipment/import" class="btn-secondary">Cancelar</a>
            </div>
        </div>

        <div class="form-new">
            <% if (analysis.aborted) { %>
                <div class="import-alert import-alert--error">
                    <strong>El archivo no se puede importar.</strong>
                    <ul>
                        <% analysis.rows.forEach(function(r) { %>
                            <% (r.errors || []).forEach(function(e) { %>
                                <li><%= e.message %></li>
                            <% }) %>
                        <% }) %>
                    </ul>
                </div>
                <div class="form-actions">
                    <a href="/shipment/import" class="btn-primary">Probar de nuevo</a>
                </div>
            <% } else { %>
                <p class="import-hint">
                    Archivo: <code><%= filename %></code> — total <strong><%= analysis.total %></strong> filas.
                    Antes de importar, revisá lo que el sistema detectó:
                </p>

                <div class="import-summary">
                    <div class="import-stat import-stat--ok">
                        <span class="import-stat__num"><%= analysis.summary.ok %></span>
                        <span class="import-stat__label">Listas para importar</span>
                    </div>
                    <div class="import-stat import-stat--warn">
                        <span class="import-stat__num"><%= analysis.summary.duplicates %></span>
                        <span class="import-stat__label">Duplicados</span>
                    </div>
                    <div class="import-stat import-stat--err">
                        <span class="import-stat__num"><%= analysis.summary.invalid %></span>
                        <span class="import-stat__label">Inválidas</span>
                    </div>
                </div>

                <% const okRows = analysis.rows.filter(r => r.status === 'ok'); %>
                <% const dupRows = analysis.rows.filter(r => r.status === 'duplicate'); %>
                <% const invalidRows = analysis.rows.filter(r => r.status === 'invalid'); %>

                <% if (okRows.length > 0) { %>
                    <section class="import-section">
                        <h3>Filas listas para importar (<%= okRows.length %>)</h3>
                        <div class="table-wrapper">
                            <table>
                                <thead>
                                    <tr><th>Fila</th><th>Remitente</th><th>Destinatario</th><th>Dirección</th><th>Estado</th><th>Legacy ID</th></tr>
                                </thead>
                                <tbody>
                                    <% okRows.forEach(function(r) { %>
                                        <tr>
                                            <td><%= r.rowNumber %></td>
                                            <td><%= r.data.senderName %> (<%= r.data.senderDocument %>)</td>
                                            <td><%= r.data.recipientName %> (<%= r.data.recipientDocument %>)</td>
                                            <td><%= r.data.street %> <%= r.data.number %></td>
                                            <td><%= r.data.statusId === 4 ? 'Entregado' : 'Cancelado' %></td>
                                            <td><%= r.data.legacyTrackingId || '-' %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </section>
                <% } %>

                <% if (dupRows.length > 0) { %>
                    <section class="import-section">
                        <h3>Posibles duplicados (<%= dupRows.length %>)</h3>
                        <p class="import-hint">
                            Estas filas parecen coincidir con envíos existentes (en el sistema o en este mismo CSV).
                            Por defecto se omiten al importar; podés forzar la inserción si estás seguro.
                        </p>
                        <div class="table-wrapper">
                            <table>
                                <thead>
                                    <tr><th>Fila</th><th>Remitente</th><th>Destinatario</th><th>Dirección</th><th>Motivo</th></tr>
                                </thead>
                                <tbody>
                                    <% dupRows.forEach(function(r) { %>
                                        <tr>
                                            <td><%= r.rowNumber %></td>
                                            <td><%= r.data.senderName %> (<%= r.data.senderDocument %>)</td>
                                            <td><%= r.data.recipientName %> (<%= r.data.recipientDocument %>)</td>
                                            <td><%= r.data.street %> <%= r.data.number %></td>
                                            <td><%= r.duplicateOf.reason %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </section>
                <% } %>

                <% if (invalidRows.length > 0) { %>
                    <section class="import-section">
                        <h3>Filas inválidas (<%= invalidRows.length %>)</h3>
                        <p class="import-hint">Estas filas no se importan en ningún caso. Corregilas en el CSV y volvé a subirlo.</p>
                        <div class="table-wrapper">
                            <table>
                                <thead>
                                    <tr><th>Fila</th><th>Campo</th><th>Mensaje</th></tr>
                                </thead>
                                <tbody>
                                    <% invalidRows.forEach(function(r) { %>
                                        <% (r.errors || []).forEach(function(e) { %>
                                            <tr>
                                                <td><%= r.rowNumber %></td>
                                                <td><code><%= e.field %></code></td>
                                                <td><%= e.message %></td>
                                            </tr>
                                        <% }) %>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </section>
                <% } %>

                <section class="import-section">
                    <div class="form-actions">
                        <a href="/shipment/import" class="btn-secondary">Cancelar</a>

                        <% if (analysis.summary.ok > 0) { %>
                            <form action="/shipment/import/commit" method="post" style="display:inline">
                                <input type="hidden" name="previewId" value="<%= previewId %>">
                                <input type="hidden" name="force" value="false">
                                <button type="submit" class="btn-primary">
                                    <span class="material-symbols-outlined">check</span>Importar solo válidas (<%= analysis.summary.ok %>)
                                </button>
                            </form>
                        <% } %>

                        <% if (analysis.summary.duplicates > 0) { %>
                            <form id="force-form" action="/shipment/import/commit" method="post" style="display:inline">
                                <input type="hidden" name="previewId" value="<%= previewId %>">
                                <input type="hidden" name="force" value="true">
                                <button type="button" id="btn-force" class="btn-secondary">
                                    <span class="material-symbols-outlined">warning</span>Importar todo (incluir duplicados)
                                </button>
                            </form>
                        <% } %>
                    </div>
                </section>
            <% } %>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btn = document.getElementById('btn-force');
            if (!btn) return;
            btn.addEventListener('click', function() {
                const isDark = (localStorage.getItem('theme') ?? 'light') === 'dark';
                Swal.fire({
                    icon:  'warning',
                    title: '¿Importar duplicados también?',
                    text:  'Vas a crear envíos que ya existen en el sistema o que se repiten en este CSV. Esta acción no se puede deshacer.',
                    showCancelButton:   true,
                    confirmButtonText:  'Sí, importar todo',
                    cancelButtonText:   'Cancelar',
                    confirmButtonColor: '#d97706',
                    background: isDark ? '#1e293b' : '#ffffff',
                    color:      isDark ? '#f1f5f9' : '#1e293b',
                }).then(function(result) {
                    if (result.isConfirmed) {
                        document.getElementById('force-form').submit();
                    }
                });
            });
        });
    </script>
</body>
</html>
