<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/shipments-import.css">
    <title>Historial de importes - LogiTrack</title>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Historial de importes</h1>
            <a href="/shipment/import" class="btn-primary">
                <span class="material-symbols-outlined">upload_file</span>Nueva importación
            </a>
        </div>

        <div class="shipments-wrapper">
            <% if (imports.length === 0) { %>
                <div class="import-section">
                    <p>No hay importaciones registradas todavía.</p>
                </div>
            <% } else { %>
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th>Archivo</th>
                                <th>Procesadas</th>
                                <th>Importadas</th>
                                <th>Duplicados</th>
                                <th>Errores</th>
                                <th>Forzado</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% imports.forEach(function(imp) { %>
                                <tr>
                                    <td>
                                        <%= imp.createdAt
                                            ? new Date(imp.createdAt).toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'short' })
                                            : '-' %>
                                    </td>
                                    <td><%= imp.user ? imp.user.fullName : '-' %></td>
                                    <td><%= imp.filename || '-' %></td>
                                    <td><%= imp.totalRows %></td>
                                    <td><%= imp.importedCount %></td>
                                    <td><%= imp.duplicateCount || 0 %></td>
                                    <td><%= imp.errorCount %></td>
                                    <td><%= imp.forced ? 'Sí' : 'No' %></td>
                                    <td>
                                        <% if (imp.aborted) { %>
                                            <span class="status-badge cancelado">Abortado</span>
                                        <% } else if (imp.errorCount === 0) { %>
                                            <span class="status-badge entregado">OK</span>
                                        <% } else if (imp.importedCount === 0) { %>
                                            <span class="status-badge cancelado">Sin importar</span>
                                        <% } else { %>
                                            <span class="status-badge en_transito">Parcial</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
