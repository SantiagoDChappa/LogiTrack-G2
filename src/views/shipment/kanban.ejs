<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Kanban — LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
</head>
<body>
    <%- include('../partials/header') %>

    <main class="main-content kanban-page">

        <%
            const KANBAN_COLS = [
                { id: 1, name: 'Pendiente',       icon: 'schedule'       },
                { id: 6, name: 'Asignado',        icon: 'assignment_ind' },
                { id: 7, name: 'En Preparación',  icon: 'inventory_2'    },
                { id: 2, name: 'En Tránsito',     icon: 'local_shipping' },
                { id: 3, name: 'En Sucursal',     icon: 'warehouse'      },
                { id: 9, name: 'Intento Fallido', icon: 'report'         },
            ];
            const CARD_BTNS = {
                1: ['cancel'],
                6: ['cancel'],
                7: ['cancel', 'failed'],
                2: ['cancel', 'failed'],
                3: ['failed'],
                9: ['failed'],
            };
        %>

        <!-- ── Page header ─────────────────────────────────────── -->
        <div class="page-header kanban-page-header">
            <div>
                <h1>Tablero Kanban</h1>
                <p class="kanban-subtitle">Vista operativa de envíos activos</p>
            </div>
        </div>

        <!-- ── Métricas ──────────────────────────────────────────── -->
        <div class="kanban-metrics-bar">
            <% KANBAN_COLS.forEach((col, i) => { %>
                <% const count = (columns[col.id] || []).length; %>
                <div class="k-metric-pill k-pill-<%= col.id %><%= (col.id === 9 && count > 0) ? ' k-pill-alert' : '' %>">
                    <span class="material-symbols-outlined"><%= col.icon %></span>
                    <span class="k-pill-name"><%= col.name %>:</span>
                    <strong id="k-pill-<%= col.id %>"><%= count %></strong>
                    <% if (col.id === 9 && count > 0) { %>
                        <span class="material-symbols-outlined k-pill-warn-ico">warning</span>
                    <% } %>
                </div>
                <% if (i < KANBAN_COLS.length - 1) { %><div class="k-metrics-sep"></div><% } %>
            <% }); %>
        </div>

        <!-- ── Filtros ────────────────────────────────────────────── -->
        <div class="kanban-filter-bar">
            <div class="k-search-box">
                <span class="material-symbols-outlined">search</span>
                <input type="text" id="k-filter-search"
                       placeholder="Buscar por tracking o destinatario…"
                       oninput="kanban.applyFilters()">
            </div>
            <select class="k-filter-sel" id="k-filter-driver" onchange="kanban.applyFilters()">
                <option value="">Todos los repartidores</option>
                <option value="__none__">Sin asignar</option>
                <%
                    const driversSeen = new Set();
                    KANBAN_COLS.forEach(col => {
                        (columns[col.id] || []).forEach(s => {
                            if (s.deliveryUser && !driversSeen.has(s.deliveryUser.id)) {
                                driversSeen.add(s.deliveryUser.id);
                %>
                                <option value="<%= s.deliveryUser.id %>"><%= s.deliveryUser.fullName %></option>
                <%
                            }
                        });
                    });
                %>
            </select>
            <span class="k-filter-hint">
                <span class="material-symbols-outlined">drag_indicator</span>
                Arrastrá las tarjetas para cambiar el estado
            </span>
            <span class="k-filter-count" id="k-filter-count"></span>
        </div>

        <!-- ── Board ───────────────────────────────────────────── -->
        <div class="kanban-board-wrap">
            <div class="kanban-board" id="kanban-board">

                <% KANBAN_COLS.forEach(col => { %>
                    <% const colShips = columns[col.id] || []; %>

                    <div class="k-col col-sid-<%= col.id %>" data-col-sid="<%= col.id %>">

                        <div class="col-head">
                            <div class="col-icon">
                                <span class="material-symbols-outlined"><%= col.icon %></span>
                            </div>
                            <span class="col-name"><%= col.name %></span>
                            <span class="col-badge" id="k-cnt-<%= col.id %>"><%= colShips.length %></span>
                        </div>

                        <div class="col-body" id="k-body-<%= col.id %>">

                            <% colShips.slice(0, 50).forEach(s => { %>
                                <%
                                    const btns     = CARD_BTNS[s.statusId] || [];
                                    const drvName  = s.deliveryUser ? s.deliveryUser.fullName : '';
                                    const drvId    = s.deliveryUserId ? String(s.deliveryUserId) : '';
                                    const provName = (s.address && s.address.province) ? s.address.province.name : '';
                                %>
                                <div class="k-card"
                                     draggable="true"
                                     data-id="<%= s.id %>"
                                     data-sid="<%= s.statusId %>"
                                     data-trk="<%= s.trackingId %>"
                                     data-rec="<%= s.recipient.fullName.toLowerCase() %>"
                                     data-rec-full="<%= s.recipient.fullName %>"
                                     data-prov="<%= provName %>"
                                     data-drv-id="<%= drvId %>"
                                     data-drv-name="<%= drvName.toLowerCase() %>">

                                    <div class="card-track"><%= s.trackingId %></div>
                                    <div class="card-recip"><%= s.recipient.fullName %></div>

                                    <% if (provName) { %>
                                    <div class="card-meta">
                                        <span class="material-symbols-outlined">location_on</span><%= provName %>
                                    </div>
                                    <% } %>

                                    <% if (drvName) { %>
                                    <div class="card-driver">
                                        <span class="material-symbols-outlined">directions_bike</span><%= drvName %>
                                    </div>
                                    <% } else { %>
                                    <div class="card-driver card-driver--none">
                                        <span class="material-symbols-outlined">person_off</span>Sin asignar
                                    </div>
                                    <% } %>

                                    <div class="card-sep"></div>

                                    <div class="card-actions">
                                        <a href="/shipment/detail/<%= s.id %>?from=/shipment/kanban&fromLabel=Kanban"
                                           class="c-btn c-btn-detail">
                                            <span class="material-symbols-outlined">info</span>Ver detalle
                                        </a>
                                        <% if (btns.includes('cancel')) { %>
                                        <button class="c-btn c-btn-cancel"
                                                data-action="cancel"
                                                data-sid="<%= s.id %>">
                                            <span class="material-symbols-outlined">cancel</span>Cancelar
                                        </button>
                                        <% } %>
                                        <% if (btns.includes('failed')) { %>
                                        <button class="c-btn c-btn-failed"
                                                data-action="failed"
                                                data-sid="<%= s.id %>">
                                            <span class="material-symbols-outlined">broken_image</span>Fallido
                                        </button>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>

                            <% if (colShips.length === 0) { %>
                            <div class="col-empty" id="k-empty-<%= col.id %>">
                                <span class="material-symbols-outlined">inbox</span>
                                <span>Sin envíos</span>
                            </div>
                            <% } else { %>
                            <div class="col-empty" id="k-empty-<%= col.id %>" style="display:none">
                                <span class="material-symbols-outlined">inbox</span>
                                <span>Sin envíos</span>
                            </div>
                            <% } %>

                            <% if (colShips.length > 50) { %>
                            <div class="col-more">
                                <a href="/shipment/search?statusIds=<%= col.id %>">
                                    Ver todos (<%= colShips.length %>) →
                                </a>
                            </div>
                            <% } %>

                        </div><!-- /col-body -->
                    </div><!-- /k-col -->
                <% }); %>

            </div><!-- /kanban-board -->
        </div><!-- /kanban-board-wrap -->

        <!-- ── Modal ───────────────────────────────────────────── -->
        <div class="app-modal-backdrop" id="k-modal-back">
            <div class="app-modal" id="k-modal" onclick="event.stopPropagation()">
                <div class="modal-head-row">
                    <div class="modal-head-icon" id="k-modal-icon">
                        <span class="material-symbols-outlined" id="k-modal-icon-sym">assignment_ind</span>
                    </div>
                    <div>
                        <div class="k-modal-title" id="k-modal-title">—</div>
                        <div class="k-modal-subtitle" id="k-modal-subtitle">—</div>
                    </div>
                </div>
                <div id="k-modal-body"></div>
                <div class="app-modal-actions">
                    <button class="btn-secondary btn-sm" onclick="kanban.closeModal()">Cancelar</button>
                    <button class="btn-primary btn-sm" id="k-modal-confirm" onclick="kanban.confirmModal()">Confirmar</button>
                </div>
            </div>
        </div>

        <!-- ── Datos para JS ────────────────────────────────────── -->
        <script id="k-drivers-data" type="application/json"><%- driversJson %></script>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/kanban.js"></script>
</body>
</html>
