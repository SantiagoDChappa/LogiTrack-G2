<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>2FA — LogiTrack</title>
    <style>
        .tfa-wrapper {
            max-width: 560px;
            margin: 0 auto;
            padding: var(--space-6) var(--space-4);
        }
        .tfa-status {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            font-weight: var(--font-weight-semibold);
            margin: 0 0 var(--space-4);
        }
        .tfa-note {
            color: var(--color-text-secondary);
            font-size: var(--font-size-sm);
        }
        .tfa-field {
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
            margin: var(--space-3) 0;
        }
        .tfa-field label {
            font-size: var(--font-size-sm);
            font-weight: var(--font-weight-semibold);
            color: var(--color-text-secondary);
        }
        .tfa-field input {
            padding: 0.55rem 0.75rem;
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            background: var(--color-surface);
            color: var(--color-text);
            font-size: var(--font-size-sm);
            font-family: inherit;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .tfa-field input:focus {
            outline: none;
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px var(--color-primary-light);
        }
        .tfa-alert {
            padding: 0.55rem 0.75rem;
            border-radius: var(--radius-md);
            font-size: var(--font-size-sm);
            margin-bottom: var(--space-4);
            background: var(--color-info-bg);
            color: var(--color-info);
        }
        .tfa-alert--error {
            background: var(--color-danger-bg);
            color: var(--color-danger);
            margin: var(--space-3) 0;
        }
        .tfa-sep {
            border: none;
            border-top: 1px solid var(--color-border);
            margin: var(--space-4) 0;
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="tfa-wrapper">
            <div class="page-header"><h1>Verificación en dos pasos (2FA)</h1></div>

            <div class="card">
                <% if (ok === 'disabled') { %>
                    <div class="tfa-alert" role="status">El 2FA fue desactivado.</div>
                <% } %>

                <p class="tfa-status">
                    Estado:
                    <% if (enabled) { %>
                        <span class="badge badge--success">Activado</span>
                    <% } else { %>
                        <span class="badge badge--neutral">Desactivado</span>
                    <% } %>
                </p>

                <% if (enabled) { %>
                    <p class="tfa-note">Te quedan <strong><%= remaining %></strong> códigos de respaldo de un solo uso.</p>

                    <form method="POST" action="/account/2fa/backup/regenerate" style="margin:var(--space-3) 0">
                        <button type="submit" class="btn btn-secondary">
                            <span class="material-symbols-outlined">autorenew</span>
                            Regenerar códigos de respaldo
                        </button>
                    </form>

                    <hr class="tfa-sep">

                    <form method="POST" action="/account/2fa/disable">
                        <div class="tfa-field">
                            <label for="password">Para desactivar el 2FA, confirmá tu contraseña</label>
                            <input id="password" type="password" name="password" autocomplete="current-password" required>
                        </div>
                        <% if (locals.error) { %>
                            <div class="tfa-alert--error tfa-alert" role="alert"><%= error %></div>
                        <% } %>
                        <button type="submit" class="action-btn action-btn--lg eliminar" data-tooltip="Desactivar 2FA" aria-label="Desactivar 2FA">
                            <span class="material-symbols-outlined">gpp_bad</span>
                        </button>
                    </form>
                <% } else { %>
                    <p class="tfa-note">Sumá una capa extra de seguridad: además de tu contraseña, pediremos un código temporal de tu teléfono al iniciar sesión.</p>
                    <a href="/account/2fa/setup" class="action-btn action-btn--lg guardar" data-tooltip="Activar 2FA" aria-label="Activar 2FA" style="margin-top:var(--space-2)">
                        <span class="material-symbols-outlined">verified_user</span>
                    </a>
                <% } %>
            </div>
        </div>
    </main>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
