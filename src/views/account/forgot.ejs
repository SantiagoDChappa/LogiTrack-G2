<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/login.css">
    <title>Recuperar contraseña — LogiTrack</title>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-brand">
                <img src="/images/logo.png" alt="LogiTrack" class="login-logo">
                <h1>LogiTrack</h1>
                <p>Recuperar contraseña</p>
            </div>

            <% if (sent) { %>
                <div class="login-error" style="background:rgba(22,163,74,.12);color:#166534;border-color:#86efac">
                    <span class="material-symbols-outlined">mark_email_read</span>
                    Si el email está registrado, te enviamos un enlace para restablecer la contraseña.
                    Revisá tu casilla (y la carpeta de spam). El enlace vence en 60 minutos.
                </div>
                <% if (locals.devLink) { %>
                    <p style="font-size:.8rem;color:var(--color-text-secondary);margin-top:.75rem;word-break:break-all">
                        [modo desarrollo] Enlace: <a href="<%= devLink %>"><%= devLink %></a>
                    </p>
                <% } %>
                <div class="login-support"><a href="/login">Volver a iniciar sesión</a></div>
            <% } else { %>
                <p style="font-size:.88rem;color:var(--color-text-secondary);margin-bottom:1rem">
                    Ingresá tu email y te enviaremos un enlace para definir una nueva contraseña.
                </p>
                <form class="login-form" action="/account/password/forgot" method="post">
                    <div class="login-field">
                        <label for="email">Correo electrónico</label>
                        <input id="email" type="email" name="email" placeholder="usuario@logitrack.com" autocomplete="email" required>
                    </div>
                    <% if (locals.error) { %>
                    <div class="login-error"><span class="material-symbols-outlined">error</span><%= error %></div>
                    <% } %>
                    <button type="submit" class="login-btn">Enviar enlace</button>
                </form>
                <div class="login-support"><a href="/login">Volver a iniciar sesión</a></div>
            <% } %>
        </div>
    </div>
    <script src="/js/theme.js" defer></script>
</body>
</html>
