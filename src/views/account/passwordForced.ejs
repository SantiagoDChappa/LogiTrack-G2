<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/login.css">
    <title>Cambiar contraseña — <%= nombreEmpresa %></title>
</head>
<body>
    <button id="btn-theme" class="login-theme-btn" aria-label="Cambiar tema">
        <span class="material-symbols-outlined" id="theme-icon">light_mode</span>
        <span id="theme-label">Modo claro</span>
    </button>

    <div class="login-wrapper">
        <div class="login-card">
            <div class="login-brand">
                <img src="<%= typeof logoEmpresa !== 'undefined' ? logoEmpresa : '/images/logo.png' %>" alt="<%= nombreEmpresa %>" class="login-logo">
                <h1><%= nombreEmpresa %></h1>
                <p>Primer ingreso — definí tu contraseña</p>
            </div>

            <p style="font-size:.88rem;color:var(--color-text-secondary);margin-bottom:1rem">
                Estás usando una contraseña temporal. Por seguridad, ingresá tu contraseña actual
                (la temporal que te pasaron) y definí una nueva.
            </p>

            <form class="login-form" action="/account/password/forced" method="post">
                <div class="login-field">
                    <label for="currentPassword">Contraseña actual (temporal)</label>
                    <input id="currentPassword" type="password" name="currentPassword" autocomplete="current-password" data-pw-toggle required>
                </div>
                <div class="login-field">
                    <label for="newPassword">Nueva contraseña</label>
                    <input id="newPassword" type="password" name="newPassword" autocomplete="new-password" data-pw-toggle data-pw-strength required>
                </div>
                <div class="login-field">
                    <label for="confirmPassword">Repetir nueva contraseña</label>
                    <input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" data-pw-toggle required>
                </div>

                <% if (locals.error) { %>
                <div class="login-error">
                    <span class="material-symbols-outlined">error</span>
                    <%= error %>
                </div>
                <% } %>

                <button type="submit" class="login-btn">Guardar y continuar</button>
            </form>

            <div class="login-support"><a href="/logout">Cerrar sesión</a></div>
        </div>
    </div>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/password-ui.js" defer></script>
</body>
</html>
