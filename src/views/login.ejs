<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/login.css">
    <title>LogiTrack — Iniciar sesión</title>
</head>
<body>

    <!-- Toggle modo oscuro/claro -->
    <button id="btn-theme" class="login-theme-btn" aria-label="Cambiar tema">
        <span class="material-symbols-outlined" id="theme-icon">light_mode</span>
        <span id="theme-label">Modo claro</span>
    </button>

    <div class="login-wrapper">
        <div class="login-card">

            <!-- Logo -->
            <div class="login-brand">
                <img src="/images/logo.png" alt="LogiTrack" class="login-logo">
                <h1>LogiTrack</h1>
                <p>Sistema de gestión de envíos</p>
            </div>

            <!-- Acceso rápido DEV -->
            <div style="margin-bottom:1rem">
                <label style="display:block;font-size:.78rem;font-weight:600;color:var(--color-text-secondary);margin-bottom:4px">
                    <span class="material-symbols-outlined" style="font-size:13px;vertical-align:middle">science</span>
                    Cuenta de prueba
                </label>
                <select id="dev-accounts" style="width:100%;padding:8px 10px;border:1px solid var(--color-border);border-radius:8px;background:var(--color-surface);color:var(--color-text);font-size:.85rem;font-family:inherit;cursor:pointer">
                    <option value="">— Seleccioná una cuenta —</option>
                    <optgroup label="Supervisor">
                        <option value="juan@logitrack.com.ar">Juan</option>
                        <option value="bruno@logitrack.com.ar">Bruno Merlo</option>
                        <option value="super@logitrack.com">Supervisor Test</option>
                        <option value="supervisor@logitrack.com.ar">Supervisor Logitrack</option>
                        <option value="supervisor2@logitrack.com.ar">Supervisor 2</option>
                        <option value="supervisor.rosario@logitrack.com.ar">Supervisor Rosario Centro</option>
                        <option value="opt01.supervisor@logitrack.com.ar">Supervisor BA OPT-01</option>
                        <option value="opt02.supervisor@logitrack.com.ar">Supervisor Córdoba OPT-02</option>
                        <option value="opt03.supervisor@logitrack.com.ar">Supervisor Santa Fe OPT-03</option>
                        <option value="opt04.supervisor@logitrack.com.ar">Supervisor Mendoza OPT-04</option>
                        <option value="opt05.supervisor@logitrack.com.ar">Supervisor Tucumán OPT-05</option>
                    </optgroup>
                    <optgroup label="Operador">
                        <option value="juanoperador@logitrack.com.ar">Juan OP</option>
                        <option value="oper@logitrack.com">Operador Test</option>
                        <option value="operador@logitrack.com.ar">Operador Logitrack</option>
                        <option value="operador2@logitrack.com.ar">Operador 2</option>
                        <option value="xavisimons@gmail.com">Xavier Hernandez</option>
                        <option value="coriglianoprueba@gmail.com">Luca Prueba</option>
                    </optgroup>
                    <optgroup label="Repartidor">
                        <option value="amin@logitrack.com.ar">Amin</option>
                        <option value="repart@logitrack.com">Repartidor Test</option>
                        <option value="repartidor@logitrack.com.ar">Repartidor Logitrack</option>
                        <option value="repartidor2@logitrack.com.ar">Repartidor 2</option>
                        <option value="coriglianoluc@gmail.com">Luca Kori</option>
                        <option value="opt01.driver@logitrack.com.ar">Driver OPT-01</option>
                        <option value="opt02.driver@logitrack.com.ar">Driver OPT-02</option>
                        <option value="opt03.driver1@logitrack.com.ar">Driver OPT-03A</option>
                        <option value="opt03.driver2@logitrack.com.ar">Driver OPT-03B</option>
                        <option value="opt04.driver1@logitrack.com.ar">Driver OPT-04A</option>
                        <option value="opt04.driver2@logitrack.com.ar">Driver OPT-04B</option>
                        <option value="opt04.driver3@logitrack.com.ar">Driver OPT-04C</option>
                        <option value="opt05.driver1@logitrack.com.ar">Driver OPT-05A</option>
                        <option value="opt05.driver2@logitrack.com.ar">Driver OPT-05B</option>
                    </optgroup>
                    <optgroup label="Admin">
                        <option value="admin@logitrack.com.ar">Admin Logitrack</option>
                        <option value="admin@logitrack.com">Admin Test</option>
                    </optgroup>
                </select>
            </div>

            <!-- Formulario -->
            <form class="login-form" action="/login" method="post">
                <% if (locals.returnTo) { %>
                <input type="hidden" name="returnTo" value="<%= returnTo %>">
                <% } %>

                <div class="login-field">
                    <label for="user-email">Correo electrónico</label>
                    <input
                        id="user-email"
                        type="email"
                        name="email"
                        placeholder="usuario@logitrack.com"
                        autocomplete="email"
                        required
                    >
                </div>

                <div class="login-field">
                    <label for="password">Contraseña</label>
                    <input
                        id="password"
                        type="password"
                        name="password"
                        placeholder="••••••••"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <% if (locals.error) { %>
                <div class="login-error">
                    <span class="material-symbols-outlined">error</span>
                    <%= error %>
                </div>
                <% } %>

                <div class="login-options">
                    <label class="login-remember">
                        <input type="checkbox" name="remember">
                        <span>Recordar sesión</span>
                    </label>
                    <a href="#" class="login-forgot">¿Olvidaste tu contraseña?</a>
                </div>

                <input type="hidden" name="returnTo" value="<%= locals.returnTo || '' %>">
                <button type="submit" class="login-btn">Ingresar</button>

            </form>

            <!-- Soporte -->
            <div class="login-support">
                <a href="/support">Solicitar acceso a Soporte Técnico</a>
            </div>

        </div>
    </div>

    <a href="/" class="login-back-btn">
        <span class="material-symbols-outlined">arrow_back</span>
        VOLVER
    </a>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script>
    document.getElementById('dev-accounts').addEventListener('change', function () {
        if (!this.value) return;
        document.getElementById('user-email').value = this.value;
        document.getElementById('password').value = 'Test1234!';
    });
    </script>
</body>
</html>
