<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/settings.css">
    <title>Ojo de Patrón - LogiTrack</title>
    <style>
        .settings-content {
            padding: var(--space-6) clamp(1.25rem, 2.5vw, 2rem);
            display: flex;
            flex-direction: column;
            gap: var(--space-6);
        }
        .settings-category {
            display: flex; align-items: center; gap: .75rem;
            margin: .25rem 0 .5rem; padding-bottom: .6rem;
            border-bottom: 2px solid var(--color-border);
        }
        .settings-category > .material-symbols-outlined {
            font-size: 1.6rem; color: var(--color-primary);
            background: var(--color-primary-light); border-radius: var(--radius-md);
            padding: .35rem; flex-shrink: 0;
        }
        .settings-category h3 { margin: 0; font-size: var(--font-size-lg); }
        .settings-category p  { margin: .1rem 0 0; font-size: var(--font-size-sm); color: var(--color-text-secondary); }
        .cfg-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: var(--space-4) var(--space-5);
            align-items: start;
        }
        .cfg-grid .span-full { grid-column: 1 / -1; }
        .cfg-switch {
            display: flex; align-items: center; gap: .6rem;
            padding: .65rem .85rem;
            border: 1px solid var(--color-border);
            border-radius: var(--radius-sm);
            background: var(--color-surface-alt);
            cursor: pointer;
        }
        .cfg-switch input[type=checkbox] { width: 18px; height: 18px; cursor: pointer; }
        .cfg-switch .cfg-switch-label { font-weight: var(--font-weight-semibold); }
        .cfg-switch small { display: block; color: var(--color-text-secondary); font-weight: 400; }
        .cfg-help { display: block; color: var(--color-text-secondary); font-size: var(--font-size-xs); line-height: 1.35; margin-top: .2rem; }
    </style>
</head>

<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Ojo de Patrón</h1>
        </div>

        <div class="settings-content">
            <section class="settings-category">
                <span class="material-symbols-outlined">monitor_heart</span>
                <div>
                    <h3>Control de fatiga</h3>
                    <p>Valores globales por defecto. Ley 25.326: la retención controla el borrado automático de datos.</p>
                </div>
            </section>

            <% if (saved) { %>
                <div class="settings-card" style="border-left:4px solid #16a34a;color:#16a34a">Configuración guardada.</div>
            <% } %>
            <% if (errors && errors.length) { %>
                <div class="settings-card" style="border-left:4px solid #dc2626;color:#dc2626"><%= errors.join(' · ') %></div>
            <% } %>

            <form method="POST" action="/fatigue/config">
                <!-- Card: Control general -->
                <div class="settings-card">
                    <h2 class="settings-card-title">
                        <span class="material-symbols-outlined">tune</span>
                        Control general
                    </h2>
                    <p class="settings-subtitle">Activación del control de fatiga y umbral de bloqueo.</p>
                    <div class="cfg-grid">
                        <label class="cfg-switch">
                            <input type="checkbox" name="enabled" <%= cfg.enabled ? 'checked' : '' %>>
                            <span class="cfg-switch-label">Control de fatiga activo</span>
                        </label>
                        <label class="cfg-switch">
                            <input type="checkbox" name="autoBlock" <%= cfg.autoBlock ? 'checked' : '' %>>
                            <span class="cfg-switch-label">Bloqueo automático</span>
                        </label>
                        <div class="field">
                            <label for="thresholdPct">Umbral de fatiga (%)</label>
                            <input type="number" id="thresholdPct" name="thresholdPct" min="0" max="100" value="<%= cfg.thresholdPct %>">
                            <small class="cfg-help">Si la fatiga calculada supera este %, se bloquea (0–100).</small>
                        </div>
                    </div>
                </div>

                <!-- Card: Métodos de prueba -->
                <div class="settings-card">
                    <h2 class="settings-card-title">
                        <span class="material-symbols-outlined">psychology</span>
                        Métodos de prueba
                    </h2>
                    <p class="settings-subtitle">Qué prueba se usa al iniciar la ruta y en los re-chequeos.</p>
                    <div class="cfg-grid">
                        <div class="field">
                            <label for="method">Métodos habilitados</label>
                            <select id="method" name="method">
                                <% ['VOZ','REACCION','AMBOS'].forEach(o => { %><option value="<%= o %>" <%= cfg.method===o?'selected':'' %>><%= o %></option><% }) %>
                            </select>
                        </div>
                        <div class="field">
                            <label for="methodStart">Método al iniciar</label>
                            <select id="methodStart" name="methodStart">
                                <% ['VOZ','REACCION','AMBOS'].forEach(o => { %><option value="<%= o %>" <%= cfg.methodStart===o?'selected':'' %>><%= o==='AMBOS'?'Ambos (el conductor elige)':o %></option><% }) %>
                            </select>
                        </div>
                        <div class="field">
                            <label for="methodRecheck">Método en re-chequeo</label>
                            <select id="methodRecheck" name="methodRecheck">
                                <% ['VOZ','REACCION','AMBOS'].forEach(o => { %><option value="<%= o %>" <%= cfg.methodRecheck===o?'selected':'' %>><%= o==='AMBOS'?'Ambos (el conductor elige)':o %></option><% }) %>
                            </select>
                        </div>
                        <div class="field">
                            <label for="testDurationSec">Duración de la prueba (seg)</label>
                            <input type="number" id="testDurationSec" name="testDurationSec" min="1" max="60" value="<%= cfg.testDurationSec %>">
                            <small class="cfg-help">Solo para la prueba de voz: segundos que escucha el micrófono.</small>
                        </div>
                        <div class="field">
                            <label for="voiceMaxAttempts">Intentos de voz</label>
                            <input type="number" id="voiceMaxAttempts" name="voiceMaxAttempts" min="1" max="10" value="<%= cfg.voiceMaxAttempts %>"
                                   title="Cuántas veces puede intentar leer la frase antes de quedar bloqueado.">
                            <small class="cfg-help">Si no logra leer la frase en esta cantidad de intentos, queda <b>no apto</b>. Ej.: 3.</small>
                        </div>
                        <div class="field span-full">
                            <label class="cfg-switch">
                                <input type="checkbox" name="voiceAcousticEnabled" <%= cfg.voiceAcousticEnabled ? 'checked' : '' %>>
                                <span class="cfg-switch-label">Análisis acústico de fatiga vocal
                                    <small>Mide la fatiga por la voz (velocidad, pausas, tono), no solo si leíste la frase. Requiere STT activo (graba el audio). Se evalúa en el navegador; el audio no se guarda.</small>
                                </span>
                            </label>
                        </div>
                        <div class="field">
                            <label for="reactionAttempts">Intentos de reacción</label>
                            <input type="number" id="reactionAttempts" name="reactionAttempts" min="1" max="10" value="<%= cfg.reactionAttempts %>"
                                   title="Cantidad de toques del test de reacción.">
                            <small class="cfg-help">Cantidad de toques que hace el conductor. Ej.: 3.</small>
                        </div>
                        <div class="field">
                            <label for="reactionFastMs">Reacción óptima (ms)</label>
                            <input type="number" id="reactionFastMs" name="reactionFastMs" min="50" max="2000" value="<%= cfg.reactionFastMs %>"
                                   title="Tiempo de reacción muy rápido = fatiga 0.">
                            <small class="cfg-help">Reacción muy rápida = sin fatiga. Ej.: 250 ms.</small>
                        </div>
                        <div class="field">
                            <label for="reactionSlowMs">Límite de reacción (ms)</label>
                            <input type="number" id="reactionSlowMs" name="reactionSlowMs" min="100" max="5000" value="<%= cfg.reactionSlowMs %>"
                                   title="Tiempo de reacción tan lento que cuenta como no apto / fatiga máxima.">
                            <small class="cfg-help">El “límite”: una reacción más lenta que esto cuenta como mala. Ej.: 800 ms.</small>
                        </div>
                        <div class="field">
                            <label for="reactionEvalMode">Cómo se evalúa la reacción</label>
                            <select id="reactionEvalMode" name="reactionEvalMode">
                                <option value="PROMEDIO" <%= cfg.reactionEvalMode==='PROMEDIO'?'selected':'' %>>Por promedio (promedio de los intentos ≤ límite)</option>
                                <option value="APROBADOS" <%= cfg.reactionEvalMode==='APROBADOS'?'selected':'' %>>Por aprobados (cuántos intentos pasan el límite)</option>
                            </select>
                            <small class="cfg-help">PROMEDIO: suma de ms ÷ intentos ≤ límite. APROBADOS: cuenta cuántos intentos quedaron bajo el límite.</small>
                        </div>
                        <div class="field">
                            <label for="reactionRequired">Aprobados requeridos (si “por aprobados”)</label>
                            <select id="reactionRequired" name="reactionRequired">
                                <option value="UNO" <%= cfg.reactionRequired==='UNO'?'selected':'' %>>Al menos uno</option>
                                <option value="MITAD" <%= cfg.reactionRequired==='MITAD'?'selected':'' %>>Al menos la mitad</option>
                                <option value="TODOS" <%= cfg.reactionRequired==='TODOS'?'selected':'' %>>Todos</option>
                            </select>
                            <small class="cfg-help">Solo aplica si elegiste “por aprobados”. Cuántos intentos deben quedar bajo el límite para ser apto.</small>
                        </div>
                    </div>
                </div>

                <!-- Card: Re-chequeo en ruta -->
                <div class="settings-card">
                    <h2 class="settings-card-title">
                        <span class="material-symbols-outlined">schedule</span>
                        Re-chequeo en ruta
                    </h2>
                    <p class="settings-subtitle">Disparadores de re-chequeo durante el viaje. Se pide una nueva prueba cuando se cumplen <b>las dos primeras condiciones a la vez</b>.</p>
                    <div class="cfg-grid">
                        <div class="field">
                            <label for="recheckDriveMin">Conducción para re-chequeo (min)</label>
                            <input type="number" id="recheckDriveMin" name="recheckDriveMin" min="1" max="1440" value="<%= cfg.recheckDriveMin %>"
                                   title="Minutos que el conductor debe haber manejado antes de que el sistema pueda pedir una nueva prueba.">
                            <small class="cfg-help">Tiempo de manejo acumulado antes de habilitar un re-chequeo. Ej.: 90 = recién tras 1h30 de viaje.</small>
                        </div>
                        <div class="field">
                            <label for="recheckStoppedMin">Detención que dispara re-chequeo (min)</label>
                            <input type="number" id="recheckStoppedMin" name="recheckStoppedMin" min="1" max="240" value="<%= cfg.recheckStoppedMin %>"
                                   title="Ya cumplido el manejo mínimo, minutos detenido que disparan la nueva prueba.">
                            <small class="cfg-help">Cumplido lo anterior, minutos detenido (botón “Estoy detenido”) que disparan la prueba. Ej.: 3 = a los 3 min parado.</small>
                        </div>
                        <div class="field">
                            <label for="recheckRestMin">Descanso para reintentar prueba en ruta (min)</label>
                            <input type="number" id="recheckRestMin" name="recheckRestMin" min="1" max="720" value="<%= cfg.recheckRestMin %>"
                                   title="Si la prueba en ruta da fatiga, la ruta se pausa y el conductor debe descansar este tiempo antes de reintentar.">
                            <small class="cfg-help">Si la prueba da fatiga, la ruta se pausa y el conductor descansa este tiempo antes de reintentar. Ej.: 30.</small>
                        </div>
                        <div class="field">
                            <label for="recheckOmitMin">Aviso al supervisor si omite el re-chequeo (min)</label>
                            <input type="number" id="recheckOmitMin" name="recheckOmitMin" min="1" max="240" value="<%= cfg.recheckOmitMin %>"
                                   title="Si el conductor no completa la prueba pedida, pasado este tiempo se avisa al supervisor y se crea un registro en Ojo de Patrón.">
                            <small class="cfg-help">Minutos sin completar la prueba pedida antes de avisar al supervisor y registrar el caso. Ej.: 10.</small>
                        </div>
                    </div>
                </div>

                <!-- Card: Patrón y retención -->
                <div class="settings-card">
                    <h2 class="settings-card-title">
                        <span class="material-symbols-outlined">policy</span>
                        Patrón y retención (Ley 25.326)
                    </h2>
                    <p class="settings-subtitle">Detección de patrones recurrentes y borrado automático de datos sensibles.</p>
                    <div class="cfg-grid">
                        <div class="field">
                            <label for="patternWindowDays">Ventana de patrón (días)</label>
                            <input type="number" id="patternWindowDays" name="patternWindowDays" min="1" max="365" value="<%= cfg.patternWindowDays %>">
                        </div>
                        <div class="field">
                            <label for="patternEventCount">Eventos para marcar patrón</label>
                            <input type="number" id="patternEventCount" name="patternEventCount" min="1" max="50" value="<%= cfg.patternEventCount %>">
                        </div>
                        <div class="field">
                            <label for="retentionDays">Retención de datos (días)</label>
                            <input type="number" id="retentionDays" name="retentionDays" min="1" max="3650" value="<%= cfg.retentionDays %>">
                            <small class="cfg-help">Borrado automático de los datos de fatiga pasado este plazo (Ley 25.326).</small>
                        </div>
                        <div class="field">
                            <label for="consentVersion">Versión de consentimiento</label>
                            <input type="text" id="consentVersion" name="consentVersion" value="<%= cfg.consentVersion %>">
                        </div>
                    </div>
                </div>

                <div class="settings-actions">
                    <a href="/fatigue" class="action-btn action-btn--lg" data-tooltip="Volver al panel" aria-label="Volver al panel">
                        <span class="material-symbols-outlined">arrow_back</span>
                    </a>
                    <button type="submit" class="action-btn action-btn--lg guardar" data-tooltip="Guardar configuración" aria-label="Guardar configuración">
                        <span class="material-symbols-outlined">save</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>

</html>
