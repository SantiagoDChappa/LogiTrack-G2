<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/settings.css">
    <title>Control de fatiga - LogiTrack</title>
    <style>
        .fb-card { border-left: 5px solid var(--color-border); }
        .fb-card.blocked { border-left-color: #dc2626; }
        .fb-meta { color: var(--color-text-secondary); font-size: var(--font-size-sm); margin: 0; }
        .fb-actions { margin-top: var(--space-3); display: flex; gap: var(--space-2); flex-wrap: wrap; align-items: center; }
        .fb-section-title { margin: var(--space-6) 0 var(--space-3); font-size: var(--font-size-lg); }
        .fb-empty { color: var(--color-text-secondary); }
        .fb-select {
            padding: .4rem .6rem; border: 1.5px solid var(--color-border);
            border-radius: var(--radius-sm); background: var(--color-surface);
            color: var(--color-text); font-size: var(--font-size-sm);
        }
        .btn-sm { padding: .35rem .75rem; font-size: var(--font-size-sm); }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>👁 Ojo de Patrón — Control de fatiga</h1>
            <% if (isAdmin) { %>
                <a href="/fatigue/config" class="btn-secondary">
                    <span class="material-symbols-outlined">tune</span>Configuración
                </a>
            <% } %>
        </div>

        <div class="settings-content">
            <p class="fb-meta">
                Umbral actual: <b><%= cfg.thresholdPct %>%</b> ·
                Bloqueo automático: <b><%= cfg.autoBlock ? 'sí' : 'no' %></b>
            </p>

            <!-- Rutas bloqueadas -->
            <section>
                <h2 class="fb-section-title">Rutas bloqueadas por fatiga</h2>
                <% if (!blocked.length) { %>
                    <p class="fb-empty">No hay rutas bloqueadas por fatiga.</p>
                <% } %>
                <% blocked.forEach(b => { %>
                    <div class="update-card fb-card blocked" id="check-<%= b.id %>" style="margin-bottom:var(--space-3)">
                        <b>Ruta #<%= b.routeId %></b> — transportista #<%= b.userId %> ·
                        score <b><%= b.score %></b>/<%= b.threshold %> · <%= b.method || '—' %> ·
                        <span class="fb-meta"><%= new Date(b.createdAt).toLocaleString('es-AR') %></span>
                        <div class="fb-actions">
                            <button class="btn-primary btn-sm" onclick="release(<%= b.id %>)">Liberar con motivo</button>
                            <button class="btn-secondary btn-sm" onclick="keep(<%= b.id %>)">Mantener bloqueada</button>
                            <% if (!isAdmin) { %>
                                <select id="tx-<%= b.routeId %>" class="fb-select">
                                    <option value="">Reasignar a…</option>
                                    <% transports.forEach(t => { %>
                                        <option value="<%= t.id %>"><%= t.name %><%= t.driverName ? ' — ' + t.driverName : '' %></option>
                                    <% }) %>
                                </select>
                                <button class="btn-secondary btn-sm" onclick="reassign(<%= b.routeId %>)">Reasignar ruta</button>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </section>

            <!-- Transportistas inhabilitados (solo supervisor) -->
            <% if (!isAdmin) { %>
            <section>
                <h2 class="fb-section-title">Transportistas inhabilitados</h2>
                <% if (!disabledDrivers || !disabledDrivers.length) { %>
                    <p class="fb-empty">No hay transportistas inhabilitados.</p>
                <% } %>
                <% (disabledDrivers || []).forEach(d => { %>
                    <div class="update-card fb-card blocked" id="drv-<%= d.userId %>" style="margin-bottom:var(--space-3)">
                        <b>Transportista #<%= d.userId %></b> · motivo: <%= d.reason || '—' %> ·
                        <span class="fb-meta">desde <%= d.disabledAt ? new Date(d.disabledAt).toLocaleString('es-AR') : '—' %></span>
                        <div class="fb-actions">
                            <button class="btn-primary btn-sm" onclick="restoreDriver(<%= d.userId %>, 'consent')">Restablecer consentimiento</button>
                            <button class="btn-secondary btn-sm" onclick="restoreDriver(<%= d.userId %>, 'test')">Restablecer prueba</button>
                        </div>
                    </div>
                <% }) %>
            </section>
            <% } %>

            <!-- Patrón recurrente -->
            <section>
                <h2 class="fb-section-title">Patrón de fatiga recurrente</h2>
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Transportista</th>
                                <th>Bloqueos (ventana <%= cfg.patternWindowDays %>d)</th>
                                <th>Total histórico</th>
                                <th>Patrón</th>
                                <th>Revisión</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!patterns.length) { %>
                                <tr><td colspan="5" class="fb-empty">Sin eventos registrados.</td></tr>
                            <% } %>
                            <% patterns.forEach(p => { %>
                                <tr id="pat-<%= p.userId %>">
                                    <td>#<%= p.userId %></td>
                                    <td><%= p.windowCount %> / <%= p.threshold %></td>
                                    <td><%= p.totalBlocked %></td>
                                    <td>
                                        <span class="status-badge status-badge--sm <%= p.recurrent ? 'cancelado' : 'entregado' %>">
                                            <%= p.recurrent ? '⚠ Recurrente' : 'Normal' %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (p.recurrent && !isAdmin && (p.reviewStatus === 'PENDING' || p.reviewStatus === 'NONE')) { %>
                                            <button class="btn-secondary btn-sm" onclick="reviewPattern(<%= p.userId %>, 'REVIEWED')">Revisado</button>
                                            <button class="btn-secondary btn-sm" onclick="reviewPattern(<%= p.userId %>, 'DISCARDED')">Descartar</button>
                                        <% } else if (p.reviewStatus && p.reviewStatus !== 'NONE') { %>
                                            <%= p.reviewStatus === 'REVIEWED' ? '✔ Revisado' : (p.reviewStatus === 'DISCARDED' ? 'Descartado' : 'Pendiente') %>
                                        <% } else { %>
                                            —
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script>
async function release(id) {
    const opt = prompt('Motivo de liberación:\n1) Falso positivo (la ruta queda apta, sin nueva prueba)\n2) Autorizado con descanso (debe rehacer la prueba)\n3) Otro (descripción obligatoria)\n\nEscribí 1, 2 o 3:');
    const map = { '1': 'falso_positivo', '2': 'autorizado_descanso', '3': 'otro' };
    const reason = map[(opt || '').trim()];
    if (!reason) { return; }
    let detail = '';
    if (reason === 'otro') {
        detail = prompt('Descripción (mínimo 10 caracteres):') || '';
        if (detail.trim().length < 10) { alert('La descripción debe tener al menos 10 caracteres.'); return; }
    }
    const r = await fetch('/fatigue/' + id + '/release', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason, detail }) });
    const data = await r.json().catch(() => ({}));
    if (r.ok) { document.getElementById('check-' + id)?.remove(); } else { alert(data.error || 'No se pudo liberar.'); }
}
async function keep(id) {
    await fetch('/fatigue/' + id + '/keep', { method: 'POST' });
    alert('La ruta sigue bloqueada.');
}
async function reassign(routeId) {
    const sel = document.getElementById('tx-' + routeId);
    const transportId = sel && sel.value;
    if (!transportId) { alert('Elegí un transporte para reasignar.'); return; }
    const r = await fetch('/fatigue/reassign', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ routeId, transportId }),
    });
    const data = await r.json().catch(() => ({}));
    if (r.ok) { alert('Ruta reasignada. El nuevo conductor deberá rehacer consentimiento y prueba.'); location.reload(); }
    else { alert(data.error || 'No se pudo reasignar.'); }
}
async function restoreDriver(userId, kind) {
    const r = await fetch('/fatigue/driver/restore', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId, kind }),
    });
    const data = await r.json().catch(() => ({}));
    if (r.ok) { document.getElementById('drv-' + userId)?.remove(); } else { alert(data.error || 'No se pudo restablecer.'); }
}
async function reviewPattern(userId, status) {
    let note = '';
    if (status === 'DISCARDED') { note = prompt('Motivo de descarte (opcional):') || ''; }
    const r = await fetch('/fatigue/pattern/review', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId, status, note }),
    });
    const data = await r.json().catch(() => ({}));
    if (r.ok) { location.reload(); } else { alert(data.error || 'No se pudo registrar la revisión.'); }
}
    </script>
</body>
</html>
