<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Prueba de Entrega</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 30px;
            background: #f5f5f5;
        }

        .container {
            max-width: 500px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
        }

        h1 {
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
        }

        input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button {
            padding: 10px 20px;
            border: none;
            background: #1f6feb;
            color: white;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background: #1558b0;
        }
    </style>
</head>
<body>

<div class="container">

    <h1>Prueba de Entrega</h1>

    <form method="POST" action="/delivery/evidence/<%= shipmentId %>">

        <div class="form-group">
            <label>Nombre</label>

            <input
                type="text"
                name="receiverName"
                required
            >
        </div>

        <div class="form-group">
            <label>Apellido</label>

            <input
                type="text"
                name="receiverLastname"
                required
            >
        </div>

        <div class="form-group">
            <label>DNI</label>

            <input
                type="text"
                name="receiverDni"
                required
            >
        </div>

        <input type="hidden" name="latitude" id="latitude">
        <input type="hidden" name="longitude" id="longitude">
        <div class="form-group" id="gps-status">
            📍 Obteniendo ubicación...
        </div>

        <div class="form-group">
            <label>Foto del paquete</label>
            <input type="file" name="photoFile" id="photoFile" accept="image/*" capture="environment" style="display:none;">
            <button type="button" onclick="document.getElementById('photoFile').click()">📷 Sacar foto del paquete</button>
            <canvas id="photoCanvas" style="display:none;"></canvas>
            <img id="photoPreview" style="display:none; width:100%; border-radius:5px; margin-top:10px;">
            <input type="hidden" name="photoBase64" id="photoBase64">
        </div>

        <button type="submit">
            Guardar evidencia
        </button>

    </form>

</div>

<script>
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            (position) => {
                document.getElementById('latitude').value = position.coords.latitude;
                document.getElementById('longitude').value = position.coords.longitude;
                document.getElementById('gps-status').innerHTML = '📍 Ubicación obtenida';
                document.getElementById('gps-status').style.color = 'green';
            },
            () => {
                document.getElementById('gps-status').innerHTML = '⚠️ No se pudo obtener ubicación';
                document.getElementById('gps-status').style.color = 'orange';
            }
        );
    } else {
        document.getElementById('gps-status').innerHTML = '⚠️ GPS no disponible';
    }

    document.getElementById('photoFile').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(event) {
        const img = document.getElementById('photoPreview');
        img.src = event.target.result;
        img.style.display = 'block';
        document.getElementById('photoBase64').value = event.target.result;
    };
    reader.readAsDataURL(file);
});
</script>

</body>
</html>