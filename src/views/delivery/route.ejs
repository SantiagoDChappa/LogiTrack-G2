                try {
                    const geo = await getGeo();
                    const res = await fetch(`/delivery/route/${routeId}/incident`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ...form, ...geo }),
                    });
                    if (!res.ok) {
                        const err = await res.json().catch(() => ({}));
                        Swal.showValidationMessage(err.error || 'No se pudo reportar el incidente.');
                        return false;
                    }
                    return await res.json();
                } catch (e) {
                    Swal.showValidationMessage('Sin conexión. Probá de nuevo.');
                    return false;
                }
            },
        });
        if (!form) return;
        const n = Array.isArray(form.affected) ? form.affected.length : 0;
        const text = n > 0
            ? `Marcamos como demorados ${n} envío${n === 1 ? '' : 's'} pendientes y avisamos a los destinatarios. Se abrió una incidencia por cada uno.`
            : 'Quedó registrado.';
        await Swal.fire({ icon: 'success', title: 'Incidente en ruta registrado', text, confirmButtonColor: '#2563eb' });
        // Recarga suave para que las paradas afectadas se vean con el nuevo look "demorado".
        if (n > 0) { location.reload(); }
    });

    // === Pánico ===
    document.getElementById('btn-panic')?.addEventListener('click', async () => {
        const c = await Swal.fire({
            icon: 'warning', title: '¿Activar pánico?',
            text: 'Se enviará tu ubicación al despachante de inmediato.',
            showCancelButton: true, confirmButtonText: 'Sí, enviar SOS',
            confirmButtonColor: '#dc2626',
        });
        if (!c.isConfirmed) return;
