<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Mi Ruta - LogiTrack</title>
    <meta name="theme-color" content="#2563eb">
    <script src="/js/fatigue-reaction-scorer.js" defer></script>
    <%# BUG-33 — quitado fatigue-driver.js: wrapper global de fetch redundante con el gate
        inline de esta página; reabría la prueba ante cualquier 409 de /start (doble gate). %>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
    :root {
        --lt-bg:        #f0f2f5;
        --lt-surface:   #ffffff;
        --lt-blue:      #2563eb;
        --lt-blue-dark: #1a3566;
        --lt-blue-soft: #3b82f6;
        --lt-amber:     #f59e0b;
        --lt-green:     #16a34a;
        --lt-red:       #dc2626;
        --lt-purple:    #7c3aed;
        --lt-text:      #0f172a;
        --lt-text-strong: #1a3566;
        --lt-muted:     #64748b;
        --lt-border:    rgba(15, 23, 42, .08);
        --glass-bg:     rgba(255, 255, 255, .72);
        --glass-brdr:   rgba(255, 255, 255, .55);
        --row-bg:       rgba(255,255,255,.65);
        --row-bg-cur:   rgba(255,255,255,.95);
        --row-bg-locked:rgba(241,245,249,.5);
        --row-bg-skip:  rgba(254, 243, 199, .35);
        --shadow-md:    0 2px 8px rgba(15, 23, 42, .06);
        --shadow-sheet: 0 -8px 28px rgba(15, 23, 42, .08);
        --tile-filter:  saturate(.85) brightness(1.02);
        --lock-chip-bg: rgba(15,23,42,.04);
    }
    html[data-theme="dark"] {
        --lt-bg:        #0b1220;
        --lt-surface:   #111827;
        --lt-blue:      #60a5fa;
        --lt-blue-dark: #cbd5e1;
        --lt-blue-soft: #93c5fd;
        --lt-text:      #e2e8f0;
        --lt-text-strong: #f1f5f9;
        --lt-muted:     #94a3b8;
        --lt-border:    rgba(148, 163, 184, .18);
        --glass-bg:     rgba(17, 24, 39, .72);
        --glass-brdr:   rgba(148, 163, 184, .15);
        --row-bg:       rgba(30, 41, 59, .55);
        --row-bg-cur:   rgba(30, 41, 59, .92);
        --row-bg-locked:rgba(15, 23, 42, .55);
        --row-bg-skip:  rgba(120, 53, 15, .25);
        --shadow-md:    0 6px 24px rgba(0,0,0,.45), 0 1px 2px rgba(0,0,0,.3);
        --shadow-sheet: 0 -12px 40px rgba(0,0,0,.55), 0 -2px 6px rgba(0,0,0,.3);
        --tile-filter:  invert(1) hue-rotate(180deg) saturate(.6) brightness(.9);
        --lock-chip-bg: rgba(148,163,184,.12);
    }

    html, body { height: 100%; }
    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: var(--lt-bg);
        color: var(--lt-text);
        overflow: hidden;
        -webkit-font-smoothing: antialiased;
        letter-spacing: -0.01em;
    }
    .main-content { height: calc(100vh - 56px); display: flex; flex-direction: column; padding: 0; position: relative; }

    /* === Top bar === */
    .route-toolbar {
        position: absolute; top: 12px; left: 12px; right: 12px; z-index: 700;
        padding: .75rem 1rem;
        background: var(--glass-bg);
        backdrop-filter: blur(18px) saturate(180%);
        -webkit-backdrop-filter: blur(18px) saturate(180%);
        border: 1px solid var(--glass-brdr);
        border-radius: 18px;
        box-shadow: var(--shadow-md);
        display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    }
    .route-toolbar h1 {
        font-size: .95rem; margin: 0; font-weight: 700;
        color: var(--lt-text-strong); letter-spacing: -0.02em;
    }
    .route-toolbar .meta {
        font-size: .72rem; color: var(--lt-muted);
        font-weight: 500; margin-top: 2px;
    }
    .progress-wrap { flex: 1; min-width: 140px; max-width: 320px; }
    .progress-bar {
        width: 100%; height: 6px;
        background: rgba(15,23,42,.06); border-radius: 999px; overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--lt-blue) 0%, var(--lt-blue-soft) 100%);
        transition: width .5s cubic-bezier(.22,1,.36,1);
        border-radius: 999px;
    }
    .progress-label {
        font-size: .68rem; color: var(--lt-muted);
        margin-top: 4px; font-weight: 500;
        text-transform: uppercase; letter-spacing: .04em;
    }
    .live-metrics {
        display: flex; gap: 14px; flex-wrap: wrap;
        font-size: .7rem; color: var(--lt-muted);
        margin-top: 6px;
    }
    .live-metrics b { color: var(--lt-text-strong); font-weight: 700; }

    /* === Map === */
    .route-map-wrap { flex: 1; position: relative; background: var(--lt-bg); }
    #map { width: 100%; height: 100%; }
    .leaflet-tile-pane { filter: var(--tile-filter); }
    .leaflet-control-attribution { background: var(--glass-bg) !important; color: var(--lt-muted) !important; }
    .leaflet-control-attribution a { color: var(--lt-blue) !important; }
    .leaflet-control-zoom a {
        background: var(--glass-bg) !important;
        color: var(--lt-text) !important;
        border-color: var(--lt-border) !important;
    }

    .map-actions {
        position: absolute; left: 16px; z-index: 600;
        display: flex; flex-direction: column; gap: 8px;
    }
    /* Top-left floating: back + menú — esquina superior izquierda, mínimo intrusivo */
    .map-topleft {
        position: fixed; left: 10px; top: 10px; z-index: 1200;
        display: flex; gap: 6px;
        pointer-events: auto;
    }
    /* Cuando el drawer del menú está abierto, debe estar encima de todo */
    .left-header.open    { z-index: 9999 !important; }
    .nav-overlay.open    { z-index: 9998 !important; }
    body.nav-open .map-topleft,
    body.nav-open .map-actions,
    body.nav-open .route-toolbar,
    body.nav-open .bottom-sheet,
    body.nav-open .pause-banner { z-index: 1 !important; }
    .btn-back, .btn-menu { width: 38px; height: 38px; }
    .btn-back .material-symbols-outlined, .btn-menu .material-symbols-outlined { font-size: 20px; }
    .btn-back, .btn-menu {
        background: var(--glass-bg);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-brdr);
        border-radius: 50%; width: 44px; height: 44px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; box-shadow: var(--shadow-md);
        color: var(--lt-text-strong);
        text-decoration: none !important;
        transition: transform .15s ease;
        font-family: inherit;
    }
    .btn-back:hover, .btn-menu:hover { transform: scale(1.05); }
    .btn-back .material-symbols-outlined, .btn-menu .material-symbols-outlined { font-size: 22px; }

    .btn-recenter, .btn-gmaps, .btn-pause, .btn-incident, .btn-panic, .btn-voice, .btn-voice-wake {
        background: var(--glass-bg);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-brdr);
        border-radius: 50%; width: 48px; height: 48px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; box-shadow: var(--shadow-md);
        color: var(--lt-blue); transition: transform .15s ease;
        font-family: inherit;
    }
    .btn-recenter:hover, .btn-gmaps:hover, .btn-pause:hover, .btn-incident:hover, .btn-panic:hover, .btn-voice:hover, .btn-voice-wake:hover { transform: scale(1.05); }
    .btn-gmaps    { color: var(--lt-green); }
    .btn-pause    { color: var(--lt-amber); }
    .btn-incident { color: var(--lt-purple); }

    /* === Copiloto de voz (CV-01) === */
    .btn-voice { color: var(--lt-blue); position: relative; }
    .btn-voice.listening {
        background: linear-gradient(135deg,#2563eb,#3b82f6); color: #fff;
        border-color: rgba(255,255,255,.3);
        animation: voice-pulse 1.3s infinite;
    }
    .btn-voice.processing { background: linear-gradient(135deg,#7c3aed,#a855f7); color: #fff; }
    .btn-voice.speaking   { background: linear-gradient(135deg,#0ea5e9,#22d3ee); color: #fff; }
    .btn-voice.unavailable { opacity: .55; }
    @keyframes voice-pulse {
        0%,100% { box-shadow: 0 8px 24px rgba(37,99,235,.45); }
        50%     { box-shadow: 0 8px 30px rgba(37,99,235,.85); }
    }
    .btn-voice .material-symbols-outlined { font-size: 22px; }
    /* Modo escucha (palabra clave): apagado = neutro; encendido = verde con latido suave */
    .btn-voice-wake { color: var(--lt-blue); }
    .btn-voice-wake .material-symbols-outlined { font-size: 22px; }
    .btn-voice-wake.active {
        background: linear-gradient(135deg,#16a34a,#22c55e); color: #fff;
        border-color: rgba(255,255,255,.3);
        animation: voice-pulse 1.8s infinite;
    }
    #voice-bubble {
        position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%);
        max-width: min(86vw, 420px); z-index: 10001;
        background: #0e1730; color: #fff; padding: 12px 16px; border-radius: 12px;
        font-family: Inter, system-ui, sans-serif; font-size: .92rem; line-height: 1.35;
        box-shadow: 0 10px 30px rgba(0,0,0,.35); text-align: center;
    }
    #voice-bubble[data-kind="error"] { background: #7f1d1d; }
    #voice-bubble[data-kind="state"] { background: #1e293b; font-weight: 600; }
    /* CV-14: destello al "indicar" una parada encontrada por voz */
    @keyframes voice-flash-kf { 0%,100% { background: transparent; } 30% { background: rgba(37,99,235,.18); } }
    .voice-flash { animation: voice-flash-kf 1.1s ease 2; outline: 2px solid var(--lt-blue); outline-offset: 2px; border-radius: 12px; }
    .btn-panic    {
        background: linear-gradient(135deg,#dc2626,#ef4444); color: #fff;
        border-color: rgba(255,255,255,.3);
        box-shadow: 0 8px 24px rgba(220,38,38,.5);
        animation: panic-pulse 2.4s infinite;
    }
    @keyframes panic-pulse {
        0%,100% { box-shadow: 0 8px 24px rgba(220,38,38,.5); }
        50%     { box-shadow: 0 8px 28px rgba(220,38,38,.85); }
    }
    .btn-recenter .material-symbols-outlined,
    .btn-gmaps .material-symbols-outlined,
    .btn-pause .material-symbols-outlined,
    .btn-incident .material-symbols-outlined,
    .btn-panic .material-symbols-outlined { font-size: 22px; }

    /* === Bottom sheet === */
    .bottom-sheet {
        position: absolute; left: 0; right: 0; bottom: 0; z-index: 650;
        max-height: 62vh;
        background: var(--glass-bg);
        backdrop-filter: blur(24px) saturate(180%);
        -webkit-backdrop-filter: blur(24px) saturate(180%);
        border-top: 1px solid var(--glass-brdr);
        border-radius: 24px 24px 0 0;
        box-shadow: var(--shadow-sheet);
        padding: .25rem 1rem 1.25rem;
        overflow-y: auto;
        transition: transform .35s cubic-bezier(.22,1,.36,1), max-height .35s cubic-bezier(.22,1,.36,1);
    }
    .sheet-grab {
        display: flex; align-items: center; justify-content: center;
        padding: 8px 0 10px; cursor: pointer;
        position: sticky; top: 0; z-index: 5;
        background: linear-gradient(180deg, var(--glass-bg) 60%, transparent 100%);
        margin: -.25rem -1rem 0;
    }
    .sheet-handle {
        width: 44px; height: 5px; border-radius: 999px;
        background: var(--lt-muted); opacity: .4;
        transition: opacity .2s ease, width .2s ease;
    }
    .sheet-grab:hover .sheet-handle { opacity: .7; width: 52px; }
    .sheet-grab { flex-direction: column; gap: 3px; }
    .sheet-hint {
        font-size: 11px; font-weight: 600; color: var(--lt-muted);
        opacity: 0; max-height: 0; overflow: hidden;
        transition: opacity .25s ease, max-height .25s ease;
    }
    .bottom-sheet.is-tucked .sheet-hint { opacity: .8; max-height: 18px; }
    .bottom-sheet.collapsed { max-height: 80px !important; overflow: hidden; }
    .bottom-sheet.collapsed .stops-list, .bottom-sheet.collapsed .section-title { opacity: 0; pointer-events: none; }

    /* === Sections === */
    .section-title {
        font-size: .68rem; font-weight: 700; color: var(--lt-muted);
        text-transform: uppercase; letter-spacing: .12em;
        margin: 14px 0 4px; padding: 0 4px;
    }

    /* === Stop cards === */
    .stops-list { padding: 0; margin: 0; list-style: none; }
    .stop-row {
        background: var(--row-bg);
        border: 1px solid var(--lt-border);
        border-radius: 16px;
        padding: .75rem .9rem;
        margin: .5rem 0;
        position: relative;
        transition: all .3s cubic-bezier(.22,1,.36,1);
    }
    .stop-row.completed {
        opacity: .55; padding: .5rem .9rem;
        background: var(--row-bg);
    }
    .stop-row.completed .stop-meta,
    .stop-row.completed .stop-actions,
    .stop-row.completed .lock-msg { display: none; }
    .stop-row.locked {
        background: var(--row-bg-locked);
        border-style: dashed; opacity: .7;
    }
    .stop-row.locked .stop-actions { display: none; }
    .stop-row.locked .stop-title { color: var(--lt-muted); }
    .stop-row.skipped {
        background: var(--row-bg-skip);
        border: 1px dashed rgba(245, 158, 11, .55);
    }
    .stop-row.is-current {
        background: var(--row-bg-cur);
        border: 1px solid rgba(37, 99, 235, .35);
        box-shadow: 0 2px 10px rgba(37, 99, 235, .12);
        padding: 1.1rem;
    }
    /* Demorado: tinte naranja sobre el fondo actual, NO oculta ni deshabilita acciones.
       Sigue el mismo patrón que .skipped ("Volver") — solo marca visual. */
    .stop-row.is-delayed {
        background: rgba(217, 119, 6, .10);
        border-left: 4px solid #d97706;
    }
    .stop-row.is-delayed.is-current {
        background: rgba(217, 119, 6, .16);
        border-left: 4px solid #d97706;
    }
    .status-badge.status-badge--delayed {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fcd34d;
    }

    .stop-head { display: flex; align-items: center; gap: .65rem; }
    .stop-info-btn {
        flex-shrink: 0;
        width: 34px; height: 34px;
        border-radius: 10px;
        display: inline-flex; align-items: center; justify-content: center;
        background: rgba(37,99,235,.08);
        border: 1px solid rgba(37,99,235,.18);
        color: var(--lt-blue) !important;
        text-decoration: none !important;
        cursor: pointer;
        transition: transform .12s ease, background .15s ease;
    }
    .stop-info-btn:hover { background: rgba(37,99,235,.15); transform: scale(1.05); }
    .stop-info-btn .material-symbols-outlined { font-size: 20px; }
    html[data-theme="dark"] .stop-info-btn { background: rgba(96,165,250,.12); border-color: rgba(96,165,250,.22); color: #93c5fd !important; }
    .stop-bubble {
        display: inline-flex; align-items: center; justify-content: center;
        width: 32px; height: 32px; border-radius: 10px;
        font-weight: 700; font-size: .88rem;
        color: #fff; flex-shrink: 0;
    }
    .stop-bubble.pending  { background: #64748b; }
    .stop-bubble.current  { background: var(--lt-blue); }
    .stop-bubble.delivered{ background: #16a34a; }
    .stop-bubble.failed   { background: #dc2626; }
    .stop-bubble.pickup   { background: #f59e0b; }
    .stop-bubble.locked   { background: #94a3b8; }
    .stop-bubble.skipped  { background: #f59e0b; }

    .stop-title-wrap { flex: 1; min-width: 0; }
    .stop-tracking {
        font-size: .68rem; font-weight: 600; color: var(--lt-muted);
        text-transform: uppercase; letter-spacing: .08em;
        margin-bottom: 1px;
    }
    .stop-title {
        font-weight: 700; font-size: 1rem; color: var(--lt-text-strong);
        line-height: 1.2; letter-spacing: -0.015em;
    }
    .stop-eta {
        font-size: .72rem; font-weight: 600;
        color: var(--lt-blue); margin-top: 2px;
    }

    /* Package badges */
    .pkg-chips { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; }
    .pkg-chip {
        display: inline-flex; align-items: center; gap: 4px;
        font-size: .68rem; font-weight: 700; padding: 3px 8px;
        border-radius: 999px; text-transform: uppercase; letter-spacing: .05em;
    }
    .pkg-chip .material-symbols-outlined { font-size: 14px; }
    .pkg-chip.fragile   { background: rgba(220,38,38,.12);  color: #b91c1c; }
    .pkg-chip.cold      { background: rgba(59,130,246,.14); color: #1d4ed8; }
    .pkg-chip.big       { background: rgba(124,58,237,.13); color: #6d28d9; }
    .pkg-chip.cod       { background: rgba(22,163,74,.13);  color: #166534; }
    .pkg-chip.weight    { background: rgba(100,116,139,.12);color: #475569; }
    html[data-theme="dark"] .pkg-chip.fragile { background: rgba(239,68,68,.2);  color: #fca5a5; }
    html[data-theme="dark"] .pkg-chip.cold    { background: rgba(96,165,250,.2); color: #93c5fd; }
    html[data-theme="dark"] .pkg-chip.big     { background: rgba(167,139,250,.2);color: #c4b5fd; }
    html[data-theme="dark"] .pkg-chip.cod     { background: rgba(74,222,128,.2); color: #86efac; }
    html[data-theme="dark"] .pkg-chip.weight  { background: rgba(148,163,184,.2);color: #cbd5e1; }

    .status-badge {
        display: inline-flex; align-items: center; gap: 4px;
        font-size: .65rem; font-weight: 700;
        padding: 3px 9px; border-radius: 999px;
        text-transform: uppercase; letter-spacing: .06em;
    }
    .status-badge.amber {
        background: #fef3c7;
        color: #92400e;
    }
    html[data-theme="dark"] .status-badge.amber {
        background: linear-gradient(135deg, rgba(251,191,36,.18), rgba(245,158,11,.12));
        color: #fbbf24;
    }
    html[data-theme="dark"] .status-badge.green { background: rgba(22,163,74,.18); color: #4ade80; }
    html[data-theme="dark"] .status-badge.gray  { background: rgba(148,163,184,.15); color: #cbd5e1; }
    .status-badge.amber::before {
        content: ''; width: 6px; height: 6px; border-radius: 50%;
        background: var(--lt-amber);
    }
    .status-badge.green { background: #dcfce7; color: #166534; }
    .status-badge.gray  { background: #f1f5f9; color: #475569; }
    .status-badge.red   { background: rgba(220,38,38,.15); color: #b91c1c; }
    .status-badge.blue  { background: #dbeafe; color: #1e40af; }
    html[data-theme="dark"] .status-badge.red  { background: rgba(239,68,68,.18); color: #fca5a5; }
    html[data-theme="dark"] .status-badge.blue { background: rgba(59,130,246,.2);  color: #93c5fd; }
    @keyframes pulse-dot {
        0%,100% { box-shadow: 0 0 0 2px rgba(245, 158, 11, .25); }
        50%     { box-shadow: 0 0 0 5px rgba(245, 158, 11, .05); }
    }

    .stop-meta {
        margin-top: .65rem;
        font-size: .85rem; color: var(--lt-muted);
        line-height: 1.45;
    }
    .stop-meta .addr {
        font-weight: 600; color: var(--lt-text-strong);
        font-size: .92rem;
        display: flex; align-items: center; gap: 6px;
    }
    .stop-meta .addr .material-symbols-outlined { color: var(--lt-blue); font-size: 18px; }
    .stop-meta .row { display: flex; align-items: center; gap: 6px; margin-top: 4px; }
    .stop-meta .row .material-symbols-outlined { font-size: 16px; color: var(--lt-muted); }
    .stop-meta .dist {
        font-size: .7rem; color: var(--lt-muted); margin-top: 6px;
        font-weight: 500;
    }
    .stop-meta .instructions {
        margin-top: 8px; padding: 8px 10px;
        background: rgba(245, 158, 11, .08);
        border-left: 3px solid var(--lt-amber);
        border-radius: 6px;
        color: var(--lt-text); font-size: .82rem;
    }
    html[data-theme="dark"] .stop-meta .instructions { background: rgba(245,158,11,.12); }

    .stop-actions {
        display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 1rem;
    }
    .btn-ui {
        font-size: .85rem; padding: .6rem 1rem;
        border-radius: 12px; border: 1px solid var(--lt-border);
        background: var(--lt-surface); color: var(--lt-text);
        cursor: pointer; font-weight: 600; font-family: inherit;
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        text-decoration: none !important;
        transition: transform .12s ease, box-shadow .15s ease;
        outline: none;
    }
    .btn-ui,
    .btn-ui:hover,
    .btn-ui:focus,
    .btn-ui:active,
    .btn-ui:visited { text-decoration: none !important; }
    .btn-ui:focus-visible { box-shadow: 0 0 0 3px rgba(37,99,235,.3); }
    .btn-ui:active { transform: scale(.97); }
    .btn-ui .material-symbols-outlined { font-size: 18px; }
    /* color en estados, sobreescribiendo defaults de <a> */
    .btn-cta, .btn-cta:hover, .btn-cta:focus, .btn-cta:visited { color: #fff !important; }
    .btn-pickup-cta, .btn-pickup-cta:hover, .btn-pickup-cta:focus, .btn-pickup-cta:visited { color: #fff !important; }
    .btn-secondary-ui, .btn-secondary-ui:hover, .btn-secondary-ui:focus, .btn-secondary-ui:visited { color: var(--lt-blue) !important; }
    .btn-failed-ui, .btn-failed-ui:hover, .btn-failed-ui:focus, .btn-failed-ui:visited { color: #ef4444 !important; }
    .btn-skip-ui, .btn-skip-ui:hover, .btn-skip-ui:focus, .btn-skip-ui:visited { color: #b45309 !important; }
    html[data-theme="dark"] .btn-skip-ui, html[data-theme="dark"] .btn-skip-ui:hover, html[data-theme="dark"] .btn-skip-ui:focus, html[data-theme="dark"] .btn-skip-ui:visited { color: #fcd34d !important; }
    .btn-cta {
        background: var(--lt-blue);
        color: #fff; border-color: transparent;
        box-shadow: 0 2px 8px rgba(37, 99, 235, .22);
        font-weight: 700;
    }
    .btn-cta:hover { box-shadow: 0 3px 12px rgba(37,99,235,.3); }
    .btn-pickup-cta {
        background: #f59e0b;
        color: #fff; border-color: transparent;
        box-shadow: 0 2px 8px rgba(245, 158, 11, .22);
        font-weight: 700;
    }
    .btn-failed-ui {
        background: var(--lt-surface); color: #ef4444;
        border: 1.5px solid rgba(220, 38, 38, .35);
    }
    html[data-theme="dark"] .btn-failed-ui { background: rgba(239,68,68,.1); }
    .btn-skip-ui {
        background: rgba(245, 158, 11, .1); color: #b45309;
        border: 1.5px solid rgba(245, 158, 11, .3);
    }
    html[data-theme="dark"] .btn-skip-ui { background: rgba(251,191,36,.12); color: #fcd34d; }
    .btn-secondary-ui {
        background: rgba(37,99,235,.08); color: var(--lt-blue);
        border-color: rgba(37,99,235,.18);
    }
    html[data-theme="dark"] .btn-secondary-ui {
        background: rgba(96,165,250,.12); color: var(--lt-blue);
        border-color: rgba(96,165,250,.22);
    }
    .btn-finish-route {
        background: var(--lt-green);
        color: #fff; border: none; font-weight: 700;
        padding: .85rem 1rem; width: 100%; margin-top: 1rem;
        border-radius: 14px; cursor: pointer;
        box-shadow: 0 2px 8px rgba(22,163,74,.22);
        font-family: inherit; font-size: 1rem;
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    }

    .lock-msg {
        margin-top: .55rem; font-size: .78rem;
        color: var(--lt-muted);
        display: flex; align-items: center; gap: 5px;
        background: var(--lock-chip-bg);
        padding: .4rem .65rem; border-radius: 8px;
    }
    .lock-msg .material-symbols-outlined { font-size: 16px; }

    /* Pause banner */
    .pause-banner {
        position: absolute; top: 70px; left: 12px; right: 12px; z-index: 720;
        background: #f59e0b;
        color: #78350f;
        padding: 12px 16px; border-radius: 14px;
        display: flex; align-items: center; gap: 12px;
        font-weight: 700;
        box-shadow: 0 3px 12px rgba(245,158,11,.28);
    }
    .pause-banner .material-symbols-outlined { font-size: 22px; }
    .pause-banner button {
        margin-left: auto; background: #fff; color: #92400e;
        border: none; padding: 8px 14px; border-radius: 10px;
        font-weight: 700; cursor: pointer; font-family: inherit;
    }

    /* Desktop */
    @media (min-width: 769px) {
        .main-content { flex-direction: row; align-items: stretch; }
        .route-toolbar {
            position: absolute; top: 16px; left: auto; right: 16px;
            width: auto; max-width: 460px; z-index: 700;
        }
        .route-map-wrap { flex: 1; order: 2; min-width: 0; }
        .bottom-sheet {
            position: relative; max-height: none; height: 100%;
            width: 440px; flex-shrink: 0; order: 1;
            border-radius: 0; border-top: none;
            border-right: 1px solid var(--lt-border);
            background: var(--glass-bg);
            padding: 1rem 1.25rem 1.5rem;
            box-shadow: 4px 0 24px rgba(15,23,42,.05);
        }
        .sheet-grab { display: none; }
        .bottom-sheet.collapsed { max-height: none !important; }
        .bottom-sheet.collapsed .stops-list { opacity: 1; pointer-events: auto; }
        .map-actions { top: 16px; bottom: auto; left: 16px; right: auto; }
        .map-actions { top: auto; bottom: 24px; }
    }

    /* Mobile - bottom sheet con drag estilo Instagram */
    @media (max-width: 768px) {
        .main-content { height: calc(100vh - 56px); overflow: hidden; }
        .route-toolbar { padding: .55rem .8rem; top: 70px; }
        .route-toolbar h1 { font-size: .85rem; }
        .route-map-wrap { position: absolute; inset: 0; }
        .map-actions { bottom: calc(var(--sheet-visible, 50vh) + 16px); left: 14px; right: auto; transition: bottom .35s cubic-bezier(.22,1,.36,1); }
        .bottom-sheet {
            position: absolute; left: 0; right: 0; bottom: 0;
            height: 90vh; max-height: none;
            padding-bottom: 5rem;
            transform: translateY(var(--sheet-y, 60vh));
            transition: transform .35s cubic-bezier(.22,1,.36,1);
            touch-action: pan-y;
        }
        .bottom-sheet.dragging { transition: none !important; }
        .bottom-sheet .sheet-grab {
            padding: 14px 0 12px; touch-action: none;
        }
        .bottom-sheet .sheet-handle { width: 56px; height: 6px; }
        .bottom-sheet.collapsed { /* clase legada, ya no se usa en mobile */ }
        .stop-row.is-current { padding: 1.15rem; border-radius: 18px; }
        .stop-row.is-current .stop-title { font-size: 1.1rem; }
        .stop-row.is-current .stop-meta { font-size: .95rem; }
        .stop-row.is-current .stop-actions { flex-direction: column; gap: .55rem; }
        .stop-row.is-current .btn-ui { width: 100%; padding: 1rem 1rem; min-height: 54px; font-size: 1rem; border-radius: 14px; }
        .stop-row.is-current .btn-cta, .stop-row.is-current .btn-pickup-cta { font-size: 1.05rem; }
        .stop-row.is-current .secondary-row { display: flex; gap: .55rem; width: 100%; }
        .stop-row.is-current .secondary-row .btn-ui { flex: 1; min-height: 46px; font-size: .9rem; padding: .65rem; }
        .fab-current {
            position: fixed; right: 16px; bottom: 16px; z-index: 800;
            background: var(--lt-blue);
            color: #fff;
            border-radius: 999px; padding: .9rem 1.1rem;
            box-shadow: 0 3px 12px rgba(37,99,235,.3);
            display: flex; align-items: center; gap: .4rem;
            font-weight: 700; font-size: .9rem; border: none;
            cursor: pointer; font-family: inherit;
        }
    }
    @media (min-width: 769px) { .fab-current { display: none; } }

    /* En el detalle (bottom-sheet arriba, mapa tapado) ocultamos los overlays del mapa
       para bajar el ruido: chip de fatiga "Manejo", su countdown y el panel de prueba.
       !important para ganarle al display inline que setean sus propios updaters. */
    body.sheet-detail #fatigue-drive-chip,
    body.sheet-detail #fatigue-next-check,
    body.sheet-detail #fatigue-stop-btn,
    body.sheet-detail .route-toolbar,
    body.sheet-detail #dchat-btn,
    body.sheet-detail #dchat-panel,
    body.sheet-detail #sim-panel { display: none !important; }

    /* Modo prueba abierto: ocultamos la tarjeta de info de la ruta para que el panel no
       se superponga (comparten la esquina superior izquierda). Vuelve al cerrar el panel. */
    body.sim-open .route-toolbar { display: none !important; }

    /* En el ruteo ocultamos la barra superior global: ya hay botones flotantes sobre el
       mapa (volver, menú, tour, ayuda). El drawer (.left-header) sigue abriéndose con el
       botón de menú flotante. */
    .top-header { display: none !important; }
    .main-content { height: 100vh !important; }

    /* Tour e info (page-help) con el mismo estilo glass que volver/menú. */
    .map-topleft .page-help-actions { position: static !important; display: flex; gap: 6px; margin: 0; padding: 0; }
    .map-topleft .page-help-btn {
        background: var(--glass-bg);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-brdr);
        border-radius: 50%; width: 44px; height: 44px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; box-shadow: var(--shadow-md);
        color: var(--lt-text-strong) !important;
        text-decoration: none !important;
        transition: transform .15s ease;
    }
    .map-topleft .page-help-btn:hover { transform: scale(1.05); }
    .map-topleft .page-help-btn .material-symbols-outlined { font-size: 22px; }

    @keyframes pulse {
        0%,100% { box-shadow: 0 0 0 0 rgba(37,99,235,.55);}
        50%     { box-shadow: 0 0 0 14px rgba(37,99,235,0);}
    }

    </style>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">

        <div class="route-map-wrap">
            <div id="map"></div>
            <div class="map-topleft">
                <a class="btn-back" href="/delivery" title="Volver a Mi Ruteo">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <button class="btn-menu" id="btn-route-menu" title="Menú" aria-label="Menú">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <%- include('../partials/page-help-btn', { helpModule: 'entregas-repartidor' }) %>
                <button class="btn-menu" id="btn-sim" title="Modo prueba (simular viaje)" aria-label="Modo prueba">
                    <span class="material-symbols-outlined">science</span>
                </button>
            </div>
            <div class="map-actions">
                <% if (!readOnly) { %>
                    <button class="btn-panic"    id="btn-panic"    title="Pánico: enviar ubicación a despacho" aria-label="Pánico: enviar ubicación a despacho">
                        <span class="material-symbols-outlined">sos</span>
                    </button>
                    <button class="btn-incident" id="btn-incident" title="Reportar incidente en ruta (vehicular, accidente, etc.)" aria-label="Reportar incidente en ruta">
                        <span class="material-symbols-outlined">report</span>
                    </button>
                    <button class="btn-pause"    id="btn-pause"    title="Pausar ruta (almuerzo / combustible)" aria-label="Pausar ruta (almuerzo / combustible)">
                        <span class="material-symbols-outlined">pause_circle</span>
                    </button>
                    <button class="btn-voice"    id="btn-voice"    title="Copiloto de voz: tocá para hablar" aria-label="Copiloto de voz: tocá para hablar" aria-pressed="false">
                        <span class="material-symbols-outlined">mic</span>
                    </button>
                    <button class="btn-voice-wake" id="btn-voice-wake" title="Modo escucha: activá para hablar diciendo &quot;hola copiloto&quot;" aria-label="Modo escucha por palabra clave" aria-pressed="false">
                        <span class="material-symbols-outlined">hearing</span>
                    </button>
                <% } %>
                <button class="btn-gmaps"    id="btn-gmaps"    title="Abrir ruta en Google Maps" aria-label="Abrir ruta en Google Maps">
                    <span class="material-symbols-outlined">map</span>
                </button>
                <button class="btn-recenter" id="btn-recenter" title="Centrar en mi posición" aria-label="Centrar en mi posición">
                    <span class="material-symbols-outlined">my_location</span>
                </button>
                <% if (readOnly) { %>
                    <a class="btn-gmaps" href="/delivery/route/<%= route.id %>/summary" title="Ver resumen" style="color: var(--lt-blue)">
                        <span class="material-symbols-outlined">summarize</span>
                    </a>
                <% } %>
            </div>
        </div>

        <% const activePause = !readOnly && route.statusId === 2 && route.startedAt && (route.pauses || []).find(p => !p.endedAt && p.startedAt); %>
        <% if (activePause) { %>
            <div class="pause-banner" id="pause-banner">
                <span class="material-symbols-outlined">pause_circle</span>
                <div>
                    Ruta en pausa <small id="pause-reason">· <%= activePause.reason %></small>
                    <div style="font-size:.72rem;font-weight:500;opacity:.85" id="pause-elapsed">—</div>
                </div>
                <button id="btn-resume">Reanudar</button>
            </div>
        <% } %>

        <div class="route-toolbar">
            <div style="flex:1;min-width:0">
                <h1>Ruta #<%= route.id %></h1>
                <div class="meta"><%= route.transport.name %> · <%= route.totalDistanceKm %> km · <%= (route.stops || []).length %> paradas</div>
                <div class="live-metrics">
                    <span>Fin del reparto: <b id="m-eta">—</b></span>
                    <span>Km: <b id="m-km">0 / <%= route.totalDistanceKm %></b></span>
                    <span>Prom/parada: <b id="m-avg">—</b></span>
                </div>
            </div>
            <div class="progress-wrap">
                <div class="progress-bar"><div id="progress-fill" class="progress-fill" style="width:0%"></div></div>
                <div class="progress-label"><span id="progress-text">0 / 0</span> completadas</div>
            </div>
        </div>

        <section class="bottom-sheet" id="bottom-sheet">
            <div class="sheet-grab" id="sheet-grab" role="button" aria-label="Mostrar u ocultar lista de envíos">
                <div class="sheet-handle"></div>
                <div class="sheet-hint" id="sheet-hint">Deslizá para ver la entrega</div>
            </div>

            <ol class="stops-list" id="stops-list">
                <% (route.stops || []).forEach((s) => {
                    const isPickup = s.stopType === 'pickup';
                    // Retiro por sucursal: parada de entrega con branchId = dejar el paquete en
                    // la sucursal de retiro (no es entrega a domicilio, no requiere POD).
                    const isBranchDrop = !isPickup && !!s.branchId && !!s.shipment;
                    const recipientPhone = s.shipment && s.shipment.recipient ? s.shipment.recipient.phone : null;
                    const trackingId = s.shipment ? s.shipment.trackingId : null;
                    const sh = s.shipment || {};
                %>
                    <% const shipStatusId = s.shipment ? s.shipment.statusId : null; %>
                    <% const wasFailed = !isPickup && s.completed && shipStatusId === 9; %>
                    <% const isDelayed = !isPickup && s.shipment && s.shipment.delayNotifiedAt && !s.completed && !s.skipped; %>
                    <li class="stop-row <%= s.completed ? 'completed' : '' %> <%= (s.skipped && !s.completed) ? 'skipped' : '' %> <%= isDelayed ? 'is-delayed' : '' %>"
                        data-stop-id="<%= s.id %>"
                        data-stop-seq="<%= s.sequence %>"
                        data-stop-type="<%= s.stopType %>"
                        data-branch-drop="<%= isBranchDrop ? '1' : '0' %>"
                        data-skipped="<%= s.skipped ? '1' : '0' %>"
                        data-est-min="<%= s.estimatedMinutes || 5 %>"
                        data-lat="<%= s.lat %>"
                        data-lng="<%= s.lng %>"
                        data-ship-status="<%= shipStatusId || '' %>">

                        <div class="stop-head">
                            <span class="stop-bubble <%= s.completed ? (isPickup ? 'pickup' : (wasFailed ? 'failed' : 'delivered')) : 'pending' %>"><%= s.sequence %></span>
                            <div class="stop-title-wrap">
                                <% if (isPickup) { %>
                                    <div class="stop-tracking">Pickup</div>
                                    <div class="stop-title"><%= s.branch ? (s.branch.name.startsWith('Sucursal') ? s.branch.name : 'Sucursal ' + s.branch.name) : 'Sucursal' %></div>
                                <% } else { %>
                                    <div class="stop-tracking"><%= trackingId || 'Entrega' %></div>
                                    <div class="stop-title" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                                        <%= isBranchDrop ? 'Dejar en sucursal' : 'Entrega' %>
                                        <span class="status-badge amber js-status-badge">En camino</span>
                                        <% if (isDelayed) { %>
                                            <span class="status-badge status-badge--delayed" title="Marcado como demorado por un incidente en la ruta. Podés seguir entregando normalmente.">
                                                <span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle">schedule</span>
                                                Demorado
                                            </span>
                                        <% } %>
                                    </div>
                                <% } %>
                                <div class="stop-eta js-stop-eta"></div>
                            </div>
                            <% if (!isPickup && s.shipment) { %>
                                <a class="stop-info-btn"
                                   href="/shipment/detail/<%= s.shipment.id %>?from=/delivery/route/<%= route.id %>&fromLabel=Mi%20Ruta"
                                   title="Ver detalle del envío (entrega/motivo/historial)">
                                    <span class="material-symbols-outlined">info</span>
                                </a>
                            <% } %>
                        </div>

                        <% if (!isPickup && (sh.fragile || sh.refrigerated || sh.oversized || sh.weightKg || sh.codAmount)) { %>
                            <div class="pkg-chips">
                                <% if (sh.fragile)      { %><span class="pkg-chip fragile"><span class="material-symbols-outlined">warning</span>Frágil</span><% } %>
                                <% if (sh.refrigerated) { %><span class="pkg-chip cold"><span class="material-symbols-outlined">ac_unit</span>Refrig.</span><% } %>
                                <% if (sh.oversized)    { %><span class="pkg-chip big"><span class="material-symbols-outlined">inventory</span>Voluminoso</span><% } %>
                                <% if (sh.weightKg)     { %><span class="pkg-chip weight"><span class="material-symbols-outlined">scale</span><%= sh.weightKg %> kg<%= sh.packageQty ? ' · ' + sh.packageQty + ' bultos' : '' %></span><% } %>
                                <% if (sh.codAmount)    { %><span class="pkg-chip cod"><span class="material-symbols-outlined">payments</span>$<%= sh.codAmount %> <%= sh.codMethod || '' %></span><% } %>
                            </div>
                        <% } %>

                        <div class="stop-meta">
                            <% if (!isPickup && s.shipment && s.shipment.address) { %>
                                <div class="addr">
                                    <span class="material-symbols-outlined">location_on</span>
                                    <%= s.shipment.address.street %> <%= s.shipment.address.number %>
                                </div>
                                <% if (s.shipment.recipient) { %>
                                    <div class="row"><span class="material-symbols-outlined">person</span><%= s.shipment.recipient.fullName %></div>
                                <% } %>
                                <% if (sh.expectedDeliveryFrom || sh.expectedDeliveryTo) { %>
                                    <div class="row"><span class="material-symbols-outlined">schedule</span>Ventana: <%= sh.expectedDeliveryFrom || '?' %> - <%= sh.expectedDeliveryTo || '?' %></div>
                                <% } %>
                                <% if (sh.specialInstructions) { %>
                                    <div class="instructions">
                                        <span class="material-symbols-outlined" style="font-size:14px;vertical-align:-2px">info</span>
                                        <%= sh.specialInstructions %>
                                    </div>
                                <% } %>
                            <% } else if (s.branch) { %>
                                <div class="addr">
                                    <span class="material-symbols-outlined">store</span>
                                    <%= s.branch.address || 'Punto de retiro' %>
                                </div>
                            <% } %>
                            <div class="dist">+ <%= s.distanceFromPrevKm %> km desde paso anterior</div>
                            <% if (s.skipped && !s.completed) { %>
                                <div class="row" style="color:#b45309;font-weight:600;margin-top:6px">
                                    <span class="material-symbols-outlined">schedule_send</span>Postergada<%= s.skipReason ? ': ' + s.skipReason : '' %>
                                </div>
                            <% } %>
                        </div>

                        <% if (!s.completed && !readOnly) { %>
                            <div class="stop-actions">
                                <% if (isPickup) { %>
                                    <button class="btn-ui btn-pickup-cta" data-action="pickup-confirmed" data-stop-id="<%= s.id %>" style="width:100%">
                                        <span class="material-symbols-outlined">inventory_2</span>Confirmar pickup
                                    </button>
                                <% } else if (isBranchDrop) { %>
                                    <button class="btn-ui btn-pickup-cta" data-action="drop-at-branch" data-stop-id="<%= s.id %>" style="width:100%">
                                        <span class="material-symbols-outlined">store</span>Dejar en sucursal
                                    </button>
                                <% } else { %>
                                    <% if (s.shipment) { %>
                                        <a class="btn-ui btn-cta js-pod-btn"
                                           href="/delivery/evidence/<%= s.shipment.trackingId %>/pod?routeId=<%= route.id %>&stopId=<%= s.id %>"
                                           style="width:100%">
                                            <span class="material-symbols-outlined">photo_camera</span>Confirmar Entrega (POD)
                                        </a>
                                    <% } %>
                                    <div class="secondary-row" style="display:flex;gap:.5rem;width:100%;margin-top:.55rem">
                                        <a class="btn-ui btn-secondary-ui" target="_blank" style="flex:1"
                                           href="https://www.google.com/maps/dir/?api=1&destination=<%= s.lat %>,<%= s.lng %>">
                                            <span class="material-symbols-outlined">navigation</span>Navegar
                                        </a>
                                        <% if (recipientPhone) { %>
                                            <a class="btn-ui btn-secondary-ui" href="tel:<%= recipientPhone %>" style="flex:1">
                                                <span class="material-symbols-outlined">call</span>Llamar
                                            </a>
                                        <% } %>
                                    </div>
                                    <div class="secondary-row" style="display:flex;gap:.5rem;width:100%;margin-top:.55rem">
                                        <% if (s.skipped) { %>
                                            <button class="btn-ui btn-skip-ui" data-action="unskip" data-stop-id="<%= s.id %>" style="flex:1">
                                                <span class="material-symbols-outlined">restart_alt</span>Retomar
                                            </button>
                                        <% } else { %>
                                            <button class="btn-ui btn-skip-ui" data-action="skip" data-stop-id="<%= s.id %>" style="flex:1">
                                                <span class="material-symbols-outlined">schedule_send</span>Volver luego
                                            </button>
                                        <% } %>
                                        <button class="btn-ui btn-failed-ui" data-action="failed" data-stop-id="<%= s.id %>" style="flex:1">
                                            <span class="material-symbols-outlined">close</span>Fallido
                                        </button>
                                    </div>
                                <% } %>
                            </div>
                            <div class="lock-msg" hidden>
                                <span class="material-symbols-outlined">lock</span>
                                <span class="lock-text">Completá el paso anterior</span>
                            </div>
                        <% } %>
                    </li>
                <% }) %>
            </ol>

            <% if (!readOnly) { %>
                <button class="btn-finish-route" id="btn-finish-route" hidden>
                    <span class="material-symbols-outlined">flag</span>Finalizar ruta y ver resumen
                </button>
            <% } else { %>
                <a class="btn-finish-route" href="/delivery/route/<%= route.id %>/summary" style="background: linear-gradient(135deg, #475569, #64748b); text-decoration: none !important;">
                    <span class="material-symbols-outlined">summarize</span>Ver resumen de la ruta
                </a>
            <% } %>
        </section>

        <button class="fab-current" id="fab-current" hidden>
            <span class="material-symbols-outlined fab-icon">arrow_downward</span><span class="fab-label">Paso actual</span>
        </button>

        <%# [prototype] El POD se hace en la página /delivery/evidence/:tracking/pod (online y offline).
            El botón "Confirmar Entrega" navega a esa página; el SW la sirve cacheada sin conexión. %>
    </main>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/voice-copilot.js" defer></script>
    <%# [prototype] Offline del repartidor: globals para el script (cargado desde head.ejs) %>
    <%
        // Copiloto de voz (CV-01): próxima parada pendiente para responder "¿cuál es mi próxima entrega?".
        const _pendNext = (route.stops || [])
            .filter(s => s.stopType === 'delivery' && !s.completed && !s.skipped && s.shipment)
            .sort((a, b) => a.sequence - b.sequence);
        const _altNext = (route.stops || [])
            .filter(s => s.stopType === 'delivery' && !s.completed && s.shipment)
            .sort((a, b) => a.sequence - b.sequence);
        const _ns = _pendNext[0] || _altNext[0] || null;
        const _nsData = _ns ? {
            id:        _ns.id,
            street:    (_ns.shipment.address && _ns.shipment.address.street)  || null,
            number:    (_ns.shipment.address && _ns.shipment.address.number)  || null,
            recipient: (_ns.shipment.recipient && _ns.shipment.recipient.fullName) || null,
            lat:       (_ns.lat != null ? Number(_ns.lat) : null), // para abrir navegación (CV-16)
            lng:       (_ns.lng != null ? Number(_ns.lng) : null),
            phone:     (_ns.shipment.recipient && _ns.shipment.recipient.phone) || null, // para llamar por voz
        } : null;

        // Buscar un envío por voz (CV-14): lista de entregas con destinatario y dirección.
        const _stopsData = (route.stops || [])
            .filter(s => s.stopType === 'delivery' && s.shipment)
            .sort((a, b) => a.sequence - b.sequence)
            .map(s => ({
                id:        s.id,
                seq:       s.sequence,
                completed: !!s.completed,
                skipped:   !!s.skipped,
                recipient: (s.shipment.recipient && s.shipment.recipient.fullName) || null,
                street:    (s.shipment.address && s.shipment.address.street) || null,
                number:    (s.shipment.address && s.shipment.address.number) || null,
                lat:       (s.lat != null ? Number(s.lat) : null),
                lng:       (s.lng != null ? Number(s.lng) : null),
                phone:     (s.shipment.recipient && s.shipment.recipient.phone) || null,
            }));

        // Avance de la ruta (CV-06): conteo sobre las entregas.
        const _deliv = (route.stops || []).filter(s => s.stopType === 'delivery');
        const _completedN = _deliv.filter(s => s.completed).length;
        const _postponedN = _deliv.filter(s => s.skipped && !s.completed).length;
        const _progress = {
            total:     _deliv.length,
            completed: _completedN,
            pending:   _deliv.length - _completedN, // incluye las postergadas (CA4)
            postponed: _postponedN,
        };
    %>
    <script>window.LT_ROUTE_ID = <%= route.id %>; window.LT_ROUTE_ACTIVE = <%= route.statusId === 2 ? 'true' : 'false' %>; window.LT_READONLY = <%= readOnly ? 'true' : 'false' %>; window.LT_NEXT_STOP = <%- jsonScript(_nsData) %>; window.LT_PROGRESS = <%- jsonScript(_progress) %>; window.LT_STOPS = <%- jsonScript(_stopsData) %>;</script>
    <style>
    /* === SweetAlert dark + fixes === */
