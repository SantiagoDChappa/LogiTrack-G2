    .swal2-popup .swal2-select {
        height: 2.625em;
        line-height: 1.4;
    }
    </style>

    <script>
    const routeId = <%= route.id %>;
    const readOnly = <%= readOnly ? 'true' : 'false' %>;

    // === Swal defaults: respeta tema oscuro automáticamente ===
    (function() {
        const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';
        const origFire = Swal.fire.bind(Swal);
        Swal.fire = function(...args) {
            const opts = (args.length === 1 && typeof args[0] === 'object') ? args[0] : null;
            if (opts) {
                if (isDark()) {
                    opts.background = opts.background || '#1e293b';
                    opts.color      = opts.color      || '#f1f5f9';
                }
                return origFire(opts);
            }
            return origFire(...args);
        };
    })();
    const routeStarted = <%= route.startedAt ? 'true' : 'false' %>;
    let activePauseId = <%= activePause ? activePause.id : 'null' %>;
    let activePauseStart = <%- activePause ? jsonScript(activePause.startedAt) : 'null' %>;

    const stops = <%- jsonScript((route.stops || []).map(s => ({
        id: s.id, sequence: s.sequence, stopType: s.stopType,
        shipmentId: s.shipmentId || null,
        lat: Number(s.lat), lng: Number(s.lng),
        completed: s.completed, skipped: s.skipped,
        estimatedMinutes: s.estimatedMinutes || 5,
        distanceFromPrevKm: Number(s.distanceFromPrevKm || 0),
        completedAt: s.completedAt || null,
        label: s.stopType === 'pickup' ? (s.branch ? s.branch.name : 'Pickup') : (s.shipment ? s.shipment.trackingId : 'Entrega'),
        tracking: s.shipment ? s.shipment.trackingId : null,
        recipient: s.shipment && s.shipment.recipient ? s.shipment.recipient.fullName : null,
    }))) %>;
    const totalKm = <%= route.totalDistanceKm || 0 %>;

    const markers = {};
    const map = L.map('map', { zoomControl: false }).setView([stops[0]?.lat || -34.6, stops[0]?.lng || -58.4], 12);
    L.control.zoom({ position: 'bottomright' }).addTo(map);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '© OSM © CARTO', subdomains: 'abcd', maxZoom: 19,
    }).addTo(map);

    function buildIcon(stop, state) {
        const grads = {
            pending:      'linear-gradient(135deg,#94a3b8,#64748b)',
            current:      'linear-gradient(135deg,#2563eb,#3b82f6)',
            delivered:    'linear-gradient(135deg,#16a34a,#22c55e)',
            failed:       'linear-gradient(135deg,#dc2626,#ef4444)',
            'pickup-done':'linear-gradient(135deg,#f59e0b,#fbbf24)',
            locked:       'linear-gradient(135deg,#cbd5e1,#94a3b8)',
            skipped:      'linear-gradient(135deg,#f59e0b,#fbbf24)',
        };
        const grad = grads[state] || grads.pending;
        const pulse = state === 'current' ? 'animation:pulse 1.6s infinite;' : '';
        return L.divIcon({
            html: `<div style="background:${grad};color:#fff;border-radius:10px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.88rem;border:2px solid #fff;box-shadow:0 4px 12px rgba(15,23,42,.25);${pulse}font-family:Inter,sans-serif">${stop.sequence}</div>`,
            className: '', iconSize: [34,34], iconAnchor: [17,17],
        });
    }

    function stateForStop(s) {
        if (s.completed) return s.stopType === 'pickup' ? 'pickup-done' : 'delivered';
        if (s.skipped) return 'skipped';
        return 'pending';
    }

    // Duraciones de manejo (seg) por tramo OSRM entre paradas consecutivas + el orden de
    // ids de parada que corresponde a ese trazado, para calcular la "hora de llegada" real.
    let osrmLegSec = null;
    const osrmStopIds = [];
    const latlngs = [];
    stops.forEach(s => {
        if (!Number.isFinite(s.lat) || !Number.isFinite(s.lng)) return;
        const m = L.marker([s.lat, s.lng], { icon: buildIcon(s, stateForStop(s)) })
            .bindPopup(`#${s.sequence} · ${s.label}`)
            .addTo(map);
        markers[s.id] = m;
        latlngs.push([s.lat, s.lng]);
        osrmStopIds.push(s.id);
    });

    let routeGlow = null, routeLine = null;
    function drawRoute(coords) {
        if (routeGlow) map.removeLayer(routeGlow);
        if (routeLine) map.removeLayer(routeLine);
        routeGlow = L.polyline(coords, { color: '#3b82f6', weight: 14, opacity: 0.18 }).addTo(map);
        routeLine = L.polyline(coords, { color: '#2563eb', weight: 5, opacity: 0.95, lineCap: 'round', lineJoin: 'round' }).addTo(map);
    }
    if (latlngs.length > 1) {
        drawRoute(latlngs);
        map.fitBounds(latlngs, { padding: [40,40] });
        const coordsStr = latlngs.map(([la, ln]) => ln + ',' + la).join(';');
        fetch('https://router.project-osrm.org/route/v1/driving/' + coordsStr + '?overview=full&geometries=geojson')
            .then(r => r.ok ? r.json() : null)
            .then(d => {
                if (!d || !d.routes || !d.routes[0]) return;
                const poly = d.routes[0].geometry.coordinates.map(([ln, la]) => [la, ln]);
                drawRoute(poly);
                map.fitBounds(poly, { padding: [40,40] });
                // Tramos OSRM: leg[i] = manejo de osrmStopIds[i] → osrmStopIds[i+1] (seg).
                if (Array.isArray(d.routes[0].legs) && d.routes[0].legs.length) {
                    osrmLegSec = d.routes[0].legs.map(l => Number(l.duration) || 0);
                    applyStepState(); // recalcular horas de llegada con manejo real
                }
            }).catch(() => {});
    }

    let driverMarker = null, lastPos = null;
    function updateDriverDot(lat, lng) {
        lastPos = [lat, lng];
        if (!driverMarker) {
            const icon = L.divIcon({
                html: `<div style="background:radial-gradient(circle,#3b82f6,#2563eb);width:20px;height:20px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 6px rgba(37,99,235,.25),0 4px 12px rgba(37,99,235,.4);animation:pulse 1.8s infinite"></div>`,
                className: '', iconSize: [20,20], iconAnchor: [10,10],
            });
            driverMarker = L.marker([lat, lng], { icon, zIndexOffset: 1000 }).addTo(map);
        } else {
            driverMarker.setLatLng([lat, lng]);
        }
    }
    document.getElementById('btn-recenter').addEventListener('click', () => {
        if (lastPos) map.setView(lastPos, 15);
    });

    // Google Maps URL
    document.getElementById('btn-gmaps').addEventListener('click', () => {
        const pending = stops.filter(s => Number.isFinite(s.lat) && Number.isFinite(s.lng) && !s.completed);
        const points = pending.length ? pending : stops.filter(s => Number.isFinite(s.lat) && Number.isFinite(s.lng));
        if (points.length === 0) {
            Swal.fire({ icon: 'info', title: 'Sin paradas', text: 'No hay puntos válidos.', confirmButtonColor: '#2563eb' });
            return;
        }
        const origin = lastPos ? `${lastPos[0]},${lastPos[1]}` : `${points[0].lat},${points[0].lng}`;
        const dest = `${points[points.length - 1].lat},${points[points.length - 1].lng}`;
        const middle = points.slice(lastPos ? 0 : 1, -1).map(p => `${p.lat},${p.lng}`);
        const waypoints = middle.slice(0, 9).join('|');
        const params = new URLSearchParams({ api: '1', travelmode: 'driving', origin, destination: dest });
        if (waypoints) params.set('waypoints', waypoints);
        window.open('https://www.google.com/maps/dir/?' + params.toString(), '_blank');
    });

    // === Bottom sheet drag (Instagram-style) ===
    const sheet = document.getElementById('bottom-sheet');
    const grab  = document.getElementById('sheet-grab');
    const isMobile = () => window.innerWidth <= 768;

    // Snap points en px (translateY desde la posición full).
    // tucked = el handle queda flush en el borde inferior (~36px visible) y el mapa ocupa todo
    // el resto. No dejamos hueco entre el sheet y el mapa.
    function snapPoints() {
        const vh = window.innerHeight;
        const tucked = vh - 36;               // sólo handle pegado abajo
        const mid    = Math.round(vh * 0.42); // ~58% visible
        const full   = 0;                     // sheet abierto al máximo (~95% visible)
        return { tucked, mid, full };
    }
    let currentSnap = 'mid';

    function setSheetY(px) {
        sheet.style.setProperty('--sheet-y', px + 'px');
        // exporta cuánto se ve para reposicionar map-actions
        const vh = window.innerHeight;
        const visible = Math.max(0, vh - px);
        sheet.style.setProperty('--sheet-visible', visible + 'px');
        document.documentElement.style.setProperty('--sheet-visible', visible + 'px');
    }

    function snapTo(name) {
        if (!isMobile()) return;
        const pts = snapPoints();
        currentSnap = name;
        setSheetY(pts[name]);
        sheet.classList.toggle('is-tucked', name === 'tucked'); // muestra el hint "Deslizá…"
        // pan:false → el mapa NO se reposiciona al subir/bajar el sheet; queda fijo y la
        // solapa de detalle lo tapa (en vez de que el mapa "se suba").
        setTimeout(() => map.invalidateSize({ pan: false }), 380);
        setSheetContext();
    }

    // Detalle = sheet arriba tapando el mapa (mobile, no 'tucked'). Marca el body para
    // ocultar overlays del mapa y refresca el rótulo del FAB.
    function setSheetContext() {
        const detail = isMobile() && currentSnap !== 'tucked';
        document.body.classList.toggle('sheet-detail', detail);
        if (window.__updateFab) { window.__updateFab(); }
    }

    function nearestSnap(px, velocityPxPerMs) {
        const pts = snapPoints();
        const order = ['full', 'mid', 'tucked'];
        // Swipe hacia abajo
        if (velocityPxPerMs > 0.25) {
            for (const name of order) if (pts[name] > px + 10) return name;
            return 'tucked';
        }
        // Swipe hacia arriba
        if (velocityPxPerMs < -0.25) {
            for (const name of [...order].reverse()) if (pts[name] < px - 10) return name;
            return 'full';
        }
        // Sin velocidad: el más cercano
        let best = order[0], bestDist = Math.abs(px - pts[best]);
        for (const name of order) {
            const d = Math.abs(px - pts[name]);
            if (d < bestDist) { best = name; bestDist = d; }
        }
        return best;
    }

    // Inicializa el sheet plegado en mobile (solo el handle; mapa al máximo).
    // El conductor lo arrastra hacia arriba para ver el envío. Desktop: full.
    function initSheet() {
        if (isMobile()) snapTo('tucked');
        else setSheetY(0);
    }
    initSheet();
    window.addEventListener('resize', initSheet);

    // === Drag handler ===
    if (sheet && grab) {
        let dragging = false;
        let startY = 0, startYpx = 0, lastY = 0, lastT = 0, velocity = 0;

        const onDown = (e) => {
            if (!isMobile()) return;
            // Solo arrastra si el target es el handle, la zona grab o la cima del sheet (no la lista)
            const target = e.target;
            const insideGrab = grab.contains(target);
            const sheetScrollTop = sheet.scrollTop;
            const onTopEdge = !insideGrab && sheetScrollTop === 0 && (e.clientY - sheet.getBoundingClientRect().top < 50);
            if (!insideGrab && !onTopEdge) return;

            dragging = true;
            sheet.classList.add('dragging');
            startY = e.clientY;
            const cur = parseFloat(getComputedStyle(sheet).getPropertyValue('--sheet-y')) || 0;
            startYpx = cur;
            lastY = e.clientY; lastT = performance.now();
            sheet.setPointerCapture?.(e.pointerId);
            e.preventDefault();
        };
        const onMove = (e) => {
            if (!dragging) return;
            const dy = e.clientY - startY;
            let next = startYpx + dy;
            const pts = snapPoints();
            // Permite un pequeño overscroll arriba/abajo con resistencia
            if (next < pts.full - 20)    next = pts.full - 20;
            if (next > pts.tucked + 20)  next = pts.tucked + 20;
            setSheetY(next);
            const now = performance.now();
            velocity = (e.clientY - lastY) / Math.max(1, now - lastT);
            lastY = e.clientY; lastT = now;
        };
        const onUp = (e) => {
            if (!dragging) return;
            dragging = false;
            sheet.classList.remove('dragging');
            const cur = parseFloat(getComputedStyle(sheet).getPropertyValue('--sheet-y')) || 0;
            const target = nearestSnap(cur, velocity);
            snapTo(target);
            try { sheet.releasePointerCapture?.(e.pointerId); } catch (_) {}
        };

        sheet.addEventListener('pointerdown', onDown);
        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
        window.addEventListener('pointercancel', onUp);

        // Click rápido en el handle → cicla snap
        let downTime = 0;
        grab.addEventListener('pointerdown', () => { downTime = performance.now(); });
        grab.addEventListener('pointerup', () => {
            if (performance.now() - downTime < 200) {
                // tap cicla: tucked → mid → full → tucked
                const order = ['tucked', 'mid', 'full'];
                const idx = order.indexOf(currentSnap);
                const next = order[(idx + 1) % order.length];
                snapTo(next);
            }
        });
    }

    // Menú: dispara el hamburger del header. Espera a que ui.js termine de bindear.
    document.getElementById('btn-route-menu')?.addEventListener('click', (ev) => {
        ev.stopPropagation();
        const hb = document.getElementById('btn-hamburger');
        if (hb) { hb.click(); }
        else {
            // Fallback: abre manualmente
            document.querySelector('.left-header')?.classList.add('open');
            document.getElementById('nav-overlay')?.classList.add('open');
        }
    });

    // Botón 🧪 de la barra superior: entra al modo prueba (construye y muestra el panel).
    document.getElementById('btn-sim')?.addEventListener('click', () => {
        if (window.__openSim) { window.__openSim(); }
    });

    // Sincroniza body.nav-open con .left-header.open para z-index correcto
    const leftHdr = document.querySelector('.left-header');
    if (leftHdr) {
        const obs = new MutationObserver(() => {
            document.body.classList.toggle('nav-open', leftHdr.classList.contains('open'));
        });
        obs.observe(leftHdr, { attributes: true, attributeFilter: ['class'] });
    }

    if (navigator.geolocation && !readOnly) {
        navigator.geolocation.watchPosition(
            (pos) => updateDriverDot(pos.coords.latitude, pos.coords.longitude),
            () => {}, { enableHighAccuracy: true, timeout: 8000, maximumAge: 5000 }
        );
        const sendHb = (pos) => {
            // Modo prueba (?sim=1): mientras está activo, el GPS real no pisa la posición
            // simulada (el panel de prueba es la única fuente de heartbeats).
            if (window.__simActive) { return; }
            updateDriverDot(pos.coords.latitude, pos.coords.longitude);
            fetch('/delivery/heartbeat', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    latitude: pos.coords.latitude, longitude: pos.coords.longitude,
                    speedKmh: pos.coords.speed ? pos.coords.speed * 3.6 : null, routeId,
                }),
            }).catch(() => {});
        };
        navigator.geolocation.getCurrentPosition(sendHb, () => {}, { enableHighAccuracy: true, timeout: 5000 });
        setInterval(() => navigator.geolocation.getCurrentPosition(sendHb, () => {}, { enableHighAccuracy: true, timeout: 5000 }), 30000);
    }

    // ===================== Ojo de Patrón — UI del conductor =====================
    // LGT-190 (consentimiento) · LGT-191/198 (prueba) · LGT-199 (re-chequeo en ruta).

    // Overlay de carga: bloquea toda la ruta mientras se resuelve el gate de fatiga.
    function showRouteLoader(msg) {
        let el = document.getElementById('route-fatigue-loader');
        if (!el) {
            el = document.createElement('div');
            el.id = 'route-fatigue-loader';
            el.style.cssText = 'position:fixed;inset:0;z-index:9998;background:rgba(15,23,42,.82);' +
                'display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;' +
                'color:#fff;font-family:system-ui,sans-serif';
            el.innerHTML = '<div style="width:54px;height:54px;border-radius:50%;border:5px solid rgba(255,255,255,.25);' +
                'border-top-color:#fff;animation:rflspin 1s linear infinite"></div>' +
                '<div id="route-fatigue-loader-msg" style="font-size:.95rem;font-weight:600"></div>';
            const st = document.createElement('style');
            st.textContent = '@keyframes rflspin{to{transform:rotate(360deg)}}';
            el.appendChild(st);
            document.body.appendChild(el);
        }
        document.getElementById('route-fatigue-loader-msg').textContent = msg || 'Cargando…';
        el.style.display = 'flex';
    }
    function hideRouteLoader() {
        const el = document.getElementById('route-fatigue-loader');
        if (el) { el.style.display = 'none'; }
    }

    let fatigueCfgCache = null;
    async function getFatigueCfg() {
        if (fatigueCfgCache) { return fatigueCfgCache; }
        try {
            const r = await fetch(`/delivery/route/${routeId}/fatigue/config`);
            fatigueCfgCache = await r.json();
        } catch (_) { fatigueCfgCache = { enabled: false }; }
        return fatigueCfgCache;
    }

    // LGT-190: modal de consentimiento. Devuelve { accepted, checkId } o null si error.
    async function runConsent(cfg) {
        const res = await Swal.fire({
            title: 'Consentimiento — Control de fatiga',
            html: `<div style="text-align:left;font-size:.9rem;line-height:1.5">
                <p>Antes de salir realizaremos una <b>prueba de fatiga</b>.</p>
                <ul style="padding-left:18px">
                  <li><b>Dato:</b> una muestra de voz o tiempos de reacción.</li>
                  <li><b>Finalidad:</b> evaluar tu estado de fatiga para tu seguridad.</li>
                  <li><b>Responsable:</b> LogiTrack. <b>No</b> se guarda el dato biométrico crudo, solo un puntaje.</li>
                  <li><b>Tus derechos (Ley 25.326):</b> acceso, revocación y supresión desde "Mis datos de fatiga".</li>
                </ul>
                <p style="font-size:.8rem;opacity:.7">Versión ${cfg.consentVersion || 'v1'}</p></div>`,
            showCancelButton: true, confirmButtonText: 'Acepto', cancelButtonText: 'No acepto',
            confirmButtonColor: '#16a34a', cancelButtonColor: '#dc2626', allowOutsideClick: false,
        });
        const accepted = res.isConfirmed;
        showRouteLoader(accepted ? 'Preparando prueba…' : 'Registrando rechazo…');
        try {
            const r = await fetch(`/delivery/route/${routeId}/consent`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ accepted }),
            });
            const data = await r.json();
            return {
                accepted, checkId: data.checkId,
                disabled: !!data.disabled, rejections: data.rejections, max: data.max,
            };
        } catch (_) {
            hideRouteLoader();
            Swal.fire({ icon: 'error', title: 'No se pudo registrar', text: 'Reintentá en unos segundos.' });
            return null;
        }
    }

    // LGT-198: prueba de reacción (tap). Devuelve { method:'REACCION', metrics } ,
    // 'BACK' si el conductor elige volver a elegir método (solo modo AMBOS), o null.
    async function pruebaReaccion(cfg, canGoBack = false) {
        const attempts = Math.max(1, Number(cfg && cfg.reactionAttempts) || 3); // intentos configurables
        const limite = (cfg && Number(cfg.reactionSlowMs)) || 800; // ms tope de reacción
        const reactionsMs = [];
        for (let i = 0; i < attempts; i++) {
            // Entre cada paso mostramos la carga a pantalla completa: la ruta no se puede tocar.
            showRouteLoader(i === 0 ? 'Iniciando prueba de reacción…' : `Preparando intento ${i + 1} de ${attempts}…`);
            await new Promise((res) => setTimeout(res, 650));
            const r = await new Promise((resolve) => {
                Swal.fire({
                    title: `Prueba de reacción (${i + 1}/${attempts})`,
                    html: `<div id="rt-box" style="height:160px;border-radius:12px;background:#334155;display:flex;
                            flex-direction:column;gap:4px;align-items:center;justify-content:center;color:#fff;font-weight:700;cursor:pointer">
                            Esperá el verde…</div>
                            <div id="rt-info" style="margin-top:8px;font-size:.8rem;opacity:.85">Tocá apenas se ponga verde. Límite: ${limite} ms.</div>`,
                    showConfirmButton: false, showCancelButton: canGoBack, cancelButtonText: 'Volver a elegir',
                    allowOutsideClick: false, allowEscapeKey: false, didOpen: () => {
                        hideRouteLoader(); // el modal ya cubre la pantalla; ocultamos el loader
                        const box = document.getElementById('rt-box');
                        const info = document.getElementById('rt-info');
                        let shownAt = 0, armed = false, tapped = false;
                        const delay = 800 + Math.random() * 2500;
                        const t = setTimeout(() => {
                            if (!document.body.contains(box)) { return; }
                            box.style.background = '#16a34a'; box.textContent = '¡TOCÁ!';
                            shownAt = performance.now(); armed = true;
                        }, delay);
                        box.addEventListener('click', () => {
                            if (tapped) { return; }
                            if (!armed) { // tocó antes del estímulo → se anula (Esc.2)
                                clearTimeout(t); resolve('early'); Swal.close(); return;
                            }
                            tapped = true;
                            const ms = Math.round(performance.now() - shownAt);
                            reactionsMs.push(ms);
                            const ok = ms <= limite;
                            box.style.background = ok ? '#16a34a' : '#dc2626';
                            box.textContent = `${ms} ms`;
                            info.innerHTML = ok
                                ? `<span style="color:#16a34a;font-weight:700">✓ Dentro del límite</span> (${limite} ms)`
                                : `<span style="color:#dc2626;font-weight:700">✗ Superó el límite</span> de ${limite} ms`;
                            setTimeout(() => { resolve('ok'); Swal.close(); }, 1200);
                        });
                    },
                }).then((sw) => { if (sw.dismiss === Swal.DismissReason.cancel) { resolve('back'); } });
            });
            if (r === 'back') { hideRouteLoader(); return 'BACK'; }
            if (r === 'early') { i--; } // intento anulado, se repite sin penalización
        }
        showRouteLoader('Calculando resultado…'); // bloquea la ruta hasta mostrar el veredicto
        return { method: 'REACCION', metrics: { reactionsMs } };
    }

    // LGT-191: prueba de voz REAL. El conductor lee una frase y se valida con
    // reconocimiento de voz (Web Speech API). La muestra es efímera: solo se
    // envía el % de coincidencia, nunca el audio (Ley 25.326).
    const FRASES_VOZ = [
        'El camión sale de la sucursal a las ocho',
        'Hoy entrego paquetes en la zona norte',
        'Conduzco con cuidado y respeto las señales',
        'La ruta de hoy tiene varias paradas',
        'Reviso los bultos antes de salir de viaje',
    ];
    // El reconocedor puede devolver "8" u "ocho": unificamos a dígito para no
    // fallar por esa variación (uno/1, dos/2, ...).
    const NUM_PALABRA = { cero: '0', uno: '1', una: '1', dos: '2', tres: '3', cuatro: '4', cinco: '5', seis: '6', siete: '7', ocho: '8', nueve: '9', diez: '10' };
    function normalizarTexto(s) {
        return (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
            .replace(/[^a-z0-9\s]/g, '').replace(/\s+/g, ' ').trim()
            .split(' ').map(w => NUM_PALABRA[w] || w).join(' ');
    }
    // Distancia de edición a nivel de palabra (Levenshtein sobre tokens).
    function levenshteinPalabras(a, b) {
        const m = a.length, n = b.length;
        if (!m) { return n; }
        if (!n) { return m; }
        let prev = Array.from({ length: n + 1 }, (_, j) => j);
        for (let i = 1; i <= m; i++) {
            const cur = [i];
            for (let j = 1; j <= n; j++) {
                const cost = a[i - 1] === b[j - 1] ? 0 : 1;
                cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost);
            }
            prev = cur;
        }
        return prev[n];
    }
    // Coincidencia 0..1 sensible al orden y que penaliza palabras de más/faltantes.
    // Frase exacta → 1; frase mal dicha → baja.
    function similitudFrase(dicho, esperado) {
        const a = normalizarTexto(dicho).split(' ').filter(Boolean);
        const b = normalizarTexto(esperado).split(' ').filter(Boolean);
        if (!a.length || !b.length) { return 0; }
        const dist = levenshteinPalabras(a, b);
        return Math.max(0, 1 - dist / Math.max(a.length, b.length));
    }

    // Elige un mimeType de grabación soportado (iOS usa audio/mp4).
    function pickMimeAudio() {
        const cands = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4', 'audio/aac', 'audio/ogg'];
        if (window.MediaRecorder && MediaRecorder.isTypeSupported) {
            for (const c of cands) { if (MediaRecorder.isTypeSupported(c)) { return c; } }
        }
        return '';
    }
    function blobToBase64(blob) {
        return new Promise((resolve, reject) => {
            const fr = new FileReader();
            fr.onload = () => { const s = String(fr.result); resolve(s.slice(s.indexOf(',') + 1)); };
            fr.onerror = reject;
            fr.readAsDataURL(blob);
        });
    }

    // === Análisis ACÚSTICO de fatiga vocal (Web Audio, 100% en el navegador, $0) ===
    // Extrae marcadores reales del waveform: velocidad de habla, pausas, tono (F0) y
    // su variabilidad, dinámica de energía. El audio es efímero: se analiza y se
    // descarta (Ley 25.326); al server solo va el puntaje, nunca el audio.
    async function extraerFeaturesVoz(blob) {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC || !blob || !blob.size) { return null; }
        const ctx = new AC();
        let audio;
        try { audio = await ctx.decodeAudioData(await blob.arrayBuffer()); }
        catch (_) { try { await ctx.close(); } catch (e) {} return null; }
        const data = audio.getChannelData(0);
        const sr = audio.sampleRate;
        try { await ctx.close(); } catch (e) {}
        if (!data || data.length < sr * 0.3) { return null; }

        const frameLen = Math.max(1, Math.round(0.03 * sr)); // 30 ms
        const hop = Math.max(1, Math.round(0.01 * sr));       // 10 ms
        const rms = [];
        for (let i = 0; i + frameLen <= data.length; i += hop) {
            let s = 0;
            for (let j = 0; j < frameLen; j++) { const v = data[i + j]; s += v * v; }
            rms.push(Math.sqrt(s / frameLen));
        }
        if (rms.length < 3) { return null; }
        const maxRms = Math.max.apply(null, rms);
        if (maxRms <= 1e-4) { return null; } // sin audio útil
        const thr = maxRms * 0.18; // umbral voz/silencio
        const voiced = rms.map(r => r > thr);
        const voicedFrames = voiced.filter(Boolean).length;
        const pauseRatio = 1 - voicedFrames / voiced.length;
        let onsets = 0;
        for (let i = 1; i < voiced.length; i++) { if (voiced[i] && !voiced[i - 1]) { onsets++; } }
        const durSec = data.length / sr;
        const speechRate = onsets / Math.max(0.5, durSec); // arranques de voz por seg

        // F0 por autocorrelación en frames con voz (70–350 Hz)
        const minLag = Math.floor(sr / 350), maxLag = Math.floor(sr / 70);
        const f0s = [];
        for (let i = 0; i + frameLen <= data.length; i += hop * 2) {
            if (!voiced[Math.floor(i / hop)]) { continue; }
            let best = 0, bestLag = 0;
            for (let lag = minLag; lag <= maxLag; lag++) {
                let s = 0;
                for (let j = 0; j < frameLen - lag; j++) { s += data[i + j] * data[i + j + lag]; }
                if (s > best) { best = s; bestLag = lag; }
            }
            if (bestLag) { f0s.push(sr / bestLag); }
        }
        const mean = (arr) => arr.reduce((a, b) => a + b, 0) / arr.length;
        const f0mean = f0s.length ? mean(f0s) : 0;
        const f0std = f0s.length ? Math.sqrt(mean(f0s.map(x => (x - f0mean) * (x - f0mean)))) : 0;
        const f0cv = f0mean ? f0std / f0mean : 0;
        const rmsMean = mean(rms);
        const rmsStd = Math.sqrt(mean(rms.map(x => (x - rmsMean) * (x - rmsMean))));
        const energyCv = rmsMean ? rmsStd / rmsMean : 0;

        return {
            durSec: +durSec.toFixed(2), speechRate: +speechRate.toFixed(2),
            pauseRatio: +pauseRatio.toFixed(2), f0mean: Math.round(f0mean),
            f0cv: +f0cv.toFixed(3), energyCv: +energyCv.toFixed(3), voicedFrames,
        };
    }

    // Mapa de features → fatiga 0..100 (heurística sobre marcadores reales, calibrable).
    // Más fatiga: habla lenta, muchas pausas, tono monótono, poca dinámica de energía.
    function scoreAcusticoVoz(f) {
        if (!f) { return null; }
        const c01 = (x) => Math.max(0, Math.min(1, x));
        const lento   = c01((2.6 - f.speechRate) / 2.2);
        const pausas  = c01((f.pauseRatio - 0.40) / 0.40);
        const monoton = c01((0.12 - f.f0cv) / 0.12);
        const planoEn = c01((0.55 - f.energyCv) / 0.55);
        const fatiga = 0.35 * lento + 0.30 * pausas + 0.20 * monoton + 0.15 * planoEn;
        return Math.round(fatiga * 100);
    }

    // Prueba de voz SERVER-SIDE (iOS/compatibilidad): graba con MediaRecorder, sube
    // el audio en base64 y el server lo transcribe (STT) y compara con la frase.
    // El audio es efímero (Ley 25.326): no se guarda. Devuelve métricas, 'BACK' o null.
    async function pruebaVozSTT(cfg, canGoBack, vozLog) {
        if (!navigator.mediaDevices || !window.MediaRecorder) {
            vozLog('stt-sin-mediarecorder', {});
            await Swal.fire({ icon: 'warning', title: 'Grabación no disponible',
                text: 'Tu dispositivo no permite grabar audio. Usá el test de reacción.' });
            return canGoBack ? 'BACK' : null;
        }
        const frase = FRASES_VOZ[Math.floor(Math.random() * FRASES_VOZ.length)];
        const MIN_MATCH = 0.95;
        const secs = cfg.testDurationSec || 5;

        function grabar() {
            return new Promise((resolve) => {
                let resolved = false;
                const done = (v) => { if (!resolved) { resolved = true; resolve(v); } };
                Swal.fire({
                    title: 'Prueba de voz',
                    html: `<div style="font-size:.85rem;margin-bottom:8px">Tocá el botón y leé en voz alta, claro y completo:</div>
                           <div style="font-weight:700;font-size:1.05rem;margin:8px 0;padding:10px 12px;border-radius:8px;background:rgba(37,99,235,.12);color:inherit">“${frase}”</div>
                           <button id="vz-go" style="padding:12px 16px;border:0;border-radius:12px;background:#2563eb;color:#fff;font-weight:700">🎤 Empezar prueba</button>
                           <div id="vz-tip" style="margin-top:10px;font-size:.85rem;opacity:.85"></div>`,
                    showConfirmButton: false, showCancelButton: canGoBack, cancelButtonText: 'Volver a elegir',
                    allowOutsideClick: false, allowEscapeKey: false,
                    didOpen: () => {
                        const go = document.getElementById('vz-go');
                        const tip = document.getElementById('vz-tip');
                        go.addEventListener('click', async () => {
                            go.disabled = true;
                            let stream;
                            try { stream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
                            catch (e) { vozLog('stt-denied', { e: String(e && e.name) }); done({ denied: true }); return; }
                            const mime = pickMimeAudio();
                            let rec;
                            try { rec = mime ? new MediaRecorder(stream, { mimeType: mime }) : new MediaRecorder(stream); }
                            catch (_) { rec = new MediaRecorder(stream); }
                            const chunks = [];
                            rec.ondataavailable = (ev) => { if (ev.data && ev.data.size) { chunks.push(ev.data); } };
                            rec.onstop = () => {
                                stream.getTracks().forEach(t => t.stop());
                                const blob = new Blob(chunks, { type: rec.mimeType || mime || 'audio/webm' });
                                vozLog('stt-grabado', { bytes: blob.size, mime: blob.type });
                                done({ blob });
                            };
                            let left = secs;
                            const paint = () => { tip.innerHTML = `<span style="color:#dc2626;font-weight:700">🔴 Micrófono activado</span> — leé ahora (${Math.max(0, left)}s)`; };
                            paint();
                            const iv = setInterval(() => { left--; paint(); }, 1000);
                            vozLog('stt-rec-start', { mime: mime || '(default)', secs });
                            try { rec.start(); } catch (e) { clearInterval(iv); vozLog('stt-no-inicia', { msg: String(e && e.message) }); done({ error: true }); return; }
                            setTimeout(() => { clearInterval(iv); try { rec.stop(); } catch (_) {} }, secs * 1000);
                        });
                    },
                }).then((sw) => { if (sw.dismiss === Swal.DismissReason.cancel) { done({ back: true }); } });
            });
        }

        const maxIntentos = Math.max(1, Number(cfg.voiceMaxAttempts) || 3);
        let intentosFallidos = 0;
        for (;;) {
            const g = await grabar();
            Swal.close();
            if (g.back) { return canGoBack ? 'BACK' : null; }
            if (g.denied) {
                await Swal.fire({ icon: 'error', title: 'Sin permiso de micrófono',
                    text: canGoBack ? 'Podés elegir el test de reacción.' : 'Habilitá el micrófono y reintentá.' });
                return canGoBack ? 'BACK' : null;
            }
            if (g.error || !g.blob || !g.blob.size) {
                const rr = await Swal.fire({ icon: 'error', title: 'No se grabó audio',
                    text: 'No se pudo capturar tu voz. Probá de nuevo.',
                    showCancelButton: true, confirmButtonText: 'Reintentar', cancelButtonText: canGoBack ? 'Volver a elegir' : 'Cancelar' });
                if (!rr.isConfirmed) { return canGoBack ? 'BACK' : null; }
                continue;
            }
            Swal.fire({ title: 'Evaluando…', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            let data, httpOk = false;
            try {
                const audioBase64 = await blobToBase64(g.blob);
                const resp = await fetch(`/delivery/route/${routeId}/fatigue/voz-stt`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ frase, audioBase64, mimeType: g.blob.type }),
                });
                httpOk = resp.ok;
                data = await resp.json().catch(() => ({}));
                if (!httpOk) { throw new Error(data.error || ('HTTP ' + resp.status)); }
            } catch (e) {
                vozLog('stt-error', { msg: String(e.message) });
                Swal.close();
                const rr = await Swal.fire({ icon: 'error', title: 'No se pudo evaluar',
                    text: 'Hubo un problema al transcribir tu voz. Probá de nuevo.',
                    showCancelButton: true, confirmButtonText: 'Reintentar', cancelButtonText: canGoBack ? 'Volver a elegir' : 'Cancelar' });
                if (!rr.isConfirmed) { return canGoBack ? 'BACK' : null; }
                continue;
            }
            vozLog('stt-result', { dicho: data.dicho, match: data.matchRatio });
            if (data.matchRatio >= MIN_MATCH) {
                // Gate de frase superado → ahora evaluamos la FATIGA por análisis acústico.
                // El loader "Evaluando…" sigue visible durante el análisis del waveform.
                const feats = cfg.voiceAcousticEnabled !== false ? await extraerFeaturesVoz(g.blob) : null;
                const acousticScore = scoreAcusticoVoz(feats);
                vozLog('acustico', { feats, acousticScore });
                Swal.close();
                const metrics = { matchRatio: data.matchRatio, durationMs: secs * 1000, expectedMs: secs * 1000 };
                if (Number.isFinite(acousticScore)) { metrics.acousticScore = acousticScore; }
                return { method: 'VOZ', metrics };
            }
            Swal.close();
            intentosFallidos++;
            // Agotó los intentos permitidos → el verdicto (bloquear o avisar) lo decide
            // quien llamó a la prueba, según autoBlock.
            if (intentosFallidos >= maxIntentos) {
                vozLog('gate-fallido', { intentos: intentosFallidos });
                return { method: 'VOZ', metrics: { phraseGateFailed: true } };
            }
            const pct = Math.round((data.matchRatio || 0) * 100);
            const rr = await Swal.fire({ icon: 'info', title: 'No coincide la frase',
                html: `<div style="text-align:left;font-size:.9rem">
                        <div>Tenés que leer <b>completa</b> (intento ${intentosFallidos + 1} de ${maxIntentos}):</div>
                        <div style="margin:6px 0;padding:8px 10px;border-radius:8px;background:rgba(37,99,235,.12)">“${frase}”</div>
                        ${data.dicho ? `<div>Escuché: “<i>${data.dicho}</i>” — coincidencia <b>${pct}%</b> (mínimo ${Math.round(MIN_MATCH*100)}%).</div>` : '<div>No detecté tu voz.</div>'}
                       </div>`,
                showCancelButton: true, confirmButtonText: 'Reintentar', cancelButtonText: canGoBack ? 'Volver a elegir' : 'Cancelar', allowOutsideClick: false });
            if (!rr.isConfirmed) { return canGoBack ? 'BACK' : null; }
        }
    }

    async function pruebaVoz(cfg, canGoBack = false) {
        // Manda diagnóstico al server (aparece en logs de Render) y a la consola.
        const sessionTag = Math.random().toString(36).slice(2, 8);
        const vozLog = (stage, data) => {
            const payload = { tag: sessionTag, stage, ...(data || {}) };
            console.log('[fatiga-voz]', stage, JSON.stringify(data || {}));
            try {
                fetch(`/delivery/route/${routeId}/fatigue/voz-log`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload), keepalive: true,
                }).catch(() => {});
            } catch (_) {}
        };

        // Modo ACÚSTICO: si está activo y el server tiene STT, usamos SIEMPRE el camino
        // de grabación (sirve en cualquier dispositivo, incl. iOS): el servidor valida la
        // frase y el navegador analiza la onda para medir la fatiga vocal real.
        if (cfg.voiceAcousticEnabled !== false && cfg.voiceSttEnabled) {
            vozLog('modo-acustico', {});
            return pruebaVozSTT(cfg, canGoBack, vozLog);
        }

        // iOS (iPhone/iPad): la Web Speech API dice estar soportada pero NO capta
        // audio (todos los navegadores son WebKit). Si el server tiene STT, grabamos
        // y transcribimos del lado del servidor; si no, derivamos al test de reacción.
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent)
            || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        if (isIOS) {
            vozLog('ios-detectado', { stt: !!cfg.voiceSttEnabled });
            if (cfg.voiceSttEnabled) { return pruebaVozSTT(cfg, canGoBack, vozLog); }
            const r = await Swal.fire({
                icon: 'warning', title: 'Voz no disponible en iPhone/iPad',
                text: 'El reconocimiento de voz no funciona en iPhone ni iPad. Usá el test de reacción.',
                showCancelButton: true,
                confirmButtonText: canGoBack ? 'Usar test de reacción' : 'Intentar igual',
                cancelButtonText: canGoBack ? 'Intentar voz igual' : 'Cancelar',
                confirmButtonColor: '#16a34a',
            });
            if (canGoBack) { if (r.isConfirmed) { return 'BACK'; } } // si no, intenta voz igual
            else if (!r.isConfirmed) { return null; }
        }

        const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SR) {
            vozLog('no-soportado', { ua: navigator.userAgent });
            // Si el server tiene STT, lo usamos también en navegadores sin Web Speech.
            if (cfg.voiceSttEnabled) { return pruebaVozSTT(cfg, canGoBack, vozLog); }
            await Swal.fire({ icon: 'warning', title: 'Reconocimiento de voz no disponible',
                text: canGoBack
                    ? 'Tu navegador no soporta la prueba de voz. Elegí el test de reacción.'
                    : 'Tu navegador no soporta la prueba de voz. Usá Chrome o Edge, o pedile a tu supervisor el test de reacción.' });
            return canGoBack ? 'BACK' : null;
        }
        vozLog('soportado', { ua: navigator.userAgent.slice(0, 140), https: location.protocol });

        const frase = FRASES_VOZ[Math.floor(Math.random() * FRASES_VOZ.length)];
        const MIN_MATCH = 0.95; // exige leer la frase casi completa y en orden

        // Un intento: muestra la frase, escucha y devuelve { ok, matchRatio, dicho, durationMs, denied, noSpeech }.
        function intentar() {
            return new Promise((resolve) => {
                let resolved = false;
                const done = (v) => { if (!resolved) { resolved = true; resolve(v); } };
                Swal.fire({
                    title: 'Prueba de voz',
                    html: `<div style="font-size:.85rem;margin-bottom:8px">Tocá el botón y leé en voz alta, claro y completo:</div>
                           <div style="font-weight:700;font-size:1.05rem;margin:8px 0;padding:10px 12px;border-radius:8px;background:rgba(37,99,235,.12);color:inherit">“${frase}”</div>
                           <button id="vz-go" style="padding:12px 16px;border:0;border-radius:12px;background:#2563eb;color:#fff;font-weight:700">🎤 Empezar prueba</button>
                           <div id="vz-tip" style="margin-top:10px;font-size:.85rem;opacity:.85"></div>`,
                    showConfirmButton: false, allowOutsideClick: false, allowEscapeKey: false,
                    didOpen: () => {
                        const go = document.getElementById('vz-go');
                        const tip = document.getElementById('vz-tip');
                        go.addEventListener('click', () => {
                            const rec = new SR();
                            rec.lang = 'es-AR'; rec.interimResults = false; rec.maxAlternatives = 3; rec.continuous = false;
                            go.disabled = true;
                            // Mic activo en rojo + cuenta regresiva. Corta solo según testDurationSec (ajustes).
                            const secs = cfg.testDurationSec || 5;
                            let left = secs;
                            const paint = () => { tip.innerHTML = `<span style="color:#dc2626;font-weight:700">🔴 Micrófono activado</span> — leé ahora (${Math.max(0, left)}s)`; };
                            paint();
                            const countdown = setInterval(() => { left--; paint(); }, 1000);
                            const autostop = setTimeout(() => { try { rec.stop(); } catch (_) {} }, secs * 1000);
                            const cleanup = () => { clearInterval(countdown); clearTimeout(autostop); };
                            const t0 = performance.now();
                            const el = () => Math.round(performance.now() - t0);
                            let gotSound = false, gotSpeech = false;
                            vozLog('start', { secs, palabras: frase.split(' ').length });
                            rec.onaudiostart  = () => vozLog('audiostart', { ms: el() });
                            rec.onsoundstart  = () => { gotSound = true; vozLog('soundstart', { ms: el() }); };
                            rec.onspeechstart = () => { gotSpeech = true; vozLog('speechstart', { ms: el() }); };
                            rec.onspeechend   = () => vozLog('speechend', { ms: el() });
                            rec.onresult = (e) => {
                                cleanup();
                                let best = 0, dicho = '';
                                const alts = e.results[0];
                                for (let i = 0; i < alts.length; i++) {
                                    const sim = similitudFrase(alts[i].transcript, frase);
                                    if (sim > best) { best = sim; dicho = alts[i].transcript; }
                                }
                                vozLog('result', { dicho, match: Number(best.toFixed(2)), min: MIN_MATCH, ms: el() });
                                done({ ok: best >= MIN_MATCH, matchRatio: best, dicho, durationMs: el() });
                            };
                            rec.onerror = (ev) => {
                                cleanup();
                                vozLog('error', { error: ev.error, ms: el(), gotSound, gotSpeech });
                                if (ev.error === 'not-allowed' || ev.error === 'service-not-allowed') { done({ denied: true }); return; }
                                done({ ok: false, matchRatio: 0, dicho: '', durationMs: 0, errorType: ev.error || 'desconocido' });
                            };
                            rec.onend = () => {
                                cleanup();
                                if (!resolved) { vozLog('end-sin-resultado', { ms: el(), gotSound, gotSpeech }); }
                                done({ ok: false, matchRatio: 0, dicho: '', durationMs: 0, errorType: 'sin-resultado' });
                            };
                            try { rec.start(); } catch (err) { cleanup(); vozLog('no-inicia', { msg: String((err && err.message) || err) }); done({ ok: false, matchRatio: 0, errorType: 'no-inicia' }); }
                        });
                    },
                });
            });
        }

        const maxIntentos = Math.max(1, Number(cfg.voiceMaxAttempts) || 3);
        let intentosFallidos = 0;
        for (;;) {
            const r = await intentar();
            Swal.close();
            if (r.denied) {
                await Swal.fire({ icon: 'error', title: 'Sin permiso de micrófono',
                    text: canGoBack
                        ? 'Necesitamos el micrófono para la voz. Podés elegir el test de reacción.'
                        : 'Necesitamos el micrófono para la prueba de voz. Habilitalo y reintentá.' });
                return canGoBack ? 'BACK' : null;
            }
            if (r.ok) {
                return { method: 'VOZ', metrics: { matchRatio: r.matchRatio, durationMs: r.durationMs, expectedMs: (cfg.testDurationSec || 5) * 1000 } };
            }
            intentosFallidos++;
            if (intentosFallidos >= maxIntentos) {
                vozLog('gate-fallido', { intentos: intentosFallidos });
                return { method: 'VOZ', metrics: { phraseGateFailed: true } };
            }
            const HINTS = {
                'no-speech': 'No detecté tu voz. Hablá más fuerte y cerca del micrófono.',
                'sin-resultado': 'No detecté tu voz. Hablá apenas toques el botón, sin esperar.',
                'audio-capture': 'No se detecta el micrófono. Revisá que esté conectado y permitido en el navegador.',
                'network': 'Falló la conexión del reconocimiento de voz (requiere internet).',
                'aborted': 'Se interrumpió la prueba. Probá de nuevo.',
                'no-inicia': 'El navegador no pudo iniciar el micrófono. Usá Chrome o Edge.',
            };
            const pct = Math.round((r.matchRatio || 0) * 100);
            const msg = r.errorType
                ? (HINTS[r.errorType] || ('Error técnico: ' + r.errorType))
                : `<div style="text-align:left;font-size:.9rem">
                     <div>Tenés que leer <b>completa</b>:</div>
                     <div style="margin:6px 0;padding:8px 10px;border-radius:8px;background:rgba(37,99,235,.12)">“${frase}”</div>
                     ${r.dicho ? `<div>Escuché: “<i>${r.dicho}</i>” — coincidencia <b>${pct}%</b> (mínimo ${Math.round(MIN_MATCH*100)}%).</div>` : '<div>No detecté tu voz.</div>'}
                   </div>`;
            const retry = await Swal.fire({
                icon: 'info', title: r.errorType ? 'No te entendí bien' : 'No coincide la frase',
                html: msg,
                showCancelButton: true, confirmButtonText: 'Reintentar',
                cancelButtonText: canGoBack ? 'Volver a elegir' : 'Cancelar',
                allowOutsideClick: false,
            });
            if (!retry.isConfirmed) { return canGoBack ? 'BACK' : null; }
        }
    }

    // Cuando el método configurado es AMBOS, el conductor elige cuál hacer.
    async function elegirMetodo() {
        const res = await Swal.fire({
            title: 'Elegí la prueba de fatiga',
            html: 'Podés hacer la prueba de <b>voz</b> o la de <b>reacción</b>.',
            showDenyButton: true,
            confirmButtonText: '🎤 Prueba de voz',
            denyButtonText: '⚡ Prueba de reacción',
            confirmButtonColor: '#2563eb', denyButtonColor: '#16a34a',
            allowOutsideClick: false, allowEscapeKey: false,
        });
        return res.isConfirmed ? 'VOZ' : 'REACCION';
    }

    // Ejecuta la prueba según el método configurado (VOZ, REACCION o AMBOS→elige).
    // En AMBOS, desde cada prueba se puede "Volver a elegir" (vuelve al selector).
    async function runPrueba(method, cfg) {
        if (method !== 'AMBOS') {
            return method === 'VOZ' ? pruebaVoz(cfg, false) : pruebaReaccion(cfg, false);
        }
        for (;;) {
            const m = await elegirMetodo();
            const res = m === 'VOZ' ? await pruebaVoz(cfg, true) : await pruebaReaccion(cfg, true);
            if (res === 'BACK') { continue; } // volvió a elegir método
            return res; // métricas, o null si abortó
        }
    }

    // Desglose del test de reacción para que el conductor entienda el veredicto:
    // promedio, intentos dentro del límite y el criterio configurado (US-9/US-10).
    function reaccionResumenHtml(data) {
        const rx = data && data.reaction;
        if (!rx || !rx.total) { return ''; }
        const avgOk = rx.avg != null && rx.avg <= rx.limit;
        const critTxt = rx.mode === 'APROBADOS'
            ? `aprobás si al menos <b>${rx.need} de ${rx.total}</b> intentos quedan dentro de <b>${rx.limit} ms</b>`
            : `aprobás si el <b>promedio</b> queda dentro de <b>${rx.limit} ms</b>`;
        const verdictColor = rx.apto ? '#16a34a' : '#dc2626';
        return `<div style="text-align:left;font-size:.88rem;line-height:1.6;margin-top:12px;padding:10px 12px;
                    border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc;color:#0f172a">
                <div>⏱ <b>Promedio:</b> ${rx.avg} ms
                    <span style="color:${avgOk ? '#16a34a' : '#dc2626'};font-weight:700">${avgOk ? '✓ dentro' : '✗ supera'}</span>
                    del límite (${rx.limit} ms)</div>
                <div>✅ <b>Intentos dentro del límite:</b> ${rx.passedCount} de ${rx.total}
                    <span style="opacity:.75">(se requieren ${rx.need})</span></div>
                <div style="opacity:.8;margin-top:4px">Criterio (${rx.mode === 'APROBADOS' ? 'por intentos' : 'por promedio'}): ${critTxt}.</div>
                <div style="margin-top:8px;font-weight:800;color:${verdictColor}">
                    ${rx.apto ? '✔ APTO' : '✗ NO APTO'} según la parametrización</div>
            </div>`;
    }

    // BUG-32 — aviso no bloqueante cuando no hay conexión para correr el gate de fatiga.
    // La ruta queda visible en modo lectura; el control se difiere hasta recuperar señal.
    let fatigueOfflineShown = false;
    function notifyFatigueOffline() {
        hideRouteLoader();
        if (fatigueOfflineShown) { return; }
        fatigueOfflineShown = true;
        const b = document.createElement('div');
        b.id = 'fatigue-offline-banner';
        b.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:10000;background:#b45309;color:#fff;' +
            'padding:10px 14px;font:600 .9rem system-ui,sans-serif;text-align:center;box-shadow:0 2px 10px rgba(0,0,0,.3)';
        b.textContent = '📴 Sin conexión: el control de fatiga y el inicio de ruta se harán al recuperar señal.';
        document.body.appendChild(b);
        window.addEventListener('online', () => { b.remove(); fatigueOfflineShown = false; }, { once: true });
    }

    // Última Milla — GPS obligatorio para rutear: el seguimiento en vivo y el aviso "ya casi
    // llego" dependen de la posición del repartidor. Pide la ubicación una vez; si el permiso
    // está denegado o no hay señal, no se puede iniciar. En modo prueba (?sim=1) se omite,
    // porque los heartbeats los inyecta el panel de simulación.
    function ensureGpsReady() {
        return new Promise((resolve) => {
            if (new URLSearchParams(location.search).get('sim') === '1') { resolve(true); return; }
            if (!navigator.geolocation) { resolve(false); return; }
            navigator.geolocation.getCurrentPosition(
                () => resolve(true),
                () => resolve(false),
                { enableHighAccuracy: true, timeout: 8000 }
            );
        });
    }

    // LGT-190/191 — gate de inicio: consentimiento + prueba antes de salir.
    async function startWithFatigue() {
        // BUG-32 — sin conexión no se puede correr el gate ni persistir el inicio en el
        // server; abortamos sin recargar (evita el bucle) y diferimos hasta que vuelva online.
        if (!navigator.onLine) { notifyFatigueOffline(); return; }
        // GPS obligatorio antes de cualquier gate: sin ubicación no se inicia la ruta.
        if (!(await ensureGpsReady())) {
            await Swal.fire({
                icon: 'warning',
                title: 'Activá la ubicación (GPS)',
                html: 'Para iniciar la ruta necesitás permitir el acceso a tu ubicación.<br>' +
                      'Activá el GPS del dispositivo y el permiso de ubicación del navegador, y volvé a intentar.',
                confirmButtonText: 'Entendido', confirmButtonColor: '#d97706', allowOutsideClick: false,
            });
            return;
        }
        // Bloquea la ruta mientras se carga la config y se resuelve el gate (no se puede operar antes).
        showRouteLoader('Preparando control de fatiga…');
        const cfg = await getFatigueCfg();
        if (!cfg.enabled) {
            // Sólo recargamos si el inicio se persistió en el server; si falló (offline/
            // error) NO recargamos para no reentrar en bucle: avisamos y diferimos.
            const ok = await fetch(`/delivery/route/${routeId}/start`, { method: 'POST' }).then(r => r.ok).catch(() => false);
            if (ok) { window.location.reload(); } else { notifyFatigueOffline(); }
            return;
        }
        hideRouteLoader();
        const consent = await runConsent(cfg);
        if (!consent) { return; }
        if (!consent.accepted) {
            // Rechazo: el loader queda visible mientras navegamos al home; el popup
            // explicando el rechazo lo muestra /delivery al detectar los flags.
            const params = new URLSearchParams({ fatiga: 'rechazo', ruta: String(routeId) });
            if (consent.disabled) { params.set('disabled', '1'); }
            if (consent.rejections != null) { params.set('rej', String(consent.rejections)); }
            if (consent.max != null) { params.set('max', String(consent.max)); }
            window.location.href = '/delivery?' + params.toString();
            return;
        }
        hideRouteLoader();
        const prueba = await runPrueba(cfg.methodStart, cfg);
        if (!prueba) { return; } // prueba cancelada / sin micrófono → no inicia
        showRouteLoader('Evaluando la prueba…');
        const r = await fetch(`/delivery/route/${routeId}/fatigue-check`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ checkId: consent.checkId, ...prueba, triggerType: 'INICIO' }),
        });
        const data = await r.json().catch(() => ({}));
        hideRouteLoader();
        const gateFail = !!(prueba.metrics && prueba.metrics.phraseGateFailed);
        const failed = data.failed === true;
        const resumen = reaccionResumenHtml(data); // desglose si fue prueba de reacción

        // autoBlock ON → bloqueado: no queda habilitado. Redirige a Mis Envíos con banner rojo.
        if (data.blocked) {
            await Swal.fire({ icon: 'error',
                title: gateFail ? 'No pudiste leer la frase' : 'No pasaste el control de fatiga',
                html: (gateFail
                    ? 'No quedás habilitado para salir.<br>Tu supervisor fue notificado.'
                    : `Puntaje <b>${data.score}/${data.threshold}</b>. No quedás habilitado para salir.<br>Tu supervisor fue notificado.`)
                    + resumen,
                confirmButtonText: 'Entendido', confirmButtonColor: '#dc2626', allowOutsideClick: false });
            window.location.href = `/delivery?fatiga=bloqueado&ruta=${routeId}`;
            return;
        }

        // autoBlock OFF pero no pasó → puede iniciar, el supervisor lo contactará.
        // Queda un aviso en "Ojo de Patrón" para que el supervisor decida (inhabilitar/reasignar).
        if (failed) {
            await Swal.fire({ icon: 'warning', title: 'No pasaste las pruebas',
                html: 'Pronto el supervisor se va a contactar con vos.<br>Por ahora <b>podés iniciar la ruta</b>.' + resumen,
                confirmButtonText: 'Iniciar ruta', confirmButtonColor: '#d97706', allowOutsideClick: false });
            showRouteLoader('Iniciando ruta…');
            await fetch(`/delivery/route/${routeId}/start`, { method: 'POST' }).catch(() => {});
            window.location.reload();
            return;
        }

        // Apto.
        const metodoLbl = prueba.method === 'VOZ' ? 'de voz' : 'de reacción';
        const aptoHtml = resumen
            ? `Prueba ${metodoLbl} superada.${resumen}<p style="margin-top:8px">¡Buen viaje!</p>`
            : `Prueba ${metodoLbl} superada.<br><b>Puntaje ${data.score}/${data.threshold}</b>. ¡Buen viaje!`;
        await Swal.fire({ icon: 'success', title: 'Apto para salir',
            html: aptoHtml,
            confirmButtonText: 'Iniciar ruta', confirmButtonColor: '#16a34a', allowOutsideClick: false,
            showCloseButton: true, timer: 10000, timerProgressBar: true });
        showRouteLoader('Iniciando ruta…');
        await fetch(`/delivery/route/${routeId}/start`, { method: 'POST' }).catch(() => {});
        window.location.reload();
    }

    // LGT-199 — widget de re-chequeo en ruta ("Estoy detenido").
    function mountRecheckWidget() {
        const btn = document.createElement('button');
        btn.id = 'fatigue-stop-btn';
        btn.style.cssText = 'position:fixed;bottom:84px;right:16px;z-index:9999;padding:12px 16px;border:0;' +
            'border-radius:999px;background:#b45309;color:#fff;font-weight:700;box-shadow:0 4px 14px rgba(0,0,0,.3)';
        btn.textContent = '🛑 Estoy detenido';
        document.body.appendChild(btn);

        // Cartel flotante con la hora del próximo chequeo / reintento.
        const nextLbl = document.createElement('div');
        nextLbl.id = 'fatigue-next-check';
        nextLbl.style.cssText = 'position:fixed;bottom:132px;right:16px;z-index:9999;padding:8px 12px;border-radius:10px;' +
            'background:#0f172a;color:#fff;font-weight:700;font-size:.8rem;box-shadow:0 4px 14px rgba(0,0,0,.3);display:none';
        document.body.appendChild(nextLbl);
        // Zona horaria y formato 12/24h configurados en Ajustes (no la del navegador).
        const FATIGUE_TZ  = '<%= typeof displayTimezone !== "undefined" && displayTimezone ? displayTimezone : "America/Argentina/Buenos_Aires" %>';
        const FATIGUE_H12 = <%= (typeof clock24h !== "undefined" && !clock24h) ? "true" : "false" %>;
        const fmtHora = (iso) => { try { return new Date(iso).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', timeZone: FATIGUE_TZ, hour12: FATIGUE_H12 }); } catch (_) { return '--:--'; } };
        // Muestra la hora REAL del próximo chequeo/reintento (en la zona de Ajustes) con
        // una cuenta regresiva en vivo. Al llegar a la hora, dispara un refresh para que
        // el re-chequeo se active automáticamente (sin esperar el siguiente poll).
        let nextTick = null;
        const showNext = (iso, label) => {
            if (nextTick) { clearInterval(nextTick); nextTick = null; }
            if (!iso) { nextLbl.style.display = 'none'; return; }
            const target = new Date(iso).getTime();
            let firedAtZero = false;
            const paint = () => {
                const remMs = target - Date.now();
                let cd;
                if (remMs <= 0) {
                    cd = 'ahora';
                    if (nextTick) { clearInterval(nextTick); nextTick = null; }
                    if (!firedAtZero) { firedAtZero = true; refresh(); } // activa el re-chequeo puntual
                } else {
                    const totalSec = Math.floor(remMs / 1000);
                    const m = Math.floor(totalSec / 60); const s = totalSec % 60;
                    cd = m > 0 ? `en ${m}m ${String(s).padStart(2, '0')}s` : `en ${s}s`;
                }
                nextLbl.innerHTML = `⏱ ${label}: <span style="color:#fbbf24">${fmtHora(iso)}</span> <span style="opacity:.85">(${cd})</span>`;
            };
            paint();
            nextTick = setInterval(paint, 1000);
            nextLbl.style.display = 'block';
        };

        // Campo visual: tiempo de manejo acumulado vs el mínimo que habilita el re-chequeo.
        // Así el repartidor sabe si ya "pasó ese tiempo" sin tener que adivinar.
        const driveChip = document.createElement('div');
        driveChip.id = 'fatigue-drive-chip';
        driveChip.style.cssText = 'position:fixed;bottom:180px;right:16px;z-index:9999;padding:8px 12px;border-radius:10px;' +
            'background:#0f172a;color:#fff;font-weight:700;font-size:.8rem;box-shadow:0 4px 14px rgba(0,0,0,.3);display:none;max-width:230px';
        document.body.appendChild(driveChip);
        const renderDriveChip = (s) => {
            if (!s || s.driveMin == null || s.driveThresholdMin == null) { driveChip.style.display = 'none'; return; }
            const ready = s.driveMin >= s.driveThresholdMin;
            const color = ready ? '#22c55e' : '#fbbf24';
            const pct = Math.min(100, Math.round((s.driveMin / Math.max(1, s.driveThresholdMin)) * 100));
            driveChip.innerHTML = `🚚 Manejo: <span style="color:${color}">${s.driveMin}</span> / ${s.driveThresholdMin} min` +
                `<div style="margin-top:5px;height:5px;border-radius:4px;background:rgba(255,255,255,.18);overflow:hidden">` +
                `<div style="height:100%;width:${pct}%;background:${color}"></div></div>` +
                `<div style="margin-top:4px;font-weight:500;opacity:.85">${ready ? '✓ Si te detenés, se pedirá la prueba.' : 'Aún no llegás al mínimo para el re-chequeo.'}</div>`;
            driveChip.style.display = 'block';
        };
        // Último estado del server; el front recompone el minutaje local entre polls.
        let lastDriveStatus = null;
        // Pinta el chip recomputando driveMin LOCALMENTE cuando está en marcha, así
        // tickea cada minuto sin depender del poll al server (que es cada 60s).
        const paintDrive = (s) => {
            if (!s) { return; }
            let driveMin = s.driveMin;
            if (s.driving && s.driveStartedAt) {
                driveMin = Math.max(0, Math.floor((Date.now() - new Date(s.driveStartedAt).getTime()) / 60000));
            }
            renderDriveChip(Object.assign({}, s, { driveMin }));
        };
        async function updateDriveChip() {
            try {
                const r = await fetch(`/delivery/route/${routeId}/fatigue/recheck-status`, { cache: 'no-store' });
                lastDriveStatus = await r.json();
                paintDrive(lastDriveStatus);
            } catch (_) { /* red */ }
        }

        let stopped = false, poll = null;

        async function refresh() {
            try {
                const r = await fetch(`/delivery/route/${routeId}/fatigue/recheck-status`, { cache: 'no-store' });
                const s = await r.json();
                lastDriveStatus = s;
                paintDrive(s);
                if (s.paused) {
                    btn.textContent = `⏸ Pausada por fatiga (${s.restRemainingMin}m)`;
                    btn.style.background = '#dc2626';
                    showNext(s.nextCheckAt, 'PRÓXIMO REINTENTO');
                    if (s.restRemainingMin <= 0) { await launchRecheck(s.methodRecheck, true); }
                } else if (s.needsRecheck) {
                    showNext(null);
                    await launchRecheck(s.methodRecheck, true); // obligatorio: sí o sí debe hacerlo
                } else {
                    showNext(s.nextCheckAt, 'PRÓXIMO CHEQUEO');
                }
            } catch (_) { /* red */ }
        }
        let launching = false;
        async function launchRecheck(method, mandatory = false) {
            if (launching) { return; } // evita dos pruebas en paralelo
            launching = true;
            try {
            const cfg = await getFatigueCfg();
            const prueba = await runPrueba(method || cfg.methodRecheck, cfg);
            if (!prueba) {
                // No completó la prueba. Si es obligatoria (re-chequeo pendiente), no puede
                // seguir la ruta: lo mandamos al inicio. Al reentrar, se le vuelve a pedir.
                if (mandatory) {
                    await Swal.fire({ icon: 'warning', title: 'Tenés que hacer el control de fatiga',
                        html: 'No podés continuar la ruta sin completar el re-chequeo.<br>Te llevamos al inicio; cuando vuelvas a entrar, te lo pediremos de nuevo.',
                        confirmButtonText: 'Entendido', confirmButtonColor: '#d97706', allowOutsideClick: false });
                    window.location.href = '/delivery?rechequeo=pendiente';
                }
                return;
            }
            const r = await fetch(`/delivery/route/${routeId}/fatigue-recheck`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(prueba),
            });
            const data = await r.json().catch(() => ({}));
            if (r.status === 409) {
                Swal.fire({ icon: 'info', title: 'Descanso en curso', text: `Esperá ${data.restRemainingMin} min.` });
                return;
            }
            if (data.blocked) {
                Swal.fire({ icon: 'error', title: 'Pausada por fatiga',
                    text: 'La ruta queda pausada. Tu Supervisor fue notificado.' });
            } else {
                Swal.fire({ icon: 'success', title: 'Apto', text: 'Podés continuar la ruta.' });
                stopped = false; btn.textContent = '🛑 Estoy detenido'; btn.style.background = '#b45309';
                showNext(null);
                if (poll) { clearInterval(poll); poll = null; }
            }
            } finally { launching = false; }
        }
        btn.addEventListener('click', async () => {
            if (stopped) {
                await fetch(`/delivery/route/${routeId}/fatigue/resume`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
                stopped = false; btn.textContent = '🛑 Estoy detenido'; btn.style.background = '#b45309';
                showNext(null);
                if (poll) { clearInterval(poll); poll = null; }
                return;
            }
            const sr = await fetch(`/delivery/route/${routeId}/fatigue/stopped`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
                .then(r => r.json()).catch(() => null);
            stopped = true; btn.textContent = '▶ Reanudar marcha'; btn.style.background = '#2563eb';
            // El próximo chequeo se carga en pantalla apenas el conductor se detiene.
            if (sr && sr.nextCheckAt) { showNext(sr.nextCheckAt, 'PRÓXIMO CHEQUEO'); }
            await refresh();
            poll = setInterval(refresh, 30000);
        });

        // Al entrar a la ruta: refresca el estado y muestra el chip de manejo ya con el
        // tiempo acumulado desde el inicio de la ruta (no desde que se abre el widget).
        refresh();
        updateDriveChip();
        // Sync con el server cada minuto (estado real: detenido/pausado/umbral).
        setInterval(updateDriveChip, 60000);
        // Tick LOCAL cada 30s: recompone el minutaje sin esperar al poll, así el número
        // sube solo mientras está en marcha (antes parecía "congelado" entre polls).
        setInterval(() => paintDrive(lastDriveStatus), 30000);
    }

    // Inicia ruta con gate de fatiga si aún no se inició (sólo modo activo).
    // BUG-32 — startWithFatigue() se autoprotege offline (difiere sin recargar). Si
    // entramos sin conexión, reintentamos una vez cuando vuelva la señal.
    if (!routeStarted && !readOnly) {
        startWithFatigue();
        if (!navigator.onLine) {
            window.addEventListener('online', function onBack() {
                window.removeEventListener('online', onBack);
                startWithFatigue();
            });
        }
    } else if (routeStarted && !readOnly) {
        getFatigueCfg().then(cfg => { if (cfg.enabled) { mountRecheckWidget(); } });
    }

    // === Step gating + métricas live ===
    function fmtTime(d) { return d.toTimeString().slice(0, 5); }
    function fmtDuration(sec) {
        if (!sec || sec < 60) return Math.max(0, Math.floor(sec)) + 's';
        const h = Math.floor(sec / 3600);
        const m = Math.floor((sec % 3600) / 60);
        return (h ? h + 'h ' : '') + m + 'm';
    }

    function applyStepState() {
        const rows = Array.from(document.querySelectorAll('.stop-row'));
        let currentFound = false;
        let kmDone = 0, kmAcc = 0;
        const now = new Date();
        let etaCursor = new Date(now);
        // Estado para la hora de llegada con manejo OSRM: índice de la parada desde la que
        // se mide el próximo tramo y el servicio (min en puerta) de la parada anterior.
        let lastEtaIdx = null;
        let lastServiceSec = 0;
        // Suma de tramos de manejo OSRM (seg) entre dos paradas por su índice en el trazado.
        const osrmTravelSec = (fromIdx, toIdx) => {
            if (!osrmLegSec || fromIdx == null || toIdx == null || toIdx <= fromIdx) return null;
            let s = 0;
            for (let i = fromIdx; i < toIdx && i < osrmLegSec.length; i++) s += osrmLegSec[i];
            return s;
        };

        rows.forEach(r => {
            r.classList.remove('is-current', 'locked');
            const lockMsg = r.querySelector('.lock-msg'); if (lockMsg) lockMsg.hidden = true;
            const bubble = r.querySelector('.stop-bubble');
            const etaEl  = r.querySelector('.js-stop-eta');
            if (bubble) bubble.classList.remove('current', 'locked', 'skipped');
            const badge = r.querySelector('.js-status-badge');
            if (badge) {
                badge.classList.remove('amber', 'gray', 'green');
                badge.classList.add('gray');
                badge.textContent = 'En espera';
            }

            const stopId = Number(r.dataset.stopId);
            const stop = stops.find(s => s.id === stopId);
            const estMin = Number(r.dataset.estMin || 5);

            if (r.classList.contains('completed')) {
                // Distinguir estados terminales por shipment.statusId.
                // 4=DELIVERED, 9=FAILED_ATTEMPT, 3=AT_BRANCH, 5=CANCELLED, 8=PACKAGE_FAILED.
                const shipStatus = Number(r.dataset.shipStatus || 0);
                const isPickup = r.dataset.stopType === 'pickup';
                if (badge) {
                    badge.classList.remove('amber','gray','green','red','blue');
                    // Limpiar inline styles previos (cuando antes seteabamos style.background/color directo)
                    badge.style.background = '';
                    badge.style.color = '';
                    if (isPickup) {
                        badge.classList.add('green'); badge.textContent = 'Retirado';
                    } else if (shipStatus === 4) {
                        badge.classList.add('green'); badge.textContent = 'Entregado';
                    } else if (shipStatus === 9) {
                        badge.classList.add('red'); badge.textContent = 'Intento fallido';
                    } else if (shipStatus === 3) {
                        badge.classList.add('blue');
                        badge.textContent = r.dataset.branchDrop === '1' ? 'Dejado en sucursal' : 'Devuelto a sucursal';
                    } else if (shipStatus === 5) {
                        badge.classList.add('red'); badge.textContent = 'Cancelado';
                    } else if (shipStatus === 8) {
                        badge.classList.add('red'); badge.textContent = 'Paquete fallido';
                    } else {
                        badge.classList.add('gray'); badge.textContent = 'Completado';
                    }
                }
                if (bubble) {
                    bubble.classList.remove('pending','current','locked','skipped','delivered','failed','pickup');
                    if (isPickup) bubble.classList.add('pickup');
                    else if (shipStatus === 4) bubble.classList.add('delivered');
                    else if (shipStatus === 9 || shipStatus === 5 || shipStatus === 8) bubble.classList.add('failed');
                    else bubble.classList.add('delivered'); // AT_BRANCH y otros: visualmente "ok"
                }
                if (etaEl) etaEl.textContent = '';
                if (stop) kmDone += stop.distanceFromPrevKm;
                kmAcc += (stop ? stop.distanceFromPrevKm : 0);
                // El viaje hacia la primera parada pendiente se mide desde esta parada ya
                // completada (sin sumar servicio: el repartidor ya la atendió).
                lastEtaIdx = osrmStopIds.indexOf(Number(r.dataset.stopId));
                lastServiceSec = 0;
                return;
            }

            if (r.dataset.skipped === '1') {
                r.classList.add('skipped');
                if (bubble) { bubble.classList.remove('pending'); bubble.classList.add('skipped'); }
                if (etaEl) etaEl.textContent = 'Postergada';
                if (badge) {
                    badge.classList.remove('gray','green');
                    badge.classList.add('amber');
                    badge.style.background = '';
                    badge.style.color = '';
                    badge.textContent = 'Postergada';
                }
                return;
            }

            if (!currentFound && !readOnly) {
                r.classList.add('is-current');
                if (bubble) { bubble.classList.remove('pending'); bubble.classList.add('current'); }
                if (badge) { badge.classList.remove('gray'); badge.classList.add('amber'); badge.textContent = 'En camino'; }
                if (stop && markers[stopId]) markers[stopId].setIcon(buildIcon(stop, 'current'));
                // Primera parada pendiente: hora de llegada = ahora + manejo OSRM desde la
                // última parada (completada u origen). Sin OSRM cae al estimado por parada.
                const thisIdx = osrmStopIds.indexOf(stopId);
                const travelSec = osrmTravelSec(lastEtaIdx, thisIdx);
                etaCursor = new Date(now.getTime() + (travelSec != null ? travelSec * 1000 : estMin * 60000));
                if (etaEl) etaEl.textContent = 'Hora de llegada: ' + fmtTime(etaCursor);
                lastEtaIdx = thisIdx;
                lastServiceSec = estMin * 60;
                currentFound = true;
            } else if (!currentFound && readOnly) {
                // Modo solo lectura: marca el stop incompleto pero sin "is-current" interactivo
                if (etaEl) etaEl.textContent = '';
                currentFound = true;
            } else {
                r.classList.add('locked');
                if (bubble) { bubble.classList.remove('pending'); bubble.classList.add('locked'); }
                if (lockMsg) {
                    const prev = r.previousElementSibling;
                    const prevSeq = prev ? prev.dataset.stopSeq : '?';
                    const txt = lockMsg.querySelector('.lock-text');
                    if (txt) txt.textContent = `Completá el paso #${prevSeq} antes`;
                    lockMsg.hidden = false;
                }
                // Paradas siguientes: parten de la salida de la parada anterior (llegada +
                // servicio) más el manejo OSRM hasta esta. Sin OSRM, estimado por parada.
                const thisIdx = osrmStopIds.indexOf(stopId);
                const travelSec = osrmTravelSec(lastEtaIdx, thisIdx);
                if (travelSec != null) {
                    etaCursor = new Date(etaCursor.getTime() + lastServiceSec * 1000 + travelSec * 1000);
                } else {
                    etaCursor = new Date(etaCursor.getTime() + estMin * 60000);
                }
                if (etaEl) etaEl.textContent = 'Hora de llegada: ' + fmtTime(etaCursor);
                lastEtaIdx = thisIdx;
                lastServiceSec = estMin * 60;
            }
        });

        const total = rows.length;
        const done = rows.filter(r => r.classList.contains('completed')).length;
        const pct = total ? Math.round((done / total) * 100) : 0;
        document.getElementById('progress-fill').style.width = pct + '%';
        document.getElementById('progress-text').textContent = `${done} / ${total}`;

        // Métricas en vivo. "Fin del reparto" = llegada a la última parada + su servicio.
        const endCursor = new Date(etaCursor.getTime() + lastServiceSec * 1000);
        document.getElementById('m-eta').textContent = currentFound ? fmtTime(endCursor) : (done === total ? 'completa' : '—');
        document.getElementById('m-km').textContent = `${kmDone.toFixed(1)} / ${Number(totalKm).toFixed(1)}`;
        const completedWithTime = stops.filter(s => s.completed && s.completedAt);
        if (completedWithTime.length > 0) {
            const elapsedMin = completedWithTime.reduce((acc, s) => acc + Math.max(0, (Date.now() - new Date(s.completedAt).getTime())/60000), 0);
            // promedio simple: tiempo total transcurrido / cantidad — más útil sería elapsed_since_start/done
            document.getElementById('m-avg').textContent = Math.round(elapsedMin / completedWithTime.length) + 'm';
        } else {
            document.getElementById('m-avg').textContent = '—';
        }

        // Botón finalizar visible cuando todo está done o no hay pendientes accionables
        const finishBtn = document.getElementById('btn-finish-route');
        if (finishBtn && !readOnly) {
            const pendingActionable = rows.some(r => !r.classList.contains('completed') && r.dataset.skipped !== '1');
            finishBtn.hidden = pendingActionable;
        }
        // No auto-abrimos el detalle del envío: el repartidor decide cuándo subir el panel.
        // (Antes esto hacía scrollIntoView al stop actual en cada render.)
    }

    function markStopDone(stopId, kind) {
        const row = document.querySelector(`.stop-row[data-stop-id="${stopId}"]`);
        if (!row) return;
        row.classList.add('completed');
        row.dataset.skipped = '0';
        if (kind === 'failed') row.dataset.shipStatus = '9';
        else if (kind === 'branch-dropped') row.dataset.shipStatus = '3';
        else if (kind === 'delivered') row.dataset.shipStatus = '4';
        const actions = row.querySelector('.stop-actions'); if (actions) actions.remove();
        const lock = row.querySelector('.lock-msg'); if (lock) lock.remove();
        const bubble = row.querySelector('.stop-bubble');
        if (bubble) {
            bubble.classList.remove('pending', 'current', 'locked', 'skipped');
            bubble.classList.add(kind === 'failed' ? 'failed' : (kind === 'pickup-done' ? 'pickup' : 'delivered'));
        }
        const stop = stops.find(s => s.id === Number(stopId));
        if (stop) {
            stop.completed = true; stop.completedAt = new Date().toISOString();
            if (markers[stop.id]) markers[stop.id].setIcon(buildIcon(stop, kind));
        }
        applyStepState();
    }

    function markStopSkipped(stopId, skipped) {
        const row = document.querySelector(`.stop-row[data-stop-id="${stopId}"]`);
        if (!row) return;
        row.dataset.skipped = skipped ? '1' : '0';
        const stop = stops.find(s => s.id === Number(stopId));
        if (stop) { stop.skipped = !!skipped; if (markers[stop.id]) markers[stop.id].setIcon(buildIcon(stop, skipped ? 'skipped' : 'pending')); }
        // El botón lo renderiza el servidor (skip/unskip); acá lo togglemos para que refleje el
        // estado sin recargar. El handler es delegado y lee data-action al click, así que es seguro.
        const skipBtn = row.querySelector('.btn-skip-ui');
        if (skipBtn) {
            skipBtn.dataset.action = skipped ? 'unskip' : 'skip';
            skipBtn.innerHTML = skipped
                ? '<span class="material-symbols-outlined">restart_alt</span>Retomar'
                : '<span class="material-symbols-outlined">schedule_send</span>Volver luego';
        }
        applyStepState();
    }

    applyStepState();
    setInterval(applyStepState, 30000);

    // FAB — contextual:
    //  • En detalle (sheet arriba tapando el mapa): dice "Ver mapa" y al tocarlo baja el
    //    sheet para mostrar el mapa.
    //  • Con el mapa visible: vuelve a "Paso actual" y lleva al stop en curso si quedó fuera.
    const fab = document.getElementById('fab-current');
    if (fab) {
        const fabIcon = fab.querySelector('.fab-icon');
        const fabLabel = fab.querySelector('.fab-label');
        // "En detalle" = el sheet NO está plegado (tapa el mapa). Usamos el estado lógico
        // `currentSnap` (lo setea snapTo al instante) y NO la geometría: durante la animación
        // del snap, getBoundingClientRect devuelve la posición vieja y el rótulo/overlays
        // quedaban desfasados hasta el próximo evento (click/drag). Esto lo hace inmediato.
        const inDetail = () => isMobile() && currentSnap !== 'tucked';

        const updateFab = () => {
            if (window.innerWidth > 768) { fab.hidden = true; document.body.classList.remove('sheet-detail'); return; }
            const detail = inDetail();
            // Misma fuente para ocultar overlays del mapa (Manejo / Modo prueba) y el FAB.
            document.body.classList.toggle('sheet-detail', detail);
            if (detail) {
                fab.hidden = false;
                fabIcon.textContent = 'arrow_upward';
                fabLabel.textContent = 'Ver mapa';
                return;
            }
            fabIcon.textContent = 'arrow_downward';
            fabLabel.textContent = 'Paso actual';
            const cur = document.querySelector('.stop-row.is-current');
            if (!cur) { fab.hidden = true; return; }
            const r = cur.getBoundingClientRect();
            fab.hidden = r.top > 80 && r.bottom < window.innerHeight - 80;
        };

        fab.addEventListener('click', () => {
            if (inDetail()) {
                snapTo('tucked');                 // baja el sheet → muestra el mapa
                setTimeout(() => map.invalidateSize({ pan: false }), 200);
                setTimeout(updateFab, 420);
                return;
            }
            // "Paso actual": sube la solapa como overlay (snapTo cambia currentSnap →
            // oculta overlays del mapa y pasa el FAB a "Ver mapa") y centra el stop en curso
            // DENTRO del sheet, sin scrollear el documento (que haría "subir" el mapa).
            snapTo('full');
            setTimeout(() => {
                const cur = document.querySelector('.stop-row.is-current');
                if (cur) cur.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 380);
        });

        window.addEventListener('scroll', updateFab, { passive: true });
        // El sheet se mueve por transform (no dispara scroll de window): seguimos su drag,
        // su scroll interno y el fin de la animación de snap.
        sheet.addEventListener('scroll', updateFab, { passive: true });
        sheet.addEventListener('pointermove', updateFab, { passive: true });
        sheet.addEventListener('transitionend', updateFab);
        window.addEventListener('resize', updateFab, { passive: true });
        updateFab();
        // Permite que el snap/drag del sheet refresque el rótulo del FAB.
        window.__updateFab = updateFab;
    }

    // === Helpers ===
    const getGeo = () => new Promise((resolve) => {
        if (!navigator.geolocation) return resolve({});
        navigator.geolocation.getCurrentPosition(
            p => resolve({ latitude: p.coords.latitude, longitude: p.coords.longitude }),
            () => resolve({}), { timeout: 4000 }
        );
    });
    const post = async (url, body) => {
        const res = await fetch(url, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body || {}),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
            Swal.fire({ icon: 'warning', title: 'No se puede', text: data.error || 'Error', confirmButtonColor: '#2563eb' });
            return null;
        }
        return data;
    };

    // === Stop actions ===
    const FAILED_REASONS = [
        { code: 'ausente',          label: 'Destinatario ausente'   },
        { code: 'domicilio_erroneo',label: 'Dirección errónea'      },
        { code: 'rechazo',          label: 'Rechazo del destinatario' },
        { code: 'calle_cortada',    label: 'Calle cortada / inaccesible' },
        { code: 'paquete_dañado',   label: 'Paquete dañado'         },
        { code: 'otro',             label: 'Otro motivo'            },
    ];

    async function openFailedModal(stopId) {
        const optionsHtml = FAILED_REASONS.map(r => `<option value="${r.code}">${r.label}</option>`).join('');
        const { value: form } = await Swal.fire({
            title: 'Intento fallido',
            html: `
                <div style="text-align:left;display:flex;flex-direction:column;gap:8px">
                    <label style="font-size:.85rem;font-weight:600">Motivo</label>
                    <select id="fa-reason" class="swal2-input" style="margin:0">${optionsHtml}</select>
                    <label style="font-size:.85rem;font-weight:600">Detalle (opcional)</label>
                    <input id="fa-detail" class="swal2-input" placeholder="Comentario..." style="margin:0">
                    <details style="margin-top:6px">
                        <summary style="cursor:pointer;font-weight:600;font-size:.85rem">Entregado a vecino / portero</summary>
                        <input id="fa-neighbor-name" class="swal2-input" placeholder="Nombre del vecino" style="margin:6px 0">
                        <input id="fa-neighbor-rel"  class="swal2-input" placeholder="Relación (vecino, portero, familiar)" style="margin:6px 0">
                        <input id="fa-neighbor-phone" class="swal2-input" placeholder="Teléfono (opcional)" style="margin:6px 0">
                    </details>
                    <label style="display:flex;align-items:center;gap:6px;margin-top:8px;font-size:.9rem">
                        <input type="checkbox" id="fa-retry"> Reintentar el mismo día (volver al final de la ruta)
                    </label>
                </div>`,
            focusConfirm: false,
            showCancelButton: true,
            confirmButtonText: 'Registrar',
            confirmButtonColor: '#dc2626',
            preConfirm: () => {
                const reasonCode = document.getElementById('fa-reason').value;
                const reasonText = FAILED_REASONS.find(r => r.code === reasonCode)?.label || reasonCode;
                return {
                    reasonCode, reasonText,
                    comment:          document.getElementById('fa-detail').value || null,
                    neighborName:     document.getElementById('fa-neighbor-name').value || null,
                    neighborRelation: document.getElementById('fa-neighbor-rel').value  || null,
                    neighborPhone:    document.getElementById('fa-neighbor-phone').value || null,
                    retrySameDay:     document.getElementById('fa-retry').checked,
                };
            },
        });
        return form || null;
    }

    if (!readOnly) document.getElementById('stops-list').addEventListener('click', async (ev) => {
        const btn = ev.target.closest('[data-action]');
        if (!btn) return;
        const row = btn.closest('.stop-row');
        const action = btn.dataset.action;
        const stopId = btn.dataset.stopId;

        // Skipped puede retomarse aunque el step gating diga otra cosa
        if (row && row.classList.contains('locked') && action !== 'unskip') {
            Swal.fire({ icon: 'info', title: 'Paso bloqueado', text: 'Completá el paso anterior primero.', confirmButtonColor: '#2563eb' });
            return;
        }

        const baseUrl = `/delivery/route/${routeId}/stop/${stopId}`;

        if (action === 'skip') {
            const { value: reason } = await Swal.fire({
                title: 'Volver más tarde', input: 'text',
                inputPlaceholder: 'Ej: timbre roto, tráfico, etc.',
                showCancelButton: true, confirmButtonText: 'Postergar',
                confirmButtonColor: '#f59e0b',
            });
            if (reason === undefined) return;
            markStopSkipped(stopId, true);              // UI optimista: cambia el estado ya
            const r = await post(`${baseUrl}/skip`, { reason });
            if (!r) markStopSkipped(stopId, false);     // revertir si el server rechazó (post ya avisó)
            return;
        }
        if (action === 'unskip') {
            markStopSkipped(stopId, false);             // UI optimista
            const r = await post(`${baseUrl}/unskip`);
            if (!r) markStopSkipped(stopId, true);      // revertir si falló
            return;
        }

        // Cada acción pide el GPS recién al confirmar (no antes), para que el modal/confirmación
        // abran al instante. skip/unskip salieron antes: no usan ubicación.
        if (action === 'failed') {
            const form = await openFailedModal(stopId);
            if (!form) return;
            const geo = await getGeo();
            const r = await post(`${baseUrl}/failed`, { ...form, ...geo });
            if (r) {
                if (r.retrySameDay) markStopSkipped(stopId, true);
                else markStopDone(stopId, 'failed');
            }
            return;
        }
        if (action === 'delivered') {
            const c = await Swal.fire({
                icon: 'question', title: '¿Confirmar entrega?',
                text: 'Asegurate de tener el paquete con el destinatario.',
                showCancelButton: true, confirmButtonText: 'Sí, entregar',
                confirmButtonColor: '#16a34a',
            });
            if (!c.isConfirmed) return;
            const geo = await getGeo();
            const r = await post(`${baseUrl}/delivered`, geo);
            if (r) markStopDone(stopId, 'delivered');
            return;
        }
        if (action === 'pickup-confirmed') {
            const geo = await getGeo();
            const r = await post(`${baseUrl}/pickup-confirmed`, geo);
            if (r) markStopDone(stopId, 'pickup-done');
            return;
        }
        if (action === 'drop-at-branch') {
            const c = await Swal.fire({
                icon: 'question', title: '¿Dejar en sucursal?',
                text: 'El paquete queda disponible para que el cliente lo retire en la sucursal.',
                showCancelButton: true, confirmButtonText: 'Sí, dejar en sucursal',
                confirmButtonColor: '#16a34a',
            });
            if (!c.isConfirmed) return;
            const geo = await getGeo();
            const r = await post(`${baseUrl}/drop-at-branch`, geo);
            if (r) {
                markStopDone(stopId, 'branch-dropped');
                Swal.fire({
                    icon: 'success', title: 'Dejado en sucursal',
                    html: `<b>${r.trackingId || 'Envío'}</b> quedó en <b>${r.branchName || 'la sucursal'}</b> para retiro del cliente.`,
                    confirmButtonColor: '#16a34a', timer: 4000, timerProgressBar: true,
                });
            }
            return;
        }
    });

    // === Pausa ===
    // Los elementos pueden no existir si el banner no se renderizó (no hay pausa activa).
    let pauseBanner   = document.getElementById('pause-banner');
    let pauseElapsedE = document.getElementById('pause-elapsed');
    let pauseReasonE  = document.getElementById('pause-reason');
    let pauseTimer = null;
    function startPauseTimer() {
        if (pauseTimer) clearInterval(pauseTimer);
        const tick = () => {
            if (!activePauseStart) return;
            // Re-consultamos el elemento cada tick (el banner puede haberse creado dinámicamente
            // después de capturar la referencia) y clampeamos a 0 por si hay desfasaje de reloj.
            const el = document.getElementById('pause-elapsed');
            if (!el) return;
            const sec = Math.max(0, Math.floor((Date.now() - new Date(activePauseStart).getTime()) / 1000));
            el.textContent = 'Tiempo pausado: ' + fmtDuration(sec);
        };
        tick();
        pauseTimer = setInterval(tick, 1000);
    }
    function ensurePauseBanner() {
        // Inyectamos el banner sólo si todavía no existe (cuando el usuario pausa desde una sesión limpia).
        if (document.getElementById('pause-banner')) return;
        const html = `
            <div class="pause-banner" id="pause-banner">
                <span class="material-symbols-outlined">pause_circle</span>
                <div>
                    Ruta en pausa <small id="pause-reason"></small>
                    <div style="font-size:.72rem;font-weight:500;opacity:.85" id="pause-elapsed">—</div>
                </div>
                <button id="btn-resume">Reanudar</button>
            </div>`;
        const main = document.querySelector('main.main-content');
        if (main) {
            main.insertAdjacentHTML('afterbegin', html);
            pauseBanner   = document.getElementById('pause-banner');
            pauseElapsedE = document.getElementById('pause-elapsed');
            pauseReasonE  = document.getElementById('pause-reason');
            document.getElementById('btn-resume').addEventListener('click', resumeHandler);
        }
    }
    if (activePauseId) startPauseTimer();

    document.getElementById('btn-pause')?.addEventListener('click', async () => {
        if (activePauseId) {
            Swal.fire({ icon: 'info', title: 'Ya está en pausa', confirmButtonColor: '#2563eb' });
            return;
        }
        const { value: reason } = await Swal.fire({
            title: 'Pausar ruta',
            input: 'select',
            inputOptions: { almuerzo: 'Almuerzo', combustible: 'Recarga combustible', descanso: 'Descanso', otro: 'Otro' },
            showCancelButton: true, confirmButtonText: 'Pausar', confirmButtonColor: '#f59e0b',
        });
        if (!reason) return;
        const r = await post(`/delivery/route/${routeId}/pause`, { reason });
        if (r) {
            activePauseId = r.pauseId; activePauseStart = new Date().toISOString(); // contador desde el cliente (inmune al desfasaje de reloj)
            ensurePauseBanner();
            if (pauseReasonE) pauseReasonE.textContent = '· ' + reason;
            if (pauseBanner) pauseBanner.hidden = false;
            startPauseTimer();
        }
    });
    function clearPauseUI() {
        activePauseId = null; activePauseStart = null;
        if (pauseTimer) { clearInterval(pauseTimer); pauseTimer = null; }
        if (pauseBanner) { pauseBanner.remove(); pauseBanner = null; }
    }
    async function resumeHandler() {
        // Fuerza hide UI aún si backend no encuentra pausa (estado inconsistente)
        try {
            const res = await fetch(`/delivery/route/${routeId}/resume`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}'
            });
            await res.json().catch(() => ({}));
        } catch (_) { /* ignora red */ }
        clearPauseUI();
        // Recargamos para reflejar el estado limpio del servidor (evita banner zombi en futuras navegaciones).
        setTimeout(() => window.location.reload(), 200);
    }
    document.getElementById('btn-resume')?.addEventListener('click', resumeHandler);

    // === Hooks para el copiloto de voz (CV-03) ===
    // Pausar/retomar por voz reutilizando el banner, el timer y el estado (activePauseId).
    // El flujo por voz no muestra el selector de motivo (manos libres): usa un motivo genérico.
    window.LT_isPaused = () => !!activePauseId;
    window.LT_voicePause = async function (reason) {
        if (activePauseId) { return { ok: false, already: true }; }
        try {
            const res = await fetch(`/delivery/route/${routeId}/pause`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason: reason || 'pausa' }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) { return res.status === 409 ? { ok: false, already: true } : { ok: false, error: true }; }
            activePauseId = data.pauseId; activePauseStart = new Date().toISOString(); // contador desde el cliente (inmune al desfasaje de reloj)
            ensurePauseBanner();
            if (pauseReasonE) { pauseReasonE.textContent = '· ' + (reason || 'pausa'); }
            if (pauseBanner) { pauseBanner.hidden = false; }
            startPauseTimer();
            return { ok: true, queued: !!data.queued }; // CV-17: offline → quedó en cola
        } catch (_) { return { ok: false, error: true }; }
    };
    window.LT_voiceResume = async function () {
        if (!activePauseId) { return { ok: false, none: true }; }
        try {
            const res = await fetch(`/delivery/route/${routeId}/resume`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}',
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) { return { ok: false, error: true }; }
            clearPauseUI();
            return { ok: true, addedSeconds: data.addedSeconds || 0, queued: !!data.queued }; // CV-17
        } catch (_) { return { ok: false, error: true }; }
    };
    // Posponer ("volver luego") por voz: reusa el endpoint /skip (encolable offline) + la UI,
    // y recalcula LT_NEXT_STOP para que "próxima/navegar/llamar" no apunten a la pospuesta.
    window.LT_voiceSkip = async function (stopId, reason) {
        try {
            const res = await fetch(`/delivery/route/${routeId}/stop/${stopId}/skip`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason: reason || 'Pospuesta por voz' }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) { return res.status === 409 ? { ok: false, paused: true } : { ok: false, error: true }; }
            markStopSkipped(stopId, true);
            const st = (window.LT_STOPS || []).find((s) => s.id === stopId);
            if (st) { st.skipped = true; }
            // Misma lógica que _ns en el render: primero pendiente sin postergar; si no quedan, una postergada.
            const nx = (window.LT_STOPS || []).find((s) => !s.completed && !s.skipped)
                    || (window.LT_STOPS || []).find((s) => !s.completed) || null;
            window.LT_NEXT_STOP = nx ? {
                id: nx.id, street: nx.street, number: nx.number, recipient: nx.recipient,
                lat: nx.lat, lng: nx.lng, phone: nx.phone,
            } : null;
            return { ok: true, queued: !!data.queued };
        } catch (_) { return { ok: false, error: true }; }
    };
    // Retomar/despostergar por voz: reusa /unskip (encolable) + la UI, y recalcula LT_NEXT_STOP
    // (la parada retomada vuelve a pendiente y puede pasar a ser la próxima).
    window.LT_voiceUnskip = async function (stopId) {
        try {
            const res = await fetch(`/delivery/route/${routeId}/stop/${stopId}/unskip`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}',
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) { return { ok: false, error: true }; }
            markStopSkipped(stopId, false);
            const st = (window.LT_STOPS || []).find((s) => s.id === stopId);
            if (st) { st.skipped = false; }
            const nx = (window.LT_STOPS || []).find((s) => !s.completed && !s.skipped)
                    || (window.LT_STOPS || []).find((s) => !s.completed) || null;
            window.LT_NEXT_STOP = nx ? {
                id: nx.id, street: nx.street, number: nx.number, recipient: nx.recipient,
                lat: nx.lat, lng: nx.lng, phone: nx.phone,
            } : null;
            return { ok: true, queued: !!data.queued };
        } catch (_) { return { ok: false, error: true }; }
    };

    // === Incidente ===
    document.getElementById('btn-incident')?.addEventListener('click', async () => {
        const { value: form } = await Swal.fire({
            title: 'Reportar incidente en ruta',
            html: `
                <div style="text-align:left;display:flex;flex-direction:column;gap:8px">
                    <label style="font-size:.85rem;font-weight:600">Tipo</label>
                    <select id="inc-type" class="swal2-input" style="margin:0">
                        <option value="vehicular">Problema vehicular</option>
                        <option value="accidente">Accidente</option>
                        <option value="trafico">Tráfico severo</option>
                        <option value="clima">Clima adverso</option>
                        <option value="otro">Otro</option>
                    </select>
                    <label style="font-size:.85rem;font-weight:600">Severidad</label>
                    <select id="inc-sev" class="swal2-input" style="margin:0">
                        <option value="baja">Baja</option>
                        <option value="media" selected>Media</option>
                        <option value="alta">Alta</option>
                    </select>
                    <label style="font-size:.85rem;font-weight:600">Descripción</label>
                    <textarea id="inc-desc" class="swal2-textarea" placeholder="¿Qué pasó?"></textarea>
                </div>`,
            focusConfirm: false, showCancelButton: true,
            confirmButtonText: 'Reportar', confirmButtonColor: '#7c3aed',
            // Spinner + botón deshabilitado durante el POST. El fetch va acá adentro
            // para que Swal muestre "Reportando…" mientras corre la propagación.
            showLoaderOnConfirm: true,
            allowOutsideClick: () => !Swal.isLoading(),
            preConfirm: async () => {
                const form = {
