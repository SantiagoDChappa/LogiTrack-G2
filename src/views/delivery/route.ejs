    html[data-theme="dark"] .swal2-input,
    html[data-theme="dark"] .swal2-textarea,
    html[data-theme="dark"] .swal2-select,
    html[data-theme="dark"] .swal2-file {
        background: #0f172a !important; color: #f1f5f9 !important;
        border: 1px solid rgba(148, 163, 184, .25) !important;
        box-shadow: none !important;
    }
    html[data-theme="dark"] .swal2-input::placeholder,
    html[data-theme="dark"] .swal2-textarea::placeholder { color: #64748b !important; }
    html[data-theme="dark"] .swal2-validation-message {
        background: #334155 !important; color: #f1f5f9 !important;
    }
    html[data-theme="dark"] .swal2-cancel { background: #475569 !important; color: #f1f5f9 !important; }
    html[data-theme="dark"] .swal2-icon.swal2-warning { color: #fbbf24 !important; border-color: #fbbf24 !important; }
    html[data-theme="dark"] .swal2-icon.swal2-question { color: #60a5fa !important; border-color: #60a5fa !important; }
    html[data-theme="dark"] .swal2-icon.swal2-info { color: #60a5fa !important; border-color: #60a5fa !important; }
    html[data-theme="dark"] .swal2-icon.swal2-success { color: #4ade80 !important; border-color: #4ade80 !important; }

    /* Fix: input overflow del popup (caso "Volver más tarde") */
    .swal2-popup .swal2-input,
    .swal2-popup .swal2-textarea,
    .swal2-popup .swal2-select {
        max-width: calc(100% - 2.4em);
        box-sizing: border-box;
    }
    /* Alinear inputs y combo: el margen por defecto de SweetAlert es asimétrico y los descentra.
       Ancho completo, centrado y con padding consistente. (Los campos con style inline propio
       —ej. el modal de fallido— mantienen su margen por la especificidad del inline.) */
