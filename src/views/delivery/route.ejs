        const r = await post('/delivery/panic', { ...geo, routeId, message: 'SOS desde la app del repartidor' });
        if (r) {
            const avisado = r.notified > 0
                ? 'Tu supervisor fue avisado.'
                : (r.queued ? 'Sin señal: se enviará al recuperar la conexión.'
                            : 'Quedó registrado, pero no pude avisar a un supervisor.');
