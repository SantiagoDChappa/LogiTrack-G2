        // al recuperar internet se sincroniza todo (estados, fallidos, mails de incidencia).
        if (r.queued) {
            await Swal.fire({
                icon: 'success', title: 'Ruta finalizada',
                html: 'Quedó guardada sin conexión. Cuando vuelva internet se sincronizan los estados de envío, la ruta y los avisos automáticamente.',
                confirmButtonColor: '#16a34a',
            });
            window.location.href = '/delivery';
            return;
        }
        window.location.href = `/delivery/route/${routeId}/summary`;
    });

    // ===================== Chat con el cliente (Última Milla) =====================
    // Inbox: el repartidor ve/atiende los chats de TODAS sus entregas pendientes (cualquier
    // cliente que abrió el "seguimiento en vivo"), no sólo la entrega en mano. Mismo canal
    // por envío que usa el cliente desde el mapa en vivo (delivery_chat por shipmentId).
    (function initDriverChat() {
        const deliveries = (stops || []).filter(s => s.stopType === 'delivery' && !s.completed && !s.skipped && s.shipmentId);
        if (!deliveries.length) return;
        const labelFor = (sid) => {
            const st = deliveries.find(d => d.shipmentId === sid);
            if (!st) return 'Cliente';
            return (st.recipient || st.tracking || ('Envío ' + sid));
        };

        const btn = document.createElement('button');
        btn.id = 'dchat-btn';
        btn.textContent = '💬';
        btn.title = 'Chat con los clientes';
        btn.style.cssText = 'position:fixed;top:230px;right:18px;z-index:1200;width:52px;height:52px;border-radius:50%;border:0;background:#2563eb;color:#fff;font-size:1.4rem;box-shadow:0 4px 14px rgba(15,23,42,.35);cursor:pointer;';
        const dot = document.createElement('span');
        dot.style.cssText = 'position:absolute;top:6px;right:6px;min-width:18px;height:18px;padding:0 4px;border-radius:9px;background:#ef4444;color:#fff;font-size:.7rem;font-weight:700;line-height:18px;text-align:center;border:2px solid #fff;display:none;';
        btn.appendChild(dot);

        const panel = document.createElement('div');
        panel.id = 'dchat-panel';
        panel.style.cssText = 'position:fixed;top:290px;right:18px;z-index:1200;width:min(340px,92vw);background:var(--lt-surface);color:var(--lt-text);border:1px solid var(--lt-border);border-radius:12px;box-shadow:0 8px 28px rgba(15,23,42,.25);display:none;flex-direction:column;overflow:hidden;';
        panel.innerHTML =
            '<div style="background:#1e3a8a;color:#fff;padding:.55rem .9rem;font-weight:600;">Chat con el cliente</div>' +
            '<select class="dchat-sel" style="margin:.55rem .9rem 0;padding:.45rem .5rem;background:var(--lt-surface);color:var(--lt-text);border:1px solid var(--lt-border);border-radius:8px;font-size:.85rem;"></select>' +
            '<div class="dchat-msgs" style="height:220px;overflow-y:auto;padding:.6rem .9rem;display:flex;flex-direction:column;gap:.4rem;background:var(--lt-bg);margin-top:.55rem;"></div>' +
            '<form class="dchat-form" style="display:flex;gap:.4rem;padding:.6rem;border-top:1px solid var(--lt-border);">' +
            '<input type="text" class="dchat-input" maxlength="1000" placeholder="Mensaje…" autocomplete="off" style="flex:1;padding:.5rem .7rem;background:var(--lt-surface);color:var(--lt-text);border:1px solid var(--lt-border);border-radius:8px;">' +
            '<button type="submit" style="padding:.5rem .9rem;border:0;border-radius:8px;background:var(--lt-blue);color:#fff;font-weight:600;">Enviar</button></form>';
        document.body.appendChild(btn);
        document.body.appendChild(panel);

        const selEl = panel.querySelector('.dchat-sel');
        const msgsEl = panel.querySelector('.dchat-msgs');
        const form = panel.querySelector('.dchat-form');
        const input = panel.querySelector('.dchat-input');
        let sid = deliveries[0].shipmentId;  // por defecto, la entrega en mano
        let lastId = 0, open = false;
        let unreadBySid = {};

        // Opciones del selector (una por entrega pendiente).
        deliveries.forEach(d => {
            const opt = document.createElement('option');
            opt.value = d.shipmentId;
            opt.textContent = labelFor(d.shipmentId);
            selEl.appendChild(opt);
        });

        const renderSelLabels = () => {
            Array.from(selEl.options).forEach(opt => {
                const id = Number(opt.value);
                const u = unreadBySid[id] || 0;
                opt.textContent = labelFor(id) + (u > 0 ? ' (' + u + ')' : '');
            });
        };
        const totalUnread = () => Object.values(unreadBySid).reduce((a, b) => a + b, 0);
        const renderDot = () => {
            const t = totalUnread();
            if (t > 0 && !open) { dot.textContent = t; dot.style.display = 'block'; }
            else { dot.style.display = 'none'; }
        };

        const append = (m) => {
            const mine = m.role === 'DRIVER';
            const row = document.createElement('div');
            // Colores por tema: propio = azul con texto blanco; del cliente = superficie con
            // texto del tema. Antes el texto heredaba el color del tema (claro) sobre una
            // burbuja clara → invisible en modo oscuro.
            const bubble = mine
                ? 'background:var(--lt-blue);color:#fff;border:1px solid var(--lt-blue);'
                : 'background:var(--lt-surface);color:var(--lt-text);border:1px solid var(--lt-border);';
            row.style.cssText = 'align-self:' + (mine ? 'flex-end' : 'flex-start') + ';max-width:80%;padding:.4rem .65rem;border-radius:10px;font-size:.88rem;' + bubble;
            row.textContent = m.body;
            msgsEl.appendChild(row);
            if (m.id > lastId) lastId = m.id;
        };

        // Refresca el hilo de la conversación seleccionada.
        const pollThread = () => {
            fetch('/delivery/chat/shipment/' + sid + '/messages?since=' + lastId)
                .then(r => r.ok ? r.json() : null)
                .then(t => {
                    if (!t || !t.messages) return;
                    if (t.messages.length) { t.messages.forEach(append); msgsEl.scrollTop = msgsEl.scrollHeight; }
                }).catch(() => {});
        };

        // Resumen de no leídos por entrega (inbox).
        const pollSummary = () => {
            fetch('/delivery/route/' + routeId + '/chats')
                .then(r => r.ok ? r.json() : null)
                .then(rows => {
                    if (!Array.isArray(rows)) return;
                    unreadBySid = {};
                    rows.forEach(r => { unreadBySid[Number(r.shipmentId)] = r.unread || 0; });
                    renderSelLabels();
                    renderDot();
                }).catch(() => {});
        };

        // Carga un hilo desde cero (al abrir o cambiar de cliente) + marca leído.
        const loadThread = (newSid) => {
            sid = Number(newSid);
            lastId = 0;
            msgsEl.innerHTML = '';
            pollThread();
            fetch('/delivery/chat/shipment/' + sid + '/read', { method: 'POST' })
                .then(() => { unreadBySid[sid] = 0; renderSelLabels(); renderDot(); }).catch(() => {});
        };

        selEl.addEventListener('change', () => loadThread(selEl.value));
        btn.addEventListener('click', () => {
            open = !open;
            panel.style.display = open ? 'flex' : 'none';
            if (open) { loadThread(sid); selEl.value = String(sid); renderDot(); }
        });
        form.addEventListener('submit', (ev) => {
            ev.preventDefault();
            const body = input.value.trim();
            if (!body) return;
            input.value = '';
            fetch('/delivery/chat/shipment/' + sid + '/messages', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ body }),
            }).then(r => r.ok ? r.json() : null).then(m => { if (m) { append(m); msgsEl.scrollTop = msgsEl.scrollHeight; } }).catch(() => {});
        });

        pollSummary();
        setInterval(pollSummary, 5000);
        setInterval(() => { if (open) pollThread(); }, 3000);
    })();

    // ===================== Modo prueba — simular viaje (?sim=1) ===================
    // Inyecta posiciones GPS falsas (heartbeats) para probar avisos/ETA/mapa sin manejar.
    // El GPS real se pausa mientras está activo (window.__simActive). Sólo aparece con ?sim=1.
    (function initSimPanel() {
        let __built = false;
        function build() {
        if (__built) { return; }
        __built = true;

        const pendingDeliveries = () => (stops || [])
            .filter(s => s.stopType === 'delivery' && !s.completed && !s.skipped && s.shipmentId && Number.isFinite(s.lat) && Number.isFinite(s.lng))
            .sort((a, b) => a.sequence - b.sequence);

        // Punto a N cuadras (≈100 m c/u) al norte de una parada.
        const offsetFrom = (stop, cuadras) => ({
            lat: stop.lat + (cuadras * 100) / 111000,
            lng: stop.lng,
        });

        let lastSim = null;
        const sendSim = (lat, lng) => {
            lastSim = { lat, lng };
            if (typeof updateDriverDot === 'function') { updateDriverDot(lat, lng); }
            fetch('/delivery/heartbeat', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ latitude: lat, longitude: lng, speedKmh: 15, routeId }),
            }).catch(() => {});
        };

        const panel = document.createElement('div');
        panel.id = 'sim-panel';
        panel.style.cssText = 'position:fixed;top:64px;left:10px;z-index:1300;width:min(248px,84vw);background:#111827;color:#cbd5e1;border:1px solid #2a3441;border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,.3);font-family:Inter,sans-serif;overflow:hidden;font-size:.8rem;';
        const btnStyle = 'padding:.5rem;border-radius:8px;font-weight:600;font-size:.8rem;cursor:pointer;text-align:center;background:transparent;';
        panel.innerHTML =
            '<div style="display:flex;justify-content:space-between;align-items:center;padding:.5rem .75rem;border-bottom:1px solid #1f2937;font-weight:600;color:#e2e8f0;font-size:.76rem;letter-spacing:.03em;text-transform:uppercase;"><span style="display:flex;align-items:center;gap:.4rem;">🧪 Modo prueba</span><span class="sim-min" title="Cerrar modo prueba" style="cursor:pointer;color:#94a3b8;font-size:1.05rem;line-height:1;">&times;</span></div>' +
            '<div class="sim-body" style="padding:.7rem .75rem;display:flex;flex-direction:column;gap:.6rem;">' +
              '<label style="display:flex;align-items:flex-start;gap:.5rem;cursor:pointer;color:#cbd5e1;line-height:1.3;"><input type="checkbox" class="sim-toggle" style="margin-top:2px;"> Simular ubicación <span style="color:#64748b;">(pausa GPS real)</span></label>' +
              '<div style="display:flex;align-items:center;gap:.45rem;color:#94a3b8;">A <input type="number" class="sim-cuadras" value="5" min="0" max="50" style="width:52px;padding:.3rem .4rem;border-radius:6px;border:1px solid #334155;background:#1e293b;color:#e2e8f0;font-size:.8rem;"> cuadras</div>' +
              '<button class="sim-near" style="' + btnStyle + 'border:1px solid #2563eb;color:#93c5fd;">📍 Acercarme al próximo</button>' +
              '<button class="sim-door" style="' + btnStyle + 'border:1px solid #334155;color:#cbd5e1;">🚪 En la puerta (0 cuadras)</button>' +
              '<div class="sim-status" style="font-size:.72rem;color:#94a3b8;line-height:1.35;"></div>' +
            '</div>';
        document.body.appendChild(panel);

        const toggle = panel.querySelector('.sim-toggle');
        const cuadrasEl = panel.querySelector('.sim-cuadras');
        const statusEl = panel.querySelector('.sim-status');
        const body = panel.querySelector('.sim-body');
        // ✕ cierra el panel y restaura la tarjeta de info de la ruta.
        panel.querySelector('.sim-min').addEventListener('click', () => {
            panel.style.display = 'none';
            document.body.classList.remove('sim-open');
        });

        const setStatus = (msg) => { statusEl.textContent = msg; };
        const targetInfo = () => {
            const pend = pendingDeliveries();
            if (!pend.length) { return null; }
            return { current: pend[0], next: pend[1] || null };
        };

        toggle.addEventListener('change', () => {
            window.__simActive = toggle.checked;
            setStatus(toggle.checked
                ? 'Simulación ON: el GPS real está pausado. Usá los botones.'
                : 'Simulación OFF: vuelve el GPS real.');
        });

        const jump = (cuadras) => {
            const info = targetInfo();
            if (!info) { setStatus('No hay entregas pendientes para simular.'); return; }
            if (!window.__simActive) { toggle.checked = true; window.__simActive = true; }
            const p = offsetFrom(info.current, cuadras);
            sendSim(p.lat, p.lng);
            const nextTxt = info.next ? ('Debería avisarle al siguiente (' + (info.next.label || ('#' + info.next.shipmentId)) + ').') : 'Es la última entrega: no hay "siguiente" a avisar.';
            setStatus('A ' + cuadras + ' cuadras de ' + (info.current.label || ('#' + info.current.shipmentId)) + '. ' + nextTxt);
        };

        panel.querySelector('.sim-near').addEventListener('click', () => jump(parseInt(cuadrasEl.value, 10) || 5));
        panel.querySelector('.sim-door').addEventListener('click', () => jump(0));

        // Mantiene viva la posición simulada (sigue siendo la "última") cada 12s.
        setInterval(() => { if (window.__simActive && lastSim) { sendSim(lastSim.lat, lastSim.lng); } }, 12000);

        setStatus('Listo. Tildá "Simular" y tocá un botón.');
        }
        // Abre el panel: lo construye una vez y lo muestra. Lo usa el botón 🧪 de arriba.
        window.__openSim = () => {
            build();
            const p = document.getElementById('sim-panel');
            if (p) { p.style.display = 'block'; const b = p.querySelector('.sim-body'); if (b) { b.style.display = 'flex'; } }
            document.body.classList.add('sim-open');  // oculta la tarjeta de info mientras dura
        };
        // Auto-abre si se entró con ?sim=1 (compatibilidad).
        if (new URLSearchParams(location.search).get('sim') === '1') { build(); document.body.classList.add('sim-open'); }
    })();

    // === POD: navega a la página de evidencia (sirve online y offline) ==============
    // El botón "Confirmar Entrega" es un <a> a /delivery/evidence/:tracking/pod. Esa página
    // hace el POST normal online y encola el POD (foto+firma) offline; el SW la sirve cacheada
    // sin conexión. Acá solo bloqueamos la navegación si el paso anterior no está completo.
    (function () {
        if (readOnly) { return; }
        const list = document.getElementById('stops-list');
        if (!list) { return; }
        list.addEventListener('click', (e) => {
            const btn = e.target.closest('.js-pod-btn');
            if (!btn) { return; }
            const row = btn.closest('.stop-row');
            if (row && row.classList.contains('locked')) {
                e.preventDefault();
                Swal.fire({ icon: 'info', title: 'Paso bloqueado', text: 'Completá el paso anterior primero.', confirmButtonColor: '#2563eb' });
            }
        });
    })();
    </script>
</body>
</html>
