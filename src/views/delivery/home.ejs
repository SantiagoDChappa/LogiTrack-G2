<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Mis Envíos - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Mis Envíos Asignados</h1>
        </div>

        <% if (typeof activeRoute !== 'undefined' && activeRoute) { %>
            <div style="margin:0 clamp(1.25rem,2.5vw,2rem) 1rem;background:var(--color-info-bg);border:1px solid var(--color-info);border-radius:var(--radius-md);padding:var(--space-4) var(--space-5);display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap">
                <div style="display:flex;align-items:center;gap:var(--space-3)">
                    <span class="material-symbols-outlined" style="color:var(--color-info);font-size:1.5rem">map</span>
                    <div>
                        <strong style="font-size:var(--font-size-sm);color:var(--color-text)">Tenés una ruta activa</strong>
                        <p style="font-size:var(--font-size-xs);color:var(--color-text-secondary);margin:0">Ruta #<%= activeRoute.id %> · <%= activeRoute.totalDistanceKm %> km</p>
                    </div>
                </div>
                <a href="/delivery/route/<%= activeRoute.id %>" class="btn-primary">
                    <span class="material-symbols-outlined">directions</span>Ver mi recorrido
                </a>
            </div>
        <% } %>

        <div style="padding:0 clamp(1.25rem,2.5vw,2rem);margin-bottom:var(--space-4)">
            <button id="btn-reschedule-failed" class="btn-secondary">
                <span class="material-symbols-outlined">replay</span>Reprogramar intentos fallidos
            </button>
        </div>
        <script>
        document.getElementById('btn-reschedule-failed')?.addEventListener('click', async () => {
            if (!confirm('¿Devolver tus envíos con intento fallido a sucursal para reprogramar?')) return;
            const r = await fetch('/delivery/reschedule-failed', { method: 'POST' });
            const d = await r.json();
            if (r.ok) { alert('Reprogramados: ' + d.rescheduled); location.reload(); }
            else { alert(d.error || 'Error'); }
        });
        </script>

        <div class="shipments-wrapper">
            <div class="table-wrapper">
                <table id="shipments-table">
                    <thead>
                        <tr>
                            <th class="th-sortable" data-col="0" data-sort="">
                                ID Tracking <span class="material-symbols-outlined sort-icon">unfold_more</span>
                            </th>
                            <th>Destinatario</th>
                            <th>Dirección</th>
                            <th class="th-sortable" data-col="3" data-sort="">
                                Estado <span class="material-symbols-outlined sort-icon">unfold_more</span>
                            </th>
                            <th class="col-actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (shipments.length === 0) { %>
                            <tr>
                                <td colspan="5" class="empty-row">
                                    <span class="material-symbols-outlined">inbox</span>
                                    No tenés envíos asignados.
                                </td>
                            </tr>
                        <% } else { %>
                            <% shipments.forEach(shipment => { %>
                                <%
                                    const _sk = shipment.status.description.toLowerCase().replace(/[\s-]+/g, '_');
                                    const _sl = {pendiente:'Pendiente',en_transito:'En Tránsito',entregado:'Entregado',cancelado:'Cancelado',cancelada:'Cancelada',retrasado:'Retrasado',en_sucursal:'En Sucursal',inicial:'Inicial'};
                                %>
                                <tr>
                                    <td class="tracking-id"><%= shipment.trackingId %></td>
                                    <td><%= shipment.recipient.fullName %></td>
                                    <td><%= shipment.address.street %> <%= shipment.address.number %></td>
                                    <td>
                                        <span class="status-badge <%= _sk %>">
                                            <%= _sl[_sk] || shipment.status.description %>
                                        </span>
                                    </td>
                                    <td class="col-actions">
                                        <a href="/shipment/detail/<%= shipment.id %>?from=/delivery&fromLabel=Mis%20Env%C3%ADos" class="action-btn detalle" data-tooltip="Detalle">
                                            <span class="material-symbols-outlined">info</span>
                                        </a>
                                        <button type="button" class="action-btn" data-tooltip="Ver QR"
                                                onclick="showQR(<%= shipment.id %>, '<%= shipment.trackingId %>')">
                                            <span class="material-symbols-outlined">qr_code</span>
                                        </button>
                                        <a href="/scan/<%= shipment.trackingId %>" class="action-btn estado" data-tooltip="Cambiar Estado">
                                            <span class="material-symbols-outlined">swap_horiz</span>
                                        </a>
                                        <a href="/incident/new?shipmentId=<%= shipment.id %>" class="action-btn" data-tooltip="Reportar incidencia">
                                            <span class="material-symbols-outlined">report</span>
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script>
        function showQR(id, trackingId) {
            const isDark = (localStorage.getItem('theme') ?? 'light') === 'dark';
            Swal.fire({
                title: trackingId,
                html: '<img src="/shipment/' + id + '/qr" style="width:200px;height:200px;display:block;margin:0 auto;" alt="QR">',
                showCancelButton: true,
                confirmButtonText: '<span style="display:flex;align-items:center;gap:6px"><span class="material-symbols-outlined" style="font-size:18px">print</span>Imprimir</span>',
                cancelButtonText: 'Cerrar',
            }).then(function(result) {
                if (result.isConfirmed) window.open('/shipment/' + id + '/label', '_blank');
            });
        }
    </script>
    <script>
        document.querySelectorAll('.th-sortable').forEach(function(th) {
            th.addEventListener('click', function() {
                const col   = parseInt(this.dataset.col);
                const tbody = document.querySelector('#shipments-table tbody');
                const rows  = Array.from(tbody.querySelectorAll('tr')).filter(r => !r.querySelector('.empty-row'));
                if (rows.length === 0) return;

                const isAsc = this.dataset.sort !== 'asc';

                document.querySelectorAll('.th-sortable').forEach(function(t) {
                    t.dataset.sort = '';
                    t.querySelector('.sort-icon').textContent = 'unfold_more';
                });

                this.dataset.sort = isAsc ? 'asc' : 'desc';
                this.querySelector('.sort-icon').textContent = isAsc ? 'arrow_upward' : 'arrow_downward';

                rows.sort(function(a, b) {
                    const aVal = (a.cells[col]?.textContent || '').trim();
                    const bVal = (b.cells[col]?.textContent || '').trim();
                    return isAsc ? aVal.localeCompare(bVal, 'es') : bVal.localeCompare(aVal, 'es');
                });

                rows.forEach(function(r) { tbody.appendChild(r); });
            });
        });
    </script>

<script>
    if (new URLSearchParams(window.location.search).get('delivered') === 'true') {
        const isDark = (localStorage.getItem('theme') ?? 'light') === 'dark';
        Swal.fire({
            icon: 'success',
            title: '¡Entrega confirmada!',
            text: 'La evidencia fue registrada correctamente.',
            confirmButtonText: 'Aceptar',
            confirmButtonColor: isDark ? '#3b82f6' : '#2563eb',
            background: isDark ? '#1e293b' : '#ffffff',
            color: isDark ? '#f1f5f9' : '#1e293b',
        }).then(() => {
            history.replaceState(null, '', '/delivery');
        });
    }
</script>

<script>
    if (new URLSearchParams(window.location.search).get('failed') === 'true') {
        Swal.fire({
            icon: 'warning',
            title: '¡Intento fallido registrado!',
            text: 'El operador recibirá la notificación para reprogramar la entrega.',
            confirmButtonText: 'Aceptar',
            confirmButtonColor: '#2563eb',
        }).then(() => {
            history.replaceState(null, '', '/delivery');
        });
    }
</script>

</body>
</html>
