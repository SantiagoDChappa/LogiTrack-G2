<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>Dashboard - LogiTrack</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
</head>
<body>
    <%- include('partials/header') %>
    <main class="main-content">
        <div class="dashboard-wrapper">
            <div class="page-header">
                <h1>Inicio - Panel General</h1>
                <div class="header-quick-actions">
                    <a href="/shipment/new" class="btn-primary quick-btn">
                        <span class="material-symbols-outlined">add_box</span>
                        Crear Nuevo Envío
                    </a>
                    <a href="/shipment" class="btn-outline quick-btn">
                        <span class="material-symbols-outlined">search</span>
                        Buscar Envío por ID/DNI
                    </a>
                </div>
            </div>
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-info">
                        <span class="stat-label">Envíos Activos</span>
                        <span class="stat-value"><%= activeShipments %></span>
                    </div>
                    <div class="stat-icon icon-blue">
                        <span class="material-symbols-outlined">local_shipping</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-info">
                        <span class="stat-label">Entregas Hoy</span>
                        <span class="stat-value"><%= deliveriesToday %></span>
                    </div>
                    <div class="stat-icon icon-green">
                        <span class="material-symbols-outlined">inventory_2</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-info">
                        <span class="stat-label">Alertas de Demora</span>
                        <span class="stat-value"><%= delayAlerts %></span>
                    </div>
                    <div class="stat-icon icon-orange">
                        <span class="material-symbols-outlined">warning</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-info">
                        <span class="stat-label">Registros Nuevos</span>
                        <span class="stat-value"><%= newRecords %></span>
                    </div>
                    <div class="stat-icon icon-teal">
                        <span class="material-symbols-outlined">note_add</span>
                    </div>
                </div>
                <div class="stat-card stat-card--clickable" onclick="document.getElementById('modal-ocupados').showModal()">
                    <div class="stat-info">
                        <span class="stat-label">Repartidores Ocupados</span>
                        <span class="stat-value"><%= busyDeliveryUsers.length %></span>
                    </div>
                    <div class="stat-icon icon-orange">
                        <span class="material-symbols-outlined">directions_bike</span>
                    </div>
                </div>
                <div class="stat-card stat-card--clickable" onclick="document.getElementById('modal-disponibles').showModal()">
                    <div class="stat-info">
                        <span class="stat-label">Repartidores Disponibles</span>
                        <span class="stat-value"><%= availableDeliveryUsers.length %></span>
                    </div>
                    <div class="stat-icon icon-green">
                        <span class="material-symbols-outlined">check_circle</span>
                    </div>
                </div>
            </div>
            <!-- Modal Ocupados -->
            <dialog id="modal-ocupados" class="delivery-modal">
                <div class="delivery-modal-header">
                    <h2><span class="material-symbols-outlined">directions_bike</span> Repartidores Ocupados</h2>
                    <button onclick="document.getElementById('modal-ocupados').close()" class="modal-close-btn">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <div class="delivery-modal-body">
                    <% if (busyDeliveryUsers.length === 0) { %>
                        <p class="empty-state">No hay repartidores ocupados.</p>
                    <% } else { %>
                        <table class="delivery-modal-table">
                            <thead>
                                <tr>
                                    <th>Repartidor</th>
                                    <th>Envíos Activos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% busyDeliveryUsers.forEach(u => { %>
                                    <tr>
                                        <td><%= u.fullName %></td>
                                        <td><span class="badge-count"><%= u.shipmentCount %></span></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
            </dialog>

            <!-- Modal Disponibles -->
            <dialog id="modal-disponibles" class="delivery-modal">
                <div class="delivery-modal-header">
                    <h2><span class="material-symbols-outlined">check_circle</span> Repartidores Disponibles</h2>
                    <button onclick="document.getElementById('modal-disponibles').close()" class="modal-close-btn">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <div class="delivery-modal-body">
                    <% if (availableDeliveryUsers.length === 0) { %>
                        <p class="empty-state">No hay repartidores disponibles.</p>
                    <% } else { %>
                        <table class="delivery-modal-table">
                            <thead>
                                <tr>
                                    <th>Repartidor</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% availableDeliveryUsers.forEach(u => { %>
                                    <tr>
                                        <td><%= u.fullName %></td>
                                        <td><span class="badge-available">Disponible</span></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
            </dialog>
            <div class="bottom-grid">
                <div class="card estado-envios">
                    <h2>Total de envíos por estado</h2>
                    <% if (statusTotals.length === 0) { %>
                        <p class="empty-state">Todavía no hay envíos registrados.</p>
                    <% } else { %>
                        <div class="status-total-list">
                            <% statusTotals.forEach(item => { %>
                                <a href="/shipment/search?statusIds=<%= item.id %>" class="status-total-row">
                                    <span class="status-badge <%= item.key %>"><%= item.label %></span>
                                    <span class="status-total-value"><%= item.total %></span>
                                </a>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
                <div class="card" style="grid-column: span 2;">
                    <h2>Densidad de envíos (heatmap)</h2>
                    <div id="dashboard-heatmap" style="height:340px;border-radius:8px;overflow:hidden;border:1px solid var(--color-border);"></div>
                </div>
                <div class="card">
                    <h2>Saturación por sucursal</h2>
                    <% if (!branchSaturation || branchSaturation.length === 0) { %>
                        <p class="empty-state">Sin envíos pendientes.</p>
                    <% } else { %>
                        <canvas id="chart-saturacion" height="180"></canvas>
                    <% } %>
                </div>
                <div class="card ultima-actividad">
                    <h2>Última Actividad</h2>
                    <table class="activity-table">
                        <thead>
                            <tr>
                                <th>ID de rastreo</th>
                                <th>Destinatario</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (lastActivity.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="empty-row">Sin actividad reciente</td>
                                </tr>
                            <% } else { %>
                                <% lastActivity.forEach(s => { %>
                                    <tr>
                                        <td class="tracking-id"><%= s.trackingId %></td>
                                        <td>
                                            <span class="dest-nombre"><%= s.recipient.fullName %></span>
                                            <span class="dest-dni">DNI: <%= s.recipient.document %></span>
                                        </td>
                                        <td>
                                            <% const _sk = s.status.description.toLowerCase().replace(/[\s-]+/g, '_'); %>
                                            <% const _sl = {pendiente:'Pendiente',en_transito:'En Tránsito',entregado:'Entregado',cancelado:'Cancelado',cancelada:'Cancelada',retrasado:'Retrasado',en_sucursal:'En Sucursal',inicial:'Inicial',asignado:'Asignado',en_preparacion:'En Preparación',paquete_fallido:'Paquete Fallido',intento_fallido:'Intento Fallido'}; %>
                                            <span class="status-badge <%= _sk %>">
                                                <%= _sl[_sk] || s.status.description %>
                                            </span>
                                        </td>
                                        <td>
                                            <a href="/shipment/detail/<%= s.id %>" class="btn-ver-detalle">Ver Detalle</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                <div class="card entregas-card">
                    <h2>Entregas Completadas por Día</h2>
                    <canvas id="chart-entregas" height="80"></canvas>
                </div>
            </div>
        </div>
    </main>
    <!-- Gráfico entregas por día + heatmap + saturación -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
    <script>
    (function(){
        const heatmapPoints = <%- JSON.stringify(heatmapPoints || []) %>;
        const branchSaturation = <%- JSON.stringify(branchSaturation || []) %>;

        const heatEl = document.getElementById('dashboard-heatmap');
        if (heatEl && heatmapPoints.length > 0) {
            const map = L.map('dashboard-heatmap').setView([-34.6, -58.4], 5);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OSM' }).addTo(map);
            const data = heatmapPoints.map(p => [p.lat, p.lng, 0.5]);
            L.heatLayer(data, { radius: 22, blur: 18, maxZoom: 11 }).addTo(map);
            try { map.fitBounds(data.map(d => [d[0], d[1]]), { padding: [20,20] }); } catch(_) {}
        } else if (heatEl) {
            heatEl.innerHTML = '<p style="padding:1rem;color:var(--color-text-muted)">Sin envíos activos para mapear.</p>';
        }

        const satEl = document.getElementById('chart-saturacion');
        if (satEl && branchSaturation.length > 0) {
            new Chart(satEl.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: branchSaturation.map(b => b.name.replace(/^Sucursal /,'')),
                    datasets: [{
                        label: 'Pendientes',
                        data: branchSaturation.map(b => b.pending),
                        backgroundColor: 'rgba(59,130,246,0.7)',
                        borderColor: 'rgba(59,130,246,1)',
                        borderWidth: 1, borderRadius: 6,
                    }],
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, ticks: { color: '#94a3b8', stepSize: 1 }, grid: { color: 'rgba(255,255,255,0.05)' } },
                        y: { ticks: { color: '#94a3b8' }, grid: { display: false } }
                    }
                }
            });
        }
    })();
    </script>
    <script>
        const deliveriesByDay = <%- JSON.stringify(deliveriesByDay) %>;
        const labels = deliveriesByDay.map(d => {
            const date = new Date(d.date + 'T00:00:00');
            return date.toLocaleDateString('es-AR', { weekday: 'short', day: 'numeric', month: 'short' });
        });
        const data = deliveriesByDay.map(d => d.count);

        const ctx = document.getElementById('chart-entregas').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Entregas',
                    data,
                    backgroundColor: 'rgba(34, 197, 94, 0.7)',
                    borderColor: 'rgba(34, 197, 94, 1)',
                    borderWidth: 1,
                    borderRadius: 6,
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, color: '#94a3b8' },
                        grid: { color: 'rgba(255,255,255,0.05)' }
                    },
                    x: {
                        ticks: { color: '#94a3b8' },
                        grid: { display: false }
                    }
                }
             }
        });
    </script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
