<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Reporte - Comparación de Períodos</title>
    <link rel="stylesheet" href="/css/report.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="report-wrapper">

            <div class="page-header">
                <h1>Comparación de Períodos</h1>
            </div>

            <div class="report-card filter-card">
                <form method="GET" action="/report/period-comparison" id="report-form" novalidate>
                    <div class="filter-row">
                        <div class="filter-field">
                            <label for="from">Fecha de inicio</label>
                            <input type="date" id="from" name="from" value="<%= dateFrom %>" required>
                        </div>
                        <div class="filter-field">
                            <label for="to">Fecha de fin</label>
                            <input type="date" id="to" name="to" value="<%= dateTo %>" required>
                        </div>
                        <div class="filter-actions">
                            <button type="submit" class="action-btn action-btn--lg buscar" data-tooltip="Consultar" aria-label="Consultar">
                                <span class="material-symbols-outlined">search</span>
                            </button>
                            <% if (hasQuery) { %>
                                <a href="/report/period-comparison" class="action-btn action-btn--lg neutro" data-tooltip="Limpiar" aria-label="Limpiar">
                                    <span class="material-symbols-outlined">refresh</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                    <% if (error) { %>
                        <div class="report-alert report-alert--error">
                            <span class="material-symbols-outlined">error</span>
                            <%= error %>
                        </div>
                    <% } %>
                </form>
            </div>

            <% if (!error && rows && rows.length > 0) { %>
                <div class="report-card">
                    <div class="dp-table-header">
                        <h2>Período actual: <strong><%= dateFrom %></strong> → <strong><%= dateTo %></strong></h2>
                        <span class="dp-sort-hint" style="font-size:0.85rem;color:var(--color-text-muted)">
                            Período anterior: <%= prevDateFrom %> → <%= prevDateTo %> &nbsp;|&nbsp;
                            Mismo período año anterior: <%= yearAgoFrom %> → <%= yearAgoTo %>
                        </span>
                    </div>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th>Indicador</th>
                                <th class="text-right">Período actual</th>
                                <th class="text-right">Período anterior</th>
                                <th class="text-right">Año anterior</th>
                                <th class="text-right">Var. vs anterior</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% rows.forEach(row => { %>
                                <%
                                    const varMes = row.var_mes;
                                    let varClass = '';
                                    if (varMes !== null) {
                                        const positive = varMes > 0;
                                        const good = row.invert ? !positive : positive;
                                        varClass = varMes === 0 ? '' : (good ? 'ot-badge--green' : 'ot-badge--red');
                                    }
                                    const varSign = varMes !== null && varMes > 0 ? '+' : '';
                                %>
                                <tr>
                                    <td><strong><%= row.label %></strong></td>
                                    <td class="text-right">
                                        <% if (row.current !== null) { %>
                                            <strong><%= row.current %><%= row.unit !== '#' ? ' ' + row.unit : '' %></strong>
                                        <% } else { %>
                                            <span class="dp-na">—</span>
                                        <% } %>
                                    </td>
                                    <td class="text-right">
                                        <% if (row.previous !== null) { %>
                                            <%= row.previous %><%= row.unit !== '#' ? ' ' + row.unit : '' %>
                                        <% } else { %>
                                            <span class="dp-na">—</span>
                                        <% } %>
                                    </td>
                                    <td class="text-right">
                                        <% if (row.year_ago !== null) { %>
                                            <%= row.year_ago %><%= row.unit !== '#' ? ' ' + row.unit : '' %>
                                        <% } else { %>
                                            <span class="dp-na">—</span>
                                        <% } %>
                                    </td>
                                    <td class="text-right">
                                        <% if (varMes !== null) { %>
                                            <span class="ot-badge <%= varClass %>">
                                                <%= varSign %><%= varMes %><%= row.unit === 'pts' ? ' pts' : row.unit === '%' ? ' pp' : '' %>
                                            </span>
                                        <% } else { %>
                                            <span class="dp-na">—</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>

        </div>
    </main>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script>
        document.getElementById('report-form').addEventListener('submit', function (e) {
            const from = document.getElementById('from').value;
            const to   = document.getElementById('to').value;
            if (from && to && from > to) {
                e.preventDefault();
                const existing = this.querySelector('.report-alert');
                if (!existing) {
                    const alert = document.createElement('div');
                    alert.className = 'report-alert report-alert--error';
                    alert.innerHTML = '<span class="material-symbols-outlined">error</span> La fecha de inicio no puede ser mayor a la fecha de fin.';
                    this.querySelector('.filter-row').insertAdjacentElement('afterend', alert);
                }
            }
        });
    </script>
</body>
</html>
