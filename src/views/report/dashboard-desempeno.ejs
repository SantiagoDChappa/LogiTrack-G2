<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Análisis de Desempeño</title>
    <link rel="stylesheet" href="/css/report.css">
    <style>
        .dash-kpi-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:1rem; margin-bottom:1.5rem; }
        .dash-kpi { background:var(--color-surface); border:1px solid var(--color-border); border-radius:8px; padding:1.2rem 1.4rem; }
        .dash-kpi__label { font-size:.78rem; color:var(--color-text-muted); letter-spacing:.04em; margin-bottom:.4rem; }
        .dash-kpi__value { font-size:2rem; font-weight:700; line-height:1; }
        .dash-kpi__value--warn { color:#e07b00; }
        .dash-kpi__value--ok { color:var(--color-success,#2e7d32); }
        .dash-kpi__value--danger { color:var(--color-danger,#c62828); }
        .dash-tabs { display:flex; gap:.5rem; margin-bottom:1rem; flex-wrap:wrap; }
        .dash-tab { padding:.4rem 1rem; border-radius:6px; border:1px solid var(--color-border);
                    background:var(--color-surface); cursor:pointer; font-size:.88rem; }
        .dash-tab.active { background:var(--color-primary,#1565c0); color:#fff; border-color:var(--color-primary,#1565c0); }
        .dash-tab-panel { display:none; }
        .dash-tab-panel.active { display:block; }

        /* ── Tooltip informativo inline ── */
        .info-tip {
            display: inline-flex;
            align-items: center;
            position: relative;
            cursor: help;
            color: var(--color-text-muted);
            font-size: .85rem;
            vertical-align: middle;
            margin-left: .3rem;
        }
        .info-tip::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: calc(100% + 7px);
            left: 50%;
            transform: translateX(-50%);
            background: var(--color-surface-elevated, #1e293b);
            color: var(--color-text, #f1f5f9);
            font-size: .77rem;
            font-weight: 400;
            line-height: 1.45;
            padding: .5rem .7rem;
            border-radius: 6px;
            white-space: normal;
            width: 230px;
            text-align: left;
            pointer-events: none;
            opacity: 0;
            transition: opacity .15s;
            z-index: 30;
            box-shadow: 0 4px 14px rgba(0,0,0,.22);
        }
        .info-tip:hover::after { opacity: 1; }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="report-wrapper">

            <div class="page-header">
                <h1>Análisis de Desempeño</h1>
                <p class="dash-hint" style="margin-top:.25rem;">Compara los tiempos estimados vs. reales de entrega, segmentado por zona, repartidor, sucursal y período. Permite identificar dónde se generan los mayores desvíos.</p>
            </div>

            <!-- Filtro -->
            <div class="report-card filter-card">
                <form method="GET" action="/dashboard/desempeno" id="report-form" novalidate>
                    <div class="filter-row">
                        <div class="filter-field">
                            <label for="from">Desde</label>
                            <input type="date" id="from" name="from" value="<%= dateFrom %>" required>
                        </div>
                        <div class="filter-field">
                            <label for="to">Hasta</label>
                            <input type="date" id="to" name="to" value="<%= dateTo %>" required>
                        </div>
                        <div class="filter-actions">
                            <button type="submit" class="action-btn action-btn--lg buscar" data-tooltip="Consultar" aria-label="Consultar">
                                <span class="material-symbols-outlined">search</span>
                            </button>
                            <% if (hasQuery) { %>
                                <a href="/dashboard/desempeno" class="action-btn action-btn--lg neutro" data-tooltip="Limpiar" aria-label="Limpiar">
                                    <span class="material-symbols-outlined">refresh</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                    <% if (error) { %>
                        <div class="report-alert report-alert--error">
                            <span class="material-symbols-outlined">error</span>
                            <%= error %>
                        </div>
                    <% } %>
                </form>
            </div>

            <% if (!error) { %>

            <!-- KPIs -->
            <div class="dash-kpi-grid">
                <div class="dash-kpi">
                    <div class="dash-kpi__label">
                        Entregas analizadas
                        <span class="info-tip" data-tooltip="Total de envíos entregados en el período que cuentan con datos de predicción completados. Solo estos entran en el cálculo de OTIF y delta.">
                            <span class="material-symbols-outlined" style="font-size:1rem;">info</span>
                        </span>
                    </div>
                    <div class="dash-kpi__value"><%= kpis.total || 0 %></div>
                </div>
                <div class="dash-kpi">
                    <div class="dash-kpi__label">
                        OTIF
                        <span class="info-tip" data-tooltip="On Time In Full: % de entregas realizadas en o antes de la fecha prometida al cliente. Verde ≥ 85%, amarillo ≥ 70%, rojo < 70%.">
                            <span class="material-symbols-outlined" style="font-size:1rem;">info</span>
                        </span>
                    </div>
                    <div class="dash-kpi__value <%= (kpis.otif_pct||0) >= 85 ? 'dash-kpi__value--ok' : (kpis.otif_pct||0) >= 70 ? 'dash-kpi__value--warn' : 'dash-kpi__value--danger' %>">
                        <%= kpis.otif_pct !== null ? kpis.otif_pct + '%' : '—' %>
                    </div>
                </div>
                <div class="dash-kpi">
                    <div class="dash-kpi__label">
                        Días estimados prom.
                        <span class="info-tip" data-tooltip="Promedio de días que el modelo de predicción estimó para completar cada entrega, desde la creación del envío.">
                            <span class="material-symbols-outlined" style="font-size:1rem;">info</span>
                        </span>
                    </div>
                    <div class="dash-kpi__value"><%= kpis.avg_predicted !== null ? kpis.avg_predicted + 'd' : '—' %></div>
                </div>
                <div class="dash-kpi">
                    <div class="dash-kpi__label">
                        Días reales prom.
                        <span class="info-tip" data-tooltip="Promedio de días que tardaron realmente las entregas, medido desde la creación del envío hasta la confirmación de entrega.">
                            <span class="material-symbols-outlined" style="font-size:1rem;">info</span>
                        </span>
                    </div>
                    <div class="dash-kpi__value"><%= kpis.avg_actual !== null ? kpis.avg_actual + 'd' : '—' %></div>
                </div>
                <div class="dash-kpi">
                    <div class="dash-kpi__label">
                        Delta prom. (desvío)
                        <span class="info-tip" data-tooltip="Diferencia promedio entre días reales y días estimados. Positivo = tardó más de lo previsto. Verde ≤ 0.3d, amarillo ≤ 1d, rojo > 1d.">
                            <span class="material-symbols-outlined" style="font-size:1rem;">info</span>
                        </span>
                    </div>
                    <div class="dash-kpi__value <%= (kpis.avg_delta||0) <= 0.3 ? 'dash-kpi__value--ok' : (kpis.avg_delta||0) <= 1 ? 'dash-kpi__value--warn' : 'dash-kpi__value--danger' %>">
                        <%= kpis.avg_delta !== null ? ((kpis.avg_delta > 0 ? '+' : '') + kpis.avg_delta + 'd') : '—' %>
                    </div>
                </div>
            </div>

            <!-- Tabs de segmentación -->
            <div class="dash-tabs">
                <button class="dash-tab active" onclick="switchTab(this,'tab-zone')" title="Ver desvíos agrupados por zona geográfica de entrega">Por Zona</button>
                <button class="dash-tab" onclick="switchTab(this,'tab-driver')" title="Ver desvíos por repartidor, considerando el viaje completo desde creación hasta entrega">Por Repartidor</button>
<button class="dash-tab" onclick="switchTab(this,'tab-branch')" title="Ver desvíos agrupados por sucursal (derivada del repartidor asignado)">Por Sucursal</button>
                <button class="dash-tab" onclick="switchTab(this,'tab-weekday')" title="Detectar qué días de la semana concentran más demoras">Por Día de la semana</button>
                <button class="dash-tab" onclick="switchTab(this,'tab-evolution')" title="Ver cómo evolucionó la eficiencia semana a semana dentro del período">Evolución semanal</button>
            </div>

            <!-- Por zona -->
            <div id="tab-zone" class="dash-tab-panel active report-card">
                <h2>Predicción vs. Realidad — por zona</h2>
                <% if (zonePvr.length === 0) { %>
                    <div class="report-empty-state"><span class="material-symbols-outlined">map</span><p>Sin datos en el período seleccionado.</p></div>
                <% } else { %>
                <table class="report-table" id="adm-zone-table">
                    <thead>
                        <tr>
                            <th class="sortable" data-col="zone_name">Zona <span class="sort-icon">↕</span></th>
                            <th class="sortable text-right" data-col="total">
                                Entregas <span class="sort-icon">↕</span>
                                <span class="info-tip" data-tooltip="Cantidad de entregas completadas en esa zona dentro del período.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="sortable text-right" data-col="avg_predicted">
                                Estimado <span class="sort-icon">↕</span>
                                <span class="info-tip" data-tooltip="Promedio de días que el modelo predijo para entregas en esta zona.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="sortable text-right" data-col="avg_actual">
                                Real <span class="sort-icon">↕</span>
                                <span class="info-tip" data-tooltip="Promedio de días que tardaron realmente las entregas en esta zona.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="sortable text-right" data-col="avg_delta">
                                Delta <span class="sort-icon">↕</span>
                                <span class="info-tip" data-tooltip="Desvío promedio (real − estimado). Verde ≤ 0.2d, amarillo ≤ 0.8d, rojo > 0.8d.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="sortable text-right" data-col="otif_pct">
                                OTIF <span class="sort-icon">↕</span>
                                <span class="info-tip" data-tooltip="% de entregas en esta zona realizadas en o antes de la fecha prometida. Verde ≥ 85%, amarillo ≥ 70%, rojo < 70%.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="adm-zone-tbody">
                        <% zonePvr.forEach(z => { %>
                        <%
                            const d = z.avg_delta || 0;
                            const dClass = d <= 0.2 ? 'ot-badge--green' : d <= 0.8 ? 'ot-badge--amber' : 'ot-badge--red';
                        %>
                        <tr data-zone_name="<%= z.zone_name %>" data-total="<%= z.total %>"
                            data-avg_predicted="<%= z.avg_predicted %>" data-avg_actual="<%= z.avg_actual %>"
                            data-avg_delta="<%= z.avg_delta %>" data-otif_pct="<%= z.otif_pct %>">
                            <td><%= z.zone_name || '—' %></td>
                            <td class="text-right count-cell"><%= z.total %></td>
                            <td class="text-right"><%= z.avg_predicted %>d</td>
                            <td class="text-right"><%= z.avg_actual %>d</td>
                            <td class="text-right"><span class="ot-badge <%= dClass %>"><%= d > 0 ? '+' : '' %><%= d %>d</span></td>
                            <td class="text-right">
                                <div class="dp-pct-cell">
                                    <div class="dp-pct-bar-track">
                                        <div class="dp-pct-bar-fill <%= (z.otif_pct||0) >= 85 ? 'fill--green' : (z.otif_pct||0) >= 70 ? 'fill--amber' : 'fill--red' %>"
                                             style="width:<%= z.otif_pct || 0 %>%"></div>
                                    </div>
                                    <span class="dp-pct-label"><%= z.otif_pct || 0 %>%</span>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <% } %>
            </div>

            <!-- Por repartidor -->
            <div id="tab-driver" class="dash-tab-panel report-card">
                <h2>Desvío por repartidor — viaje completo</h2>
                <p class="dash-hint">El delta refleja el viaje total (creación → entrega), no solo la última milla.</p>
                <% if (driverPvr.length === 0) { %>
                    <div class="report-empty-state"><span class="material-symbols-outlined">person_off</span><p>Sin datos en el período seleccionado.</p></div>
                <% } else { %>
                <table class="report-table" id="adm-driver-table">
                    <thead>
                        <tr>
                            <th class="sortable" data-col="driver_name">Repartidor <span class="sort-icon">↕</span></th>
                            <th class="sortable text-right" data-col="total">
                                Entregas <span class="sort-icon">↕</span>
                                <span class="info-tip" data-tooltip="Cantidad de entregas completadas por este repartidor en el período.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="sortable text-right" data-col="avg_predicted">
                                Estimado <span class="sort-icon">↕</span>
                                <span class="info-tip" data-tooltip="Promedio de días estimados por el modelo para los envíos asignados a este repartidor.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="sortable text-right" data-col="avg_actual">
                                Real <span class="sort-icon">↕</span>
                                <span class="info-tip" data-tooltip="Promedio de días reales que tardaron las entregas de este repartidor.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="sortable text-right" data-col="avg_delta">
                                Delta <span class="sort-icon">↕</span>
                                <span class="info-tip" data-tooltip="Desvío promedio (real − estimado) del repartidor. Un delta alto indica que este repartidor tarda más de lo previsto. Verde ≤ 0.2d, amarillo ≤ 0.8d, rojo > 0.8d.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="sortable text-right" data-col="otif_pct">
                                OTIF <span class="sort-icon">↕</span>
                                <span class="info-tip" data-tooltip="% de entregas de este repartidor realizadas en o antes de la fecha prometida.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="adm-driver-tbody">
                        <% driverPvr.forEach(d => { %>
                        <%
                            const delta = d.avg_delta || 0;
                            const dClass = delta <= 0.2 ? 'ot-badge--green' : delta <= 0.8 ? 'ot-badge--amber' : 'ot-badge--red';
                        %>
                        <tr data-driver_name="<%= d.driver_name %>" data-total="<%= d.total %>"
                            data-avg_predicted="<%= d.avg_predicted %>" data-avg_actual="<%= d.avg_actual %>"
                            data-avg_delta="<%= d.avg_delta %>" data-otif_pct="<%= d.otif_pct %>">
                            <td>
                                <div class="dp-driver-cell">
                                    <div class="dp-avatar"><%= (d.driver_name || '?').split(' ').slice(0,2).map(w => w[0]).join('').toUpperCase() %></div>
                                    <%= d.driver_name || '—' %>
                                </div>
                            </td>
                            <td class="text-right count-cell"><%= d.total %></td>
                            <td class="text-right"><%= d.avg_predicted %>d</td>
                            <td class="text-right"><%= d.avg_actual %>d</td>
                            <td class="text-right"><span class="ot-badge <%= dClass %>"><%= delta > 0 ? '+' : '' %><%= delta %>d</span></td>
                            <td class="text-right">
                                <div class="dp-pct-cell">
                                    <div class="dp-pct-bar-track">
                                        <div class="dp-pct-bar-fill <%= (d.otif_pct||0) >= 85 ? 'fill--green' : (d.otif_pct||0) >= 70 ? 'fill--amber' : 'fill--red' %>"
                                             style="width:<%= d.otif_pct || 0 %>%"></div>
                                    </div>
                                    <span class="dp-pct-label"><%= d.otif_pct || 0 %>%</span>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <% } %>
            </div>

            <!-- Por sucursal -->
            <div id="tab-branch" class="dash-tab-panel report-card">
                <h2>Predicción vs. Realidad — por sucursal</h2>
                <p class="dash-hint">Sucursal derivada del repartidor asignado al envío.</p>
                <% if (branchPvr.length === 0) { %>
                    <div class="report-empty-state"><span class="material-symbols-outlined">store</span><p>Sin datos en el período seleccionado.</p></div>
                <% } else { %>
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Sucursal</th>
                            <th class="text-right">
                                Entregas
                                <span class="info-tip" data-tooltip="Cantidad de entregas completadas por repartidores de esta sucursal en el período.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="text-right">
                                Estimado
                                <span class="info-tip" data-tooltip="Promedio de días estimados por el modelo para los envíos de esta sucursal.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="text-right">
                                Real
                                <span class="info-tip" data-tooltip="Promedio de días reales que tardaron las entregas de esta sucursal.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="text-right">
                                Delta
                                <span class="info-tip" data-tooltip="Desvío promedio (real − estimado) para esta sucursal. Verde ≤ 0.2d, amarillo ≤ 0.8d, rojo > 0.8d.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="text-right">
                                OTIF
                                <span class="info-tip" data-tooltip="% de entregas de esta sucursal realizadas en o antes de la fecha prometida.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <% branchPvr.forEach(b => { %>
                        <%
                            const delta = b.avg_delta || 0;
                            const dClass = delta <= 0.2 ? 'ot-badge--green' : delta <= 0.8 ? 'ot-badge--amber' : 'ot-badge--red';
                        %>
                        <tr>
                            <td><%= b.branch_name || '—' %></td>
                            <td class="text-right"><%= b.total %></td>
                            <td class="text-right"><%= b.avg_predicted %>d</td>
                            <td class="text-right"><%= b.avg_actual %>d</td>
                            <td class="text-right"><span class="ot-badge <%= dClass %>"><%= delta > 0 ? '+' : '' %><%= delta %>d</span></td>
                            <td class="text-right">
                                <div class="dp-pct-cell">
                                    <div class="dp-pct-bar-track">
                                        <div class="dp-pct-bar-fill <%= (b.otif_pct||0) >= 85 ? 'fill--green' : (b.otif_pct||0) >= 70 ? 'fill--amber' : 'fill--red' %>"
                                             style="width:<%= b.otif_pct || 0 %>%"></div>
                                    </div>
                                    <span class="dp-pct-label"><%= b.otif_pct || 0 %>%</span>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <% } %>
            </div>

            <!-- Por día de la semana -->
            <div id="tab-weekday" class="dash-tab-panel report-card">
                <h2>
                    Desvío por día de la semana
                    <span class="info-tip" data-tooltip="Agrupa todas las entregas del período según el día de la semana en que se completaron. Útil para detectar patrones: por ejemplo, si los lunes tienen más demoras por acumulación del fin de semana.">
                        <span class="material-symbols-outlined" style="font-size:1.1rem;">info</span>
                    </span>
                </h2>
                <% if (byDayOfWeek.length === 0) { %>
                    <div class="report-empty-state"><span class="material-symbols-outlined">calendar_month</span><p>Sin datos en el período seleccionado.</p></div>
                <% } else { %>
                <div style="position:relative;height:240px;margin-bottom:1.5rem;">
                    <canvas id="weekday-chart"></canvas>
                </div>
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Día</th>
                            <th class="text-right">
                                Entregas
                                <span class="info-tip" data-tooltip="Cantidad de entregas completadas en ese día de la semana dentro del período.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="text-right">
                                Delta prom.
                                <span class="info-tip" data-tooltip="Desvío promedio (real − estimado) para las entregas de ese día. Verde ≤ 0.2d, amarillo ≤ 0.8d, rojo > 0.8d.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="text-right">
                                OTIF
                                <span class="info-tip" data-tooltip="% de entregas completadas ese día de la semana que cumplieron la fecha prometida.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <% byDayOfWeek.forEach(d => { %>
                        <%
                            const delta = d.avg_delta || 0;
                            const dClass = delta <= 0.2 ? 'ot-badge--green' : delta <= 0.8 ? 'ot-badge--amber' : 'ot-badge--red';
                        %>
                        <tr>
                            <td><strong><%= d.day_label %></strong></td>
                            <td class="text-right"><%= d.total %></td>
                            <td class="text-right"><span class="ot-badge <%= dClass %>"><%= delta > 0 ? '+' : '' %><%= delta %>d</span></td>
                            <td class="text-right"><%= d.otif_pct || 0 %>%</td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <% } %>
            </div>

            <!-- Evolución semanal -->
            <div id="tab-evolution" class="dash-tab-panel report-card">
                <h2>
                    Evolución semanal de eficiencia
                    <span class="info-tip" data-tooltip="Muestra cómo cambió el delta y el OTIF semana a semana dentro del período seleccionado. Permite detectar tendencias de mejora o deterioro.">
                        <span class="material-symbols-outlined" style="font-size:1.1rem;">info</span>
                    </span>
                </h2>
                <% if (weeklyEvolution.length === 0) { %>
                    <div class="report-empty-state"><span class="material-symbols-outlined">show_chart</span><p>Sin datos en el período seleccionado.</p></div>
                <% } else { %>
                <div style="position:relative;height:260px;margin-bottom:1.5rem;">
                    <canvas id="evolution-chart"></canvas>
                </div>
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>
                                Semana
                                <span class="info-tip" data-tooltip="Fecha de inicio de la semana (lunes). Cada fila agrupa todas las entregas confirmadas en esa semana.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="text-right">
                                Entregas
                                <span class="info-tip" data-tooltip="Cantidad de entregas completadas en esa semana.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="text-right">
                                Delta prom.
                                <span class="info-tip" data-tooltip="Desvío promedio (real − estimado) de esa semana. Verde ≤ 0.2d, amarillo ≤ 0.8d, rojo > 0.8d.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                            <th class="text-right">
                                OTIF
                                <span class="info-tip" data-tooltip="% de entregas de esa semana realizadas en o antes de la fecha prometida.">
                                    <span class="material-symbols-outlined" style="font-size:.9rem;">info</span>
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <% weeklyEvolution.forEach(w => { %>
                        <%
                            const delta = w.avg_delta || 0;
                            const dClass = delta <= 0.2 ? 'ot-badge--green' : delta <= 0.8 ? 'ot-badge--amber' : 'ot-badge--red';
                        %>
                        <tr>
                            <td><%= w.week_start %></td>
                            <td class="text-right"><%= w.total %></td>
                            <td class="text-right"><span class="ot-badge <%= dClass %>"><%= delta > 0 ? '+' : '' %><%= delta %>d</span></td>
                            <td class="text-right">
                                <div class="dp-pct-cell">
                                    <div class="dp-pct-bar-track">
                                        <div class="dp-pct-bar-fill <%= (w.otif_pct||0) >= 85 ? 'fill--green' : (w.otif_pct||0) >= 70 ? 'fill--amber' : 'fill--red' %>"
                                             style="width:<%= w.otif_pct || 0 %>%"></div>
                                    </div>
                                    <span class="dp-pct-label"><%= w.otif_pct || 0 %>%</span>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <% } %>
            </div>

            <% } %>
        </div>
    </main>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const isDark = document.documentElement.dataset.theme === 'dark' || document.body.classList.contains('dark');
            const textColor = isDark ? '#94a3b8' : '#64748b';
            const gridColor = isDark ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.07)';

            // ── Gráfico: delta por día de la semana ──
            const weekdayCanvas = document.getElementById('weekday-chart');
            if (weekdayCanvas) {
                const raw = <%- JSON.stringify(byDayOfWeek) %>;
                new Chart(weekdayCanvas, {
                    data: {
                        labels: raw.map(r => r.day_label),
                        datasets: [
                            {
                                type: 'bar',
                                label: 'Delta prom. (días)',
                                data: raw.map(r => r.avg_delta || 0),
                                backgroundColor: raw.map(r => {
                                    const d = r.avg_delta || 0;
                                    return d <= 0.2 ? 'rgba(34,197,94,.55)' : d <= 0.8 ? 'rgba(251,146,60,.55)' : 'rgba(239,68,68,.55)';
                                }),
                                borderColor: raw.map(r => {
                                    const d = r.avg_delta || 0;
                                    return d <= 0.2 ? 'rgba(34,197,94,.9)' : d <= 0.8 ? 'rgba(251,146,60,.9)' : 'rgba(239,68,68,.9)';
                                }),
                                borderWidth: 1,
                                borderRadius: 4,
                                yAxisID: 'yDelta',
                                order: 2,
                            },
                            {
                                type: 'line',
                                label: 'OTIF %',
                                data: raw.map(r => r.otif_pct || 0),
                                borderColor: 'rgba(99,102,241,.9)',
                                backgroundColor: 'transparent',
                                borderWidth: 2,
                                pointRadius: 4,
                                tension: 0.3,
                                yAxisID: 'yPct',
                                order: 1,
                            },
                        ],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { position: 'top', labels: { color: textColor, font: { size: 12 }, padding: 16 } },
                            tooltip: {
                                callbacks: {
                                    label: ctx => ctx.dataset.yAxisID === 'yDelta'
                                        ? ` Delta: ${ctx.parsed.y > 0 ? '+' : ''}${ctx.parsed.y}d`
                                        : ` OTIF: ${ctx.parsed.y}%`,
                                },
                            },
                        },
                        scales: {
                            x: { ticks: { color: textColor }, grid: { color: gridColor } },
                            yDelta: {
                                type: 'linear', position: 'left',
                                ticks: { color: textColor, callback: v => v + 'd' },
                                grid: { color: gridColor },
                                title: { display: true, text: 'Desvío (días)', color: textColor, font: { size: 11 } },
                            },
                            yPct: {
                                type: 'linear', position: 'right',
                                min: 0, max: 100,
                                ticks: { color: textColor, callback: v => v + '%' },
                                grid: { display: false },
                                title: { display: true, text: 'OTIF %', color: textColor, font: { size: 11 } },
                            },
                        },
                    },
                });
            }

            // ── Gráfico: evolución semanal ──
            const evolutionCanvas = document.getElementById('evolution-chart');
            if (evolutionCanvas) {
                const raw = <%- JSON.stringify(weeklyEvolution) %>;
                new Chart(evolutionCanvas, {
                    data: {
                        labels: raw.map(r => r.week_start),
                        datasets: [
                            {
                                type: 'bar',
                                label: 'Entregas',
                                data: raw.map(r => r.total),
                                backgroundColor: 'rgba(99,102,241,.25)',
                                borderColor: 'rgba(99,102,241,.6)',
                                borderWidth: 1,
                                borderRadius: 4,
                                yAxisID: 'yVol',
                                order: 2,
                            },
                            {
                                type: 'line',
                                label: 'OTIF %',
                                data: raw.map(r => r.otif_pct || 0),
                                borderColor: 'rgba(34,197,94,.9)',
                                backgroundColor: 'rgba(34,197,94,.1)',
                                borderWidth: 2,
                                pointRadius: 4,
                                tension: 0.3,
                                fill: false,
                                yAxisID: 'yPct',
                                order: 1,
                            },
                            {
                                type: 'line',
                                label: 'Delta prom.',
                                data: raw.map(r => r.avg_delta || 0),
                                borderColor: 'rgba(251,146,60,.9)',
                                backgroundColor: 'transparent',
                                borderWidth: 2,
                                borderDash: [5, 4],
                                pointRadius: 3,
                                tension: 0.3,
                                fill: false,
                                yAxisID: 'yDelta',
                                order: 1,
                            },
                        ],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { position: 'top', labels: { color: textColor, font: { size: 12 }, padding: 16 } },
                            tooltip: {
                                callbacks: {
                                    label: ctx => {
                                        if (ctx.dataset.yAxisID === 'yVol') return ` Entregas: ${ctx.parsed.y}`;
                                        if (ctx.dataset.yAxisID === 'yDelta') return ` Delta: ${ctx.parsed.y > 0 ? '+' : ''}${ctx.parsed.y}d`;
                                        return ` OTIF: ${ctx.parsed.y}%`;
                                    },
                                },
                            },
                        },
                        scales: {
                            x: { ticks: { color: textColor, maxRotation: 45 }, grid: { color: gridColor } },
                            yVol: {
                                type: 'linear', position: 'left',
                                ticks: { color: textColor, stepSize: 1 },
                                grid: { color: gridColor },
                                title: { display: true, text: 'Entregas', color: textColor, font: { size: 11 } },
                            },
                            yPct: {
                                type: 'linear', position: 'right',
                                min: 0, max: 100,
                                ticks: { color: textColor, callback: v => v + '%' },
                                grid: { display: false },
                                title: { display: true, text: 'OTIF %', color: textColor, font: { size: 11 } },
                            },
                            yDelta: {
                                type: 'linear', position: 'right',
                                ticks: { color: textColor, callback: v => v + 'd' },
                                grid: { display: false },
                                display: false,
                            },
                        },
                    },
                });
            }
        })();
    </script>
    <script>
        document.getElementById('report-form').addEventListener('submit', function (e) {
            const from = document.getElementById('from').value, to = document.getElementById('to').value;
            if (from && to && from > to) {
                e.preventDefault();
                if (!this.querySelector('.report-alert')) {
                    const a = document.createElement('div');
                    a.className = 'report-alert report-alert--error';
                    a.innerHTML = '<span class="material-symbols-outlined">error</span> La fecha de inicio no puede ser mayor a la fecha de fin.';
                    this.querySelector('.filter-row').insertAdjacentElement('afterend', a);
                }
            }
        });

        function switchTab(btn, panelId) {
            document.querySelectorAll('.dash-tab').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.dash-tab-panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById(panelId).classList.add('active');
        }

        (function makeSortable(tableId, tbodyId) {
            const tbody = document.getElementById(tbodyId);
            if (!tbody) return;
            let lastCol = null, asc = true;
            document.querySelectorAll('#' + tableId + ' th.sortable').forEach(th => {
                th.style.cursor = 'pointer';
                th.addEventListener('click', () => {
                    const col = th.dataset.col;
                    if (lastCol === col) { asc = !asc; } else { asc = col.includes('name'); }
                    lastCol = col;
                    document.querySelectorAll('#' + tableId + ' .sort-icon').forEach(i => i.textContent = '↕');
                    th.querySelector('.sort-icon').textContent = asc ? '↑' : '↓';
                    const rows = Array.from(tbody.querySelectorAll('tr'));
                    rows.sort((a, b) => {
                        const va = a.dataset[col], vb = b.dataset[col];
                        const cmp = col.includes('name') ? va.localeCompare(vb,'es') : Number(va) - Number(vb);
                        return asc ? cmp : -cmp;
                    });
                    rows.forEach(r => tbody.appendChild(r));
                });
            });
        })('adm-zone-table', 'adm-zone-tbody');

        (function makeSortable(tableId, tbodyId) {
            const tbody = document.getElementById(tbodyId);
            if (!tbody) return;
            let lastCol = null, asc = true;
            document.querySelectorAll('#' + tableId + ' th.sortable').forEach(th => {
                th.style.cursor = 'pointer';
                th.addEventListener('click', () => {
                    const col = th.dataset.col;
                    if (lastCol === col) { asc = !asc; } else { asc = col.includes('name'); }
                    lastCol = col;
                    document.querySelectorAll('#' + tableId + ' .sort-icon').forEach(i => i.textContent = '↕');
                    th.querySelector('.sort-icon').textContent = asc ? '↑' : '↓';
                    const rows = Array.from(tbody.querySelectorAll('tr'));
                    rows.sort((a, b) => {
                        const va = a.dataset[col], vb = b.dataset[col];
                        const cmp = col.includes('name') ? va.localeCompare(vb,'es') : Number(va) - Number(vb);
                        return asc ? cmp : -cmp;
                    });
                    rows.forEach(r => tbody.appendChild(r));
                });
            });
        })('adm-driver-table', 'adm-driver-tbody');
    </script>
</body>
</html>
