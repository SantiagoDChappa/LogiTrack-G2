<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Panel de Operaciones</title>
    <link rel="stylesheet" href="/css/report.css">
    <style>
        .dash-kpi-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:1rem; margin-bottom:1rem; }
        .dash-kpi { background:var(--color-surface); border:1px solid var(--color-border); border-radius:8px; padding:1.2rem 1.4rem; cursor:default; }
        .dash-kpi__label { font-size:.78rem; color:var(--color-text-muted); text-transform:uppercase; letter-spacing:.04em; margin-bottom:.4rem; }
        .dash-kpi__value { font-size:2rem; font-weight:700; line-height:1; }
        .dash-kpi__value--sm { font-size:1.5rem; font-weight:700; line-height:1; }
        .dash-kpi__pct { font-size:.75rem; color:var(--color-text-muted); margin-top:.3rem; }
        .dash-kpi__value--warn { color:#e07b00; }
        .dash-kpi__value--ok { color:var(--color-success,#2e7d32); }
        .dash-kpi__value--danger { color:var(--color-danger,#c62828); }
        .dash-section-title { font-size:.82rem; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--color-text-muted); margin:.25rem 0 .6rem; }
        .dash-alert-badge { display:inline-block; padding:.2rem .6rem; border-radius:4px; font-size:.8rem; font-weight:600;
                            background:rgba(200,50,50,.12); color:#c62828; }
        .kpi-tip { display:inline-flex; align-items:center; justify-content:center; width:14px; height:14px; border-radius:50%;
                   background:var(--color-border,#e2e8f0); color:var(--color-text-muted,#64748b); font-size:.62rem; font-weight:700;
                   cursor:help; margin-left:.35rem; vertical-align:middle; position:relative; flex-shrink:0; }
        .kpi-tip::after { content:attr(data-tip); position:absolute; bottom:calc(100% + 8px); left:50%; transform:translateX(-50%);
                          background:#1e293b; color:#f1f5f9; font-size:.72rem; font-weight:400; text-transform:none; letter-spacing:0;
                          padding:.55rem .75rem; border-radius:6px; width:230px; white-space:normal; line-height:1.45;
                          opacity:0; pointer-events:none; transition:opacity .15s; z-index:200; box-shadow:0 4px 12px rgba(0,0,0,.25); }
        .kpi-tip:hover::after { opacity:1; }
        .kpi-tip::before { content:''; position:absolute; bottom:calc(100% + 2px); left:50%; transform:translateX(-50%);
                           border:5px solid transparent; border-top-color:#1e293b; opacity:0; pointer-events:none; transition:opacity .15s; }
        .kpi-tip:hover::before { opacity:1; }
        .status-chips { display:flex; flex-wrap:wrap; gap:.4rem; margin-bottom:.75rem; }
        .status-chip { padding:.28rem .75rem; border-radius:20px; border:1.5px solid var(--color-border); background:var(--color-surface);
                       font-size:.76rem; font-weight:500; cursor:pointer; transition:all .15s; color:var(--color-text-muted); }
        .status-chip.active { background:var(--color-primary,#1d4ed8); color:#fff; border-color:var(--color-primary,#1d4ed8); opacity:1; }
        .status-chip:not(.active) { opacity:.5; }
        .status-chip:hover { opacity:1; }
        .dash-hint { font-size:.85rem; color:var(--color-text-muted); margin:.25rem 0 1rem; }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="report-wrapper">

            <div class="page-header">
                <h1>Panel de Operaciones</h1>
            </div>

            <!-- Filtro -->
            <div class="report-card filter-card">
                <form method="GET" action="/dashboard/operaciones" id="report-form" novalidate>
                    <div class="filter-row">
                        <div class="filter-field">
                            <label for="from">Desde</label>
                            <input type="date" id="from" name="from" value="<%= dateFrom %>" required>
                        </div>
                        <div class="filter-field">
                            <label for="to">Hasta</label>
                            <input type="date" id="to" name="to" value="<%= dateTo %>" required>
                        </div>
                        <div class="filter-actions">
                            <button type="submit" class="action-btn action-btn--lg buscar" data-tooltip="Consultar" aria-label="Consultar">
                                <span class="material-symbols-outlined">search</span>
                            </button>
                            <% if (hasQuery) { %>
                                <a href="/dashboard/operaciones" class="action-btn action-btn--lg neutro" data-tooltip="Limpiar" aria-label="Limpiar">
                                    <span class="material-symbols-outlined">refresh</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                    <% if (error) { %>
                        <div class="report-alert report-alert--error">
                            <span class="material-symbols-outlined">error</span>
                            <%= error %>
                        </div>
                    <% } %>
                </form>
            </div>

            <% if (!error) { %>
            <%
                const statusCls = { 4:'dash-kpi__value--ok', 5:'dash-kpi__value--danger', 8:'dash-kpi__value--danger', 9:'dash-kpi__value--warn', 10:'dash-kpi__value--warn' };
            %>

            <!-- 1. Resumen rápido -->
            <div class="dash-kpi-grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin-bottom:1.5rem;">
                <div class="dash-kpi">
                    <div class="dash-kpi__label" style="display:flex;align-items:center;gap:.3rem;">
                        Envíos en el período
                        <span class="kpi-tip" data-tip="Total de envíos creados en el período seleccionado. Incluye todos los estados.">?</span>
                    </div>
                    <div class="dash-kpi__value"><%= kpis.total %></div>
                    <div class="dash-kpi__pct"><%= dateFrom %> — <%= dateTo %></div>
                </div>
                <div class="dash-kpi">
                    <div class="dash-kpi__label" style="display:flex;align-items:center;gap:.3rem;">
                        Con demora activa
                        <span class="kpi-tip" data-tip="Envíos del período que siguen en tránsito y ya superaron su fecha de entrega comprometida. Requieren atención inmediata.">?</span>
                    </div>
                    <div class="dash-kpi__value <%= kpis.delayed_count > 0 ? 'dash-kpi__value--danger' : 'dash-kpi__value--ok' %>"><%= kpis.delayed_count %></div>
                    <% if (kpis.total > 0) { %><div class="dash-kpi__pct"><%= Math.round(kpis.delayed_count / kpis.total * 100) %>% del total</div><% } %>
                </div>
                <div class="dash-kpi">
                    <div class="dash-kpi__label" style="display:flex;align-items:center;gap:.3rem;">
                        OTIF
                        <span class="kpi-tip" data-tip="On Time In Full: porcentaje de envíos del período entregados antes o en su fecha comprometida. Verde ≥ 85%, Amarillo 70–84%, Rojo < 70%.">?</span>
                    </div>
                    <div class="dash-kpi__value <%= kpis.otif_pct !== null && kpis.otif_pct >= 85 ? 'dash-kpi__value--ok' : kpis.otif_pct !== null && kpis.otif_pct >= 70 ? 'dash-kpi__value--warn' : 'dash-kpi__value--danger' %>">
                        <%= kpis.otif_pct !== null ? kpis.otif_pct + '%' : '—' %>
                    </div>
                    <% if (kpis.otif_delivered > 0) { %><div class="dash-kpi__pct"><%= kpis.otif_on_time %>/<%= kpis.otif_delivered %> entregas</div><% } %>
                </div>
            </div>

            <!-- 2. Distribución del período -->
            <% if (statusSummary.length > 0) { %>
            <p class="dash-section-title" style="display:flex;align-items:center;justify-content:space-between;">
                Distribución por estado
                <span style="font-size:.72rem;font-weight:400;text-transform:none;letter-spacing:0;opacity:.6;">Clic para mostrar u ocultar</span>
            </p>
            <div class="status-chips" id="status-chips">
                <% statusSummary.forEach(s => { %>
                <button type="button" class="status-chip active" data-status-id="<%= s.statusId %>"><%= s.status_label %></button>
                <% }) %>
            </div>
            <div class="dash-kpi-grid" id="status-kpi-grid">
                <% statusSummary.forEach(s => {
                    const pct = kpis.total > 0 ? Math.round(s.total / kpis.total * 100) : 0;
                %>
                <div class="dash-kpi" data-status-id="<%= s.statusId %>">
                    <div class="dash-kpi__label" style="display:flex;align-items:center;gap:.3rem;">
                        <%= s.status_label %>
                        <span class="kpi-tip" data-tip="Envíos creados en el período que están actualmente en estado '<%= s.status_label %>'. Representa el <%= pct %>% del total.">?</span>
                    </div>
                    <div class="dash-kpi__value--sm <%= statusCls[s.statusId] || '' %>"><%= s.total %></div>
                    <div class="dash-kpi__pct"><%= pct %>%</div>
                </div>
                <% }) %>
            </div>
            <% } %>

            <!-- 3. Alertas activas -->
            <p class="dash-section-title" style="margin-top:1.5rem;">Alertas activas</p>
            <p class="dash-hint">Las demoras reflejan el estado de hoy — envíos del período que aún no fueron entregados.</p>
            <% if (delayedShipments.length > 0) { %>
            <div class="report-card">
                <div class="dp-table-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem;">
                    <h2>Envíos con demora activa <span class="dash-alert-badge"><%= kpis.delayed_count %> alerta<%= kpis.delayed_count !== 1 ? 's' : '' %></span></h2>
                    <label style="font-size:.8rem;color:var(--color-text-muted);display:flex;align-items:center;gap:.4rem;">
                        Mostrar
                        <select id="delayed-limit-select" style="font-size:.8rem;padding:.2rem .4rem;border-radius:4px;border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text);">
                            <option value="7">7</option>
                            <option value="15">15</option>
                            <option value="25">25</option>
                        </select>
                    </label>
                </div>
                <p id="delayed-limit-note" style="font-size:.8rem;color:var(--color-text-muted);margin:.5rem 0 .75rem;text-align:center;"></p>
                <table class="report-table" id="delayed-table">
                    <thead>
                        <tr>
                            <th>Tracking</th>
                            <th>Zona</th>
                            <th>Repartidor</th>
                            <th class="text-right">Fecha comprometida <span class="kpi-tip" data-tip="Fecha límite de entrega acordada con el cliente al momento de crear el envío.">?</span></th>
                            <th class="text-right">Días de atraso <span class="kpi-tip" data-tip="Cantidad de días transcurridos desde la fecha comprometida hasta hoy sin que el envío haya sido entregado.">?</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% delayedShipments.forEach(s => { %>
                        <tr>
                            <td><a href="/shipment/detail/<%= s.id %>" target="_blank" rel="noopener"><%= s.trackingId %></a></td>
                            <td><%= s.zone_name || '—' %></td>
                            <td><%= s.driver_name || 'Sin asignar' %></td>
                            <td class="text-right"><%= s.expectedDeliveryDate %></td>
                            <td class="text-right"><span class="ot-badge ot-badge--red">+<%= s.days_overdue %> día<%= s.days_overdue !== 1 ? 's' : '' %></span></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="report-card" style="text-align:center;padding:2rem 1.5rem;color:var(--color-text-muted);">
                <span class="material-symbols-outlined" style="font-size:2.2rem;display:block;margin-bottom:.5rem;color:var(--color-success,#2e7d32);">check_circle</span>
                Sin envíos con demora activa en el período seleccionado.
            </div>
            <% } %>

            <!-- 4. Análisis de demoras -->
            <% if (delayedByZone.length > 0 || delayedBySeverity.length > 0 || delayedByStatus.length > 0) { %>
            <p class="dash-section-title" style="margin-top:1.5rem;">Análisis de demoras activas</p>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1rem;">
                <% if (delayedByZone.length > 0) { %>
                <div class="report-card">
                    <h2>Demoras por zona
                        <span class="kpi-tip" data-tip="Envíos vencidos agrupados por zona. Azul = tiene repartidor asignado. Rojo = sin asignar — problema de gestión, no de entrega.">?</span>
                    </h2>
                    <div style="position:relative;height:<%= Math.max(180, delayedByZone.length * 52) %>px;margin-top:1rem;">
                        <canvas id="delayed-zone-chart"></canvas>
                    </div>
                </div>
                <% } %>
                <% if (delayedBySeverity.length > 0) { %>
                <div class="report-card">
                    <h2>Severidad de demoras
                        <span class="kpi-tip" data-tip="Distribución de envíos vencidos según cuántos días llevan de atraso. Muestra si el problema es reciente o crónico.">?</span>
                    </h2>
                    <div style="position:relative;height:220px;margin-top:1rem;">
                        <canvas id="delayed-severity-chart"></canvas>
                    </div>
                </div>
                <% } %>
                <% if (delayedByStatus.length > 0) { %>
                <div class="report-card">
                    <h2>¿En qué etapa se frenan?
                        <span class="kpi-tip" data-tip="En qué estado está el envío vencido. 'En Tránsito' = el repartidor salió pero no entregó. 'Asignado' o 'En Preparación' = nunca llegó al repartidor.">?</span>
                    </h2>
                    <div style="position:relative;height:220px;margin-top:1rem;">
                        <canvas id="delayed-status-chart"></canvas>
                    </div>
                </div>
                <% } %>
            </div>
            <% } %>

            <!-- 5. Tendencia semanal -->
            <% if (delayedTrend.length > 0) { %>
            <div class="report-card" style="margin-top:1rem;">
                <h2>Demoras activas por semana de creación
                    <span class="kpi-tip" data-tip="Envíos que actualmente tienen demora activa, agrupados por la semana en que fueron creados. Permite detectar qué lote de envíos concentra más problemas.">?</span>
                </h2>
                <p class="dash-hint">Cada barra representa envíos creados esa semana que hoy siguen sin entregarse.</p>
                <div style="position:relative;height:180px;margin-top:1rem;">
                    <canvas id="delayed-trend-chart"></canvas>
                </div>
            </div>
            <% } %>

            <!-- 6. Tendencias estructurales -->
            <% if (topFailingZones.length > 0) { %>
            <p class="dash-section-title" style="margin-top:1.5rem;">Tendencias estructurales</p>
            <div class="report-card">
                <h2>Top zonas con mayor tasa de fallo
                    <span class="kpi-tip" data-tip="Zonas con más intentos de entrega fallidos en el período. 'Fallo' = intento que no se concretó (el envío fue devuelto o reprogramado). La tasa se calcula sobre el total de envíos asignados a esa zona.">?</span>
                </h2>
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Zona</th>
                            <th class="text-right">Envíos <span class="kpi-tip" data-tip="Total de envíos asignados a la zona en el período seleccionado.">?</span></th>
                            <th class="text-right">Intentos fallidos <span class="kpi-tip" data-tip="Cantidad de veces que se intentó entregar un envío sin éxito. Un mismo envío puede acumular varios intentos fallidos.">?</span></th>
                            <th class="text-right">Tasa <span class="kpi-tip" data-tip="Intentos fallidos dividido el total de envíos de la zona. Puede superar el 100% si los envíos acumulan múltiples intentos sin entrega.">?</span></th>
                            <th class="text-right">Intensidad <span class="kpi-tip" data-tip="Clasificación según la tasa de fallo: Alta ≥ 15%, Media 8–14%, Baja < 8%.">?</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% topFailingZones.forEach(z => { %>
                            <%
                                const cls = z.failure_rate >= 15 ? 'ot-badge--red' : z.failure_rate >= 8 ? 'ot-badge--amber' : 'ot-badge--green';
                                const lbl = z.failure_rate >= 15 ? 'Alta' : z.failure_rate >= 8 ? 'Media' : 'Baja';
                            %>
                        <tr>
                            <td><%= z.zone_name %></td>
                            <td class="text-right"><%= z.total_shipments %></td>
                            <td class="text-right"><span class="ot-badge <%= cls %>"><%= z.failed_attempts %></span></td>
                            <td class="text-right"><%= z.failure_rate %>%</td>
                            <td class="text-right"><span class="ot-badge <%= cls %>"><%= lbl %></span></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>

            <% } %>
        </div>
    </main>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script>
        document.getElementById('report-form').addEventListener('submit', function (e) {
            const from = document.getElementById('from').value, to = document.getElementById('to').value;
            if (from && to && from > to) {
                e.preventDefault();
                if (!this.querySelector('.report-alert')) {
                    const a = document.createElement('div');
                    a.className = 'report-alert report-alert--error';
                    a.innerHTML = '<span class="material-symbols-outlined">error</span> La fecha de inicio no puede ser mayor a la fecha de fin.';
                    this.querySelector('.filter-row').insertAdjacentElement('afterend', a);
                }
                return;
            }
            const btn = this.querySelector('button[type="submit"]');
            if (btn) { btn.disabled = true; btn.style.opacity = '.5'; }
        });
        (function () {
            const isDark = document.documentElement.dataset.theme === 'dark' || document.body.classList.contains('dark');
            const textColor = isDark ? '#94a3b8' : '#64748b';
            const gridColor = isDark ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.07)';

            const barLabelPlugin = {
                id: 'barLabels',
                afterDatasetsDraw(chart) {
                    const { ctx } = chart;
                    chart.data.datasets.forEach((dataset, i) => {
                        chart.getDatasetMeta(i).data.forEach((bar, index) => {
                            const value = dataset.data[index];
                            if (!value) return;
                            ctx.save();
                            ctx.fillStyle = textColor;
                            ctx.font = 'bold 11px sans-serif';
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'bottom';
                            ctx.fillText(value, bar.x, bar.y - 4);
                            ctx.restore();
                        });
                    });
                }
            };

            const zoneCanvas = document.getElementById('delayed-zone-chart');
            if (zoneCanvas) {
                const raw = <%- JSON.stringify(delayedByZone) %>;
                new Chart(zoneCanvas, {
                    type: 'bar',
                    data: {
                        labels: raw.map(r => r.zone_name),
                        datasets: [
                            { label: 'Con repartidor', data: raw.map(r => r.con_repartidor), backgroundColor: 'rgba(59,130,246,.75)', borderRadius: 4 },
                            { label: 'Sin asignar',    data: raw.map(r => r.sin_asignar),    backgroundColor: 'rgba(198,40,40,.75)',  borderRadius: 4 },
                        ],
                    },
                    options: {
                        indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top', labels: { color: textColor, font: { size: 12 } } },
                            tooltip: { callbacks: { label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.x} envíos` } },
                        },
                        scales: {
                            x: { stacked: true, ticks: { color: textColor, stepSize: 1 }, grid: { color: gridColor } },
                            y: { stacked: true, ticks: { color: textColor, font: { size: 12 } }, grid: { display: false } },
                        },
                    },
                });
            }

            const statusCanvas = document.getElementById('delayed-status-chart');
            if (statusCanvas) {
                const st = <%- JSON.stringify(delayedByStatus) %>;
                const stColors = { 2: 'rgba(59,130,246,.8)', 6: 'rgba(249,115,22,.8)', 7: 'rgba(139,92,246,.8)' };
                const stTotal = st.reduce((s, r) => s + r.total, 0);
                const bodyColor = isDark ? '#e2e8f0' : '#1e293b';
                new Chart(statusCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: st.map(r => r.status_label),
                        datasets: [{
                            data: st.map(r => r.total),
                            backgroundColor: st.map(r => stColors[r.statusId] || 'rgba(148,163,184,.7)'),
                            borderWidth: 0,
                        }],
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'right', labels: { color: textColor, font: { size: 12 }, padding: 12, boxWidth: 12 } },
                            tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.parsed} envíos` } },
                        },
                        cutout: '65%',
                    },
                    plugins: [{
                        id: 'centerText',
                        afterDraw(chart) {
                            const meta = chart.getDatasetMeta(0);
                            if (!meta.data.length) return;
                            const { ctx } = chart;
                            const cx = meta.data[0].x, cy = meta.data[0].y;
                            ctx.save();
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'middle';
                            ctx.fillStyle = bodyColor;
                            ctx.font = 'bold 1.5rem sans-serif';
                            ctx.fillText(stTotal, cx, cy - 9);
                            ctx.font = '.68rem sans-serif';
                            ctx.fillStyle = textColor;
                            ctx.fillText('demorados', cx, cy + 11);
                            ctx.restore();
                        }
                    }],
                });
            }

            const trendCanvas = document.getElementById('delayed-trend-chart');
            if (trendCanvas) {
                const tr = <%- JSON.stringify(delayedTrend) %>;
                new Chart(trendCanvas, {
                    type: 'bar',
                    data: {
                        labels: tr.map(r => {
                            const d = new Date(r.week_start + 'T12:00:00');
                            return d.toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit' });
                        }),
                        datasets: [{
                            label: 'Envíos demorados',
                            data: tr.map(r => r.delayed),
                            backgroundColor: 'rgba(198,40,40,.7)',
                            borderRadius: 4,
                        }],
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        layout: { padding: { top: 20 } },
                        plugins: {
                            legend: { display: false },
                            tooltip: { callbacks: { label: ctx => ` ${ctx.parsed.y} envío${ctx.parsed.y !== 1 ? 's' : ''} demorado${ctx.parsed.y !== 1 ? 's' : ''}` } },
                        },
                        scales: {
                            x: { ticks: { color: textColor }, grid: { display: false } },
                            y: { display: false },
                        },
                    },
                    plugins: [barLabelPlugin],
                });
            }

            const sevCanvas = document.getElementById('delayed-severity-chart');
            if (sevCanvas) {
                const sev = <%- JSON.stringify(delayedBySeverity) %>;
                const sevColors = ['rgba(234,179,8,.8)','rgba(249,115,22,.8)','rgba(239,68,68,.8)','rgba(153,27,27,.85)'];
                new Chart(sevCanvas, {
                    type: 'bar',
                    data: {
                        labels: sev.map(r => r.banda),
                        datasets: [{
                            label: 'Envíos',
                            data: sev.map(r => r.total),
                            backgroundColor: sev.map((_, i) => sevColors[i] || sevColors[3]),
                            borderRadius: 4,
                        }],
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        layout: { padding: { top: 20 } },
                        plugins: {
                            legend: { display: false },
                            tooltip: { callbacks: { label: ctx => ` ${ctx.parsed.y} envíos` } },
                        },
                        scales: {
                            x: { ticks: { color: textColor }, grid: { display: false } },
                            y: { display: false },
                        },
                    },
                    plugins: [barLabelPlugin],
                });
            }
        })();
        (function () {
            const SEL_KEY = 'sup_delayed_limit';
            const select = document.getElementById('delayed-limit-select');
            const note   = document.getElementById('delayed-limit-note');
            const tbody  = document.querySelector('#delayed-table tbody');
            if (!select || !tbody) return;
            const totalLoaded = tbody.querySelectorAll('tr').length;
            const totalReal   = <%= kpis.delayed_count %>;
            const saved = Number(localStorage.getItem(SEL_KEY)) || 7;
            select.value = String(saved);
            const applyLimit = (limit) => {
                tbody.querySelectorAll('tr').forEach((tr, i) => {
                    tr.style.display = i < limit ? '' : 'none';
                });
                const showing = Math.min(limit, totalLoaded);
                note.textContent = totalReal > showing
                    ? `Mostrando los ${showing} más críticos de ${totalReal} envíos con demora.`
                    : '';
            };
            applyLimit(saved);
            select.addEventListener('change', () => {
                const v = Number(select.value);
                localStorage.setItem(SEL_KEY, v);
                applyLimit(v);
            });
        })();
        (function () {
            const STORAGE_KEY = 'sup_hidden_statuses';
            const chips = document.getElementById('status-chips');
            const grid  = document.getElementById('status-kpi-grid');
            if (!chips || !grid) return;
            const hidden = new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'));
            const apply = () => {
                chips.querySelectorAll('.status-chip').forEach(chip => {
                    const id = Number(chip.dataset.statusId);
                    const isHidden = hidden.has(id);
                    chip.classList.toggle('active', !isHidden);
                    const card = grid.querySelector(`.dash-kpi[data-status-id="${id}"]`);
                    if (card) card.style.display = isHidden ? 'none' : '';
                });
                localStorage.setItem(STORAGE_KEY, JSON.stringify([...hidden]));
            };
            apply();
            chips.addEventListener('click', e => {
                const chip = e.target.closest('.status-chip');
                if (!chip) return;
                const id = Number(chip.dataset.statusId);
                hidden.has(id) ? hidden.delete(id) : hidden.add(id);
                apply();
            });
        })();
    </script>
</body>
</html>
