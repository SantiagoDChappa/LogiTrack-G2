<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Nuevo Transporte - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header"><h1>Nuevo Transporte</h1></div>
        <form method="POST" action="/transport/new" class="search-form">
            <div class="search-fields">
                <div class="search-field"><label>Nombre</label><input class="search-input" name="name" required></div>
                <div class="search-field"><label>Patente</label><input class="search-input" name="plate"></div>
                <div class="search-field"><label>Peso máximo (kg)</label><input class="search-input" name="maxWeightKg" type="number" step="0.01" required></div>
                <div class="search-field"><label>Volumen máximo (m³)</label><input class="search-input" name="maxVolumeM3" type="number" step="0.001" required></div>
                <div class="search-field"><label>Costo fijo ($)</label><input class="search-input" name="fixedCost" type="number" step="0.01" value="0"></div>
                <div class="search-field"><label>Costo por km ($)</label><input class="search-input" name="costPerKm" type="number" step="0.01" value="0"></div>
                <div class="search-field">
                    <label>Conductor</label>
                    <select class="search-input" name="driverUserId">
                        <option value="">-- Sin asignar --</option>
                        <% drivers.forEach(d => { %><option value="<%= d.id %>"><%= d.fullName %></option><% }) %>
                    </select>
                </div>
                <div class="search-field">
                    <label>Sucursal</label>
                    <select class="search-input" name="branchId">
                        <option value="">-- Sin asignar --</option>
                        <% branches.forEach(b => { %><option value="<%= b.id %>"><%= b.name %></option><% }) %>
                    </select>
                </div>
                <div class="search-field">
                    <label>Zonas asignadas (opcional)</label>
                    <select class="search-input" name="zoneIds" multiple size="6">
                        <% zones.forEach(z => { %><option value="<%= z.id %>"><%= z.name %></option><% }) %>
                    </select>
                </div>
                <div class="search-field">
                    <label><input type="checkbox" name="enabled" checked> Habilitado</label>
                </div>
            </div>
            <button class="btn-primary" type="submit">Guardar</button>
            <a class="btn-secondary" href="/transport">Cancelar</a>
        </form>
    </main>
</body>
</html>
