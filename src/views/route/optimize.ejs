<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Optimización de Ruteo - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Optimizar Ruteo</h1>
            <% if (isAdmin) { %>
                <form method="GET" action="/route/optimize" style="margin-bottom:1rem">
                    <label>Sucursal:
                        <select name="branchId" onchange="this.form.submit()">
                            <option value="">-- Elegir sucursal --</option>
                            <% branches.forEach(b => { %>
                                <option value="<%= b.id %>" <%= branchId === b.id ? 'selected' : '' %>><%= b.name %> (#<%= b.id %>)</option>
                            <% }) %>
                        </select>
                    </label>
                </form>
            <% } %>
            <% if (branchId) { %>
                <p>Sucursal: #<%= branchId %> · Envíos pendientes: <%= shipments.length %></p>
            <% } else { %>
                <p>Seleccioná una sucursal para ver envíos y transportes.</p>
            <% } %>
        </div>

        <% if (!branchId) { %>
            <p>Esperando selección de sucursal.</p>
        <% } else if (shipments.length === 0) { %>
            <p>No hay envíos pendientes en tu sucursal.</p>
        <% } else if (transports.length === 0) { %>
            <p>No hay transportes habilitados disponibles.</p>
        <% } else { %>
        <form id="optimize-form">
            <h2>Envíos pendientes</h2>
            <div class="shipments-wrapper">
                <table class="shipments-table">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="select-all-shipments"></th>
                            <th>Tracking</th><th>Destinatario</th><th>Zona</th>
                            <th>Peso (kg)</th><th>Volumen (m³)</th><th>CP</th><th>Fecha estimada</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% shipments.forEach(s => { %>
                            <tr>
                                <td><input type="checkbox" name="shipmentIds" value="<%= s.id %>" class="ship-cb"></td>
                                <td><%= s.trackingId %></td>
                                <td><%= s.recipient ? s.recipient.fullName : '-' %></td>
                                <td><%= s.zone ? s.zone.name : '<sin zona>' %></td>
                                <td><%= s.weightKg || '-' %></td>
                                <td><%= s.volumeM3 || '-' %></td>
                                <td><%= s.address ? s.address.postalCode : '-' %></td>
                                <td><%= s.expectedDeliveryDate || '-' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <h2>Transportes habilitados</h2>
            <div class="shipments-wrapper">
                <table class="shipments-table">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="select-all-transports"></th>
                            <th>Nombre</th><th>Patente</th><th>Peso máx</th><th>Vol máx</th>
                            <th>Costo fijo</th><th>$/km</th><th>Conductor</th><th>Zonas</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% transports.forEach(t => { %>
                            <tr>
                                <td><input type="checkbox" name="transportIds" value="<%= t.id %>" class="tx-cb"></td>
                                <td><%= t.name %></td>
                                <td><%= t.plate || '-' %></td>
                                <td><%= t.maxWeightKg %></td>
                                <td><%= t.maxVolumeM3 %></td>
                                <td>$<%= t.fixedCost %></td>
                                <td>$<%= t.costPerKm %></td>
                                <td><%= t.driver ? t.driver.fullName : '-' %></td>
                                <td><%= (t.zones && t.zones.length) ? t.zones.map(z => z.name).join(', ') : 'Todas' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <button type="submit" class="btn-primary">Calcular ruta óptima</button>
        </form>

        <%- include('preview') %>
        <% } %>
    </main>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    document.getElementById('select-all-shipments')?.addEventListener('change', e => {
        document.querySelectorAll('.ship-cb').forEach(cb => { cb.checked = e.target.checked; });
    });
    document.getElementById('select-all-transports')?.addEventListener('change', e => {
        document.querySelectorAll('.tx-cb').forEach(cb => { cb.checked = e.target.checked; });
    });

    window.CURRENT_BRANCH_ID = <%= branchId ? branchId : 'null' %>;

    document.getElementById('optimize-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const shipmentIds = fd.getAll('shipmentIds');
        const transportIds = fd.getAll('transportIds');
        if (shipmentIds.length === 0 || transportIds.length === 0) {
            alert('Seleccioná al menos un envío y un transporte.');
            return;
        }

        const res = await fetch('/route/optimize/preview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ shipmentIds, transportIds, branchId: window.CURRENT_BRANCH_ID }),
        });
        const data = await res.json();
        if (!res.ok) { alert(data.error || 'Error'); return; }
        window.renderRoutePreview(data);
    });
    </script>
</body>
</html>
