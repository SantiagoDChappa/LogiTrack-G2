<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Rutas - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Rutas</h1>
            <div class="page-header__actions">
                <a class="btn-primary" href="/route/optimize">
                    <span class="material-symbols-outlined">add</span>Optimizar Ruta
                </a>
            </div>
        </div>

        <div class="shipments-wrapper">
            <% if (isAdmin) { %>
            <form method="GET" action="/route" class="search-form">
                <div class="search-fields">
                    <div class="search-field">
                        <label for="branchId">Filtrar por sucursal</label>
                        <select id="branchId" name="branchId" class="search-input" onchange="this.form.submit()">
                            <option value="">— Todas las sucursales —</option>
                            <% branches.forEach(b => { %>
                                <option value="<%= b.id %>" <%= branchId === b.id ? 'selected' : '' %>><%= b.name %> (#<%= b.id %>)</option>
                            <% }) %>
                        </select>
                    </div>
                </div>
            </form>
            <% } %>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Transporte</th>
                            <th>Conductor</th>
                            <th>Sucursal</th>
                            <th>Distancia</th>
                            <th>Costo</th>
                            <th>Estado</th>
                            <th>Creada</th>
                            <th class="col-actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!routes || routes.length === 0) { %>
                            <tr>
                                <td colspan="9" class="empty-row">
                                    <span class="material-symbols-outlined">route</span>
                                    Sin rutas creadas.
                                </td>
                            </tr>
                        <% } else { %>
                            <%
                                const _routeStatusMap = {
                                    1: { label: 'Planificada · sumable', cls: 'en_sucursal' },
                                    2: { label: 'En tránsito',           cls: 'en_transito' },
                                    3: { label: 'Completada',            cls: 'entregado'   },
                                    4: { label: 'Cancelada',             cls: 'cancelado'   },
                                };
                            %>
                            <% routes.forEach(r => { %>
                                <%
                                    const _rs = _routeStatusMap[r.statusId] || { label: 'Estado ' + r.statusId, cls: 'inicial' };
                                %>
                                <tr>
                                    <td class="tracking-id">#<%= r.id %></td>
                                    <td><%= r.transport ? r.transport.name : '-' %></td>
                                    <td><%= r.transport && r.transport.driver ? r.transport.driver.fullName : '-' %></td>
                                    <td><%= r.originBranch ? r.originBranch.name : '-' %></td>
                                    <td><%= r.totalDistanceKm %> km</td>
                                    <td><%= fmtMoney(r.totalCost) %></td>
                                    <td>
                                        <span class="status-badge <%= _rs.cls %>"><%= _rs.label %></span>
                                    </td>
                                    <td><%= r.createdAt ? new Date(r.createdAt).toLocaleDateString('es-AR') : '-' %></td>
                                    <td class="col-actions">
                                        <a href="/route/<%= r.id %>" class="action-btn detalle" data-tooltip="Ver detalle">
                                            <span class="material-symbols-outlined">info</span>
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
