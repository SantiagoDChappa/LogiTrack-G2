<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Notificaciones — Fallidas</title>
    <style>
        .ntf-wrap { padding: 1rem clamp(1rem, 2.5vw, 2rem); }

        /* Pestañas de estado (mismo criterio visual que los filtros de Envíos) */
        .ntf-tabs { display: flex; flex-wrap: wrap; gap: .25rem; border-bottom: 1px solid var(--color-border); margin-bottom: 1rem; }
        .ntf-tab {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .55rem .9rem; border: none; background: none; cursor: pointer;
            color: var(--color-text-secondary); font-size: .88rem; font-weight: 600;
            text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px;
        }
        .ntf-tab:hover { color: var(--color-text); }
        .ntf-tab.is-active { color: var(--color-primary); border-bottom-color: var(--color-primary); }
        .ntf-tab .ntf-tab-count {
            font-size: .72rem; font-weight: 700; padding: .05rem .45rem; border-radius: 999px;
            background: var(--color-surface-alt); color: var(--color-text-secondary);
        }
        .ntf-tab.is-active .ntf-tab-count { background: var(--color-primary); color: #fff; }

        .ntf-filters {
            display: grid;
            grid-template-columns: minmax(220px, 1fr) auto auto;
            gap: .75rem; align-items: end; margin-bottom: 1rem;
            background: var(--color-surface); border: 1px solid var(--color-border);
            border-radius: 12px; padding: 1rem;
        }
        .ntf-filters .field { display: flex; flex-direction: column; gap: .3rem; min-width: 0; }
        .ntf-filters .field input { width: 100%; box-sizing: border-box; }
        @media (max-width: 720px) { .ntf-filters { grid-template-columns: 1fr; } }
        .ntf-filters label { font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--color-text-secondary); }
        .ntf-filters select, .ntf-filters input {
            padding: .5rem .7rem; border: 1px solid var(--color-border); border-radius: 8px;
            background: var(--color-surface); color: var(--color-text); font-size: .9rem;
        }
        .ntf-filters select:focus, .ntf-filters input:focus { outline: none; border-color: var(--color-primary); }
        .ntf-btn {
            display: inline-flex; align-items: center; gap: .35rem; padding: .55rem .9rem;
            background: var(--color-primary); color: #fff; border: none; border-radius: 8px;
            font-weight: 600; font-size: .88rem; cursor: pointer; text-decoration: none;
        }
        .ntf-btn--ghost { background: transparent; color: var(--color-text-secondary); border: 1px solid var(--color-border); }

        .ntf-table-wrap {
            background: var(--color-surface); border: 1px solid var(--color-border);
            border-radius: 12px; box-shadow: var(--shadow-sm);
            overflow: auto; max-height: 65vh; -webkit-overflow-scrolling: touch;
        }
        .ntf-table { width: 100%; border-collapse: collapse; min-width: 820px; }
        .ntf-table th, .ntf-table td { padding: .7rem .9rem; text-align: left; border-bottom: 1px solid var(--color-border); font-size: .88rem; color: var(--color-text); vertical-align: top; }
        /* thead fijo: queda visible al hacer scroll vertical de la tabla */
        .ntf-table thead th {
            position: sticky; top: 0; z-index: 2;
            background: var(--color-surface-alt); font-size: .72rem; text-transform: uppercase;
            letter-spacing: .05em; color: var(--color-text-secondary);
            box-shadow: inset 0 -1px 0 var(--color-border);
        }
        .ntf-table tbody tr:hover { background: var(--color-surface-alt); }

        .ntf-badge { display: inline-flex; align-items: center; gap: .3rem; padding: .22rem .6rem; border-radius: 999px; font-size: .72rem; font-weight: 700; }
        .ntf-badge--SENT       { background: rgba(22,163,74,.15);  color: #16a34a; }
        .ntf-badge--FAILED     { background: rgba(220,38,38,.15);  color: #dc2626; }
        .ntf-badge--PENDING    { background: rgba(217,119,6,.15);  color: #d97706; }
        .ntf-badge--PROCESSING { background: rgba(37,99,235,.15);  color: var(--color-primary); }

        .ntf-provider { font-size: .72rem; font-weight: 600; padding: .15rem .5rem; border-radius: 6px; background: var(--color-surface-alt); border: 1px solid var(--color-border); color: var(--color-text-secondary); }
        .ntf-subject { font-weight: 600; max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .ntf-recipient { color: var(--color-text-secondary); font-size: .82rem; }
        .ntf-error { color: #dc2626; font-size: .8rem; max-width: 320px; }

        .ntf-history-toggle { background: none; border: 1px solid var(--color-border); border-radius: 6px; cursor: pointer; color: var(--color-text-secondary); padding: .3rem .6rem; font-size: .78rem; display: inline-flex; align-items: center; gap: .3rem; white-space: nowrap; }
        .ntf-history-toggle:hover { background: var(--color-surface-alt); border-color: var(--color-primary); color: var(--color-primary); }
        .ntf-history-toggle .count { background: var(--color-surface-alt); border-radius: 999px; padding: 0 .4rem; font-weight: 700; font-size: .7rem; }
        .ntf-history-toggle.is-open .material-symbols-outlined { transform: rotate(180deg); transition: transform .15s; }
        .ntf-history-row td { background: var(--color-surface-alt); }
        .ntf-detail-error { color: #dc2626; font-size: .82rem; margin: .25rem 0; word-break: break-word; }
        .ntf-detail-meta { color: var(--color-text-secondary); font-size: .82rem; }
        .ntf-history-list { list-style: none; margin: 0; padding: .25rem 0; display: flex; flex-direction: column; gap: .4rem; }
        .ntf-history-item { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; font-size: .82rem; }
        .ntf-history-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
        .ntf-history-dot--ok { background: #16a34a; }
        .ntf-history-dot--fail { background: #dc2626; }
        .ntf-history-when { color: var(--color-text-secondary); font-size: .78rem; }
        .ntf-empty { text-align: center; padding: 2.5rem; color: var(--color-text-secondary); }
        @media (max-width: 640px) { .ntf-subject { max-width: 160px; } }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="ntf-wrap">
            <div class="page-header"><h1>Notificaciones — Fallidas / enviadas</h1></div>

            <%# Pestañas por estado (selección única). Cada una preserva la búsqueda actual (q). %>
            <%
                const _qStr   = filters.q ? '&q=' + encodeURIComponent(filters.q) : '';
                const _total  = counts.SENT + counts.FAILED + counts.PENDING + counts.PROCESSING;
                const _tabs = [
                    { key: '',           label: 'Todas',      count: _total },
                    { key: 'FAILED',     label: 'Fallidas',   count: counts.FAILED },
                    { key: 'SENT',       label: 'Enviadas',   count: counts.SENT },
                    { key: 'PENDING',    label: 'Pendientes', count: counts.PENDING },
                    { key: 'PROCESSING', label: 'Procesando', count: counts.PROCESSING },
                ];
            %>
            <nav class="ntf-tabs">
                <% _tabs.forEach(function(t) { %>
                    <a class="ntf-tab <%= filters.status === t.key ? 'is-active' : '' %>"
                       href="/notification/fallidas?status=<%= t.key %><%= _qStr %>">
                        <%= t.label %><span class="ntf-tab-count"><%= t.count %></span>
                    </a>
                <% }); %>
            </nav>

            <form method="GET" action="/notification/fallidas" class="ntf-filters">
                <input type="hidden" name="status" value="<%= filters.status %>">
                <div class="field">
                    <label for="q">Buscar (destinatario / asunto)</label>
                    <input type="text" id="q" name="q" value="<%= filters.q %>" placeholder="ej: cliente@mail.com">
                </div>
                <button type="submit" class="ntf-btn"><span class="material-symbols-outlined" style="font-size:18px">search</span>Filtrar</button>
                <a href="/notification/fallidas" class="ntf-btn ntf-btn--ghost">Limpiar</a>
            </form>

            <div class="ntf-table-wrap">
                <table class="ntf-table">
                    <thead>
                        <tr>
                            <th>Estado</th>
                            <th>Destinatario / Asunto</th>
                            <th>Proveedor</th>
                            <th>Intentos</th>
                            <th>Creado</th>
                            <th>Enviado</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!emails || emails.length === 0) { %>
                            <tr><td colspan="7" class="ntf-empty">No hay notificaciones para los filtros seleccionados.</td></tr>
                        <% } %>
                        <% emails.forEach(e => {
                            const log = (e.attemptLog || []).slice().sort((a,b) => new Date(a.attemptedAt) - new Date(b.attemptedAt));
                        %>
                            <tr>
                                <td><span class="ntf-badge ntf-badge--<%= e.status %>"><%= e.status %></span></td>
                                <td>
                                    <div class="ntf-subject" title="<%= e.subject %>"><%= e.subject %></div>
                                    <div class="ntf-recipient"><%= e.recipient %></div>
                                </td>
                                <td><% if (e.provider) { %><span class="ntf-provider"><%= e.provider %></span><% } else { %>—<% } %></td>
                                <td><%= e.attempts != null ? e.attempts : 0 %></td>
                                <td><%= fmtDateTime(e.createdAt) %></td>
                                <td><%= e.sentAt ? fmtDateTime(e.sentAt) : '—' %></td>
                                <td>
                                    <%# Botón presente en TODAS las filas; abre el detalle desplegable %>
                                    <button type="button" class="ntf-history-toggle" data-target="hist-<%= e.id %>">
                                        <span class="material-symbols-outlined" style="font-size:16px">expand_more</span>
                                        Detalle<% if (log.length > 0) { %><span class="count"><%= log.length %></span><% } %>
                                    </button>
                                </td>
                            </tr>
                            <tr class="ntf-history-row" id="hist-<%= e.id %>" style="display:none">
                                <td colspan="7">
                                    <% if (log.length > 0) { %>
                                        <ul class="ntf-history-list">
                                            <% log.forEach((a, i) => { %>
                                                <li class="ntf-history-item">
                                                    <span class="ntf-history-dot ntf-history-dot--<%= a.success ? 'ok' : 'fail' %>"></span>
                                                    <strong>#<%= i + 1 %></strong>
                                                    <span class="ntf-provider"><%= a.provider || '—' %></span>
                                                    <span><%= a.success ? 'OK ✓' : 'Falló ✗' %></span>
                                                    <span class="ntf-history-when"><%= fmtDateTime(a.attemptedAt) %></span>
                                                    <% if (!a.success && a.error) { %><span class="ntf-error"><%= a.error %></span><% } %>
                                                </li>
                                            <% }) %>
                                        </ul>
                                    <% } else if (e.lastError) { %>
                                        <%# Sin historial de intentos: mostramos el último error acá, no suelto en la fila %>
                                        <div class="ntf-detail-meta">Sin historial de intentos registrado. Último error:</div>
                                        <div class="ntf-detail-error"><%= e.lastError %></div>
                                    <% } else { %>
                                        <div class="ntf-detail-meta">Sin intentos ni errores registrados para esta notificación.</div>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script>
        document.querySelectorAll('.ntf-history-toggle').forEach(btn => {
            btn.addEventListener('click', () => {
                const row = document.getElementById(btn.dataset.target);
                if (!row) { return; }
                const open = row.style.display === 'none';
                row.style.display = open ? 'table-row' : 'none';
                btn.classList.toggle('is-open', open);
            });
        });
    </script>
</body>
</html>
