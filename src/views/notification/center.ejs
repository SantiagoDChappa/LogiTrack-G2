<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Notificaciones - LogiTrack</title>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="notif-page">
            <div class="page-header notif-head">
                <div>
                    <h1>Notificaciones</h1>
                    <% if (typeof unread !== 'undefined' && unread > 0) { %>
                        <p class="notif-sub"><%= unread %> sin leer</p>
                    <% } %>
                </div>
                <% if (unread > 0) { %>
                    <form method="POST" action="/notifications/read-all" class="notif-readall-form">
                        <button type="submit" class="action-btn neutro" data-tooltip="Marcar todas como leídas" aria-label="Marcar todas como leídas">
                            <span class="material-symbols-outlined">mark_chat_read</span> Marcar todas como leídas
                        </button>
                    </form>
                <% } %>
            </div>

            <% if (!items || items.length === 0) { %>
                <div class="notif-empty">
                    <span class="material-symbols-outlined">notifications_off</span>
                    <p>No tenés notificaciones</p>
                </div>
            <% } else { %>
                <%
                    const _icons = { incident: 'report', return: 'assignment_return', route: 'route', shipment: 'local_shipping' };
                %>
                <ul class="notif-list">
                    <% items.forEach(n => {
                        const isUnread = !n.readAt;
                        const href = `/notifications/${n.id}/go`;
                        const f = n.createdAt ? new Date(n.createdAt).toLocaleString('es-AR') : '';
                        const icon = _icons[n.resourceType] || 'notifications';
                    %>
                        <li class="notif-item <%= isUnread ? 'notif-item--unread' : '' %>">
                            <a href="<%= href %>" class="notif-link">
                                <span class="notif-icon" aria-hidden="true"><span class="material-symbols-outlined"><%= icon %></span></span>
                                <span class="notif-main">
                                    <span class="notif-title"><%= n.title %></span>
                                    <% if (n.body) { %><span class="notif-body"><%= n.body %></span><% } %>
                                    <span class="notif-date"><span class="material-symbols-outlined">schedule</span><%= f %></span>
                                </span>
                                <span class="material-symbols-outlined notif-chevron">chevron_right</span>
                            </a>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>
    </main>

    <style>
        .notif-page { padding: 1.5rem clamp(1rem, 2.5vw, 2.25rem); max-width: 920px; }
        .notif-head { display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1.25rem; }
        .notif-head h1 { margin: 0; }
        .notif-sub { margin: .2rem 0 0; font-size: .85rem; color: var(--color-text-secondary); }
        .notif-readall-form { margin-left: auto; }
        .notif-empty { text-align: center; color: var(--color-text-secondary); padding: 4rem 1rem; border: 1px dashed var(--color-border); border-radius: 14px; }
        .notif-empty .material-symbols-outlined { font-size: 52px; opacity: .45; display: block; margin-bottom: .5rem; }
        .notif-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .6rem; }
        .notif-item { border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); box-shadow: var(--shadow-sm); transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease; }
        .notif-item:hover { transform: translateY(-1px); box-shadow: var(--shadow-md, 0 6px 18px rgba(15,23,42,.12)); border-color: var(--color-primary); }
        .notif-item--unread { border-left: 3px solid var(--color-primary); background: linear-gradient(0deg, rgba(37,99,235,.05), rgba(37,99,235,.05)), var(--color-surface); }
        .notif-link { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.1rem; text-decoration: none; color: var(--color-text); }
        .notif-icon { flex: 0 0 auto; width: 42px; height: 42px; display: grid; place-items: center; border-radius: 10px; background: rgba(37,99,235,.1); color: var(--color-primary); }
        .notif-icon .material-symbols-outlined { font-size: 22px; }
        .notif-item--unread .notif-icon { background: var(--color-primary); color: #fff; }
        .notif-main { display: flex; flex-direction: column; gap: .25rem; flex: 1; min-width: 0; }
        .notif-title { font-weight: 600; font-size: .98rem; line-height: 1.3; }
        .notif-body { font-size: .88rem; color: var(--color-text-secondary); line-height: 1.4; }
        .notif-date { display: inline-flex; align-items: center; gap: .3rem; font-size: .76rem; color: var(--color-text-muted); margin-top: .1rem; }
        .notif-date .material-symbols-outlined { font-size: 14px; }
        .notif-chevron { color: var(--color-text-secondary); flex: 0 0 auto; }
        @media (max-width: 560px) { .notif-link { gap: .75rem; padding: .85rem; } .notif-icon { width: 36px; height: 36px; } }
    </style>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
