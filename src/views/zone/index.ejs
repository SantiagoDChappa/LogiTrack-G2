<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Zonas - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Zonas</h1>
            <div class="page-header__actions">
                <a href="/zone/new" class="btn-primary"><span class="material-symbols-outlined">add</span>Nueva</a>
            </div>
        </div>
        <div class="shipments-wrapper">
            <table class="shipments-table">
                <thead>
                    <tr>
                        <th>Nombre</th><th>Provincia</th><th>Costo base</th><th>Prefijos CP</th><th>Habilitada</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    <% zones.forEach(z => { %>
                        <tr>
                            <td><%= z.name %></td>
                            <td><%= z.provinceId || '-' %></td>
                            <td>$<%= z.baseCost %></td>
                            <td><%= z.postalCodePrefixes ? z.postalCodePrefixes.join(', ') : '-' %></td>
                            <td><%= z.enabled ? 'Sí' : 'No' %></td>
                            <td><a class="btn-secondary" href="/zone/update/<%= z.id %>">Editar</a></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>
