<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Zonas - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/routes.css">
    <link rel="stylesheet" href="/css/zones.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Zonas</h1>
            <div class="page-header__actions">
                <a href="/zone/new" class="btn-primary">
                    <span class="material-symbols-outlined">add</span>Nueva
                </a>
            </div>
        </div>

        <div class="shipments-wrapper">
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Provincia</th>
                            <th>Costo base</th>
                            <th>Prefijos CP</th>
                            <th>Estado</th>
                            <th class="col-actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!zones || zones.length === 0) { %>
                            <tr>
                                <td colspan="6" class="empty-row">
                                    <span class="material-symbols-outlined">map</span>
                                    No hay zonas cargadas.
                                </td>
                            </tr>
                        <% } else { %>
                            <% zones.forEach(z => { %>
                                <tr>
                                    <td><strong><%= z.name %></strong></td>
                                    <td><%= z.provinceId || '-' %></td>
                                    <td><%= fmtMoney(z.baseCost) %></td>
                                    <td class="tracking-id"><%= z.postalCodePrefixes ? z.postalCodePrefixes.join(', ') : '-' %></td>
                                    <td>
                                        <% if (z.enabled) { %>
                                            <span class="status-badge entregado">Habilitada</span>
                                        <% } else { %>
                                            <span class="status-badge cancelado">Deshabilitada</span>
                                        <% } %>
                                    </td>
                                    <td class="col-actions">
                                        <a href="/zone/update/<%= z.id %>" class="action-btn modificar" data-tooltip="Editar">
                                            <span class="material-symbols-outlined">edit</span>
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
