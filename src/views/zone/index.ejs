<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Zonas - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/routes.css">
    <link rel="stylesheet" href="/css/zones.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Zonas</h1>
            <div class="page-header__actions">
                <a href="/zone/new" class="action-btn action-btn--lg action-btn--tip-bottom crear" data-tooltip="Nueva zona" aria-label="Nueva zona">
                    <span class="material-symbols-outlined">add</span>
                </a>
            </div>
        </div>

        <div class="shipments-wrapper">
            <form class="search-form" data-tools-for="zones" onsubmit="return false">
                <div class="search-fields">
                    <div class="search-field">
                        <label for="f-zone-name">Nombre</label>
                        <input type="text" id="f-zone-name" class="search-input" data-col="0" placeholder="Ej: CABA - Belgrano">
                    </div>
                    <div class="search-field">
                        <label for="f-zone-prov">Provincia</label>
                        <input type="text" id="f-zone-prov" class="search-input" data-col="1" placeholder="Ej: 24">
                    </div>
                    <div class="search-field">
                        <label for="f-zone-state">Estado</label>
                        <select id="f-zone-state" class="search-input" data-col="4">
                            <option value="">Todas</option>
                            <option value="Habilitada">Habilitada</option>
                            <option value="Deshabilitada">Deshabilitada</option>
                        </select>
                    </div>
                    <button type="submit" class="action-btn action-btn--lg buscar search-btn" data-tooltip="Buscar" aria-label="Buscar">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </div>
            </form>

            <div class="table-wrapper">
                <table data-tools="zones">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Provincia</th>
                            <th>Costo base</th>
                            <th>Prefijos CP</th>
                            <th>Estado</th>
                            <th class="col-actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!zones || zones.length === 0) { %>
                            <tr>
                                <td colspan="6" class="empty-row">
                                    <span class="material-symbols-outlined">map</span>
                                    No hay zonas cargadas.
                                </td>
                            </tr>
                        <% } else { %>
                            <% zones.forEach(z => { %>
                                <tr>
                                    <td><strong><%= z.name %></strong></td>
                                    <td><%= z.provinceId || '-' %></td>
                                    <td><%= fmtMoney(z.baseCost) %></td>
                                    <td class="tracking-id"><%= z.postalCodePrefixes ? z.postalCodePrefixes.join(', ') : '-' %></td>
                                    <td>
                                        <% if (z.enabled) { %>
                                            <span class="status-badge entregado">Habilitada</span>
                                        <% } else { %>
                                            <span class="status-badge cancelado">Deshabilitada</span>
                                        <% } %>
                                    </td>
                                    <td class="col-actions">
                                        <a href="/zone/update/<%= z.id %>" class="action-btn modificar" data-tooltip="Editar">
                                            <span class="material-symbols-outlined">edit</span>
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/table-tools.js" defer></script>
</body>
</html>
