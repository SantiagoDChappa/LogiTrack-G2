<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Editar Zona - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/zones.css">
    <link rel="stylesheet" href="/css/admin-forms.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Editar Zona</h1>
            <a href="/zone" class="action-btn action-btn--lg action-btn--tip-bottom volver" data-tooltip="Volver" aria-label="Volver">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
        </div>

        <div class="form-new">
            <form method="POST" action="/zone/update/<%= zone.id %>">
                <div class="usuario">
                    <h3>Datos de la zona</h3>
                    <div class="field">
                        <label for="name">Nombre <span class="req">*</span></label>
                        <input id="name" class="search-input" name="name" type="text" value="<%= zone.name %>" maxlength="100" required>
                    </div>
                    <div class="field">
                        <label for="provinceId">Provincia</label>
                        <select id="provinceId" class="search-input" name="provinceId">
                            <option value="">— Sin provincia —</option>
                            <% provinces.forEach(p => { %>
                                <option value="<%= p.id %>" <%= zone.provinceId === p.id ? 'selected' : '' %>><%= p.description %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="field">
                        <label for="baseCost">Costo base ($)</label>
                        <input id="baseCost" class="search-input" name="baseCost" type="number" step="0.01" min="0" value="<%= zone.baseCost %>">
                    </div>
                    <div class="field">
                        <label for="postalCodePrefixes">Prefijos de código postal <span style="font-weight:400;color:var(--color-text-secondary)">(separados por coma)</span></label>
                        <input id="postalCodePrefixes" class="search-input" name="postalCodePrefixes" type="text"
                               value="<%= zone.postalCodePrefixes ? zone.postalCodePrefixes.join(',') : '' %>"
                               placeholder="Ej: 1425,1426,1900">
                    </div>
                    <div class="field" style="display:flex;align-items:center;gap:0.5rem;margin-top:0.5rem">
                        <input type="checkbox" id="enabled" name="enabled" <%= zone.enabled ? 'checked' : '' %> style="width:auto">
                        <label for="enabled" style="margin:0;text-transform:none;font-size:var(--font-size-sm)">Habilitada</label>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/zone" class="action-btn action-btn--lg cancelar" data-tooltip="Cancelar" aria-label="Cancelar">
                        <span class="material-symbols-outlined">close</span>
                    </a>
                    <button type="submit" class="action-btn action-btn--lg guardar" data-tooltip="Actualizar" aria-label="Actualizar">
                        <span class="material-symbols-outlined">save</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
