<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Editar Zona - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header"><h1>Editar Zona</h1></div>
        <form method="POST" action="/zone/update/<%= zone.id %>" class="search-form">
            <div class="search-fields">
                <div class="search-field"><label>Nombre</label><input class="search-input" name="name" value="<%= zone.name %>" required></div>
                <div class="search-field">
                    <label>Provincia</label>
                    <select class="search-input" name="provinceId">
                        <option value="">-- Sin provincia --</option>
                        <% provinces.forEach(p => { %>
                            <option value="<%= p.id %>" <%= zone.provinceId === p.id ? 'selected' : '' %>><%= p.description %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="search-field"><label>Costo base ($)</label><input class="search-input" name="baseCost" type="number" step="0.01" value="<%= zone.baseCost %>"></div>
                <div class="search-field"><label>Prefijos de código postal (separados por coma)</label><input class="search-input" name="postalCodePrefixes" value="<%= zone.postalCodePrefixes ? zone.postalCodePrefixes.join(',') : '' %>"></div>
                <div class="search-field"><label><input type="checkbox" name="enabled" <%= zone.enabled ? 'checked' : '' %>> Habilitada</label></div>
            </div>
            <button class="btn-primary" type="submit">Actualizar</button>
            <a class="btn-secondary" href="/zone">Cancelar</a>
        </form>
    </main>
</body>
</html>
