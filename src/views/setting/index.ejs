                    <p style="color: var(--color-text-secondary); font-size: var(--font-size-sm);">
                        No hay usuarios registrados en el sistema.
                    </p>
                <% } else { %>
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Nombre y Apellido</th>
                                <th>Documento</th>
                                <th>Email</th>
