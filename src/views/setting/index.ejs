            <!-- LGT-172: Identidad visual (nombre + logo de la empresa) -->
            <div class="settings-card">
                <h2 class="settings-card-title">
                    <span class="material-symbols-outlined">palette</span>
                    Identidad visual
                </h2>
                <p class="settings-subtitle">
                    Personalizá el nombre y el logo de tu organización. Se aplican en el encabezado, el login, las notificaciones y el portal público.
                </p>
                <form method="POST" action="/setting/identity" enctype="multipart/form-data">
                    <div class="settings-addr">
                        <div class="field span-full">
                            <label for="nombre_empresa">Nombre de la empresa <span class="req">*</span></label>
                            <input type="text" id="nombre_empresa" name="nombre_empresa" maxlength="100" value="<%= params.nombre_empresa %>" required>
                            <small style="color:var(--color-text-secondary)">Aparece en notificaciones y portal público.</small>
                        </div>

                        <div class="field span-full">
                            <label for="logo">Logo institucional</label>
                            <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
                                <img id="logo-preview"
                                     src="<%= params.logo_empresa || '/images/logo.png' %>"
                                     alt="Logo actual"
                                     style="height:56px;width:auto;max-width:180px;object-fit:contain;background:var(--color-surface-alt);border:1px solid var(--color-border);border-radius:var(--radius-sm);padding:6px">
                                <input type="file" id="logo" name="logo" accept="image/png,image/jpeg,image/svg+xml,image/webp">
                            </div>
                            <small style="color:var(--color-text-secondary)">PNG, JPG, SVG o WEBP. Máximo 2&nbsp;MB. Dejá el campo vacío para conservar el logo actual.</small>
                        </div>
                    </div>
                    <div class="settings-actions">
                        <button type="submit" class="btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar identidad
                        </button>
                    </div>
                </form>
                <script>
                    (function () {
                        var input = document.getElementById('logo');
                        var preview = document.getElementById('logo-preview');
                        if (!input || !preview) return;

                        var ALLOWED = ['image/png', 'image/jpeg', 'image/svg+xml', 'image/webp'];
                        var MAX_BYTES = 2 * 1024 * 1024; // 2 MB

                        function logoPopup(message) {
                            var overlay = document.createElement('div');
                            overlay.setAttribute('role', 'alertdialog');
                            overlay.style.cssText = 'position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.45)';
                            var box = document.createElement('div');
                            box.style.cssText = 'background:var(--color-surface,#fff);color:var(--color-text,#1a1a1a);border:1px solid var(--color-border,#ddd);border-radius:var(--radius-md,8px);padding:1.25rem 1.5rem;max-width:380px;box-shadow:0 8px 32px rgba(0,0,0,.2);text-align:center';
                            box.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;gap:.5rem;margin-bottom:.5rem;font-weight:600">'
                                + '<span class="material-symbols-outlined" style="color:var(--color-danger,#d32f2f)">error</span>Logo no válido</div>'
                                + '<p style="margin:0 0 1rem;color:var(--color-text-secondary,#555)"></p>';
                            box.querySelector('p').textContent = message;
                            var btn = document.createElement('button');
                            btn.type = 'button';
                            btn.className = 'btn-primary';
                            btn.textContent = 'Entendido';
                            function close() { overlay.remove(); document.removeEventListener('keydown', onKey); }
                            function onKey(e) { if (e.key === 'Escape') close(); }
                            btn.addEventListener('click', close);
                            overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
                            document.addEventListener('keydown', onKey);
                            box.appendChild(btn);
                            overlay.appendChild(box);
                            document.body.appendChild(overlay);
                            btn.focus();
                        }

                        function reset() {
                            input.value = '';
                            preview.src = '<%= params.logo_empresa || '/images/logo.png' %>';
                        }

                        input.addEventListener('change', function () {
                            var file = this.files && this.files[0];
                            if (!file) return;
                            if (ALLOWED.indexOf(file.type) === -1) {
                                reset();
                                logoPopup('El archivo no cumple el formato permitido. Subí una imagen PNG, JPG, SVG o WEBP.');
                                return;
                            }
                            if (file.size > MAX_BYTES) {
                                reset();
                                logoPopup('El archivo supera el tamaño máximo de 2 MB. Subí una imagen más liviana.');
                                return;
                            }
                            preview.src = URL.createObjectURL(file);
                        });
                    })();
                </script>
            </div>

