            <!-- Card: Aviso al Supervisor por rechazo de consentimiento de fatiga (LGT-195) -->
            <% var fatigueNotif = (notifConfig || []).find(function(c){ return c.eventCode === 'FATIGUE_DRIVER_DISABLED_CONSENT'; }); %>
