                                <select id="tpl-variant-select" class="tplm-variant-select"></select>
                                <button type="button" class="tplm-icon-action" id="tpl-variant-new" title="Nueva variante"><span class="material-symbols-outlined">add</span></button>
                                <button type="button" class="tplm-icon-action" id="tpl-variant-default" title="Marcar como predeterminada"><span class="material-symbols-outlined">star</span></button>
                                <button type="button" class="tplm-icon-action tplm-icon-action--danger" id="tpl-variant-delete" title="Eliminar variante"><span class="material-symbols-outlined">delete</span></button>
