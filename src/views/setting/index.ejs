                                <input type="text" id="tpl-modal-subject" name="subject" required>
                            </div>

                            <div class="field">
                                <label>Placeholders <small>(click para insertar · o arrastrá al texto)</small></label>
                                <div class="tplm-chips" id="tpl-placeholders"></div>
