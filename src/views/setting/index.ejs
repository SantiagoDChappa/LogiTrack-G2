<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/shipments.css">
    <title>Ajustes - LogiTrack</title>
    <style>
        .settings-content {
            padding: var(--space-6) clamp(1.25rem, 2.5vw, 2rem);
            display: flex;
            flex-direction: column;
            gap: var(--space-6);
        }
        .settings-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            padding: var(--space-6);
            box-shadow: var(--shadow-sm);
            max-width: 1100px;
        }
        .settings-card-title {
            font-size: var(--font-size-base);
            font-weight: var(--font-weight-semibold);
            color: var(--color-text);
            padding-bottom: var(--space-3);
            border-bottom: 1px solid var(--color-border);
            margin-bottom: var(--space-5);
            display: flex;
            align-items: center;
            gap: var(--space-2);
        }
        .settings-card-title .material-symbols-outlined {
            font-size: 1.1rem;
            color: var(--color-primary);
        }
        .settings-subtitle {
            font-size: var(--font-size-sm);
            color: var(--color-text-secondary);
            margin-bottom: var(--space-5);
            line-height: 1.5;
        }
        #form-notification-config {
            display: flex;
            flex-direction: column;
            gap: 12px;
            width: 100%;
            margin-top: var(--space-4);
        }
        .notification-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            box-sizing: border-box;
            padding: 12px 16px;
            border: 1px solid #dcdcdc;
            border-radius: 10px;
            background-color: #f8f9fa;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }
        .notification-item:hover {
            background-color: #f1f3f5;
            border-color: #bdbdbd;
        }
        .notification-item span {
            color: #333;
        }
        .notification-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }
        .settings-actions {
            display: flex;
            justify-content: flex-end;
            padding-top: var(--space-4);
            border-top: 1px solid var(--color-border);
            margin-top: var(--space-5);
        }
        .settings-addr {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--space-4) var(--space-5);
            align-items: start;
        }
        .settings-addr .addr-full,
        .settings-addr .span-full {
            grid-column: 1 / -1;
        }
        .branch-select {
            width: 100%;
            min-width: 180px;
            padding: 0.4rem 0.6rem;
            border: 1px solid var(--color-border);
            border-radius: var(--radius-sm);
            background: var(--color-surface);
            color: var(--color-text);
            font-size: var(--font-size-sm);
        }

        /* === Editor interactivo de plantillas de email === */
        .tplm-backdrop { display:none; position:fixed; inset:0; z-index:200;
            background:rgba(15,23,42,.6); backdrop-filter:blur(4px);
            align-items:center; justify-content:center; padding:1rem; }
        .tplm-dialog { background:var(--color-bg,#fff); border:1px solid var(--color-border,#e2e8f0);
            border-radius:14px; box-shadow:0 18px 48px rgba(0,0,0,.32);
            width:min(1320px,97vw); height:min(760px,93vh); display:flex; flex-direction:column; overflow:hidden; }
        .tplm-head { display:flex; align-items:flex-start; justify-content:space-between;
            padding:1rem 1.25rem; border-bottom:1px solid var(--color-border); }
        .tplm-title { margin:0; font-size:1.05rem; }
        .tplm-event { font-size:.8rem; color:var(--color-text-secondary); }
        .tplm-close { background:none; border:none; cursor:pointer; color:var(--color-text-secondary);
            display:inline-flex; padding:.2rem; border-radius:6px; }
        .tplm-close:hover { background:var(--color-surface-alt); color:var(--color-text); }
        .tplm-body { display:grid; grid-template-columns:minmax(0,0.95fr) minmax(0,1fr) minmax(0,1fr); gap:1.25rem;
            padding:1.1rem 1.25rem; overflow:hidden; }
        .tplm-editor { display:contents; }
        .tplm-col { display:flex; flex-direction:column; gap:.85rem; min-width:0; min-height:0; overflow:auto; }
        .tplm-col-body { gap:.6rem; }
        .tplm-col-body .field { flex:1; display:flex; flex-direction:column; min-height:0; }
        .tplm-col-body .tplm-textarea { flex:1; min-height:240px; }
        .tplm-row { display:flex; align-items:center; gap:.75rem; }
        .tplm-label { font-size:.8rem; font-weight:600; color:var(--color-text-secondary); }
        .tplm-segmented { display:inline-flex; border:1px solid var(--color-border); border-radius:999px; overflow:hidden; }
        .tplm-segmented button { display:inline-flex; align-items:center; gap:.35rem; border:none;
            background:transparent; color:var(--color-text-secondary); padding:.4rem .9rem; cursor:pointer; font:inherit; font-size:.85rem; }
        .tplm-segmented button .material-symbols-outlined { font-size:1.05rem; }
        .tplm-segmented button.is-active { background:var(--color-primary,#2563eb); color:#fff; }
        .tplm-chips { display:flex; flex-wrap:wrap; gap:.4rem; }
        .tplm-chip { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:.78rem;
            background:var(--color-surface-alt); color:var(--color-primary,#2563eb);
            border:1px solid var(--color-border,#dbe1ea); border-radius:999px;
            padding:.25rem .6rem; cursor:grab; transition:all .12s ease; }
        .tplm-chip:hover { background:var(--color-primary,#2563eb); color:#fff; }
        .tplm-chip:active { cursor:grabbing; }
        .tplm-chip--link { background:rgba(124,58,237,.10); color:#7c3aed; border-color:rgba(124,58,237,.25); }
        .tplm-chip--link:hover { background:#7c3aed; color:#fff; }
        .tplm-chip--var { background:rgba(22,163,74,.10); color:#16a34a; border-color:rgba(22,163,74,.25); }
        .tplm-chip--var:hover { background:#16a34a; color:#fff; }
        .tplm-chip-group { display:flex; flex-wrap:wrap; gap:.35rem; align-items:center; margin-bottom:.3rem; }
        .tplm-chip-group-label { font-size:.68rem; text-transform:uppercase; letter-spacing:.04em; color:var(--color-text-secondary); margin-right:.25rem; min-width:5rem; }
        /* Selector de variante */
        .tplm-variant-row { gap:.5rem; }
        .tplm-variant-select { flex:1; padding:.4rem .6rem; border:1px solid var(--color-border); border-radius:8px; background:var(--color-surface); color:var(--color-text); font:inherit; }
        .tplm-icon-action { display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; border:1px solid var(--color-border); border-radius:8px; background:var(--color-surface); color:var(--color-text-secondary); cursor:pointer; }
        .tplm-icon-action:hover { color:var(--color-primary,#2563eb); border-color:var(--color-primary,#2563eb); }
        .tplm-icon-action--danger:hover { color:#dc2626; border-color:#dc2626; }
        .tplm-icon-action .material-symbols-outlined { font-size:1.1rem; }
        /* ABM cards (variables / snippets) */
        .abm-list { display:flex; flex-direction:column; gap:.5rem; }
        .abm-row { display:flex; align-items:center; gap:.5rem; }
        .abm-form { display:flex; align-items:center; gap:.5rem; flex:1; flex-wrap:wrap; }
        .abm-in { padding:.4rem .6rem; border:1px solid var(--color-border); border-radius:8px; background:var(--color-surface); color:var(--color-text); font:inherit; font-size:.85rem; min-width:7rem; }
        .abm-in--key { font-family:ui-monospace,Menlo,Consolas,monospace; max-width:11rem; }
        .abm-in--grow { flex:1; min-width:9rem; }
        .abm-add { margin-top:.6rem; padding-top:.6rem; border-top:1px dashed var(--color-border); flex-wrap:wrap; }
        .abm-snip { border:1px solid var(--color-border); border-radius:10px; padding:.6rem .7rem; display:flex; gap:.5rem; align-items:flex-start; }
        .abm-snip-form { flex:1; display:flex; flex-direction:column; gap:.4rem; min-width:0; }
        .abm-snip-head { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
        .abm-snip-label { font-size:.7rem; text-transform:uppercase; letter-spacing:.04em; color:var(--color-text-secondary); }
        .abm-badge { font-size:.68rem; background:var(--color-surface-alt); color:var(--color-text-secondary); border:1px solid var(--color-border); border-radius:999px; padding:.1rem .5rem; }
        .tplm-hint { display:block; margin-top:.4rem; font-size:.78rem; color:var(--color-text-secondary); line-height:1.4; }
        .tplm-ph-desc { display:flex; align-items:flex-start; gap:.45rem; margin-top:.5rem;
            padding:.5rem .65rem; border:1px solid var(--color-border); border-radius:8px;
            background:var(--color-surface-alt); color:var(--color-text-secondary);
            font-size:.8rem; line-height:1.35; box-sizing:border-box;
            height:3.6rem; overflow:auto; transition:border-color .15s ease; }
        .tplm-ph-desc-text { display:block; }
        .tplm-ph-desc.is-active { border-color:var(--color-primary,#2563eb); color:var(--color-text); }
        .tplm-ph-desc .material-symbols-outlined { font-size:1.05rem; flex:none; }
        .tplm-ph-desc strong { font-family:ui-monospace,Menlo,Consolas,monospace; }
        .tplm-ph-desc em { color:var(--color-text-secondary); font-style:italic; }
        .tplm-snippets { display:flex; flex-wrap:wrap; gap:.4rem; }
        .tplm-snip { display:inline-flex; align-items:center; gap:.35rem; font-size:.8rem;
            background:var(--color-surface-alt); color:var(--color-text);
            border:1px solid var(--color-border,#dbe1ea); border-radius:8px;
            padding:.35rem .7rem; cursor:pointer; transition:all .12s ease; }
        .tplm-snip:hover { border-color:var(--color-primary,#2563eb); color:var(--color-primary,#2563eb); }
        .tplm-snip .material-symbols-outlined { font-size:1.05rem; }
        .tplm-textarea { font-family:ui-monospace,Menlo,Consolas,monospace; resize:vertical;
            width:100%; line-height:1.5; }
        .tplm-test { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap;
            padding-top:.6rem; border-top:1px dashed var(--color-border); }
        .tplm-test input { flex:1 1 200px; }
        .tplm-test-msg { font-size:.82rem; color:var(--color-text-secondary); }
        .tplm-test-msg.ok  { color:#16a34a; }
        .tplm-test-msg.err { color:#dc2626; }
        /* Lienzo de vista previa: claro por defecto, oscuro en data-theme=dark */
        .tplm-preview { --pv-bg:#ffffff; --pv-text:#0f172a; --pv-muted:#64748b; --pv-border:#e2e8f0;
            display:flex; flex-direction:column; min-width:0;
            border:1px solid var(--color-border); border-radius:10px; background:var(--pv-bg); overflow:hidden; }
        [data-theme="dark"] .tplm-preview { --pv-bg:#0f172a; --pv-text:#e2e8f0; --pv-muted:#94a3b8; --pv-border:rgba(148,163,184,.18); }
        .tplm-preview-head { display:flex; align-items:center; gap:.4rem; padding:.6rem .8rem;
            border-bottom:1px solid var(--pv-border); font-size:.82rem; font-weight:600; color:var(--pv-muted); background:var(--pv-bg); }
        .tplm-preview-head small { font-weight:400; margin-left:auto; }
        .tplm-preview-head .material-symbols-outlined { font-size:1.05rem; }
        .tplm-preview-subject { padding:.6rem .8rem; font-weight:600; border-bottom:1px solid var(--pv-border);
            color:var(--pv-text); white-space:pre-wrap; word-break:break-word; }
        .tplm-preview-body { flex:1; min-height:240px; background:var(--pv-bg); display:flex; }
        .tplm-preview-body pre { flex:1; min-height:0; margin:0; padding:.8rem; overflow:auto;
            white-space:pre-wrap; word-break:break-word;
            color:var(--pv-text); font-family:ui-monospace,Menlo,Consolas,monospace; font-size:.85rem; }
        .tplm-preview-body iframe { flex:1; min-height:0; width:100%; border:none; background:var(--pv-bg); display:none; }
        .tplm-foot { display:flex; justify-content:flex-end; gap:.6rem;
            padding:.85rem 1.25rem; border-top:1px solid var(--color-border); }
        .tplm-preview { min-height:0; overflow:auto; }
        @media (max-width:1100px) { .tplm-body { grid-template-columns:1fr 1fr; overflow:auto; }
            .tplm-col, .tplm-preview { overflow:visible; } }
        @media (max-width:760px) { .tplm-body { grid-template-columns:1fr; } }
    </style>
    <link rel="stylesheet" href="/css/settings.css">
</head>

<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Ajustes</h1>
        </div>

        <!-- LGT-174: cada categoría es su propia página (navegada desde el menú superior) -->
        <div class="settings-layout">
        <div class="settings-content">

            <span class="settings-anchor" id="sec-general"></span>
            <style>
                /* LGT-174: organización de ajustes por categorías */
                .settings-category {
                    display: flex; align-items: center; gap: .75rem;
                    margin: 2.25rem 0 1rem; padding-bottom: .6rem;
                    border-bottom: 2px solid var(--color-border);
                    scroll-margin-top: 90px;
                }
                .settings-category:first-of-type { margin-top: .25rem; }
                .settings-category > .material-symbols-outlined {
                    font-size: 1.6rem; color: var(--color-primary);
                    background: var(--color-primary-light); border-radius: var(--radius-md);
                    padding: .35rem; flex-shrink: 0;
                }
                .settings-category h3 { margin: 0; font-size: var(--font-size-lg); }
                .settings-category p  { margin: .1rem 0 0; font-size: var(--font-size-sm); color: var(--color-text-secondary); }
            </style>

            <% if (activeSection === 'general') { %>
            <section class="settings-category" id="cat-general">
                <span class="material-symbols-outlined">tune</span>
                <div><h3>General</h3><p>Datos base y parámetros operativos del sistema.</p></div>
            </section>

            <!-- Card 1: Dirección de origen -->
            <div class="settings-card">
                <h2 class="settings-card-title">
                    <span class="material-symbols-outlined">location_on</span>
                    Dirección de origen del sistema
                </h2>
                <p class="settings-subtitle">
                    Esta dirección representa la sucursal o punto de partida de todos los envíos.
                    Se usa para calcular la distancia real hasta el destino y mejorar la predicción del modelo de ML.
                </p>
                <form method="POST" action="/setting">
                    <input type="hidden" id="street"      name="origin_street"      value="<%= settings.origin_street      || '' %>">
                    <input type="hidden" id="number"      name="origin_number"      value="<%= settings.origin_number      || '' %>">
                    <input type="hidden" id="province"    name="origin_province_id" value="<%= settings.origin_province_id || '' %>">
                    <input type="hidden" id="postal-code" name="origin_postal_code" value="<%= settings.origin_postal_code || '' %>">
                    <div class="settings-addr">
                        <div class="field addr-search-wrapper addr-full">
                            <label for="address-search">Dirección completa <span class="req">*</span></label>
                            <input id="address-search" type="text" autocomplete="off" placeholder="Ej: Av. Corrientes 1234, Buenos Aires">
                            <div id="address-dropdown" class="addr-dropdown" style="display:none;"></div>
                        </div>
                        <div class="addr-selected-row addr-full" id="addr-selected-row" style="display:none;">
                            <div id="address-chip" class="addr-chip">
                                <span class="material-symbols-outlined">pin_drop</span>
                                <span id="addr-chip-text"></span>
                            </div>
                            <button type="button" id="address-clear" class="addr-clear-btn">
                                <span class="material-symbols-outlined">close</span> Cambiar
                            </button>
                        </div>
                        <div id="address-validation-result" class="addr-validation-box addr-validation-box--empty addr-full"></div>
                    </div>
                    <div class="settings-actions">
                        <button type="submit" class="action-btn action-btn--lg guardar" data-tooltip="Guardar ajustes" aria-label="Guardar ajustes">
                            <span class="material-symbols-outlined">save</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Fecha y hora: zona horaria + formato 12/24 hs -->
            <div class="settings-card">
                <h2 class="settings-card-title">
                    <span class="material-symbols-outlined">schedule</span>
                    Fecha y hora
                </h2>
                <p class="settings-subtitle">
                    Zona horaria y formato con que se muestran todas las fechas del sistema (historial, notificaciones, envíos).
                    El servidor guarda en UTC; acá se ajusta solo la visualización.
                </p>
                <form method="POST" action="/setting/datetime">
                    <div class="field" style="max-width:420px">
                        <label for="display_timezone">Zona horaria</label>
                        <select id="display_timezone" name="display_timezone">
                            <% timezones.forEach(function(tz) { %>
                                <option value="<%= tz.id %>" <%= params.display_timezone === tz.id ? 'selected' : '' %>><%= tz.label %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="field" style="margin-top:.75rem">
                        <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;font-weight:500;">
                            <input type="checkbox" name="clock_24h" <%= params.clock_24h ? 'checked' : '' %>>
                            Formato 24 horas (ej: 14:30). Sin tildar usa 12 hs (02:30 p. m.).
                        </label>
                    </div>
                    <div class="settings-actions">
                        <button type="submit" class="action-btn action-btn--lg guardar" data-tooltip="Guardar fecha y hora" aria-label="Guardar fecha y hora">
                            <span class="material-symbols-outlined">save</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- LGT-173: Colores de estados -->
            <div class="settings-card">
                <h2 class="settings-card-title">
                    <span class="material-symbols-outlined">format_color_fill</span>
                    Colores de estados
                </h2>
                <p class="settings-subtitle">
                    Personalizá el color de cada estado de envío. Se aplica en los listados, el detalle y el seguimiento. Dejá tildado "Color del tema" para usar el predeterminado.
                </p>
                <form method="POST" action="/setting/status-colors">
                    <div class="status-colors-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:.75rem">
                        <% (statusColorList || []).forEach(function(st) { %>
                            <% var _scolor = st.color || '#64748b'; %>
                            <div class="status-color-row" style="display:flex;align-items:center;gap:.6rem;padding:.6rem .75rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-surface-alt)">
                                <input type="color" name="status_color_<%= st.id %>" value="<%= _scolor %>"
                                       style="width:38px;height:38px;border:none;background:none;cursor:pointer;flex-shrink:0"
                                       data-status-preview="<%= st.id %>">
                                <div style="flex:1;min-width:0">
                                    <span class="status-badge" id="status-preview-<%= st.id %>"
                                          style="background-color:<%= _scolor %>22;color:<%= _scolor %>"><%= st.description %></span>
                                    <label style="display:flex;align-items:center;gap:.35rem;margin-top:.4rem;font-size:var(--font-size-xs);text-transform:none;font-weight:500;color:var(--color-text-secondary)">
                                        <input type="checkbox" name="default_<%= st.id %>" <%= st.color ? '' : 'checked' %> style="width:auto">
                                        Color del tema
                                    </label>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    <div class="settings-actions">
                        <button type="submit" class="btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar colores
                        </button>
                    </div>
                </form>
                <script>
                    document.querySelectorAll('[data-status-preview]').forEach(function (inp) {
                        var id = inp.getAttribute('data-status-preview');
                        var badge = document.getElementById('status-preview-' + id);
                        var chk = inp.closest('.status-color-row').querySelector('input[type="checkbox"]');
                        inp.addEventListener('input', function () {
                            badge.style.backgroundColor = inp.value + '22';
                            badge.style.color = inp.value;
                            if (chk) chk.checked = false;
                        });
                    });
                </script>
            </div>

            <!-- Colores de estados de incidencias -->
            <div class="settings-card">
                <h2 class="settings-card-title">
                    <span class="material-symbols-outlined">format_color_fill</span>
                    Colores de estados de incidencias
                </h2>
                <p class="settings-subtitle">
                    Personalizá el color de cada estado de incidencia. Se aplica en los listados y el detalle de incidencias. Dejá tildado "Color del tema" para usar el predeterminado.
                </p>
                <form method="POST" action="/setting/incident-status-colors">
                    <div class="status-colors-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:.75rem">
                        <% (incidentStatusColorList || []).forEach(function(st) { %>
                            <% var _icolor = st.color || st.defaultColor; %>
                            <div class="status-color-row" style="display:flex;align-items:center;gap:.6rem;padding:.6rem .75rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-surface-alt)">
                                <input type="color" name="incident_status_color_<%= st.code %>" value="<%= _icolor %>"
                                       style="width:38px;height:38px;border:none;background:none;cursor:pointer;flex-shrink:0"
                                       data-incident-status-preview="<%= st.code %>">
                                <div style="flex:1;min-width:0">
                                    <span class="status-badge" id="incident-status-preview-<%= st.code %>"
                                          style="display:inline-block;padding:.15rem .6rem;border-radius:999px;font-size:.78rem;font-weight:600;background-color:<%= _icolor %>22;color:<%= _icolor %>"><%= st.label %></span>
                                    <label style="display:flex;align-items:center;gap:.35rem;margin-top:.4rem;font-size:var(--font-size-xs);text-transform:none;font-weight:500;color:var(--color-text-secondary)">
                                        <input type="checkbox" name="default_<%= st.code %>" <%= st.color ? '' : 'checked' %> style="width:auto">
                                        Color del tema
                                    </label>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    <div class="settings-actions">
                        <button type="submit" class="btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar colores
                        </button>
                    </div>
                </form>
                <script>
                    document.querySelectorAll('[data-incident-status-preview]').forEach(function (inp) {
                        var code = inp.getAttribute('data-incident-status-preview');
