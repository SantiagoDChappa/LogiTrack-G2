                    <%
                        // Agrupacion semantica por evento. Los codigos que no matchean caen en "Otros".
                        const sectionFor = (code) => {
                            if (code === 'FATIGUE_DRIVER_DISABLED_CONSENT') { return null; } // gestionado en card aparte
                            if (code === 'PORTAL_CLIENT_ACCESS')            { return null; } // card propia
                            if (code === 'SHIPMENT_INCIDENT' || code === 'INCIDENT_STATUS_CHANGE') { return 'incidencias'; }
                            if (code.startsWith('SHIPMENT_PACKAGE_FAILED')) { return 'incidencias'; }
                            if (code.startsWith('SHIPMENT_'))               { return 'envios'; }
                            if (code.startsWith('ROUTE_'))                  { return 'rutas'; }
                            return 'otros';
                        };
                        const SECTION_META = {
                            envios:      { title: 'Envíos',     icon: 'local_shipping', desc: 'Cambios de estado del envío y avisos accionables al cliente.' },
                            incidencias: { title: 'Incidencias', icon: 'report',         desc: 'Aperturas, cambios de estado y resoluciones de incidencias (incluye paquete fallido por motivo).' },
                            rutas:       { title: 'Rutas',       icon: 'route',          desc: 'Eventos de las rutas de reparto.' },
                            otros:       { title: 'Otros',       icon: 'mail',           desc: 'Notificaciones varias.' }
                        };
                        const grouped = { envios: [], incidencias: [], rutas: [], otros: [] };
                        notifConfig.forEach(c => {
                            const sec = sectionFor(c.eventCode);
                            if (sec) { grouped[sec].push(c); }
                        });
