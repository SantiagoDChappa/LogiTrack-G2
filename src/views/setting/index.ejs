            <%/* El modal de edición de templates y su JS viven con la sección Comunicaciones,
                 que es donde están los botones "editar mail" y los selects de destinatario. */%>
            <% if (activeSection === 'comunicaciones') { %>
            <!-- Modal: Editar template de email (interactivo) -->
