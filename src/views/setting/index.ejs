            <script id="tpl-data" type="application/json"><%- JSON.stringify({
                placeholderGroups,
                customVariables: (customVariables||[]).map(v => ({ key:v.key, label:v.label, value:v.value, description:v.description })),
                snippets: (emailSnippets||[]).map(s => ({ key:s.key, label:s.label, icon:s.icon, html:s.html, text:s.text })),
                templatesByEvent,
                sampleVars
            }) %></script>
            <script>
                (function setupNotifConfig() {
                    const DATA = JSON.parse(document.getElementById('tpl-data').textContent || '{}');
                    const PH_GROUPS  = DATA.placeholderGroups || {};
                    const CUSTOM_VARS= DATA.customVariables || [];
                    const SNIPPETS   = DATA.snippets || [];
                    const TPL        = DATA.templatesByEvent || {};
                    const SAMPLE     = DATA.sampleVars || {};

                    document.querySelectorAll('.notif-mode-select').forEach(sel => {
                        sel.addEventListener('change', e => {
                            const ev = e.target.dataset.event;
                            const input = document.querySelector('.notif-custom-input[data-event="' + ev + '"]');
                            if (!input) return;
                            input.disabled = e.target.value !== 'custom';
                            if (input.disabled) input.value = '';
                        });
                    });

                    const fillSample = (s) => String(s || '').replace(/\{\{\s*([\w]+)\s*\}\}/g, (m, k) => (SAMPLE[k] !== undefined ? SAMPLE[k] : m));
                    const escapeHtml = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

                    const backdrop = document.getElementById('tpl-modal-backdrop');
                    const form     = document.getElementById('tpl-modal-form');
                    const eventLbl = document.getElementById('tpl-modal-event');
                    const nameIn   = document.getElementById('tpl-modal-name');
                    const subject  = document.getElementById('tpl-modal-subject');
                    const body     = document.getElementById('tpl-modal-body');
                    const formatIn = document.getElementById('tpl-modal-format');
                    const toggle   = document.getElementById('tpl-format-toggle');
                    const pvSubject= document.getElementById('tpl-preview-subject');
                    const pvText   = document.getElementById('tpl-preview-text');
                    const pvHtml   = document.getElementById('tpl-preview-html');
                    const variantSel = document.getElementById('tpl-variant-select');
                    const chipsBox = document.getElementById('tpl-placeholders');
                    const snipsBox = document.getElementById('tpl-snippets');
                    let currentEvent = '';

                    function setFormat(fmt) {
                        formatIn.value = fmt;
                        toggle.querySelectorAll('button').forEach(b => b.classList.toggle('is-active', b.dataset.format === fmt));
                        renderPreview();
                    }

                    function renderPreview() {
                        const fmt = formatIn.value;
                        pvSubject.textContent = fillSample(subject.value) || '(sin asunto)';
                        const filled = fillSample(body.value);
                        if (fmt === 'html') {
                            pvText.style.display = 'none';
                            pvHtml.style.display = 'block';
                            const isFullDoc = /<!doctype/i.test(filled) || /<html[\s>]/i.test(filled);
                            if (isFullDoc) {
                                pvHtml.srcdoc = filled;
                            } else {
                                const dark = document.documentElement.getAttribute('data-theme') === 'dark';
                                const pv = dark ? { bg:'#0f172a', fg:'#e2e8f0' } : { bg:'#ffffff', fg:'#0f172a' };
                                pvHtml.srcdoc = '<!doctype html><meta charset="utf-8"><body style="font-family:system-ui,sans-serif;margin:12px;background:' + pv.bg + ';color:' + pv.fg + '">' + filled + '</body>';
                            }
                        } else {
                            pvHtml.style.display = 'none';
                            pvText.style.display = 'block';
                            pvText.textContent = filled || '(sin contenido)';
                        }
                    }

                    function insertText(str) {
                        const start = body.selectionStart ?? body.value.length;
                        const end   = body.selectionEnd   ?? body.value.length;
                        body.value = body.value.slice(0, start) + str + body.value.slice(end);
                        const pos = start + str.length;
                        body.focus();
                        body.setSelectionRange(pos, pos);
                        renderPreview();
                    }

                    // ---- Panel descriptivo del placeholder ----
                    const phDescBox  = document.getElementById('tpl-ph-desc');
                    const phDescText = phDescBox.querySelector('.tplm-ph-desc-text');
                    const phDefault  = phDescText.textContent;
                    const showDesc = (chip) => {
                        const sample = SAMPLE[chip.dataset.key];
                        phDescText.innerHTML = '<strong>' + escapeHtml(chip.dataset.token) + '</strong> — ' + escapeHtml(chip.dataset.desc || '')
                            + (sample ? ' <em>Ej.: ' + escapeHtml(String(sample).slice(0, 60)) + '</em>' : '');
                        phDescBox.classList.add('is-active');
                    };
                    const clearDesc = () => { phDescText.textContent = phDefault; phDescBox.classList.remove('is-active'); };

                    // ---- Construir chips de placeholders (catálogo + variables custom) ----
                    function buildChips() {
                        chipsBox.innerHTML = '';
                        const groups = Object.assign({}, PH_GROUPS);
                        if (CUSTOM_VARS.length) {
                            groups['Variables'] = CUSTOM_VARS.map(v => ({ token: v.key, label: v.label, description: v.description || ('Valor: ' + v.value), group: 'Variables' }));
                        }
                        Object.keys(groups).forEach(group => {
                            const wrap = document.createElement('div');
                            wrap.className = 'tplm-chip-group';
                            wrap.innerHTML = '<span class="tplm-chip-group-label">' + escapeHtml(group) + '</span>';
                            groups[group].forEach(p => {
                                const token = '{{' + p.token + '}}';
                                const b = document.createElement('button');
                                b.type = 'button';
                                b.className = 'tplm-chip' + (group === 'Enlaces' ? ' tplm-chip--link' : (group === 'Variables' ? ' tplm-chip--var' : ''));
                                b.draggable = true;
                                b.textContent = token;
                                b.dataset.token = token;
                                b.dataset.key = p.token;
                                b.dataset.desc = p.description || '';
                                b.addEventListener('click', () => insertText(token));
                                b.addEventListener('dragstart', e => e.dataTransfer.setData('text/plain', token));
                                b.addEventListener('mouseenter', () => showDesc(b));
                                b.addEventListener('focus', () => showDesc(b));
                                b.addEventListener('mouseleave', clearDesc);
                                b.addEventListener('blur', clearDesc);
                                wrap.appendChild(b);
                            });
                            chipsBox.appendChild(wrap);
                        });
                    }

                    // ---- Construir bloques rápidos (snippets) ----
                    function buildSnippets() {
                        snipsBox.innerHTML = '';
                        SNIPPETS.forEach(s => {
                            const b = document.createElement('button');
                            b.type = 'button';
                            b.className = 'tplm-snip';
                            b.innerHTML = (s.icon ? '<span class="material-symbols-outlined">' + escapeHtml(s.icon) + '</span> ' : '') + escapeHtml(s.label);
                            b.addEventListener('click', () => {
                                const content = formatIn.value === 'html' ? (s.html || '') : (s.text || '');
                                insertText((body.value && !body.value.endsWith('\n') ? '\n' : '') + content + '\n');
                            });
                            snipsBox.appendChild(b);
                        });
                    }

                    body.addEventListener('dragover', e => e.preventDefault());
                    body.addEventListener('drop', e => {
                        e.preventDefault();
                        const token = e.dataTransfer.getData('text/plain');
                        if (token) { insertText(token); }
                    });
                    toggle.querySelectorAll('button').forEach(b => b.addEventListener('click', () => setFormat(b.dataset.format)));
                    subject.addEventListener('input', renderPreview);
                    body.addEventListener('input', renderPreview);

                    // ---- Variantes ----
                    function loadVariant(v) {
                        if (!v) { // nueva variante
                            form.action = '/setting/email-template/variant/' + currentEvent;
                            nameIn.value = ''; subject.value = ''; body.value = '';
                            setFormat('text');
                            return;
                        }
                        form.action = '/setting/email-template/update/' + v.id;
                        nameIn.value = v.name || '';
                        subject.value = v.subject || '';
                        body.value = v.body || '';
                        setFormat(v.format === 'html' ? 'html' : 'text');
                    }

                    function fillVariantSelect(selectedId) {
                        const list = TPL[currentEvent] || [];
                        variantSel.innerHTML = '';
                        list.forEach(v => {
                            const o = document.createElement('option');
                            o.value = String(v.id);
                            o.textContent = v.name + (v.isDefault ? ' ★' : '');
                            variantSel.appendChild(o);
                        });
                        if (selectedId != null) { variantSel.value = String(selectedId); }
                    }

                    variantSel.addEventListener('change', () => {
                        const list = TPL[currentEvent] || [];
                        const v = list.find(x => String(x.id) === variantSel.value);
                        loadVariant(v);
                    });

                    document.getElementById('tpl-variant-new').addEventListener('click', () => {
                        variantSel.value = '';
                        loadVariant(null);
                        nameIn.focus();
                    });

                    const postForm = (action) => {
                        const f = document.createElement('form');
                        f.method = 'POST'; f.action = action;
                        document.body.appendChild(f); f.submit();
                    };
                    document.getElementById('tpl-variant-default').addEventListener('click', () => {
                        if (variantSel.value) { postForm('/setting/email-template/default/' + variantSel.value); }
                    });
                    document.getElementById('tpl-variant-delete').addEventListener('click', () => {
                        const list = TPL[currentEvent] || [];
                        if (!variantSel.value) { return; }
                        if (list.length <= 1) { alert('No se puede eliminar la única variante del evento.'); return; }
                        if (confirm('¿Eliminar esta variante?')) { postForm('/setting/email-template/delete/' + variantSel.value); }
                    });

                    // ---- Abrir modal ----
                    buildChips();
                    buildSnippets();
                    document.querySelectorAll('.notif-edit-tpl-btn').forEach(btn => {
                        btn.addEventListener('click', () => {
                            currentEvent = btn.dataset.event;
                            eventLbl.textContent = btn.dataset.description;
                            const list = TPL[currentEvent] || [];
                            const def = list.find(v => v.isDefault) || list[0] || null;
                            fillVariantSelect(def ? def.id : null);
                            loadVariant(def);
                            document.getElementById('tpl-modal-test-msg').textContent = '';
                            backdrop.style.display = 'flex';
                        });
                    });

                    const close = () => { backdrop.style.display = 'none'; };
                    document.getElementById('tpl-modal-cancel').addEventListener('click', close);
                    document.getElementById('tpl-modal-cancel2').addEventListener('click', close);
                    // No cerrar al hacer click fuera del popup: solo con la X o Cancelar.

                    document.getElementById('tpl-modal-test-btn').addEventListener('click', async () => {
                        const msg = document.getElementById('tpl-modal-test-msg');
                        const to  = document.getElementById('tpl-modal-test-email').value.trim();
                        msg.className = 'tplm-test-msg';
                        msg.textContent = 'Enviando...';
                        try {
                            const r = await fetch('/setting/email-template/' + currentEvent + '/test', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ testEmail: to, subject: subject.value, body: body.value, format: formatIn.value })
                            });
                            const data = await r.json();
                            if (data.ok) { msg.classList.add('ok'); msg.textContent = '✓ Enviado'; }
                            else { msg.classList.add('err'); msg.textContent = data.error || 'Error'; }
                        } catch { msg.classList.add('err'); msg.textContent = 'Error de red'; }
                    });
                })();
            </script>

            <!-- Card 3: Optimización de ruteo -->
            <% } %>
