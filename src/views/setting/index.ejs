                <h2 class="settings-card-title">
                    <span class="material-symbols-outlined">edit_note</span>
                    Mensajes estándar
                </h2>
                <p class="settings-subtitle">Textos reutilizables (reprogramación, próxima entrega, devuelto). Soportan placeholders <code>{{date}}</code>, <code>{{branch}}</code>, <code>{{eta}}</code>.</p>
                <% (stdMessages || []).forEach(m => { %>
                <form method="POST" action="/setting/standard-message/<%= m.code %>" style="margin-bottom:1rem">
                    <label style="font-weight:600"><%= m.label %> <code style="font-size:.75rem;color:#64748b">(<%= m.code %>)</code></label>
                    <textarea name="body" rows="2" style="width:100%;margin-top:.25rem;padding:.5rem;border:1px solid #cbd5e1;border-radius:6px"><%= m.body %></textarea>
                    <button class="action-btn action-btn--lg guardar" type="submit" style="margin-top:.25rem" data-tooltip="Guardar" aria-label="Guardar"><span class="material-symbols-outlined">save</span></button>
                </form>
                <% }) %>
            </div>

            <!-- Card 5: Historial de cambios -->
            <% } %>

            <% if (activeSection === 'incidencias') { %>
            <span class="settings-anchor" id="sec-incidencias"></span>
            <section class="settings-category" id="cat-incidencias">
                <span class="material-symbols-outlined">report</span>
                <div><h3>Incidencias</h3><p>Demoras, plantillas de gestión y tipos de incidencia.</p></div>
            </section>

            <!-- Card: Parámetros de demora (LGT-160) -->
            <div class="settings-card">
                <h2 class="settings-card-title">
                    <span class="material-symbols-outlined">schedule</span>
                    Demora significativa
                </h2>
                <p class="settings-subtitle">Cuándo se considera que un envío está demorado y cada cuánto se recuerda.</p>
                <form method="POST" action="/setting/incident-params">
                    <div class="settings-addr">
                        <div class="field">
                            <label for="delay_threshold_pct">Umbral (% de la duración del viaje)</label>
                            <input type="number" id="delay_threshold_pct" name="delay_threshold_pct" min="1" max="100"
                                   value="<%= settings.delay_threshold_pct || '15' %>">
                        </div>
                        <div class="field">
                            <label for="delay_reminder_days">Intervalo de recordatorio (días)</label>
                            <input type="number" id="delay_reminder_days" name="delay_reminder_days" min="1" max="365"
                                   value="<%= settings.delay_reminder_days || '1' %>">
                        </div>
                    </div>
                    <div class="settings-actions">
                        <button class="action-btn action-btn--lg guardar" type="submit" data-tooltip="Guardar" aria-label="Guardar"><span class="material-symbols-outlined">save</span></button>
                    </div>
                </form>
            </div>

            <!-- Card: Plantillas de checklist -->
            <div class="settings-card">
                <h2 class="settings-card-title">
                    <span class="material-symbols-outlined">checklist</span>
                    Plantillas de gestión (checklist)
                </h2>
                <p class="settings-subtitle">Pasos de resolución por tipo de incidencia.</p>
                <a class="btn-primary" href="/incident/config/templates" style="display:inline-flex;align-items:center;gap:.4rem;text-decoration:none;width:auto">
                    <span class="material-symbols-outlined">open_in_new</span> Administrar plantillas
                </a>
            </div>

            <!-- Card: Tipos de incidencia (catálogo) -->
            <div class="settings-card">
                <h2 class="settings-card-title">
                    <span class="material-symbols-outlined">category</span>
                    Tipos de incidencia
                </h2>
                <p class="settings-subtitle">Catálogo de tipos disponibles.</p>
                <div class="incident-type-grid">
                    <% (incidentTypes || []).forEach(t => { %>
                    <div class="incident-type<%= t.active === false ? ' is-inactive' : '' %>">
                        <span class="material-symbols-outlined incident-type-ico">label</span>
                        <div class="incident-type-text">
                            <code class="incident-type-code"><%= t.code %></code>
                            <span class="incident-type-desc"><%= t.description %></span>
                        </div>
                        <% if (t.active === false) { %><span class="incident-type-badge">inactivo</span><% } %>
                    </div>
                    <% }) %>
                    <% if (!incidentTypes || !incidentTypes.length) { %>
                    <p style="color:var(--color-text-secondary);grid-column:1/-1;margin:0">Sin tipos cargados.</p>
                    <% } %>
                </div>
                <style>
                    .incident-type-grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
                        gap: .6rem;
                    }
                    .incident-type {
                        display: flex; align-items: center; gap: .65rem;
                        padding: .6rem .75rem;
                        border: 1px solid var(--color-border);
                        border-radius: var(--radius-md);
                        background: var(--color-surface-alt);
                        transition: border-color .15s ease, transform .15s ease;
                    }
                    .incident-type:hover { border-color: var(--color-primary); transform: translateY(-1px); }
                    .incident-type-ico {
                        font-size: 1.2rem; color: var(--color-primary);
                        background: var(--color-primary-light);
                        border-radius: var(--radius-sm); padding: .3rem; flex-shrink: 0;
                    }
                    .incident-type-text { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
                    .incident-type-code {
                        font-family: ui-monospace, Menlo, Consolas, monospace;
                        font-size: .78rem; font-weight: 600;
                        color: var(--color-text); letter-spacing: .02em;
                    }
                    .incident-type-desc { font-size: var(--font-size-sm); color: var(--color-text-secondary); }
                    .incident-type-badge {
                        margin-left: auto; flex-shrink: 0;
                        font-size: .68rem; text-transform: uppercase; letter-spacing: .04em;
                        color: var(--color-text-secondary);
                        background: var(--color-surface); border: 1px solid var(--color-border);
                        border-radius: 999px; padding: .1rem .5rem;
                    }
                    .incident-type.is-inactive { opacity: .55; }
                    .incident-type.is-inactive .incident-type-ico { color: var(--color-text-secondary); background: var(--color-border); }
                </style>
            </div>
            <% } %>

            <% if (activeSection === 'auditoria') { %>
            <span class="settings-anchor" id="sec-auditoria"></span>
            <section class="settings-category" id="cat-auditoria">
                <span class="material-symbols-outlined">history</span>
                <div><h3>Auditoría</h3><p>Registro de cambios de configuración.</p></div>
            </section>

            <div class="settings-card">
                <h2 class="settings-card-title">
                    <span class="material-symbols-outlined">history</span>
                    Historial de cambios de configuración
                </h2>
                <p class="settings-subtitle">
                    Registro de los últimos 50 cambios realizados por administradores.
                </p>
                <% if (settingLogs.length === 0) { %>
                    <p style="color:var(--color-text-secondary);font-size:var(--font-size-sm)">No hay cambios registrados.</p>
                <% } else { %>
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Fecha y hora</th>
                                <th>Usuario</th>
                                <th>Parámetro</th>
                                <th>Valor anterior</th>
                                <th>Valor nuevo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% settingLogs.forEach(log => { %>
                            <tr>
                                <td><%= new Date(log.changedAt).toLocaleString('es-AR') %></td>
                                <td><%= log.user ? log.user.fullName : 'Sistema' %></td>
                                <td><code><%= log.key %></code></td>
                                <td><%= log.oldValue || '-' %></td>
                                <td><strong><%= log.newValue || '-' %></strong></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </div>
            <% } %>
        </div>
        </div><!-- /.settings-layout -->
    </main>

    <% const _currentProv = provinces.find(p => p.id == settings.origin_province_id); %>
    <script id="setting-addr-data" type="application/json"><%- JSON.stringify({
        street: settings.origin_street || null,
        number: settings.origin_number || null,
        prov:   _currentProv ? _currentProv.description : ''
    }) %></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/address-autocomplete.js" defer></script>
    <script>
        const _addr = JSON.parse(document.getElementById('setting-addr-data').textContent);
        if (_addr.street && _addr.number) {
            document.addEventListener('DOMContentLoaded', function () {
                const mainLine = _addr.street + ' ' + _addr.number;
                const subLine  = _addr.prov;
                const row  = document.getElementById('addr-selected-row');
                const text = document.getElementById('addr-chip-text');
                if (text) text.innerHTML = '<strong>' + mainLine + '</strong>' + (subLine ? ' — ' + subLine : '');
                if (row)  row.style.display = 'flex';
                const box = document.getElementById('address-validation-result');
                if (box) {
                    box.className = 'addr-validation-box addr-validation-box--valid addr-full';
                    box.innerHTML = '<span class="material-symbols-outlined" style="font-size:1rem">check_circle</span> Origen actual: <strong>' + mainLine + (subLine ? ', ' + subLine : '') + '</strong>';
                }
                window.addrValid = true;
            });
        }

        const _qs = new URLSearchParams(window.location.search);
        const _param = _qs.get('success');
        if (_param === '1' || _param === '2' || _param === '3' || _param === '4' || _param === 'flush' || _param === 'proc') {
            const isDark = (localStorage.getItem('theme') ?? 'light') === 'dark';
            const _titles = {
                '1': 'Ajustes guardados',
                '2': 'Sucursal asignada correctamente',
                '3': 'Configuración de ruteo guardada',
                '4': 'Parámetros guardados correctamente'
            };
            let _title = _titles[_param];
            let _text;
            if (_param === 'flush') {
                const _sent = parseInt(_qs.get('sent') || '0', 10);
                const _retried = parseInt(_qs.get('retried') || '0', 10);
                _title = _sent > 0 ? `${_sent} email(s) enviado(s)` : 'No había emails pendientes';
                _text = _retried > 0 ? `${_retried} quedaron reprogramados para reintento.` : undefined;
            }
            if (_param === 'proc') {
                _title = 'Proceso ejecutado';
                _text = _qs.get('detail') || undefined;
            }
            Swal.fire({
                icon: 'success',
                title: _title,
                text: _text,
                confirmButtonText: 'Aceptar',
                confirmButtonColor: isDark ? '#3b82f6' : '#2563eb',
                background: isDark ? '#1e293b' : '#ffffff',
                color:      isDark ? '#f1f5f9' : '#1e293b',
            }).then(() => { history.replaceState(null, '', window.location.pathname); });
        }

        // CP-CNNF04: error de variables inválidas en plantilla (mensaje dinámico en ?msg).
        const _err = _qs.get('error');
        if (_err === 'tpl_vars') {
            const isDark = (localStorage.getItem('theme') ?? 'light') === 'dark';
            Swal.fire({
                icon: 'error',
                title: 'Variables no válidas',
                text: _qs.get('msg') || 'La plantilla usa variables que no existen.',
                confirmButtonText: 'Entendido',
                confirmButtonColor: isDark ? '#3b82f6' : '#2563eb',
                background: isDark ? '#1e293b' : '#ffffff',
                color:      isDark ? '#f1f5f9' : '#1e293b',
            }).then(() => { history.replaceState(null, '', window.location.pathname); });
        }
    </script>
</body>

</html>
