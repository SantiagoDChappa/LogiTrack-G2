                <form method="POST" action="/setting/email-snippet" class="abm-snip abm-add">
                    <div class="abm-snip-head">
                        <input type="text" name="label" placeholder="etiqueta del bloque" class="abm-in" required>
                        <input type="text" name="icon" placeholder="ícono (ej: link)" class="abm-in abm-in--key">
