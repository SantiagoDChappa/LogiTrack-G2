                        <button type="button" class="action-btn modificar notif-edit-tpl-btn"
                            data-event="FATIGUE_DRIVER_DISABLED_CONSENT"
                            data-description="Aviso de transportista inhabilitado por fatiga"
                            data-tooltip="Editar mail" aria-label="Editar mail">
                            <span class="material-symbols-outlined">edit_note</span>
                        </button>
                        <% } %>
                    </div>
                    <p style="font-size:.8rem;color:var(--color-text-secondary);margin-top:.5rem">
                        Placeholders disponibles: <code>{{transportistaNombre}}</code>, <code>{{transportistaId}}</code>,
                        <code>{{sucursalNombre}}</code>, <code>{{sucursalId}}</code>, <code>{{rutaId}}</code>,
                        <code>{{rechazos}}</code>, <code>{{maxRechazos}}</code>, <code>{{motivoInhabilitacion}}</code>.
                    </p>
                    <div class="settings-actions">
                        <button type="submit" class="action-btn action-btn--lg guardar" data-tooltip="Guardar configuración" aria-label="Guardar configuración">
                            <span class="material-symbols-outlined">save</span>
                        </button>
                    </div>
                </form>
                <% } %>
            </div>

            <!-- Card: Notificaciones de incidencias (destinatarios internos) -->
            <div class="settings-card">
                <h2 class="settings-card-title">
                    <span class="material-symbols-outlined">report</span>
                    Notificaciones de incidencias
                </h2>
                <p class="settings-subtitle">
                    Elegí quiénes reciben un email cuando se registra una nueva incidencia interna. Se pueden combinar destinatarios por rol y emails personalizados.
                </p>
                <form method="POST" action="/setting/incident-notification">
                    <div class="notif-toggle-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:.6rem 1.5rem">
                        <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
                            <input type="checkbox" name="notifySupervisorBranch" <%= incidentNotif.notifySupervisorBranch ? 'checked' : '' %>>
                            <span>Supervisor de la sucursal del usuario asignado</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
                            <input type="checkbox" name="notifyAssignedOperator" <%= incidentNotif.notifyAssignedOperator ? 'checked' : '' %>>
                            <span>Operador asignado a la incidencia</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
                            <input type="checkbox" name="notifyAdmins" <%= incidentNotif.notifyAdmins ? 'checked' : '' %>>
                            <span>Todos los administradores</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
                            <input type="checkbox" name="notifyReporter" <%= incidentNotif.notifyReporter ? 'checked' : '' %>>
                            <span>Usuario que reportó la incidencia (copia)</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;grid-column:1/-1">
                            <input type="checkbox" name="notifyShipmentRecipient" <%= incidentNotif.notifyShipmentRecipient ? 'checked' : '' %>>
                            <span>Destinatario del envío (template según tipo: <code>SHIPMENT_DELAYED</code>, <code>SHIPMENT_PACKAGE_FAILED</code> o <code>SHIPMENT_INCIDENT</code>)</span>
                        </label>
                    </div>

                    <fieldset style="margin-top:1rem;padding:.8rem 1rem;border:1px solid var(--color-border,#e5e7eb);border-radius:8px;">
                        <legend style="padding:0 .5rem;font-size:.85rem;font-weight:600;color:var(--color-text-secondary);">Filtro por tipo de incidencia (aplica solo si "Destinatario del envío" está activo)</legend>
