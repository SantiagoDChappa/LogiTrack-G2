<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Incidencia #<%= incident.id %> - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/incidents.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Incidencia #<%= incident.id %></h1>
            <div class="page-header__actions">
                <a href="/incident" class="action-btn action-btn--lg action-btn--tip-bottom volver" data-tooltip="Volver" aria-label="Volver">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
            </div>
        </div>

        <% const errCode = (typeof query !== 'undefined' && query.error) || null; %>
        <% const errMessages = {
            resolution_required: 'Debés seleccionar una resolución (Procedente / No procedente) para cerrar la incidencia.',
            comment_required:    'El comentario es obligatorio para esta acción.',
            already_closed:      'La incidencia ya estaba cerrada.',
            not_closed:          'Solo se pueden reabrir incidencias cerradas.',
            closed:              'La incidencia está cerrada; no se puede modificar.',
            invalid_status:      'Estado inválido para la transición solicitada.',
            invalid_transition:  'Transición de estado no permitida (flujo: Abierta → En revisión → Cerrada).',
            invalid_user:        'El usuario asignado no es válido.',
            checklist_incomplete:'No se puede cerrar: quedan tareas obligatorias del checklist sin completar.',
            task_not_found:      'La tarea indicada no existe.',
            file_required:       'Seleccioná un archivo para adjuntar.',
            file_type:           'Tipo de archivo no permitido (solo JPG, PNG o PDF).',
            action_requires_procedente: 'La acción sobre el envío requiere resolución procedente.',
            shipment_already_terminal:  'El envío ya está en estado final, no se puede cancelar.',
            resolution_required_before_close: 'Antes de cerrar tenés que marcar la resolución (Procedente / No procedente).'
        }; %>
        <% if (errCode) { %>
            <div class="alert alert-error"><%= errMessages[errCode] || errCode %></div>
        <% } %>

        <section class="incident-detail-grid">
            <div class="incident-detail-card">
                <h2>Datos</h2>
                <dl class="incident-detail-list">
                    <dt>Envío</dt>
                    <dd>
                        <% if (incident.shipment) { %>
                            <a href="/shipment/detail/<%= incident.shipment.id %>"><%= incident.shipment.trackingId %></a>
                        <% } else { %>—<% } %>
                    </dd>
                    <dt>Tipo</dt><dd><%= incident.type ? incident.type.description : '—' %></dd>
                    <dt>Estado</dt><dd><span class="incident-badge incident-badge--<%= incident.status.toLowerCase() %>"><%= IncidentStatusLabel[incident.status] || incident.status %></span></dd>
                    <dt>Resolución</dt><dd><%= incident.resolution ? (IncidentResolutionLabel[incident.resolution] || incident.resolution) : '—' %></dd>
                    <% if (incident.damageChoice) { %>
                    <dt>Elección del remitente</dt><dd><strong><%= incident.damageChoice === 'REEMBOLSO' ? 'Reembolso' : 'Reemplazo' %></strong><% if (incident.damageChoiceAt) { %> · <%= fmtDateTime(incident.damageChoiceAt) %><% } %></dd>
                    <% } %>
                    <dt>Prioridad</dt><dd>P<%= incident.priority %></dd>
                    <dt>Escalado</dt><dd><%= incident.escalated ? 'Sí' : 'No' %></dd>
                    <dt>Canal</dt><dd><%= incident.openedChannel %></dd>
                    <dt>Reportada por</dt>
                    <dd>
                        <% if (incident.openedByUser) { %>
                            <%= incident.openedByUser.fullName %> (interno)
                        <% } else if (incident.openedByPerson) { %>
                            <%= incident.openedByPerson.fullName %> (vínculo Person)
                        <% } else { %>
                            <%= incident.reporterName || '—' %> <% if (incident.reporterEmail) { %>&lt;<%= incident.reporterEmail %>&gt;<% } %>
                        <% } %>
                    </dd>
                    <dt>Asignada a</dt><dd><%= incident.assignedTo ? incident.assignedTo.fullName : '—' %></dd>
                    <dt>Creada</dt><dd><%= fmtDateTime(incident.createdAt) %></dd>
                    <% if (incident.closedAt) { %>
                        <dt>Cerrada</dt><dd><%= fmtDateTime(incident.closedAt) %> por <%= incident.closedBy ? incident.closedBy.fullName : '—' %></dd>
                    <% } %>
                </dl>
                <h3>Descripción</h3>
                <p class="incident-description"><%= incident.description %></p>
            </div>

            <div class="incident-detail-card incident-actions-card">
                <h2>Acciones</h2>
                <div class="incident-actions-inner">

                <% if (flags.canAssign && assignableUsers.length) { %>
                    <h4 class="incident-section-title"><span class="material-symbols-outlined">person_add</span> Asignar</h4>
                    <style>
                        .incident-assign-form { flex-direction: column; align-items: stretch; gap: .75rem; }
                        .incident-assign-form .form-group { display: flex; flex-direction: column; gap: .3rem; width: 100%; }
                        .incident-assign-form label,
                        .incident-assign-form .form-group > label {
                            display: block; flex: none; margin: 0;
                            font-size: .72rem; font-weight: 600; text-transform: uppercase;
                            letter-spacing: .04em; color: var(--inc-muted);
                        }
                        .incident-assign-form select {
                            width: 100%; min-width: 0; padding: .5rem .7rem;
                            border: 1px solid var(--inc-border); border-radius: var(--inc-radius-sm);
                            background: var(--inc-surface); color: var(--inc-text); font: inherit; font-size: .88rem;
                        }
                        .incident-assign-form .user-picker {
                            grid-template-columns: 1fr; gap: .4rem; padding: .55rem; min-height: 0;
                        }
                        .incident-assign-form .user-card { padding: .5rem .6rem; gap: .55rem; }
                        .incident-assign-form .user-card__name { font-size: .85rem; }
                        .incident-assign-form .user-card__role { font-size: .7rem; }
                        .incident-assign-form .branch-picker__hint { margin-top: .15rem; font-size: .72rem; }
                        .incident-assign-form button[type="submit"] { align-self: flex-end; }
                    </style>
                    <form method="POST" action="/incident/<%= incident.id %>/assign" class="incident-action-form incident-assign-form" id="assignForm">
                        <% const currentAssignee = assignableUsers.find(u => u.id === incident.assignedToUserId); %>
                        <% const initialBranchId = currentAssignee ? currentAssignee.branchId : ''; %>
                        <div class="form-group">
                            <label for="assignBranchId">Sucursal</label>
                            <select id="assignBranchId">
                                <option value="">— Elegí una sucursal —</option>
                                <% branches.forEach(b => {
                                    const branchUserCount = assignableUsers.filter(u => u.branchId === b.id).length;
                                    const isSelected = String(initialBranchId) === String(b.id);
                                %>
                                    <option value="<%= b.id %>" <%= isSelected ? 'selected' : '' %>>
                                        <%= b.name %> (<%= branchUserCount %> usuario<%= branchUserCount === 1 ? '' : 's' %>)
                                    </option>
                                <% }) %>
                            </select>
                            <small class="branch-picker__hint" id="assign-branch-hint">Elegí una sucursal para ver sus usuarios.</small>
                        </div>
                        <div class="form-group">
                            <label>Asignar a</label>
                            <input type="hidden" id="assignedToUserId" name="assignedToUserId" value="<%= incident.assignedToUserId || '' %>">
                            <div class="user-picker" id="assign-user-picker">
                                <p class="user-picker__empty">Elegí una sucursal primero.</p>
                            </div>
                        </div>
                        <button type="submit" class="action-btn action-btn--lg buscar" data-tooltip="Asignar" aria-label="Asignar">
                            <span class="material-symbols-outlined">person_add</span>
                        </button>
                    </form>
                    <script id="assignable-users-data" type="application/json"><%- JSON.stringify(assignableUsers) %></script>
                    <script>
                    (function () {
                        const branchSelect = document.getElementById('assignBranchId');
                        const userPicker   = document.getElementById('assign-user-picker');
                        const hiddenUser   = document.getElementById('assignedToUserId');
                        const hint         = document.getElementById('assign-branch-hint');
                        const allUsers     = JSON.parse(document.getElementById('assignable-users-data').textContent || '[]');
                        const preselectedUserId = <%- JSON.stringify(incident.assignedToUserId || '') %>;

                        const escapeHtml = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

                        function renderUsers(branchId) {
                            userPicker.innerHTML = '';
                            if (!branchId) {
                                userPicker.innerHTML = '<p class="user-picker__empty">Elegí una sucursal primero.</p>';
                                return;
                            }
                            const filtered = allUsers.filter(u => u.branchId === branchId);
                            if (filtered.length === 0) {
                                userPicker.innerHTML = '<p class="user-picker__empty">Esta sucursal no tiene usuarios asignables.</p>';
                                return;
                            }
                            filtered.forEach(u => {
                                const isSel = String(preselectedUserId) === String(u.id);
                                const btn = document.createElement('button');
                                btn.type = 'button';
                                btn.className = 'user-card' + (isSel ? ' is-selected' : '');
                                btn.dataset.userId = String(u.id);
                                btn.innerHTML = ''
                                    + '<span class="user-card__avatar material-symbols-outlined">person</span>'
                                    + '<span class="user-card__body">'
                                    + '<span class="user-card__name">' + escapeHtml(u.fullName) + '</span>'
                                    + '<span class="user-card__role">' + escapeHtml(u.roleDescription || 'Sin rol') + '</span>'
                                    + '</span>'
                                    + '<span class="user-card__check material-symbols-outlined">check_circle</span>';
                                btn.addEventListener('click', () => selectUser(u.id, btn));
                                userPicker.appendChild(btn);
                            });
                        }

                        function selectUser(userId, btnEl) {
                            hiddenUser.value = String(userId);
                            userPicker.querySelectorAll('.user-card').forEach(c => c.classList.remove('is-selected'));
                            btnEl.classList.add('is-selected');
                        }

                        branchSelect.addEventListener('change', () => {
                            const bid = branchSelect.value ? Number(branchSelect.value) : null;
                            hiddenUser.value = '';
                            renderUsers(bid);
                            hint.textContent = bid
                                ? 'Sucursal: ' + branchSelect.options[branchSelect.selectedIndex].text.trim() + '. Elegí el usuario asignado.'
                                : 'Elegí una sucursal para ver sus usuarios.';
                        });

                        if (branchSelect.value) {
                            renderUsers(Number(branchSelect.value));
                        }

                        document.getElementById('assignForm').addEventListener('submit', function (e) {
                            if (!hiddenUser.value) {
                                e.preventDefault();
                                showIncidentFeedback({
                                    title: 'Falta asignar responsable',
                                    text: 'Elegí una sucursal y un usuario antes de asignar.'
                                });
                                return;
                                alert('Elegí una sucursal y un usuario antes de asignar.');
                            }
                        });
                    })();
                    </script>
                <% } %>

                <% const hasStateActions = flags.canChangeStatus || flags.canClose || flags.canReopen || flags.canComment; %>
                <% if (hasStateActions) { %>
                    <h4 class="incident-section-title"><span class="material-symbols-outlined">edit_note</span> Comentario y acciones</h4>
                    <div class="incident-master-comment">
                        <label for="masterComment">Comentario <span class="incident-required" aria-hidden="true">*</span></label>
                        <textarea id="masterComment" rows="3" required
                                  placeholder="Escribí un comentario. Es obligatorio para cualquier acción (cambiar estado, cerrar, reabrir o comentar)."></textarea>
                        <small class="incident-master-comment__hint">Se usa para todas las acciones de abajo y queda registrado en el historial.</small>
                        <% if (flags.canComment) { %>
                            <form method="POST" action="/incident/<%= incident.id %>/comment" class="incident-master-comment__form" data-needs-comment="1">
                                <input type="hidden" name="comment" value="">
                                <button type="submit" class="btn-only-comment">
                                    <span class="material-symbols-outlined">comment</span>
                                    Solo comentar
                                </button>
                            </form>
                        <% } %>
                    </div>

                    <% if (flags.canClose) { %>
                        <!-- Resolución: marcar procedente / no procedente sin cerrar -->
                        <div class="incident-resolution-block">
                            <div class="incident-resolution-block__head">
                                <span class="material-symbols-outlined">gavel</span>
                                Resolución
                                <% if (incident.resolution) { %>
                                    <span class="incident-resolution-chip incident-resolution-chip--<%= incident.resolution === 'PROCEDENTE' ? 'ok' : 'no' %>">
                                        <%= IncidentResolutionLabel[incident.resolution] %>
                                    </span>
                                <% } else { %>
                                    <span class="incident-resolution-chip incident-resolution-chip--pending">Sin marcar</span>
                                <% } %>
                            </div>
                            <div class="incident-resolution-buttons">
                                <form method="POST" action="/incident/<%= incident.id %>/resolution" class="incident-resolution-form" data-needs-comment="1">
                                    <input type="hidden" name="resolution" value="PROCEDENTE">
                                    <input type="hidden" name="comment"    value="">
                                    <button type="submit" class="btn-resolution btn-resolution--ok">
                                        <span class="material-symbols-outlined">check_circle</span>
                                        Marcar procedente
                                    </button>
                                </form>
                                <form method="POST" action="/incident/<%= incident.id %>/resolution" class="incident-resolution-form" data-needs-comment="1">
                                    <input type="hidden" name="resolution" value="NO_PROCEDENTE">
                                    <input type="hidden" name="comment"    value="">
                                    <button type="submit" class="btn-resolution btn-resolution--no">
                                        <span class="material-symbols-outlined">cancel</span>
                                        Marcar no procedente
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% } %>

                    <!-- Cambio de estado: botones tipo "estado siguiente" -->
                    <div class="incident-status-actions">
                        <span class="incident-status-actions__label">Pasar a estado:</span>

                        <% if (flags.canChangeStatus && incident.status === 'OPEN') { %>
                            <form method="POST" action="/incident/<%= incident.id %>/status" class="incident-status-form" data-needs-comment="1">
                                <input type="hidden" name="status"  value="IN_REVIEW">
                                <input type="hidden" name="comment" value="">
                                <button type="submit" class="btn-status btn-status--review">
                                    <span class="material-symbols-outlined">play_arrow</span>
                                    En revisión
                                </button>
                            </form>
                        <% } %>

                        <% if (flags.canClose) { %>
                            <form method="POST" action="/incident/<%= incident.id %>/close" class="incident-status-form" data-needs-comment="1">
                                <select name="shipmentAction" class="incident-close-action-inline">
                                    <option value="none">Sin cambio de envío</option>
                                    <option value="cancel" <%= incident.resolution !== 'PROCEDENTE' ? 'disabled' : '' %>>Cancelar envío (devolución)</option>
                                </select>
                                <input type="hidden" name="comment" value="">
                                <button type="submit" class="btn-status btn-status--closed" <%= !incident.resolution ? 'disabled' : '' %>
                                        <%= !incident.resolution ? 'title="Marcá la resolución primero"' : '' %>>
                                    <span class="material-symbols-outlined">lock</span>
                                    Cerrada
                                </button>
                            </form>
                        <% } %>

                        <% if (flags.canReopen) { %>
                            <form method="POST" action="/incident/<%= incident.id %>/reopen" class="incident-status-form" data-needs-comment="1">
                                <input type="hidden" name="comment" value="">
                                <button type="submit" class="btn-status btn-status--reopen">
                                    <span class="material-symbols-outlined">restart_alt</span>
                                    En revisión (reabrir)
                                </button>
                            </form>
                        <% } %>
                    </div>
                <% } %>

                <% if (flags.canEscalate) { %>
                    <h4 class="incident-section-title"><span class="material-symbols-outlined">priority_high</span> Prioridad y escalado</h4>
                    <form method="POST" action="/incident/<%= incident.id %>/escalate" class="incident-action-form incident-action-form--escalate">
                        <input type="hidden" name="escalate" value="<%= incident.escalated ? 'false' : 'true' %>">
                        <label>Prioridad
                            <select name="priority">
                                <% [1,2,3,4].forEach(p => { %>
                                    <option value="<%= p %>" <%= incident.priority === p ? 'selected' : '' %>>P<%= p %></option>
                                <% }) %>
                            </select>
                        </label>
                        <button type="submit" class="action-btn action-btn--lg <%= incident.escalated ? 'neutro' : 'modificar' %>">
                            <span class="material-symbols-outlined"><%= incident.escalated ? 'expand_more' : 'priority_high' %></span>
                            <%= incident.escalated ? 'Quitar escalado' : 'Escalar' %>
                        </button>
                    </form>
                <% } %>

                </div><!-- /incident-actions-inner -->
            </div>
        </section>

        <script>
        (function () {
            const master = document.getElementById('masterComment');
            if (!master) { return; }
            document.querySelectorAll('form[data-needs-comment="1"]').forEach((form) => {
                form.addEventListener('submit', (ev) => {
                    const val = (master.value || '').trim();
                    if (val.length === 0) {
                        ev.preventDefault();
                        master.focus();
                        master.classList.add('is-invalid');
                        showIncidentFeedback({
                            title: 'Falta comentario',
                            text: 'Escribí un comentario antes de ejecutar la acción.'
                        });
                        return;
                        alert('Escribí un comentario antes de ejecutar la acción.');
                        return;
                    }
                    master.classList.remove('is-invalid');
                    const hidden = form.querySelector('input[name="comment"]');
                    if (hidden) { hidden.value = val; }
                });
            });
            master.addEventListener('input', () => master.classList.remove('is-invalid'));
        })();
        </script>

        <section class="incident-detail-card" id="checklist">
            <h2>Checklist de resolución</h2>
            <% if (!tasks || tasks.length === 0) { %>
                <p class="incident-description">Este tipo de incidencia no tiene tareas definidas.</p>
            <% } else { %>
                <% if (pendingRequired > 0) { %>
                    <div class="alert alert-warning">
                        Quedan <%= pendingRequired %> tarea<%= pendingRequired === 1 ? '' : 's' %> obligatoria<%= pendingRequired === 1 ? '' : 's' %> pendiente<%= pendingRequired === 1 ? '' : 's' %>. No se podrá cerrar hasta completarlas.
                    </div>
                <% } %>
                <ul class="incident-checklist">
                    <% tasks.forEach(tk => { %>
                        <li class="incident-checklist__item <%= tk.done ? 'is-done' : '' %>">
                            <% if (flags.canManageTasks) { %>
                                <form method="POST" action="/incident/<%= incident.id %>/task/<%= tk.id %>/toggle" class="incident-checklist__form">
                                    <button type="submit" class="incident-checklist__toggle" title="<%= tk.done ? 'Marcar como pendiente' : 'Marcar como hecha' %>">
                                        <span class="material-symbols-outlined"><%= tk.done ? 'check_box' : 'check_box_outline_blank' %></span>
                                    </button>
                                    <span class="incident-checklist__text">
                                        <%= tk.description %>
                                        <% if (tk.required) { %><span class="incident-required" title="Obligatoria">*</span><% } %>
                                    </span>
                                </form>
                            <% } else { %>
                                <span class="material-symbols-outlined"><%= tk.done ? 'check_box' : 'check_box_outline_blank' %></span>
                                <span class="incident-checklist__text">
                                    <%= tk.description %>
                                    <% if (tk.required) { %><span class="incident-required">*</span><% } %>
                                </span>
                            <% } %>
                            <% if (tk.done && tk.doneBy) { %>
                                <small class="incident-checklist__meta"><%= tk.doneBy.fullName %> — <%= fmtDateTime(tk.doneAt) %></small>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </section>

        <section class="incident-detail-card" id="evidencias">
            <h2>Evidencias</h2>
            <% if (!attachments || attachments.length === 0) { %>
                <p class="incident-description">No hay evidencias adjuntas.</p>
            <% } else { %>
                <ul class="incident-attachments">
                    <% attachments.forEach(att => { %>
                        <li>
                            <a href="/incident/<%= incident.id %>/attachment/<%= att.id %>" target="_blank" rel="noopener">
                                <span class="material-symbols-outlined"><%= att.mimeType === 'application/pdf' ? 'picture_as_pdf' : 'image' %></span>
                                <%= att.fileName %>
                            </a>
                            <small>(<%= att.source === 'PORTAL' ? 'portal' : 'interno' %> — <%= fmtDateTime(att.createdAt) %>)</small>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
            <% if (flags.canAttach) { %>
                <form method="POST" action="/incident/<%= incident.id %>/attachment" enctype="multipart/form-data" class="incident-action-form">
                    <input type="file" name="evidence" accept="image/jpeg,image/png,application/pdf" required>
                    <button type="submit" class="action-btn action-btn--lg neutro" data-tooltip="Adjuntar evidencia" aria-label="Adjuntar evidencia">
                        <span class="material-symbols-outlined">upload</span>
                    </button>
                </form>
            <% } %>
        </section>

        <section class="incident-history">
            <h2>Historial</h2>
            <%
                // Mapeos para mostrar eventos lindos: label en español + ícono.
                const EVENT_LABELS = {
                    CREATED:         { label: 'Creada',              icon: 'add_circle' },
                    AUTO_CREATED:    { label: 'Creada (automática)', icon: 'autorenew' },
                    STATUS_CHANGE:   { label: 'Cambio de estado',    icon: 'swap_horiz' },
                    ASSIGNED:        { label: 'Asignación',          icon: 'person_add' },
                    ESCALATED:       { label: 'Escalada',            icon: 'priority_high' },
                    UNESCALATED:     { label: 'Desescalada',         icon: 'expand_more' },
                    PRIORITY_CHANGE: { label: 'Cambio de prioridad', icon: 'flag' },
                    COMMENT:         { label: 'Comentario',          icon: 'comment' },
                    CLOSED:          { label: 'Cerrada',             icon: 'lock' },
                    AUTO_CLOSED:     { label: 'Cerrada (automática)',icon: 'lock_clock' },
                    REOPENED:        { label: 'Reabierta',           icon: 'restart_alt' },
                    CHECKLIST_ITEM:  { label: 'Checklist',           icon: 'checklist' },
                    EVIDENCE_ADDED:  { label: 'Evidencia',           icon: 'attach_file' }
                };
                // Convierte valores tecnicos (status/resolution) a labels español para el `→`.
                const prettyValue = (v) => {
                    if (!v) { return null; }
                    const map = {
                        OPEN: 'Abierta', IN_REVIEW: 'En revisión', CLOSED: 'Cerrada',
                        PROCEDENTE: 'Procedente', NO_PROCEDENTE: 'No procedente',
                        DONE: 'Hecha', PENDING: 'Pendiente'
                    };
                    return map[v] || v;
                };
            %>
            <ol class="incident-timeline">
                <% history.forEach(h => {
                    const evCfg = EVENT_LABELS[h.eventType] || { label: h.eventType, icon: 'circle' };
                    const evKey = (h.eventType || 'OTHER').toLowerCase();
                    const fromPretty = prettyValue(h.fromValue);
                    const toPretty   = prettyValue(h.toValue);
                    // Para ASSIGNED los from/to son IDs de usuario sin label legible; el comment
                    // ya dice "Asignada a X", entonces ocultamos la fila de valores feos.
                    const showValues = (fromPretty || toPretty) && h.eventType !== 'ASSIGNED';
                %>
                    <li class="incident-timeline-item incident-timeline-item--<%= evKey %>">
                        <div class="incident-timeline-header">
                            <span class="incident-timeline-type incident-timeline-type--<%= evKey %>">
                                <span class="material-symbols-outlined"><%= evCfg.icon %></span>
                                <%= evCfg.label %>
                            </span>
                            <span class="incident-timeline-meta">
                                <%= fmtDateTime(h.changedAt) %>
                                — <%= h.user ? h.user.fullName : (h.person ? h.person.fullName : 'Portal público') %>
                            </span>
                        </div>
                        <% if (showValues) { %>
                            <div class="incident-timeline-values">
                                <% if (fromPretty) { %><span class="tl-val tl-val--from"><%= fromPretty %></span><% } else { %><span class="tl-val tl-val--empty">—</span><% } %>
                                <span class="tl-arrow material-symbols-outlined">arrow_right_alt</span>
                                <% if (toPretty) { %><span class="tl-val tl-val--to"><%= toPretty %></span><% } else { %><span class="tl-val tl-val--empty">—</span><% } %>
                            </div>
                        <% } %>
                        <% if (h.comment) { %>
                            <p class="incident-timeline-comment"><%= h.comment %></p>
                        <% } %>
                    </li>
                <% }) %>
            </ol>
        </section>
    </main>
    <%- include('../partials/incidentFeedback') %>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
