<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Incidencia #<%= incident.id %> - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/incidents.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Incidencia #<%= incident.id %></h1>
            <div class="page-header__actions">
                <a href="/incident" class="btn-secondary">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Volver
                </a>
            </div>
        </div>

        <% const errCode = (typeof query !== 'undefined' && query.error) || null; %>
        <% const errMessages = {
            resolution_required: 'Debés seleccionar una resolución (Procedente / No procedente) para cerrar la incidencia.',
            comment_required:    'El comentario de cierre es obligatorio.',
            already_closed:      'La incidencia ya estaba cerrada.',
            not_closed:          'Solo se pueden reabrir incidencias cerradas.',
            closed:              'La incidencia está cerrada; no se puede modificar.',
            invalid_status:      'Estado inválido para la transición solicitada.',
            invalid_user:        'El usuario asignado no es válido.'
        }; %>
        <% if (errCode) { %>
            <div class="alert alert-error"><%= errMessages[errCode] || errCode %></div>
        <% } %>

        <section class="incident-detail-grid">
            <div class="incident-detail-card">
                <h2>Datos</h2>
                <dl class="incident-detail-list">
                    <dt>Envío</dt>
                    <dd>
                        <% if (incident.shipment) { %>
                            <a href="/shipment/detail/<%= incident.shipment.id %>"><%= incident.shipment.trackingId %></a>
                        <% } else { %>—<% } %>
                    </dd>
                    <dt>Tipo</dt><dd><%= incident.type ? incident.type.description : '—' %></dd>
                    <dt>Estado</dt><dd><span class="incident-badge incident-badge--<%= incident.status.toLowerCase() %>"><%= incident.status %></span></dd>
                    <dt>Resolución</dt><dd><%= incident.resolution || '—' %></dd>
                    <dt>Prioridad</dt><dd>P<%= incident.priority %></dd>
                    <dt>Escalado</dt><dd><%= incident.escalated ? 'Sí' : 'No' %></dd>
                    <dt>Canal</dt><dd><%= incident.openedChannel %></dd>
                    <dt>Reportada por</dt>
                    <dd>
                        <% if (incident.openedByUser) { %>
                            <%= incident.openedByUser.fullName %> (interno)
                        <% } else if (incident.openedByPerson) { %>
                            <%= incident.openedByPerson.fullName %> (vínculo Person)
                        <% } else { %>
                            <%= incident.reporterName || '—' %> <% if (incident.reporterEmail) { %>&lt;<%= incident.reporterEmail %>&gt;<% } %>
                        <% } %>
                    </dd>
                    <dt>Asignada a</dt><dd><%= incident.assignedTo ? incident.assignedTo.fullName : '—' %></dd>
                    <dt>Creada</dt><dd><%= new Date(incident.createdAt).toLocaleString('es-AR') %></dd>
                    <% if (incident.closedAt) { %>
                        <dt>Cerrada</dt><dd><%= new Date(incident.closedAt).toLocaleString('es-AR') %> por <%= incident.closedBy ? incident.closedBy.fullName : '—' %></dd>
                    <% } %>
                </dl>
                <h3>Descripción</h3>
                <p class="incident-description"><%= incident.description %></p>
            </div>

            <div class="incident-detail-card">
                <h2>Acciones</h2>

                <% if (flags.canAssign && assignableUsers.length) { %>
                    <style>
                        .incident-assign-form { flex-direction: column; align-items: stretch; gap: .75rem; }
                        .incident-assign-form .form-group { display: flex; flex-direction: column; gap: .3rem; width: 100%; }
                        .incident-assign-form label,
                        .incident-assign-form .form-group > label {
                            display: block; flex: none; margin: 0;
                            font-size: .72rem; font-weight: 600; text-transform: uppercase;
                            letter-spacing: .04em; color: var(--inc-muted);
                        }
                        .incident-assign-form select {
                            width: 100%; min-width: 0; padding: .5rem .7rem;
                            border: 1px solid var(--inc-border); border-radius: var(--inc-radius-sm);
                            background: var(--inc-surface); color: var(--inc-text); font: inherit; font-size: .88rem;
                        }
                        .incident-assign-form .user-picker {
                            grid-template-columns: 1fr; gap: .4rem; padding: .55rem; min-height: 0;
                        }
                        .incident-assign-form .user-card { padding: .5rem .6rem; gap: .55rem; }
                        .incident-assign-form .user-card__name { font-size: .85rem; }
                        .incident-assign-form .user-card__role { font-size: .7rem; }
                        .incident-assign-form .branch-picker__hint { margin-top: .15rem; font-size: .72rem; }
                        .incident-assign-form button[type="submit"] { align-self: flex-end; }
                    </style>
                    <form method="POST" action="/incident/<%= incident.id %>/assign" class="incident-action-form incident-assign-form" id="assignForm">
                        <% const currentAssignee = assignableUsers.find(u => u.id === incident.assignedToUserId); %>
                        <% const initialBranchId = currentAssignee ? currentAssignee.branchId : ''; %>
                        <div class="form-group">
                            <label for="assignBranchId">Sucursal</label>
                            <select id="assignBranchId">
                                <option value="">— Elegí una sucursal —</option>
                                <% branches.forEach(b => {
                                    const branchUserCount = assignableUsers.filter(u => u.branchId === b.id).length;
                                    const isSelected = String(initialBranchId) === String(b.id);
                                %>
                                    <option value="<%= b.id %>" <%= isSelected ? 'selected' : '' %>>
                                        <%= b.name %> (<%= branchUserCount %> usuario<%= branchUserCount === 1 ? '' : 's' %>)
                                    </option>
                                <% }) %>
                            </select>
                            <small class="branch-picker__hint" id="assign-branch-hint">Elegí una sucursal para ver sus usuarios.</small>
                        </div>
                        <div class="form-group">
                            <label>Asignar a</label>
                            <input type="hidden" id="assignedToUserId" name="assignedToUserId" value="<%= incident.assignedToUserId || '' %>">
                            <div class="user-picker" id="assign-user-picker">
                                <p class="user-picker__empty">Elegí una sucursal primero.</p>
                            </div>
                        </div>
                        <button type="submit" class="btn-secondary">
                            <span class="material-symbols-outlined">person_add</span>
                            Asignar
                        </button>
                    </form>
                    <script id="assignable-users-data" type="application/json"><%- JSON.stringify(assignableUsers) %></script>
                    <script>
                    (function () {
                        const branchSelect = document.getElementById('assignBranchId');
                        const userPicker   = document.getElementById('assign-user-picker');
                        const hiddenUser   = document.getElementById('assignedToUserId');
                        const hint         = document.getElementById('assign-branch-hint');
                        const allUsers     = JSON.parse(document.getElementById('assignable-users-data').textContent || '[]');
                        const preselectedUserId = <%- JSON.stringify(incident.assignedToUserId || '') %>;

                        const escapeHtml = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

                        function renderUsers(branchId) {
                            userPicker.innerHTML = '';
                            if (!branchId) {
                                userPicker.innerHTML = '<p class="user-picker__empty">Elegí una sucursal primero.</p>';
                                return;
                            }
                            const filtered = allUsers.filter(u => u.branchId === branchId);
                            if (filtered.length === 0) {
                                userPicker.innerHTML = '<p class="user-picker__empty">Esta sucursal no tiene usuarios asignables.</p>';
                                return;
                            }
                            filtered.forEach(u => {
                                const isSel = String(preselectedUserId) === String(u.id);
                                const btn = document.createElement('button');
                                btn.type = 'button';
                                btn.className = 'user-card' + (isSel ? ' is-selected' : '');
                                btn.dataset.userId = String(u.id);
                                btn.innerHTML = ''
                                    + '<span class="user-card__avatar material-symbols-outlined">person</span>'
                                    + '<span class="user-card__body">'
                                    + '<span class="user-card__name">' + escapeHtml(u.fullName) + '</span>'
                                    + '<span class="user-card__role">' + escapeHtml(u.roleDescription || 'Sin rol') + '</span>'
                                    + '</span>'
                                    + '<span class="user-card__check material-symbols-outlined">check_circle</span>';
                                btn.addEventListener('click', () => selectUser(u.id, btn));
                                userPicker.appendChild(btn);
                            });
                        }

                        function selectUser(userId, btnEl) {
                            hiddenUser.value = String(userId);
                            userPicker.querySelectorAll('.user-card').forEach(c => c.classList.remove('is-selected'));
                            btnEl.classList.add('is-selected');
                        }

                        branchSelect.addEventListener('change', () => {
                            const bid = branchSelect.value ? Number(branchSelect.value) : null;
                            hiddenUser.value = '';
                            renderUsers(bid);
                            hint.textContent = bid
                                ? 'Sucursal: ' + branchSelect.options[branchSelect.selectedIndex].text.trim() + '. Elegí el usuario asignado.'
                                : 'Elegí una sucursal para ver sus usuarios.';
                        });

                        if (branchSelect.value) {
                            renderUsers(Number(branchSelect.value));
                        }

                        document.getElementById('assignForm').addEventListener('submit', function (e) {
                            if (!hiddenUser.value) {
                                e.preventDefault();
                                alert('Elegí una sucursal y un usuario antes de asignar.');
                            }
                        });
                    })();
                    </script>
                <% } %>

                <% if (flags.canChangeStatus) { %>
                    <form method="POST" action="/incident/<%= incident.id %>/status" class="incident-action-form">
                        <label>Cambiar estado a
                            <select name="status">
                                <% if (incident.status !== 'OPEN')      { %><option value="OPEN">Abierta</option><% } %>
                                <% if (incident.status !== 'IN_REVIEW') { %><option value="IN_REVIEW">En revisión</option><% } %>
                            </select>
                        </label>
                        <input type="text" name="comment" placeholder="Comentario (opcional)">
                        <button type="submit" class="btn-secondary">
                            <span class="material-symbols-outlined">swap_horiz</span>
                            Cambiar
                        </button>
                    </form>
                <% } %>

                <% if (flags.canEscalate) { %>
                    <form method="POST" action="/incident/<%= incident.id %>/escalate" class="incident-action-form">
                        <input type="hidden" name="escalate" value="<%= incident.escalated ? 'false' : 'true' %>">
                        <label>Prioridad
                            <select name="priority">
                                <% [1,2,3,4].forEach(p => { %>
                                    <option value="<%= p %>" <%= incident.priority === p ? 'selected' : '' %>>P<%= p %></option>
                                <% }) %>
                            </select>
                        </label>
                        <button type="submit" class="<%= incident.escalated ? 'btn-secondary' : 'btn-warning' %>">
                            <span class="material-symbols-outlined"><%= incident.escalated ? 'expand_more' : 'priority_high' %></span>
                            <%= incident.escalated ? 'Quitar escalado' : 'Escalar' %>
                        </button>
                    </form>
                <% } %>

                <% if (flags.canClose) { %>
                    <form method="POST" action="/incident/<%= incident.id %>/close" class="incident-action-form incident-close-form">
                        <label>Acción sobre el envío
                            <select name="shipmentAction">
                                <option value="none">Sin cambio</option>
                                <option value="cancel">Cancelar envío (devolución)</option>
                            </select>
                        </label>
                        <label class="incident-close-comment">Comentario de cierre <span class="incident-required" aria-hidden="true">*</span>
                            <textarea name="comment" rows="2" required minlength="1"
                                      placeholder="Describí brevemente cómo se resolvió la incidencia (obligatorio)"></textarea>
                        </label>
                        <div class="incident-close-buttons">
                            <button type="submit" name="resolution" value="PROCEDENTE" class="btn-success">
                                <span class="material-symbols-outlined">check_circle</span>
                                Cerrar como procedente
                            </button>
                            <button type="submit" name="resolution" value="NO_PROCEDENTE" class="btn-danger">
                                <span class="material-symbols-outlined">cancel</span>
                                Cerrar como no procedente
                            </button>
                        </div>
                    </form>
                <% } %>

                <% if (flags.canReopen) { %>
                    <form method="POST" action="/incident/<%= incident.id %>/reopen" class="incident-action-form">
                        <input type="text" name="comment" placeholder="Motivo de reapertura">
                        <button type="submit" class="btn-secondary">
                            <span class="material-symbols-outlined">restart_alt</span>
                            Reabrir
                        </button>
                    </form>
                <% } %>

                <% if (flags.canComment) { %>
                    <form method="POST" action="/incident/<%= incident.id %>/comment" class="incident-action-form">
                        <textarea name="comment" rows="3" placeholder="Agregar comentario..." required></textarea>
                        <button type="submit" class="btn-secondary">
                            <span class="material-symbols-outlined">comment</span>
                            Comentar
                        </button>
                    </form>
                <% } %>
            </div>
        </section>

        <section class="incident-history">
            <h2>Historial</h2>
            <ol class="incident-timeline">
                <% history.forEach(h => { %>
                    <li class="incident-timeline-item">
                        <span class="incident-timeline-type"><%= h.eventType %></span>
                        <span class="incident-timeline-meta">
                            <%= new Date(h.changedAt).toLocaleString('es-AR') %>
                            — <%= h.user ? h.user.fullName : (h.person ? h.person.fullName : 'Portal público') %>
                        </span>
                        <% if (h.fromValue || h.toValue) { %>
                            <div class="incident-timeline-values">
                                <%= h.fromValue || '∅' %> → <%= h.toValue || '∅' %>
                            </div>
                        <% } %>
                        <% if (h.comment) { %>
                            <p class="incident-timeline-comment"><%= h.comment %></p>
                        <% } %>
                    </li>
                <% }) %>
            </ol>
        </section>
    </main>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
