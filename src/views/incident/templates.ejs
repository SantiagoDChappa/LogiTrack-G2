<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Checklist por tipo de incidencia - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/incidents.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Checklist por tipo de incidencia</h1>
            <div class="page-header__actions">
                <a href="/incident" class="btn-secondary">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Volver
                </a>
            </div>
        </div>

        <% if (saved) { %>
            <div class="alert alert-success">Cambios guardados.</div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <div class="tpl-intro">
            <span class="material-symbols-outlined">info</span>
            <p>
                Las tareas definidas acá se copian automáticamente a cada incidencia nueva del tipo correspondiente.
                Las marcadas como <strong>obligatorias</strong> deben completarse antes de poder cerrar la incidencia.
            </p>
        </div>

        <% grouped.forEach(g => { %>
            <section class="tpl-card">
                <header class="tpl-card__head">
                    <h2><%= g.type.description %></h2>
                    <span class="tpl-code"><%= g.type.code %></span>
                    <span class="tpl-count"><%= g.templates.length %> tarea<%= g.templates.length === 1 ? '' : 's' %></span>
                </header>

                <% if (g.templates.length === 0) { %>
                    <p class="tpl-empty">Sin tareas definidas. Agregá la primera abajo.</p>
                <% } else { %>
                    <div class="tpl-list">
                        <div class="tpl-row tpl-row--head">
                            <span class="tpl-col-order">Orden</span>
                            <span class="tpl-col-desc">Descripción</span>
                            <span class="tpl-col-flag">Obligatoria</span>
                            <span class="tpl-col-flag">Activa</span>
                            <span class="tpl-col-actions"></span>
                        </div>
                        <% g.templates.forEach(tpl => { %>
                            <div class="tpl-row <%= tpl.active ? '' : 'is-inactive' %>">
                                <form method="POST" action="/incident/config/templates/<%= tpl.id %>" class="tpl-edit">
                                    <input type="number" name="ordering" value="<%= tpl.ordering %>" class="tpl-input tpl-col-order" aria-label="Orden">
                                    <input type="text" name="description" value="<%= tpl.description %>" maxlength="200" class="tpl-input tpl-col-desc" aria-label="Descripción">
                                    <label class="tpl-switch tpl-col-flag" title="Obligatoria para cerrar">
                                        <input type="checkbox" name="required" <%= tpl.required ? 'checked' : '' %>>
                                        <span class="tpl-switch__track"></span>
                                    </label>
                                    <label class="tpl-switch tpl-col-flag" title="Activa">
                                        <input type="checkbox" name="active" <%= tpl.active ? 'checked' : '' %>>
                                        <span class="tpl-switch__track"></span>
                                    </label>
                                    <button type="submit" class="btn-secondary btn-sm tpl-col-actions" title="Guardar cambios">
                                        <span class="material-symbols-outlined">save</span>
                                    </button>
                                </form>
                                <form method="POST" action="/incident/config/templates/<%= tpl.id %>/deactivate" class="tpl-deact">
                                    <button type="submit" class="tpl-icon-btn tpl-icon-btn--danger" title="Desactivar" <%= tpl.active ? '' : 'disabled' %>>
                                        <span class="material-symbols-outlined">visibility_off</span>
                                    </button>
                                </form>
                            </div>
                        <% }) %>
                    </div>
                <% } %>

                <form method="POST" action="/incident/config/templates" class="tpl-row tpl-add">
                    <input type="hidden" name="incidentTypeId" value="<%= g.type.id %>">
                    <input type="number" name="ordering" value="0" class="tpl-input tpl-col-order" aria-label="Orden" title="Orden">
                    <input type="text" name="description" placeholder="Nueva tarea..." maxlength="200" required class="tpl-input tpl-col-desc">
                    <label class="tpl-switch tpl-col-flag" title="Obligatoria">
                        <input type="checkbox" name="required" checked>
                        <span class="tpl-switch__track"></span>
                    </label>
                    <button type="submit" class="btn-primary btn-sm tpl-col-actions">
                        <span class="material-symbols-outlined">add</span>
                        Agregar
                    </button>
                </form>
            </section>
        <% }) %>
    </main>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
