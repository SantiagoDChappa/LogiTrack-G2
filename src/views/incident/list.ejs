<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Incidencias - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/incidents.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Incidencias</h1>
            <div class="page-header__actions">
                <% const _role = (typeof currentUser !== 'undefined' && currentUser) ? currentUser.roleId : null; %>
                <% if (_role === 1 || _role === 4) { %>
                    <a href="/incident/config/templates" class="action-btn action-btn--lg action-btn--tip-bottom neutro" data-tooltip="Checklist por tipo" aria-label="Checklist por tipo">
                        <span class="material-symbols-outlined">checklist</span>
                    </a>
                <% } %>
                <a href="/incident/new" class="action-btn action-btn--lg action-btn--tip-bottom crear" data-tooltip="Nueva incidencia" aria-label="Nueva incidencia">
                    <span class="material-symbols-outlined">add</span>
                </a>
            </div>
        </div>

        <form method="GET" action="/incident" class="incident-filters">
            <div class="incident-filter">
                <label for="status"><span class="material-symbols-outlined incident-filter-icon">flag</span> Estado</label>
                <select id="status" name="status">
                    <option value="">Todos</option>
                    <option value="OPEN"      <%= filters.status === 'OPEN'      ? 'selected' : '' %>>Abierta</option>
                    <option value="IN_REVIEW" <%= filters.status === 'IN_REVIEW' ? 'selected' : '' %>>En revisión</option>
                    <option value="CLOSED"    <%= filters.status === 'CLOSED'    ? 'selected' : '' %>>Cerrada</option>
                </select>
            </div>
            <div class="incident-filter">
                <label for="escalated"><span class="material-symbols-outlined incident-filter-icon">priority_high</span> Escalado</label>
                <select id="escalated" name="escalated">
                    <option value="">Todos</option>
                    <option value="1" <%= filters.escalated === '1' ? 'selected' : '' %>>Sí</option>
                    <option value="0" <%= filters.escalated === '0' ? 'selected' : '' %>>No</option>
                </select>
            </div>
            <div class="incident-filter">
                <label for="priority"><span class="material-symbols-outlined incident-filter-icon">arrow_upward</span> Prioridad</label>
                <select id="priority" name="priority">
                    <option value="">Todas</option>
                    <option value="4" <%= filters.priority === '4' ? 'selected' : '' %>>Urgente</option>
                    <option value="3" <%= filters.priority === '3' ? 'selected' : '' %>>Alta</option>
                    <option value="2" <%= filters.priority === '2' ? 'selected' : '' %>>Media</option>
                    <option value="1" <%= filters.priority === '1' ? 'selected' : '' %>>Baja</option>
                </select>
            </div>
            <% if (assignableUsers && assignableUsers.length) { %>
            <div class="incident-filter">
                <label for="assignedToUserId"><span class="material-symbols-outlined incident-filter-icon">person</span> Asignado a</label>
                <select id="assignedToUserId" name="assignedToUserId">
                    <option value="">Todos</option>
                    <% assignableUsers.forEach(u => { %>
                        <option value="<%= u.id %>" <%= String(filters.assignedToUserId) === String(u.id) ? 'selected' : '' %>><%= u.fullName %></option>
                    <% }) %>
                </select>
            </div>
            <% } %>
            <div class="incident-filter">
                <label for="origin"><span class="material-symbols-outlined incident-filter-icon">hub</span> Origen</label>
                <select id="origin" name="origin">
                    <option value="">Todos</option>
                    <option value="EXTERNO" <%= filters.origin === 'EXTERNO' ? 'selected' : '' %>>Externo (portal/chatbot)</option>
                    <option value="INTERNO" <%= filters.origin === 'INTERNO' ? 'selected' : '' %>>Interno (empresa)</option>
                </select>
            </div>
            <div class="incident-filter">
                <label for="resolution"><span class="material-symbols-outlined incident-filter-icon">gavel</span> Resolución</label>
                <select id="resolution" name="resolution">
                    <option value="">Todas</option>
                    <option value="PROCEDENTE"    <%= filters.resolution === 'PROCEDENTE'    ? 'selected' : '' %>>Procedente</option>
                    <option value="NO_PROCEDENTE" <%= filters.resolution === 'NO_PROCEDENTE' ? 'selected' : '' %>>No procedente</option>
                </select>
            </div>
            <div class="incident-filter">
                <label for="incident-id-input"><span class="material-symbols-outlined incident-filter-icon">tag</span> ID de incidencia</label>
                <input type="text" id="incident-id-input" name="id"
                       value="<%= filters.id || '' %>"
                       placeholder="Ej: INC-200 o 200"
                       pattern="^\s*(?:INC[-\s]?)?\d+\s*$"
                       title="Ingresá el número o el código INC-XXX">
            </div>
            <div class="incident-filter">
                <label for="shipmentId"><span class="material-symbols-outlined incident-filter-icon">local_shipping</span> Envío (ID)</label>
                <input type="number" id="shipmentId" name="shipmentId" value="<%= filters.shipmentId || '' %>">
            </div>
            <button type="submit" class="action-btn action-btn--lg buscar" data-tooltip="Filtrar" aria-label="Filtrar">
                <span class="material-symbols-outlined">filter_alt</span>
            </button>
            <a href="/incident" class="action-btn action-btn--lg neutro" data-tooltip="Limpiar" aria-label="Limpiar">
                <span class="material-symbols-outlined">refresh</span>
            </a>
        </form>

        <% if (typeof idInputInvalid !== 'undefined' && idInputInvalid) { %>
            <div class="alert alert-error">El ID de incidencia ingresado no es válido. Usá un número (ej. <code>200</code>) o el código <code>INC-200</code>.</div>
        <% } %>

        <div class="incident-table-wrapper">
            <table class="incident-table" data-paginate="incidents">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tracking</th>
                        <th>Tipo</th>
                        <th>Origen</th>
                        <th>Estado</th>
                        <th>Resolución</th>
                        <th>Prioridad</th>
                        <th>Escalado</th>
                        <th>Asignado</th>
                        <th>Abierta</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (incidents.length === 0) { %>
                        <tr><td colspan="11" class="incident-empty">No hay incidencias para mostrar.</td></tr>
                    <% } %>
                    <% incidents.forEach(i => {
                        const isExterno = i.openedChannel === 'PORTAL';
                        const originLabel = isExterno ? 'EXTERNO' : 'INTERNO';
                        const resLabel = i.resolution === 'PROCEDENTE' ? 'Procedente'
                                       : i.resolution === 'NO_PROCEDENTE' ? 'No procedente'
                                       : '—';
                        const resCls = i.resolution === 'PROCEDENTE' ? 'is-procedente'
                                     : i.resolution === 'NO_PROCEDENTE' ? 'is-no-procedente'
                                     : 'is-pending';
                    %>
                        <tr class="<%= i.escalated ? 'is-escalated' : '' %>">
                            <td>#<%= i.id %></td>
                            <td><%= i.shipment ? i.shipment.trackingId : '-' %></td>
                            <td><%= i.type ? i.type.description : '-' %></td>
                            <td><span class="incident-origin incident-origin--<%= isExterno ? 'externo' : 'interno' %>"><%= originLabel %></span></td>
                            <td><span class="incident-badge incident-badge--<%= i.status.toLowerCase() %>"><%= i.status %></span></td>
                            <td><span class="incident-resolution <%= resCls %>"><%= resLabel %></span></td>
                            <td><span class="incident-priority incident-priority--<%= i.priority %>">P<%= i.priority %></span></td>
                            <td><%= i.escalated ? '🔥' : '—' %></td>
                            <td><%= i.assignedTo ? i.assignedTo.fullName : '—' %></td>
                            <td><%= new Date(i.createdAt).toLocaleString('es-AR') %></td>
                            <td><a href="/incident/<%= i.id %>" class="action-btn detalle" data-tooltip="Ver detalle" aria-label="Ver detalle"><span class="material-symbols-outlined">visibility</span></a></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
</body>
</html>
