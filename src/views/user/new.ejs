<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Nuevo Usuario - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/users.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content users-module">
        <div class="page-header">
            <h1>Alta de usuario</h1>
        </div>
        <div class="form-new">
            <form action="/user/new" method="POST">
                <div class="usuario">
                    <h3>Usuario</h3>
                    <sub>Los campos marcados con * son obligatorios</sub>
                    <div class="field">
                        <label for="fullName">Nombre y Apellido <span style="color: red;">*</span></label>
                        <input id="fullName"  type="text" name="fullName" value="<%= body.fullName || '' %>" maxlength="100" required>
                    </div>
                    <div class="field">
                        <label for="document">Documento <span style="color: red;">*</span></label>
                        <input id="document" type="text" name="document" value="<%= body.document || '' %>" placeholder="Ej: 12.345.678" data-doc-format maxlength="11" required>
                    </div>
                    <div class="field">
                        <label for="email">Email <span style="color: red;">*</span></label>
                        <input id="email" type="email" name="email" value="<%= body.email || '' %>" maxlength="100" required>
                    </div>

                    <p class="field" style="font-size:.82rem;color:var(--color-text-secondary);background:var(--color-bg);border:1px solid var(--color-border);border-radius:8px;padding:.6rem .75rem">
                        <span class="material-symbols-outlined" style="font-size:1rem;vertical-align:middle">info</span>
                        El sistema generará una <strong>contraseña temporal</strong> al crear el usuario. Se mostrará una sola vez para que se la pases; deberá cambiarla en su primer ingreso.
                    </p>

                    <div class="field">
                        <label for="roleId">Rol <span style="color: red;">*</span></label>
                        <select id="roleId" name="roleId" required onchange="toggleBranchField(this.value)">
                            <option value="">Seleccione un rol </option>
                            <% roleTypes.forEach(role => { %>
                                <option value="<%= role.id %>" <%= body.roleId == role.id ? 'selected' : '' %>>
                                    <%= role.description %>
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="field" id="branch-field" style="display:<%= [1,2,3].includes(Number(body.roleId)) ? 'block' : 'none' %>">
                        <label for="branchId">Sucursal <span style="color:red">*</span></label>
                        <select id="branchId" name="branchId">
                            <option value="">Seleccione una sucursal</option>
                            <% (branches || []).forEach(b => { %>
                                <option value="<%= b.id %>" <%= body.branchId == b.id ? 'selected' : '' %>><%= b.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/user" class="action-btn action-btn--lg volver" data-tooltip="Volver" aria-label="Volver">
                        <span class="material-symbols-outlined">arrow_back</span>
                    </a>
                    <button type="submit" class="action-btn action-btn--lg guardar" data-tooltip="Guardar usuario" aria-label="Guardar usuario">
                        <span class="material-symbols-outlined">save</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>const serverErrors = <%- JSON.stringify(errors) %>;</script>
    <script src="/js/new_shipment_popup.js" defer></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script>function toggleBranchField(v){var show=['1','2','3'].includes(String(v));document.getElementById('branch-field').style.display=show?'block':'none';}</script>
    <script src="/js/document-format.js" defer></script>
</body>
</html>
