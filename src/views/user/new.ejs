<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Nuevo Usuario - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Alta de usuario</h1>
        </div>
        <div class="form-new">
            <form action="/user/new" method="POST">
                <div class="usuario">
                    <h3>Usuario</h3>
                    <sub>Los campos marcados con * son obligatorios</sub>
                    <div class="field">
                        <label for="fullName">Nombre y Apellido <span style="color: red;">*</span></label>
                        <input id="fullName"  type="text" name="fullName" value="<%= body.fullName || '' %>" maxlength="100" required>
                    </div>
                    <div class="field">
                        <label for="document">Documento <span style="color: red;">*</span></label>
                        <input id="document" type="text" name="document" value="<%= body.document || '' %>" placeholder="Ej: 12.345.678" data-doc-format maxlength="11" required>
                    </div>
                    <div class="field">
                        <label for="email">Email <span style="color: red;">*</span></label>
                        <input id="email" type="email" name="email" value="<%= body.email || '' %>" maxlength="100" required>
                    </div>

                    <div class="field">
                        <label for="password">Contraseña <span style="color: red;">*</span></label>
                        <div class="password-wrapper">
                            <div class="password-input-row">
                                <input id="password"  type="text"  name="password" autocomplete="new-password" maxlength="128" required>
                                <!--
                                <button type="button" class="toggle-password" id="togglePassword" tabindex="-1">
                                    <span class="material-symbols-outlined" id="toggleIcon">visibility</span>
                                </button>
                                -->
                            </div>

                            <div class="strength-bar-wrapper" id="strengthBar">
                                <div class="strength-segments" id="strengthSegments">
                                    <div class="strength-segment"></div>
                                    <div class="strength-segment"></div>
                                    <div class="strength-segment"></div>
                                </div>
                                <span class="strength-label" id="strengthLabel"></span>
                            </div>

                            <div class="password-rules" id="passwordRules">
                                <div class="rule" id="rule-length">
                                    <span class="material-symbols-outlined">cancel</span>
                                    Mínimo 10 caracteres
                                </div>
                                <div class="rule" id="rule-upper">
                                    <span class="material-symbols-outlined">cancel</span>
                                    Al menos una mayúscula
                                </div>
                                <div class="rule" id="rule-number">
                                    <span class="material-symbols-outlined">cancel</span>
                                    Al menos un número
                                </div>
                                <div class="rule" id="rule-symbol">
                                    <span class="material-symbols-outlined">cancel</span>
                                    Al menos un símbolo (!@#$%...)
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="field">
                        <label for="roleId">Rol <span style="color: red;">*</span></label>
                        <select id="roleId" name="roleId" required>
                            <option value="">Seleccione un rol </option>
                            <% roleTypes.forEach(role => { %>
                                <option value="<%= role.id %>" <%= body.roleId == role.id ? 'selected' : '' %>>
                                    <%= role.description %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/user" class="btn-secondary">Volver</a>
                    <button type="submit" class="btn-primary">Guardar usuario</button>
                </div>
            </form>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>const serverErrors = <%- JSON.stringify(errors) %>;</script>
    <script src="/js/new_shipment_popup.js" defer></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/document-format.js" defer></script>
    <script>
        const passwordInput  = document.getElementById('password');
        const toggleBtn      = document.getElementById('togglePassword');
        const toggleIcon     = document.getElementById('toggleIcon');
        const strengthBar    = document.getElementById('strengthBar');
        const strengthSegs   = document.getElementById('strengthSegments');
        const strengthLabel  = document.getElementById('strengthLabel');
        const rulesContainer = document.getElementById('passwordRules');

        const rules = {
            length: { el: document.getElementById('rule-length'), test: v => v.length >= 10 },
            upper:  { el: document.getElementById('rule-upper'),  test: v => /[A-Z]/.test(v) },
            number: { el: document.getElementById('rule-number'), test: v => /[0-9]/.test(v) },
            symbol: { el: document.getElementById('rule-symbol'), test: v => /[^A-Za-z0-9]/.test(v) },
        };

        const levels = [
            { label: '',           cls: ''          },
            { label: 'Insegura',   cls: 'strength-1' },
            { label: 'Segura',     cls: 'strength-2' },
            { label: 'Muy segura', cls: 'strength-3' },
        ];

        function updateRule(key, value) {
            const { el, test } = rules[key];
            const ok = test(value);
            el.classList.toggle('ok', ok);
            el.querySelector('.material-symbols-outlined').textContent = ok ? 'check_circle' : 'cancel';
        }

        function updateStrength(passed) {
            strengthSegs.className = 'strength-segments';
            if (passed === 0) {
                strengthLabel.textContent = '';
                return;
            }
            const lvl = passed <= 1 ? 1 : passed <= 3 ? 2 : 3;
            strengthSegs.classList.add(levels[lvl].cls);
            strengthLabel.textContent  = levels[lvl].label;
            strengthLabel.className    = `strength-label ${levels[lvl].cls}`;
        }

        passwordInput.addEventListener('input', () => {
            const val = passwordInput.value;

            let passed = 0;
            for (const key of Object.keys(rules)) {
                updateRule(key, val);
                if (rules[key].test(val)) passed++;
            }
            updateStrength(passed);
        });

  //      toggleBtn.addEventListener('click', () => {
  //          const isPassword = passwordInput.type === 'password';
 //           passwordInput.type    = isPassword ? 'text' : 'password';
 //           toggleIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
//        });
    </script>
</body>
</html>
