<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Modificar Usuario - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Modificación de usuario</h1>
            <a href="<%= returnUrl %>" class="btn-secondary">Volver</a>
        </div>
        <div class="form-new">
            <form action="/user/update/<%= user.id %>" method="POST">
                <div class="usuario">
                    <h3>Usuario</h3>
                    <div class="field">
                        <label for="fullName">Nombre y Apellido <span style="color: red;">*</span></label>
                        <input id="fullName" type="text" name="fullName" value="<%= user.fullName || '' %>" maxlength="100" required>
                    </div>
                    <div class="field">
                        <label for="document">Documento <span style="color: red;">*</span></label>
                        <input id="document" type="text" name="document" value="<%= user.document || '' %>" placeholder="Ej: 12.345.678" data-doc-format maxlength="11" required>
                    </div>
                    <div class="field">
                        <label for="email">Email <span style="color: red;">*</span></label>
                        <input id="email" type="email" name="email" value="<%= user.email || '' %>" maxlength="100" required>
                    </div>
                    <div class="field">
                        <label for="roleId">Rol <span style="color: red;">*</span></label>
                        <select id="roleId" name="roleId" required onchange="toggleBranchField(this.value)">
                            <option value="">Seleccione un rol</option>
                            <% roleTypes.forEach(role => { %>
                                <option value="<%= role.id %>" <%= user.roleId == role.id ? 'selected' : '' %>>
                                    <%= role.description %>
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="field" id="branch-field" style="display:<%= user.roleId == 3 ? 'block' : 'none' %>">
                        <label for="branchId">Sucursal</label>
                        <select id="branchId" name="branchId">
                            <option value="">Seleccione una sucursal</option>
                            <% (branches || []).forEach(b => { %>
                                <option value="<%= b.id %>" <%= user.branchId == b.id ? 'selected' : '' %>><%= b.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="field">
                        <label for="active">Estado</label>
                        <select id="active" name="active">
                            <option value="true"  <%= user.active  ? 'selected' : '' %>>Alta</option>
                            <option value="false" <%= !user.active ? 'selected' : '' %>>Baja</option>
                        </select>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>const serverErrors = <%- JSON.stringify(errors) %>;</script>
    <script src="/js/new_shipment_popup.js" defer></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/document-format.js" defer></script>
    <script>function toggleBranchField(v){document.getElementById('branch-field').style.display=v==3?'block':'none';}</script>
</body>
</html>
