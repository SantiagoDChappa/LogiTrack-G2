<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Modificar Usuario - LogiTrack</title>
    <link rel="stylesheet" href="/css/shipments.css">
    <link rel="stylesheet" href="/css/users.css">
</head>
<body>
    <%- include('../partials/header') %>
    <main class="main-content users-module">
        <div class="page-header">
            <h1>Modificación de usuario</h1>
            <a href="<%= returnUrl %>" class="action-btn action-btn--lg action-btn--tip-bottom volver" data-tooltip="Volver" aria-label="Volver">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
        </div>
        <div class="form-new">
            <form action="/user/update/<%= user.id %>" method="POST">
                <div class="usuario">
                    <h3>Usuario</h3>
                    <div class="field">
                        <label for="fullName">Nombre y Apellido <span style="color: red;">*</span></label>
                        <input id="fullName" type="text" name="fullName" value="<%= user.fullName || '' %>" maxlength="100" required>
                    </div>
                    <div class="field">
                        <label for="document">Documento <span style="color: red;">*</span></label>
                        <input id="document" type="text" name="document" value="<%= user.document || '' %>" placeholder="Ej: 12.345.678" data-doc-format maxlength="11" required>
                    </div>
                    <div class="field">
                        <label for="email">Email <span style="color: red;">*</span></label>
                        <input id="email" type="email" name="email" value="<%= user.email || '' %>" maxlength="100" required>
                    </div>
                    <div class="field">
                        <label for="roleId">Rol <span style="color: red;">*</span></label>
                        <select id="roleId" name="roleId" required onchange="toggleBranchField(this.value)">
                            <option value="">Seleccione un rol</option>
                            <% roleTypes.forEach(role => { %>
                                <option value="<%= role.id %>" <%= user.roleId == role.id ? 'selected' : '' %>>
                                    <%= role.description %>
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="field" id="branch-field" style="display:<%= [1,2,3].includes(Number(user.roleId)) ? 'block' : 'none' %>">
                        <label for="branchId">Sucursal <span style="color:red">*</span></label>
                        <select id="branchId" name="branchId">
                            <option value="">Seleccione una sucursal</option>
                            <% (branches || []).forEach(b => { %>
                                <option value="<%= b.id %>" <%= user.branchId == b.id ? 'selected' : '' %>><%= b.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <!-- Sprint 3 - 4.2: Ventana operativa del repartidor (turno + disponibilidad).
                         El optimizador respeta driverShiftStart/End como inicio/máximo de jornada
                         y excluye al chofer si driverAvailable=false. -->
                    <div id="driver-shift-section" style="display:<%= user.roleId == 3 ? 'block' : 'none' %>;border:1px dashed #cbd5e1;border-radius:8px;padding:.75rem;margin:.75rem 0">
                        <strong style="display:block;margin-bottom:.5rem">Turno operativo (chofer)</strong>
                        <div class="field" style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
                            <div>
                                <label for="driverShiftStart">Inicio turno</label>
                                <input id="driverShiftStart" type="time" name="driverShiftStart" value="<%= user.driverShiftStart ? String(user.driverShiftStart).slice(0,5) : '' %>">
                            </div>
                            <div>
                                <label for="driverShiftEnd">Fin turno</label>
                                <input id="driverShiftEnd" type="time" name="driverShiftEnd" value="<%= user.driverShiftEnd ? String(user.driverShiftEnd).slice(0,5) : '' %>">
                            </div>
                        </div>
                        <div class="field">
                            <label>
                                <input type="checkbox" name="driverAvailable" value="true" <%= user.driverAvailable !== false ? 'checked' : '' %>>
                                Disponible para asignación
                            </label>
                        </div>
                        <div class="field" style="display:grid;grid-template-columns:2fr 1fr;gap:.5rem">
                            <div>
                                <label for="driverUnavailableReason">Motivo de no disponibilidad</label>
                                <input id="driverUnavailableReason" type="text" name="driverUnavailableReason" value="<%= user.driverUnavailableReason || '' %>" maxlength="120" placeholder="Ej: licencia médica">
                            </div>
                            <div>
                                <label for="driverUnavailableUntil">Disponible desde</label>
                                <input id="driverUnavailableUntil" type="date" name="driverUnavailableUntil" value="<%= user.driverUnavailableUntil ? String(user.driverUnavailableUntil).slice(0,10) : '' %>">
                            </div>
                        </div>
                    </div>

                    <div class="field">
                        <label for="active">Estado</label>
                        <select id="active" name="active">
                            <option value="true"  <%= user.active  ? 'selected' : '' %>>Alta</option>
                            <option value="false" <%= !user.active ? 'selected' : '' %>>Baja</option>
                        </select>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="action-btn action-btn--lg guardar" data-tooltip="Guardar cambios" aria-label="Guardar cambios">
                        <span class="material-symbols-outlined">save</span>
                    </button>
                    <% if (user.active) { %>
                    <button type="button" class="action-btn action-btn--lg eliminar" id="btn-baja" data-tooltip="Dar de baja" aria-label="Dar de baja">
                        <span class="material-symbols-outlined">person_off</span>
                    </button>
                    <% } %>
                </div>
            </form>

            <form id="form-baja" action="/user/delete/<%= user.id %>" method="POST" style="display:none;"></form>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>const serverErrors = <%- JSON.stringify(errors) %>;</script>
    <script src="/js/new_shipment_popup.js" defer></script>
    <script src="/js/theme.js" defer></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/document-format.js" defer></script>
    <script>function toggleBranchField(v){var show=['1','2','3'].includes(String(v));document.getElementById('branch-field').style.display=show?'block':'none';var ds=document.getElementById('driver-shift-section');if(ds){ds.style.display=String(v)==='3'?'block':'none';}}</script>
    <% if (user.active) { %>
    <script>
        document.getElementById('btn-baja').addEventListener('click', function() {
            const isDark = (localStorage.getItem('theme') ?? 'light') === 'dark';
            Swal.fire({
                icon: 'warning',
                title: '¿Dar de baja al usuario?',
                text: '"<%= user.fullName %>" quedará inactivo en el sistema.',
                showCancelButton: true,
                confirmButtonText: 'Sí, dar de baja',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#dc2626',
                cancelButtonColor: isDark ? '#475569' : '#6b7280',
                background: isDark ? '#1e293b' : '#ffffff',
                color: isDark ? '#f1f5f9' : '#1e293b',
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('form-baja').submit();
                }
            });
        });
    </script>
    <% } %>
</body>
</html>
