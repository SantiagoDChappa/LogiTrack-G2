<% if (typeof currentUser !== 'undefined' && currentUser && currentUser.pendingRelease) { %>
<% const pr = currentUser.pendingRelease; %>
<div id="whats-new-backdrop" class="whats-new-backdrop" hidden aria-hidden="true">
    <div class="whats-new-modal" role="dialog" aria-modal="true" aria-labelledby="whats-new-title">
        <header class="whats-new-modal__header">
            <div>
                <span class="whats-new-modal__badge">Nuevo</span>
                <h2 id="whats-new-title" class="whats-new-modal__title"><%= pr.title %></h2>
            </div>
            <button type="button" class="whats-new-modal__close" id="whats-new-close" aria-label="Cerrar">
                <span class="material-symbols-outlined">close</span>
            </button>
        </header>
        <div class="whats-new-modal__body">
            <% pr.features.forEach(function (f) { %>
            <article class="whats-new-card" data-help-slug="<%= f.helpSlug %>">
                <div class="whats-new-card__media" aria-hidden="true">
                    <span class="material-symbols-outlined whats-new-card__icon"><%= f.icon %></span>
                </div>
                <div class="whats-new-card__content">
                    <h3 class="whats-new-card__title">
                        <span class="material-symbols-outlined"><%= f.icon %></span>
                        <%= f.title %>
                    </h3>
                    <p class="whats-new-card__summary"><%= f.summary %></p>
                    <div class="whats-new-card__actions">
                        <a href="/help/<%= f.helpSlug %>?from=whats-new" class="whats-new-btn-manual">
                            <span class="material-symbols-outlined">menu_book</span>
                            Ver manual
                        </a>
                    </div>
                </div>
            </article>
            <% }); %>
        </div>
        <footer class="whats-new-modal__footer">
            <button type="button" class="whats-new-btn-dismiss" id="whats-new-dismiss">Entendido</button>
        </footer>
    </div>
</div>
<% } %>
