<div class="univ-search" id="univ-search">
    <button type="button" class="univ-search__btn" id="univ-search-btn"
            aria-label="Buscar" aria-haspopup="true" aria-expanded="false">
        <span class="material-symbols-outlined">search</span>
    </button>
    <div class="univ-search__panel" id="univ-search-panel" hidden>
        <div class="univ-search__input-wrap">
            <span class="material-symbols-outlined">search</span>
            <input type="text" id="univ-search-input"
                   placeholder="Buscar envíos, incidencias..."
                   autocomplete="off" spellcheck="false">
        </div>
        <div class="univ-search__results" id="univ-search-results">
            <p class="univ-search__hint">Escribí al menos 2 caracteres</p>
        </div>
    </div>
</div>
