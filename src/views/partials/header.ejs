<!-- LGT-217 — salto al contenido para navegación por teclado/lector de pantalla. -->
<a href="#main-content" class="skip-to-content">Saltar al contenido</a>
<header>
    <div class="left-header">
        <button class="nav-close-btn" id="btn-nav-close" aria-label="Cerrar menú">
            <span class="material-symbols-outlined">close</span>
        </button>
        <a href="<%= currentUser.roleId === 3 ? '/delivery' : '/home' %>" class="logo">
            <img src="<%= typeof logoEmpresa !== 'undefined' ? logoEmpresa : '/images/logo.png' %>" alt="<%= nombreEmpresa %> logo">
            <h1><%= nombreEmpresa %></h1>
        </a>
        <div class="nav">
            <li>
                <% if (currentUser.roleId === 3) { %>
    <a href="/delivery"><ul><span class="material-symbols-outlined">local_shipping</span>Mis Envíos</ul></a>
<% } else { %>
    <a href="/shipment"><ul><span class="material-symbols-outlined">local_shipping</span>Envios</ul></a>
<% } %>
                <% if (currentUser.roleId === 1 || currentUser.roleId === 4) { %>
                    <a href="/route"><ul><span class="material-symbols-outlined">route</span>Ruteo</ul></a>
                    <a href="/transport"><ul><span class="material-symbols-outlined">local_shipping</span>Transportes</ul></a>
                    <a href="/zone"><ul><span class="material-symbols-outlined">map</span>Zonas</ul></a>
                    <a href="/shipment/kanban"><ul><span class="material-symbols-outlined">view_kanban</span>Kanban</ul></a>
                    <a href="/fatigue"><ul><span class="material-symbols-outlined">monitor_heart</span>Ojo de Patrón</ul></a>
                <% } %>
                <% if (currentUser.roleId === 1 || currentUser.roleId === 2 || currentUser.roleId === 4) { %>
                    <a href="/incident"><ul><span class="material-symbols-outlined">report</span>Incidencias</ul></a>
                    <a href="/shipment/modifications"><ul><span class="material-symbols-outlined">edit_note</span>Modificaciones portal</ul></a>
                <% } %>
                <% if (currentUser.roleId === 1 || currentUser.roleId === 4) { %>
                    <a href="/returns"><ul><span class="material-symbols-outlined">assignment_return</span>Devoluciones</ul></a>
                <% } %>
                <% if (currentUser.roleId === 3) { %>
                    <a href="/incident"><ul><span class="material-symbols-outlined">report</span>Mis incidencias</ul></a>
                <% } %>
                <% if (currentUser.roleId === 4) { %>
                    <a href="/shipment/import"><ul><span class="material-symbols-outlined">upload_file</span>Importar CSV</ul></a>
                    <a href="/user"><ul><span class="material-symbols-outlined">contacts_product</span>Usuarios</ul></a>
                <% } %>
                <% if (currentUser.roleId === 1 || currentUser.roleId === 4) { %>
                    <div class="nav-group" id="nav-group-reportes">
                        <button class="nav-group-toggle" onclick="toggleNavGroup('nav-group-reportes')" aria-expanded="false">
                            <span class="material-symbols-outlined">bar_chart</span>
                            Reportes
                            <span class="material-symbols-outlined nav-group-arrow">keyboard_arrow_down</span>
                        </button>
                        <div class="nav-group-items">
                            <a href="/report/shipments-by-period"><ul><span class="material-symbols-outlined">show_chart</span>Volumen de Envíos</ul></a>
                            <a href="/report/on-time-deliveries"><ul><span class="material-symbols-outlined">schedule</span>Entregas a Tiempo</ul></a>
                            <a href="/report/delivery-performance"><ul><span class="material-symbols-outlined">leaderboard</span>Rendimiento</ul></a>
                            <a href="/report/incidents-by-period"><ul><span class="material-symbols-outlined">warning</span>Fallas</ul></a>
                            <a href="/report/satisfaction"><ul><span class="material-symbols-outlined">sentiment_satisfied</span>Satisfacción</ul></a>
                        </div>
                    </div>
                    <div class="nav-group" id="nav-group-notificaciones">
                        <button class="nav-group-toggle" onclick="toggleNavGroup('nav-group-notificaciones')" aria-expanded="false">
                            <span class="material-symbols-outlined">notifications</span>
                            Notificaciones
                            <span class="material-symbols-outlined nav-group-arrow">keyboard_arrow_down</span>
                        </button>
                        <div class="nav-group-items">
                            <a href="/notification/fallidas"><ul><span class="material-symbols-outlined">mark_email_unread</span>Bandeja</ul></a>
                        </div>
                    </div>
                <% } %>
                <% if (currentUser.roleId === 4) { %>
                    <div class="nav-group" id="nav-group-ajustes">
                        <button class="nav-group-toggle" onclick="toggleNavGroup('nav-group-ajustes')" aria-expanded="false">
                            <span class="material-symbols-outlined">settings</span>
                            Ajustes
                            <span class="material-symbols-outlined nav-group-arrow">keyboard_arrow_down</span>
                        </button>
                        <div class="nav-group-items">
                            <a href="/setting/general"><ul><span class="material-symbols-outlined">tune</span>General</ul></a>
                            <a href="/setting/comunicaciones"><ul><span class="material-symbols-outlined">mark_email_read</span>Comunicaciones</ul></a>
                            <a href="/setting/plantillas"><ul><span class="material-symbols-outlined">smart_button</span>Plantillas</ul></a>
                            <a href="/setting/ruteo"><ul><span class="material-symbols-outlined">local_shipping</span>Ruteo y sucursales</ul></a>
                            <a href="/setting/catalogos"><ul><span class="material-symbols-outlined">category</span>Catálogos</ul></a>
                            <a href="/setting/incidencias"><ul><span class="material-symbols-outlined">report</span>Incidencias</ul></a>
                            <a href="/fatigue/config"><ul><span class="material-symbols-outlined">monitor_heart</span>Ojo de Patrón (config)</ul></a>
                            <a href="/setting/auditoria"><ul><span class="material-symbols-outlined">history</span>Auditoría</ul></a>
                        </div>
                    </div>
                <% } %>
            </li>
        </div>
        <div class="theme-toggle">
            <button id="btn-theme" aria-label="Cambiar tema">
                <span class="material-symbols-outlined" id="theme-icon">light_mode</span>
                <span id="theme-label">Modo oscuro</span>
            </button>
        </div>
    </div>
    <div class="top-header">
        <button id="btn-hamburger" class="hamburger-btn" aria-label="Abrir menú">
            <span class="material-symbols-outlined">menu</span>
        </button>
        <a href="<%= currentUser.roleId === 3 ? '/delivery' : '/home' %>" class="logo-mobile">
            <img src="<%= typeof logoEmpresa !== 'undefined' ? logoEmpresa : '/images/logo.png' %>" alt="<%= nombreEmpresa %>">
            <span><%= nombreEmpresa %></span>
        </a>
        <%- include('notificationBell') %>
        <div class="user">
            <div class="user-avatar"><%= currentUser.fullName.split(' ').slice(0,2).map(w => w[0]).join('').toUpperCase() %></div>
            <span class="user-name"><%= currentUser.fullName %></span>
            <span class="user-role"><%= currentUser.roleId == 1 ? "Supervisor" : currentUser.roleId == 2 ? "Operador" : currentUser.roleId == 3 ? "Repartidor" : "Administrador" %></span>
            <span class="material-symbols-outlined">keyboard_arrow_down</span>
        </div>
        <div class="user-dropdown" id="user-dropdown">
            <li>
                <ul><a href="/logout"><span class="material-symbols-outlined">manage_accounts</span>Configurar perfil</a></ul>
                <div class="dropdown-divider"></div>
                <ul class="danger"><a href="/logout"><span class="material-symbols-outlined">logout</span>Cerrar sesión</a></ul>
            </li>
        </div>
    </div>
</header>
<div id="nav-overlay" class="nav-overlay"></div>
<script>
    // LGT-217 — marca el <main> como destino del salto de contenido y foco programático.
    document.addEventListener('DOMContentLoaded', function () {
        var m = document.querySelector('main');
        if (m && !m.id) { m.id = 'main-content'; }
        if (m && !m.hasAttribute('tabindex')) { m.setAttribute('tabindex', '-1'); }
    });
</script>
