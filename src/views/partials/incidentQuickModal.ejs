<%# Modal rápido para reportar una incidencia sin salir de la página actual.
    Lo incluyen el detalle y la tabla de envíos. Expone window.openIncidentModal({...}). %>
<div id="iqm-backdrop" class="iqm-backdrop" role="dialog" aria-modal="true" aria-labelledby="iqm-title" hidden>
    <div class="iqm-modal">
        <div class="iqm-header">
            <h3 id="iqm-title"><span class="material-symbols-outlined">report</span> Reportar incidencia</h3>
            <button type="button" class="iqm-close" id="iqm-close" aria-label="Cerrar">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form id="iqm-form" class="iqm-body">
            <input type="hidden" name="shipmentId" id="iqm-shipmentId">
            <input type="hidden" name="branchId" id="iqm-branchId">

            <div class="iqm-context">
                <span class="iqm-chip"><span class="material-symbols-outlined">inventory_2</span><strong id="iqm-tracking">—</strong></span>
                <span class="iqm-chip iqm-chip--muted"><span class="material-symbols-outlined">store</span><span id="iqm-branchName">—</span></span>
            </div>

            <%# Incidencias ya abiertas del envío: se cargan al abrir el modal para que el
                operador sepa qué tiene asociado y no duplique un tipo. %>
            <div class="iqm-assoc" id="iqm-assoc" hidden></div>

            <div class="iqm-field">
                <label for="iqm-type">Tipo <span class="iqm-req">*</span></label>
                <select id="iqm-type" name="incidentTypeId" required></select>
            </div>

            <div class="iqm-row">
                <div class="iqm-field">
                    <label for="iqm-priority">Prioridad</label>
                    <select id="iqm-priority" name="priority">
                        <option value="1">Baja</option>
                        <option value="2" selected>Media</option>
                        <option value="3">Alta</option>
                        <option value="4">Urgente</option>
                    </select>
                </div>
                <div class="iqm-field">
                    <label for="iqm-assignee">Asignar a <span class="iqm-req">*</span></label>
                    <select id="iqm-assignee" name="assignedToUserId" required></select>
                </div>
            </div>

            <div class="iqm-field">
                <label for="iqm-description">Descripción <span class="iqm-req">*</span></label>
                <textarea id="iqm-description" name="description" rows="4" maxlength="2000" required
                          placeholder="Describí brevemente la incidencia..."></textarea>
            </div>

            <label class="iqm-warning" id="iqm-warning-row" hidden>
                <input type="checkbox" name="confirmWarning" value="1" id="iqm-confirm">
                <span id="iqm-warning-text"></span>
            </label>

            <div class="iqm-error" id="iqm-error" hidden></div>

            <div class="iqm-actions">
                <a id="iqm-fulllink" class="iqm-btn iqm-btn--ghost" href="#">Abrir formulario completo</a>
                <button type="submit" class="iqm-btn" id="iqm-submit">
                    <span class="material-symbols-outlined">send</span> Crear incidencia
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .iqm-backdrop { position: fixed; inset: 0; background: rgba(15,23,42,.55); display: none; align-items: center; justify-content: center; z-index: 1000; padding: 1rem; }
    .iqm-backdrop:not([hidden]) { display: flex; }
    .iqm-modal { background: var(--color-surface); color: var(--color-text); border: 1px solid var(--color-border); border-radius: 14px; width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto; box-shadow: 0 18px 48px rgba(15,23,42,.3); }
    .iqm-header { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; border-bottom: 1px solid var(--color-border); }
    .iqm-header h3 { margin: 0; font-size: 1.05rem; display: inline-flex; align-items: center; gap: .5rem; }
    .iqm-close { background: none; border: none; cursor: pointer; color: var(--color-text-secondary); display: inline-flex; padding: .25rem; border-radius: 8px; }
    .iqm-close:hover { background: var(--color-surface-alt); color: var(--color-text); }
    .iqm-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
    .iqm-context { display: flex; flex-wrap: wrap; gap: .5rem; }
    .iqm-chip { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .7rem; border-radius: 999px; font-size: .85rem; background: rgba(37,99,235,.1); border: 1px solid rgba(37,99,235,.25); }
    .iqm-chip .material-symbols-outlined { font-size: 18px; }
    .iqm-chip--muted { background: var(--color-surface-alt); border-color: var(--color-border); color: var(--color-text-secondary); }
    .iqm-field { display: flex; flex-direction: column; gap: .35rem; min-width: 0; }
    .iqm-field label { font-size: .78rem; font-weight: 600; color: var(--color-text-secondary); }
    .iqm-req { color: #dc2626; }
    .iqm-field select, .iqm-field textarea { width: 100%; box-sizing: border-box; padding: .55rem .7rem; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-surface); color: var(--color-text); font-size: .9rem; font-family: inherit; }
    .iqm-field select:focus, .iqm-field textarea:focus { outline: none; border-color: var(--color-primary); }
    .iqm-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 480px) { .iqm-row { grid-template-columns: 1fr; } }
    .iqm-warning { display: flex; align-items: flex-start; gap: .5rem; font-size: .85rem; background: rgba(217,119,6,.12); border: 1px solid rgba(217,119,6,.35); color: #92400e; padding: .6rem .75rem; border-radius: 8px; }
    .iqm-warning input { margin-top: .15rem; }
    .iqm-error { font-size: .85rem; color: #dc2626; background: rgba(220,38,38,.1); border: 1px solid rgba(220,38,38,.3); padding: .6rem .75rem; border-radius: 8px; }
    .iqm-assoc { font-size: .85rem; background: rgba(217,119,6,.1); border: 1px solid rgba(217,119,6,.35); color: #92400e; padding: .6rem .75rem; border-radius: 8px; }
    .iqm-assoc__head { display: flex; align-items: center; gap: .35rem; font-weight: 600; }
    .iqm-assoc__head .material-symbols-outlined { font-size: 18px; }
    .iqm-assoc ul { list-style: none; margin: .45rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .3rem; }
    .iqm-assoc li { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .iqm-assoc a { font-weight: 700; color: var(--color-primary); text-decoration: none; }
    .iqm-assoc a:hover { text-decoration: underline; }
    .iqm-assoc__badge { font-size: .68rem; font-weight: 700; padding: .05rem .45rem; border-radius: 999px; background: rgba(220,38,38,.15); color: #dc2626; }
    .iqm-actions { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
    .iqm-btn { display: inline-flex; align-items: center; gap: .4rem; padding: .6rem 1rem; background: var(--color-primary); color: #fff; border: none; border-radius: 8px; font-weight: 600; font-size: .9rem; cursor: pointer; text-decoration: none; }
    .iqm-btn:disabled { opacity: .6; cursor: default; }
    .iqm-btn--ghost { background: transparent; color: var(--color-text-secondary); border: 1px solid var(--color-border); font-weight: 500; font-size: .85rem; }
    .iqm-btn .material-symbols-outlined { font-size: 18px; }
</style>

<script>
(function () {
    var backdrop = document.getElementById('iqm-backdrop');
    if (!backdrop) { return; }
    var form      = document.getElementById('iqm-form');
    var elTracking = document.getElementById('iqm-tracking');
    var elBranch   = document.getElementById('iqm-branchName');
    var elShipId   = document.getElementById('iqm-shipmentId');
    var elBranchId = document.getElementById('iqm-branchId');
    var elType     = document.getElementById('iqm-type');
    var elAssignee = document.getElementById('iqm-assignee');
    var elDesc     = document.getElementById('iqm-description');
    var elPriority = document.getElementById('iqm-priority');
    var elError    = document.getElementById('iqm-error');
    var elWarnRow  = document.getElementById('iqm-warning-row');
    var elWarnText = document.getElementById('iqm-warning-text');
    var elConfirm  = document.getElementById('iqm-confirm');
    var elSubmit   = document.getElementById('iqm-submit');
    var elFullLink = document.getElementById('iqm-fulllink');
    var elAssoc    = document.getElementById('iqm-assoc');

    var cache = null;          // { types, users } cargado una sola vez
    var currentBranchKey = null; // id de sucursal seleccionada ('0' = sin sucursal)

    function close() { backdrop.setAttribute('hidden', ''); }
    function showError(msg) { elError.textContent = msg; elError.hidden = !msg; }

    var escAssoc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]); }); };

    // Carga y muestra las incidencias ya abiertas del envío (si las hay).
    function loadAssoc(shipmentId) {
        elAssoc.hidden = true; elAssoc.innerHTML = '';
        if (!shipmentId) { return; }
        fetch('/incident/quick-data?shipmentId=' + encodeURIComponent(shipmentId), { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                var list = (d && d.incidents) || [];
                if (!list.length) { return; }
                var items = list.map(function (i) {
                    return '<li><a href="/incident/' + encodeURIComponent(i.id) + '" target="_blank" rel="noopener">#' + escAssoc(i.id) + '</a>'
                        + '<span>' + escAssoc(i.typeLabel) + '</span>'
                        + '<span class="iqm-assoc__badge">' + escAssoc(i.statusLabel) + '</span></li>';
                }).join('');
                elAssoc.innerHTML = '<div class="iqm-assoc__head"><span class="material-symbols-outlined">report</span>'
                    + 'Ya tiene ' + list.length + ' incidencia' + (list.length === 1 ? '' : 's') + ' abierta' + (list.length === 1 ? '' : 's')
                    + ' — revisá no duplicar el tipo.</div><ul>' + items + '</ul>';
                elAssoc.hidden = false;
            })
            .catch(function () { /* no bloquea el alta si falla */ });
    }

    function fillTypes() {
        elType.innerHTML = '';
        cache.types.forEach(function (t) {
            var o = document.createElement('option');
            o.value = t.id; o.textContent = t.description || t.code;
            elType.appendChild(o);
        });
    }

    function fillAssignees(branchKey) {
        elAssignee.innerHTML = '';
        var matches = cache.users.filter(function (u) {
            return branchKey === '0' ? (u.branchId === null) : (String(u.branchId) === String(branchKey));
        });
        if (matches.length === 0) {
            var o = document.createElement('option');
            o.value = ''; o.textContent = 'Sin usuarios en esta sucursal';
            elAssignee.appendChild(o);
            elAssignee.disabled = true;
            elSubmit.disabled = true;
            showError('No hay staff en esta sucursal. Usá el formulario completo para elegir otra.');
            return;
        }
        elAssignee.disabled = false;
        elSubmit.disabled = false;
        matches.forEach(function (u) {
            var o = document.createElement('option');
            o.value = u.id;
            o.textContent = u.fullName + (u.roleDescription ? ' · ' + u.roleDescription : '');
            elAssignee.appendChild(o);
        });
    }

    function loadData() {
        if (cache) { return Promise.resolve(cache); }
        return fetch('/incident/quick-data', { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) { cache = d; return d; });
    }

    // API pública. branchId puede venir null/undefined → "Sin sucursal" (0).
    window.openIncidentModal = function (opts) {
        opts = opts || {};
        var branchKey = (opts.branchId === null || opts.branchId === undefined || opts.branchId === '')
            ? '0' : String(opts.branchId);
        currentBranchKey = branchKey;

        elShipId.value   = opts.shipmentId || '';
        elBranchId.value = branchKey;
        elTracking.textContent = opts.trackingId || ('#' + (opts.shipmentId || ''));
        elBranch.textContent   = opts.branchName || (branchKey === '0' ? 'Sin sucursal' : 'Sucursal #' + branchKey);
        elFullLink.href = '/incident/new?shipmentId=' + encodeURIComponent(opts.shipmentId || '');

        // reset
        elDesc.value = ''; elPriority.value = '2';
        elWarnRow.hidden = true; elConfirm.checked = false; showError('');
        elSubmit.disabled = false; elAssignee.disabled = false;

        backdrop.removeAttribute('hidden');
        loadData()
            .then(function () { fillTypes(); fillAssignees(branchKey); })
            .catch(function () { showError('No se pudieron cargar los datos. Probá el formulario completo.'); });
        loadAssoc(opts.shipmentId);
    };

    // Delegación: cualquier elemento con [data-incident-open] abre el modal con sus data-*.
    document.addEventListener('click', function (e) {
        var trigger = e.target.closest('[data-incident-open]');
        if (!trigger) { return; }
        e.preventDefault();
        window.openIncidentModal({
            shipmentId:  trigger.getAttribute('data-shipment-id'),
            trackingId:  trigger.getAttribute('data-tracking-id'),
            branchId:    trigger.getAttribute('data-branch-id'),
            branchName:  trigger.getAttribute('data-branch-name'),
        });
    });

    document.getElementById('iqm-close').addEventListener('click', close);
    backdrop.addEventListener('click', function (e) { if (e.target === backdrop) { close(); } });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !backdrop.hasAttribute('hidden')) { close(); } });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        showError('');
        elSubmit.disabled = true;
        var body = new URLSearchParams(new FormData(form)).toString();
        fetch('/incident', {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body
        }).then(function (r) {
            return r.json().then(function (data) { return { ok: r.ok, data: data }; });
        }).then(function (res) {
            if (res.ok && res.data.ok) {
                close();
                var url = '/incident/' + res.data.incidentId;
                if (window.Swal) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Incidencia #' + res.data.incidentId + ' creada',
                        text: 'Envío ' + (res.data.trackingId || ''),
                        showCancelButton: true,
                        confirmButtonText: 'Ver incidencia',
                        cancelButtonText: 'Seguir acá'
                    }).then(function (r2) { if (r2.isConfirmed) { window.location.href = url; } });
                } else {
                    window.location.href = url;
                }
                return;
            }
            elSubmit.disabled = false;
            var msg = (res.data && res.data.error) || 'No se pudo crear la incidencia.';
            showError(msg);
            // Warning soft del backend: revelar checkbox "Confirmo crear igual".
            if (/Confirmo crear igual/i.test(msg)) {
                elWarnRow.hidden = false;
                elWarnText.textContent = msg.replace(/\s*Marcá "Confirmo crear igual".*/i, '');
            }
        }).catch(function () {
            elSubmit.disabled = false;
            showError('Error de red. Intentá de nuevo.');
        });
    });
})();
</script>
