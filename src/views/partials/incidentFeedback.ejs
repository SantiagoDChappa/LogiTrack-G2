</style>
<script>
(function () {
    if (window.showIncidentFeedback) { return; }

    const ICON_MAP = {
        warning: { glyph: 'warning', label: 'Validación', badge: 'badge badge--warning' },
        error:   { glyph: 'error', label: 'Atención', badge: 'badge badge--danger' },
        success: { glyph: 'task_alt', label: 'Confirmado', badge: 'badge badge--success' },
        info:    { glyph: 'info', label: 'Información', badge: 'badge badge--info' }
    };

    function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, function (char) {
            return {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[char];
        });
    }

    function stripTags(value) {
        return String(value ?? '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
    }

    function buildBody(opts) {
        if (opts.html) { return opts.html; }

        const parts = [];
        if (opts.text || opts.intro) {
            parts.push('<p class="incident-feedback-note">' + escapeHtml(opts.text || opts.intro) + '</p>');
        }
        if (Array.isArray(opts.items) && opts.items.length) {
            parts.push(
                '<ul class="incident-feedback-list">'
                + opts.items.map(function (item) {
                    return ''
                        + '<li>'
                        + '<span class="material-symbols-outlined">subdirectory_arrow_right</span>'
                        + '<span>' + escapeHtml(item) + '</span>'
                        + '</li>';
                }).join('')
                + '</ul>'
            );
        }
        return parts.join('');
    }

    function buildMarkup(opts, tone) {
        const config = ICON_MAP[tone] || ICON_MAP.warning;
        return ''
            + '<div class="incident-feedback-shell incident-feedback-shell--' + tone + '">'
            + '  <div class="incident-feedback-head">'
            + '    <div class="incident-feedback-mark"><span class="material-symbols-outlined">' + config.glyph + '</span></div>'
            + '    <div class="incident-feedback-copy">'
            + '      <span class="' + config.badge + ' incident-feedback-badge">' + config.label + '</span>'
            + '      <h2 class="incident-feedback-title">' + escapeHtml(opts.title || 'Revisá este dato') + '</h2>'
            + '      <p class="incident-feedback-subtitle">' + escapeHtml(opts.subtitle || 'Hay un dato que necesitamos completar antes de continuar.') + '</p>'
            + '    </div>'
            + '  </div>'
            + '  <div class="incident-feedback-body">' + buildBody(opts) + '</div>'
            + '</div>';
    }

    window.showIncidentFeedback = function (opts) {
        const input = Object.assign({}, opts || {});
        const tone = input.icon || 'warning';

        if (window.Swal && typeof window.Swal.fire === 'function') {
            return window.Swal.fire({
                title: '',
                icon: undefined,
                html: buildMarkup(input, tone),
                confirmButtonText: input.confirmButtonText || 'Entendido',
                buttonsStyling: false,
                customClass: {
                    container: 'incident-feedback-container',
                    popup: 'incident-feedback-popup',
                    htmlContainer: 'incident-feedback-html',
                    actions: 'incident-feedback-actions',
                    confirmButton: 'incident-feedback-confirm'
                },
                backdrop: 'rgba(15, 23, 42, 0.32)',
                showCloseButton: false,
                focusConfirm: true
            });
        }

        const pieces = [];
        if (input.title) { pieces.push(input.title); }
        if (input.subtitle) { pieces.push(input.subtitle); }
        if (input.text) { pieces.push(input.text); }
        if (input.intro) { pieces.push(input.intro); }
        if (Array.isArray(input.items) && input.items.length) {
            pieces.push(input.items.join(', '));
        }
        if (input.html) { pieces.push(stripTags(input.html)); }
        window.alert(pieces.filter(Boolean).join('\n\n'));
        return Promise.resolve();
    };
})();
</script>
