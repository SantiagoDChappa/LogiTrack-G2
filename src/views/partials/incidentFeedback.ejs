        margin: 0 !important;
        padding: 0 !important;
        text-align: left !important;
    }
    .incident-feedback-shell {
        color: var(--color-text);
    }
    .incident-feedback-head {
        display: flex;
        align-items: flex-start;
        gap: var(--space-4);
        padding: var(--space-5);
