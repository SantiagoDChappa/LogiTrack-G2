<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>(function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=block" rel="stylesheet" />
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/components.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/logo.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/header.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/menu.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/table-paginate.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/page-loader.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/a11y.css?v=<%= assetVersion %>">
<link rel="shortcut icon" href="/images/favicon.ico?v=<%= assetVersion %>" />
<% if (typeof statusColorsCss !== 'undefined' && statusColorsCss) { %><style id="status-colors-override"><%- statusColorsCss %></style><% } %>
<link rel="stylesheet" href="/css/search.css?v=<%= assetVersion %>">
<script src="/js/table-paginate.js?v=<%= assetVersion %>" defer></script>
<script src="/js/page-loader.js?v=<%= assetVersion %>" defer></script>
<script src="/js/search.js?v=<%= assetVersion %>" defer></script>
<%# #4 PWA / modo offline del repartidor (el script se autolimita a /delivery) %>
<link rel="manifest" href="/manifest.webmanifest">
<script src="/js/offline-delivery.js?v=<%= assetVersion %>" defer></script>
<% if (typeof currentUser !== 'undefined' && currentUser) { %>
<script>window.__LGT={userId:<%= currentUser.id %>,roleId:<%= currentUser.roleId %>,onboarded:<%= currentUser.onboarded ? 'true' : 'false' %>};</script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1/dist/driver.css"/>
<link rel="stylesheet" href="/css/onboarding-tour.css?v=<%= assetVersion %>">
<script src="https://cdn.jsdelivr.net/npm/driver.js@1/dist/driver.js.iife.js"></script>
<script src="/js/onboarding-tour.js?v=<%= assetVersion %>" defer></script>
<% } %>
