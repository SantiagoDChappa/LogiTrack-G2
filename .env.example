# ==============================
# LogiTrack - Variables de Entorno
# ==============================
# Copia este archivo como .env y completa los valores

# Base de datos PostgreSQL (Neon, Supabase, local, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Puerto del servidor (por defecto 3000)
PORT=3000

# Secreto para firmar JWT (usar una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro

# Nodemailer - configuración de email (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_contrasena_de_aplicacion
EMAIL_FROM=tu_email@gmail.com

# Twilio - SMS (opcional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Python binary para el módulo ML (python o python3)
PYTHON_BIN=python
